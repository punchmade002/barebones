[{"skill": {"id": "alg-factor-quadratic", "title": "Factorise a quadratic trinomial", "level": "OL", "input": "ax² + bx + c", "output": "(px + q)(rx + s)", "example": "2x² + 7x + 3 → (2x + 1)(x + 3)", "needs": ["Multiply out two brackets"]}, "write": 1, "examParts": 1, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual. The method: Split the middle term using two numbers with the right product and sum, then factorise by grouping. Earlier backups were dropped for doing this instead: Expands (x + 6)(x + 2) and compares coefficients instead of factorising a trinomial.", "references": [{"part": "practice-alg-factor-quadratic-1", "level": "ordinary", "marks": 10, "steps": [{"title": "Find two numbers with product $3 \\times 8 = 24$ and sum $-10$", "lines": [{"text": "The numbers are $-4$ and $-6$."}]}, {"title": "Split the middle term", "lines": [{"tex": "3x^2 - 10x + 8 &= 3x^2 - 6x - 4x + 8", "sym": "3*x**2-6*x-4*x+8"}]}, {"title": "Factorise by grouping", "lines": [{"tex": "&= 3x(x - 2) - 4(x - 2)", "sym": "3*x*(x-2)-4*(x-2)"}, {"tex": "&= (3x - 4)(x - 2)", "sym": "(3*x-4)*(x-2)"}]}], "final": "(3x - 4)(x - 2)"}, {"part": "practice-alg-factor-quadratic-2", "level": "ordinary", "marks": 10, "steps": [{"title": "Find two numbers with product $2 \\times (-15) = -30$ and sum $1$", "lines": [{"text": "The numbers are $6$ and $-5$."}]}, {"title": "Split the middle term", "lines": [{"tex": "2x^2 + x - 15 &= 2x^2 + 6x - 5x - 15", "sym": "2*x**2+6*x-5*x-15"}]}, {"title": "Factorise by grouping", "lines": [{"tex": "&= 2x(x + 3) - 5(x + 3)", "sym": "2*x*(x+3)-5*(x+3)"}, {"tex": "&= (2x - 5)(x + 3)", "sym": "(2*x-5)*(x+3)"}]}], "final": "(2x - 5)(x + 3)"}]}, {"skill": {"id": "alg-fractions-simplify", "title": "Multiply, divide and simplify rational expressions", "level": "HL", "input": "rational algebraic expressions", "output": "simplified fraction", "example": "(x² − 4)/(x² + x − 6) → (x + 2)/(x + 3)", "needs": ["Add/subtract algebraic fractions", "Factorise a quadratic trinomial"]}, "write": 1, "examParts": 1, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual. The method: Factorise every quadratic, turn division into multiplication, and cancel common factors. Earlier backups were dropped for doing this instead: Substitutes for n and simplifies fractions inside fractions with nothing to factorise or cancel.", "references": [{"part": "practice-alg-fractions-simplify-2", "level": "higher", "marks": 10, "steps": [{"title": "Turn the division into a multiplication", "lines": [{"text": "Invert the second fraction."}, {"tex": "\\frac{x^2-x-6}{x^2-1} \\div \\frac{x^2-2x-3}{x^2+3x+2} &= \\frac{x^2-x-6}{x^2-1} \\times \\frac{x^2+3x+2}{x^2-2x-3}", "sym": "(x**2-x-6)/(x**2-1) / ((x**2-2*x-3)/(x**2+3*x+2))"}]}, {"title": "Factorise every quadratic", "lines": [{"tex": "x^2 - x - 6 &= (x-3)(x+2)", "sym": "(x-3)*(x+2)", "new": true}, {"tex": "x^2 - 1 &= (x-1)(x+1)", "sym": "(x-1)*(x+1)", "new": true}, {"tex": "x^2 + 3x + 2 &= (x+1)(x+2)", "sym": "(x+1)*(x+2)", "new": true}, {"tex": "x^2 - 2x - 3 &= (x-3)(x+1)", "sym": "(x-3)*(x+1)", "new": true}]}, {"title": "Substitute the factors", "lines": [{"tex": "&= \\frac{(x-3)(x+2)}{(x-1)(x+1)} \\times \\frac{(x+1)(x+2)}{(x-3)(x+1)}", "sym": "(x-3)*(x+2)/((x-1)*(x+1)) * (x+1)*(x+2)/((x-3)*(x+1))", "new": true}]}, {"title": "Cancel common factors", "lines": [{"text": "Cancel $(x-3)$ and one $(x+1)$ from top and bottom."}, {"tex": "&= \\frac{(x+2)(x+2)}{(x-1)(x+1)}", "sym": "(x+2)*(x+2)/((x-1)*(x+1))"}, {"tex": "&= \\frac{(x+2)^2}{(x-1)(x+1)}", "sym": "(x+2)**2/((x-1)*(x+1))"}]}], "final": "\\frac{(x+2)^2}{(x-1)(x+1)}"}, {"part": "practice-alg-fractions-simplify-1", "level": "higher", "marks": 10, "steps": [{"title": "Factorise the first denominator", "lines": [{"tex": "x^2 - 4 &= (x-2)(x+2)", "sym": "(x-2)*(x+2)", "new": true}, {"text": "This is the common denominator, since $x+2$ is already a factor."}]}, {"title": "Write both fractions over the common denominator", "lines": [{"tex": "\\frac{x}{x^2-4} - \\frac{1}{x+2} &= \\frac{x}{(x-2)(x+2)} - \\frac{1\\cdot(x-2)}{(x+2)(x-2)}", "sym": "x/(x**2-4)-1/(x+2)", "new": true}]}, {"title": "Combine and simplify the numerator", "lines": [{"tex": "&= \\frac{x - (x-2)}{(x-2)(x+2)}", "sym": "x/(x**2-4)-1/(x+2)"}, {"tex": "&= \\frac{x - x + 2}{(x-2)(x+2)}", "sym": "(x-x+2)/((x-2)*(x+2))"}, {"tex": "&= \\frac{2}{(x-2)(x+2)}", "sym": "2/((x-2)*(x+2))"}]}], "final": "\\frac{2}{(x-2)(x+2)}"}]}, {"skill": {"id": "alg-surd-expressions", "title": "Simplify algebraic expressions with surds", "level": "HL", "input": "expression with surds and brackets", "output": "simplified / rationalised form", "example": "(√x + 1)(√x − 1) → x − 1", "needs": ["Simplify and operate on surds", "Multiply out two brackets"]}, "write": 2, "examParts": 2, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual. The method: Write two surd fractions over a common denominator, simplify the numerator, and use difference of two squares to remove surds from the denominator. Earlier backups were dropped for doing this instead: Expands cubed surd brackets and subtracts to get a number, rather than combining surd fractions over a common denominator. Expands squared and cubed surd brackets and then squares, rather than combining surd fractions over a common denominator.", "references": [{"part": "practice-alg-surd-expressions-1", "level": "higher", "marks": 5, "steps": [{"title": "Write over a common denominator", "lines": [{"tex": "\\frac{1}{\\sqrt{a}-\\sqrt{b}} - \\frac{1}{\\sqrt{a}+\\sqrt{b}} &= \\frac{(\\sqrt{a}+\\sqrt{b}) - (\\sqrt{a}-\\sqrt{b})}{(\\sqrt{a}-\\sqrt{b})(\\sqrt{a}+\\sqrt{b})}", "sym": "1/(sqrt(a)-sqrt(b)) - 1/(sqrt(a)+sqrt(b))", "new": true}]}, {"title": "Simplify the numerator", "lines": [{"tex": "(\\sqrt{a}+\\sqrt{b}) - (\\sqrt{a}-\\sqrt{b}) &= \\sqrt{a}+\\sqrt{b}-\\sqrt{a}+\\sqrt{b}", "sym": "(sqrt(a)+sqrt(b)) - (sqrt(a)-sqrt(b))", "new": true}, {"tex": "&= 2\\sqrt{b}", "sym": "2*sqrt(b)"}]}, {"title": "Simplify the denominator (difference of two squares)", "lines": [{"tex": "(\\sqrt{a}-\\sqrt{b})(\\sqrt{a}+\\sqrt{b}) &= (\\sqrt{a})^2 - (\\sqrt{b})^2", "sym": "(sqrt(a)-sqrt(b))*(sqrt(a)+sqrt(b))", "new": true}, {"tex": "&= a - b", "sym": "a - b"}]}, {"title": "Put the numerator over the denominator", "lines": [{"tex": "\\frac{1}{\\sqrt{a}-\\sqrt{b}} - \\frac{1}{\\sqrt{a}+\\sqrt{b}} &= \\frac{2\\sqrt{b}}{a-b}", "sym": "2*sqrt(b)/(a-b)", "new": true}]}], "final": "\\frac{2\\sqrt{b}}{a-b}"}]}, {"skill": {"id": "circ-general-form", "title": "Use x² + y² + 2gx + 2fy + c = 0", "level": "HL", "input": "general equation", "output": "centre (−g, −f), r = √(g² + f² − c)", "example": "x² + y² − 4x + 6y − 12 = 0 → (2, −3), r = 5", "needs": ["Write/interpret (x − h)² + (y − k)² = r²"]}, "write": 1, "examParts": 2, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual. The method: Compare with x^2 + y^2 + 2gx + 2fy + c = 0 to read the centre (-g, -f) and radius sqrt(g^2 + f^2 - c). Earlier backups were dropped for doing this instead: Completes the square and solves for k instead of reading g, f and c straight off the general form.", "references": [{"part": "maths-pp-2024-higher-p2-q5#(a)(i)", "level": "higher", "marks": 10, "steps": [{"title": "Compare with the general circle equation", "lines": [{"text": "The general form is $x^2 + y^2 + 2gx + 2fy + c = 0$, with centre $(-g, -f)$ and radius $\\sqrt{g^2 + f^2 - c}$."}, {"tex": "2g &= 4 \\Rightarrow g = 2"}, {"tex": "2f &= -6 \\Rightarrow f = -3"}, {"tex": "c &= 5"}]}, {"title": "Write down the centre", "lines": [{"tex": "\\text{Centre} &= (-g, -f)"}, {"tex": "&= (-2, 3)"}]}, {"title": "Find the radius", "lines": [{"tex": "r &= \\sqrt{g^2 + f^2 - c}"}, {"tex": "&= \\sqrt{(2)^2 + (-3)^2 - 5}"}, {"tex": "&= \\sqrt{4 + 9 - 5}"}, {"tex": "&= \\sqrt{8}"}, {"tex": "&= 2\\sqrt{2}"}]}], "final": "\\text{Centre} = (-2, 3), \\quad r = 2\\sqrt{2}"}, {"part": "practice-circ-general-form-1", "level": "higher", "marks": 10, "steps": [{"title": "Compare with the general circle equation", "lines": [{"text": "The general form is $x^2 + y^2 + 2gx + 2fy + c = 0$, with centre $(-g, -f)$ and radius $\\sqrt{g^2 + f^2 - c}$."}, {"tex": "2g &= 6", "sym": "Eq(2*g, 6)", "new": true}, {"tex": "g &= 3", "sym": "Eq(g, 3)"}, {"tex": "2f &= -4", "sym": "Eq(2*f, -4)", "new": true}, {"tex": "f &= -2", "sym": "Eq(f, -2)"}, {"tex": "c &= -12", "sym": "Eq(c, -12)", "new": true}]}, {"title": "Write down the centre", "lines": [{"tex": "\\text{Centre} &= (-g, -f)"}, {"tex": "&= (-3, 2)", "sym": "(-3, 2)", "new": true}]}, {"title": "Find the radius", "lines": [{"tex": "r &= \\sqrt{g^2 + f^2 - c}"}, {"tex": "&= \\sqrt{(3)^2 + (-2)^2 - (-12)}", "sym": "sqrt(3**2 + (-2)**2 - (-12))", "new": true}, {"tex": "&= \\sqrt{9 + 4 + 12}", "sym": "sqrt(9 + 4 + 12)"}, {"tex": "&= \\sqrt{25}", "sym": "sqrt(25)"}, {"tex": "&= 5", "sym": "5"}]}], "final": "\\text{Centre} = (-3, 2), \\quad r = 5"}]}]