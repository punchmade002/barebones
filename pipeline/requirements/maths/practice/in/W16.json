[{"skill": {"id": "diff-apply-hl", "title": "Apply derivatives of exp/log/trig functions to problems", "level": "HL", "input": "context with non-polynomial model", "output": "rate, max/min, tangent", "example": "T = 80e^(−0.1t) → rate at t = 5 ≈ −4.85", "needs": ["Differentiate a function needing several rules", "Find and classify turning points"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2020-higher-p1-q9#(d)", "level": "higher", "marks": 5, "steps": [{"title": "Set up the inequality for the rate", "lines": [{"tex": "N'(k) &= 29.25e^{0.065k} > 90"}, {"tex": "e^{0.065k} &> \\frac{90}{29.25}"}]}, {"title": "Take logs and solve", "lines": [{"tex": "0.065k &> \\ln\\left(\\frac{90}{29.25}\\right)"}, {"tex": "k &> \\frac{\\ln(90/29.25)}{0.065}"}, {"tex": "k &> 17.29"}]}, {"title": "Choose the least whole number", "lines": [{"text": "$k$ is a whole number greater than 17.29."}, {"tex": "k &= 18"}]}], "final": "k = 18"}]}, {"skill": {"id": "diff-rational-power", "title": "Differentiate rational powers", "level": "HL", "input": "xⁿ, n ∈ Q (roots, reciprocals)", "output": "nxⁿ⁻¹", "example": "√x → 1/(2√x); 1/x² → −2/x³", "needs": ["Differentiate a polynomial by rule", "Write an expression as a power of a base"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2015-higher-p1-q5#(b)", "level": "higher", "marks": 5, "steps": [{"title": "Write the root as a power", "lines": [{"tex": "f(x) &= x - \\sqrt{x+6}"}, {"tex": "&= x - (x+6)^{\\frac{1}{2}}"}]}, {"title": "Differentiate term by term", "lines": [{"tex": "f'(x) &= 1 - \\frac{1}{2}(x+6)^{-\\frac{1}{2}}"}, {"tex": "&= 1 - \\frac{1}{2\\sqrt{x+6}}"}]}], "final": "f'(x) = 1 - \\frac{1}{2\\sqrt{x+6}}"}]}, {"skill": {"id": "diff-inverse-trig", "title": "Differentiate inverse trig functions", "level": "HL", "input": "sin⁻¹(x/a), tan⁻¹(x/a)", "output": "1/√(a² − x²), a/(a² + x²)", "example": "tan⁻¹(x/2) → 2/(4 + x²)", "needs": ["Apply the chain rule"]}, "write": 3, "examParts": 0, "references": []}, {"skill": {"id": "diff-quotient", "title": "Apply the quotient rule", "level": "HL", "input": "u/v", "output": "(u′v − uv′)/v²", "example": "x/(x + 1) → 1/(x + 1)²", "needs": ["Differentiate a polynomial by rule", "Multiply, divide and simplify rational expressions"]}, "write": 1, "examParts": 2, "references": [{"part": "maths-pp-2024-higher-p1-q4#(b)", "level": "higher", "marks": 10, "steps": [{"title": "Name u and v and differentiate each", "lines": [{"text": "Use the quotient rule: $g'(x)=\\frac{v\\,u' - u\\,v'}{v^2}$."}, {"tex": "u &= 6x + 1"}, {"tex": "\\frac{du}{dx} &= 6"}, {"tex": "v &= x^4 + 3"}, {"tex": "\\frac{dv}{dx} &= 4x^3"}]}, {"title": "Substitute into the quotient rule", "lines": [{"tex": "g'(x) &= \\frac{(x^4+3)(6) - (6x+1)(4x^3)}{(x^4+3)^2}"}]}, {"title": "Substitute x = −2", "lines": [{"tex": "g'(-2) &= \\frac{((-2)^4+3)(6) - (6(-2)+1)(4(-2)^3)}{((-2)^4+3)^2}"}, {"tex": "&= \\frac{(19)(6) - (-11)(-32)}{(19)^2}"}, {"tex": "&= \\frac{114 - 352}{361}"}, {"tex": "&= -\\frac{238}{361}"}]}], "final": "g'(-2) = -\\frac{238}{361}"}, {"part": "maths-pp-2025-higher-p1-q3#(b)", "level": "higher", "marks": 10, "steps": [{"title": "Choose the quotient rule parts", "lines": [{"tex": "u &= 3, \\quad u' = 0"}, {"tex": "v &= 2x - 7, \\quad v' = 2"}]}, {"title": "Substitute into the quotient rule", "lines": [{"tex": "g'(x) &= \\frac{v u' - u v'}{v^2}"}, {"tex": "&= \\frac{(2x-7)(0) - (3)(2)}{(2x-7)^2}"}]}, {"title": "Simplify the numerator", "lines": [{"tex": "&= \\frac{0 - 6}{(2x-7)^2}"}, {"tex": "&= -\\frac{6}{(2x-7)^2}"}]}, {"title": "Explain why there are no turning points", "lines": [{"text": "A turning point needs $g'(x) = 0$, but the numerator is $-6$, which is never $0$."}, {"text": "Also $(2x-7)^2 > 0$ for every $x$ in the domain ($x \\ne 3.5$), so $g'(x) < 0$ always."}, {"text": "So $g'(x) \\ne 0$ for all $x$ in the domain: $g$ has no local maximum or minimum points."}]}], "final": "g'(x) = -\\frac{6}{(2x-7)^2} < 0 \\text{ for all } x \\text{ in the domain, so there are no turning points}"}]}]