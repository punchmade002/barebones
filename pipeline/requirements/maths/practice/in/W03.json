[{"skill": {"id": "alg-expand-binomials", "title": "Multiply out two brackets", "level": "OL", "input": "(x ± y)(w ± z)", "output": "expanded, simplified expression", "example": "(2x + 3)(x − 4) → 2x² − 5x − 12", "needs": ["Expand a bracket by a term"]}, "write": 1, "examParts": 2, "references": [{"part": "maths-pp-2023-ordinary-p1-q6#(b)", "level": "ordinary", "marks": 10, "steps": [{"title": "Write the square as a product", "lines": [{"tex": "(2x-4)^2 - 6 &= (2x-4)(2x-4) - 6"}]}, {"title": "Multiply out each term", "lines": [{"tex": "&= 4x^2 - 8x - 8x + 16 - 6"}]}, {"title": "Collect like terms", "lines": [{"tex": "&= 4x^2 - 16x + 10"}]}], "final": "4x^2 - 16x + 10"}, {"part": "maths-pp-2025-higher-p1-q1#(b)", "level": "higher", "marks": 10, "steps": [{"title": "Split the first bracket into its two terms", "lines": [{"text": "Multiply the whole second bracket by $4x$, then by $-10\\sqrt{x}$."}, {"tex": "(4x - 10\\sqrt{x})(2x + 5\\sqrt{x} - 7) &= 4x(2x + 5\\sqrt{x} - 7) - 10\\sqrt{x}(2x + 5\\sqrt{x} - 7)"}]}, {"title": "Multiply out $4x$ times the second bracket", "lines": [{"tex": "4x(2x + 5\\sqrt{x} - 7) &= 4x \\times 2x + 4x \\times 5\\sqrt{x} - 4x \\times 7"}, {"tex": "&= 8x^2 + 20x\\sqrt{x} - 28x"}]}, {"title": "Multiply out $-10\\sqrt{x}$ times the second bracket", "lines": [{"tex": "-10\\sqrt{x}(2x + 5\\sqrt{x} - 7) &= -20x\\sqrt{x} - 50\\sqrt{x}\\sqrt{x} + 70\\sqrt{x}"}, {"text": "$\\sqrt{x} \\times \\sqrt{x} = x$, so $-50\\sqrt{x}\\sqrt{x} = -50x$."}, {"tex": "&= -20x\\sqrt{x} - 50x + 70\\sqrt{x}"}]}, {"title": "Add the two results and collect like terms", "lines": [{"tex": "&= 8x^2 + 20x\\sqrt{x} - 28x - 20x\\sqrt{x} - 50x + 70\\sqrt{x}"}, {"text": "The $x\\sqrt{x}$ terms cancel, and $-28x - 50x = -78x$."}, {"tex": "&= 8x^2 - 78x + 70\\sqrt{x}"}]}], "final": "8x^2 - 78x + 70\\sqrt{x}"}]}, {"skill": {"id": "alg-add-subtract", "title": "Add/subtract linear and quadratic expressions", "level": "OL", "input": "(ax²+bx+c) ± (dx²+ex+f)", "output": "simplified expression", "example": "(2x²−3x+1) − (x²+x−4) → x² − 4x + 5", "needs": ["Expand a bracket by a term"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2015-ordinary-p1-q7#(g)", "level": "ordinary", "marks": 5, "steps": [{"title": "Use white = total − black", "lines": [{"text": "$W_n + B_n = T_n$, so $W_n = T_n - B_n$, with $B_n = \\tfrac12 n^2 + \\tfrac32 n + 1$."}, {"tex": "W_n &= (n+1)^2 - \\left(\\tfrac{1}{2}n^2 + \\tfrac{3}{2}n + 1\\right)"}]}, {"title": "Expand and simplify", "lines": [{"tex": "W_n &= n^2 + 2n + 1 - \\tfrac{1}{2}n^2 - \\tfrac{3}{2}n - 1"}, {"tex": "&= \\tfrac{1}{2}n^2 + \\tfrac{1}{2}n"}]}], "final": "W_n = \\tfrac{1}{2}n^2 + \\tfrac{1}{2}n"}]}, {"skill": {"id": "alg-factor-grouping", "title": "Factorise by grouping", "level": "JC", "input": "four-term expression", "output": "product of two brackets", "example": "ax + ay + bx + by → (a + b)(x + y)", "needs": ["Factorise by highest common factor"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2019-higher-p1-q3#(a)", "level": "higher", "marks": 5, "steps": [{"title": "Group the terms in pairs", "lines": [{"tex": "3xy - 9x + 4y - 12 &= (3xy - 9x) + (4y - 12)"}]}, {"title": "Take out the common factor of each pair", "lines": [{"tex": "&= 3x(y-3) + 4(y-3)"}]}, {"title": "Take out the common bracket", "lines": [{"tex": "&= (3x+4)(y-3)"}]}], "final": "(3x+4)(y-3)"}]}, {"skill": {"id": "alg-factor-quadratic", "title": "Factorise a quadratic trinomial", "level": "OL", "input": "ax² + bx + c", "output": "(px + q)(rx + s)", "example": "2x² + 7x + 3 → (2x + 1)(x + 3)", "needs": ["Multiply out two brackets"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2025-ordinary-p1-q3#(c)(i), (ii)", "level": "ordinary", "marks": 10, "steps": [{"title": "Choose k and t with k × t = 12", "lines": [{"text": "Pick a factor pair of 12, for example 6 and 2."}, {"tex": "6 \\times 2 &= 12"}, {"text": "So $k = 6$ and $t = 2$."}]}, {"title": "Expand (x + 6)(x + 2)", "lines": [{"tex": "(x + 6)(x + 2) &= x^2 + 2x + 6x + 12"}, {"tex": "&= x^2 + 8x + 12"}]}, {"title": "Compare with x² + bx + 12", "lines": [{"text": "The coefficient of $x$ is $8$, so $b = 8$."}, {"tex": "b &= 8"}]}], "final": "k = 6,\\; t = 2,\\; b = 8"}]}]