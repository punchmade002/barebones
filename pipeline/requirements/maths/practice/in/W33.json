[{"skill": {"id": "seq-verify-formula", "title": "Verify and justify a formula from a number pattern", "level": "HL", "input": "pattern + proposed formula", "output": "checked/justified formula", "example": "1 + 3 + 5 + … + (2n − 1) = n²", "needs": ["Continue and generalise a pattern"]}, "write": 1, "examParts": 2, "references": [{"part": "maths-pp-2020-higher-p1-q7#(b)(i)", "level": "higher", "marks": 5, "steps": [{"title": "Substitute the formula for T_n", "lines": [{"tex": "T_{n+1} &= \\frac{n(n+1)}{2} + (n+1)"}]}, {"title": "Write over a common denominator of 2", "lines": [{"tex": "&= \\frac{n(n+1)}{2} + \\frac{2(n+1)}{2}"}, {"tex": "&= \\frac{n(n+1) + 2(n+1)}{2}"}]}, {"title": "Factor out (n + 1)", "lines": [{"tex": "&= \\frac{(n+1)(n+2)}{2}"}]}], "final": "\\frac{(n+1)(n+2)}{2}"}, {"part": "maths-pp-2020-higher-p1-q7#(b)(ii)", "level": "higher", "marks": 5, "steps": [{"title": "Write the sum of the two consecutive terms", "lines": [{"tex": "T_{n+1} + T_n &= \\frac{(n+1)(n+2)}{2} + \\frac{n(n+1)}{2}"}]}, {"title": "Combine and factor out (n + 1)", "lines": [{"tex": "&= \\frac{(n+1)\\big[(n+2) + n\\big]}{2}"}, {"tex": "&= \\frac{(n+1)(2n+2)}{2}"}, {"tex": "&= \\frac{2(n+1)(n+1)}{2}"}]}, {"title": "Cancel the 2", "lines": [{"tex": "&= (n+1)^2"}, {"text": "$n+1 \\in \\mathbb{N}$, so the sum is a square $k^2$ with $k = n+1$."}]}], "final": "T_{n+1} + T_n = (n+1)^2"}]}, {"skill": {"id": "seq-recurring-decimal", "title": "Write a recurring decimal as a fraction", "level": "HL", "input": "recurring decimal", "output": "fraction via S∞", "example": "0.454545… → 5/11", "needs": ["Sum an infinite geometric series"]}, "write": 3, "examParts": 0, "references": []}, {"skill": {"id": "seq-convergence-range", "title": "Find values of x for which a geometric series converges", "level": "HL", "input": "series with r in terms of x", "output": "interval of x", "example": "Σ (2x)ⁿ → −½ < x < ½", "needs": ["Sum an infinite geometric series", "Solve modulus inequalities"]}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2018-higher-p1-q2#(c)", "level": "higher", "marks": 5, "steps": [{"title": "Test x = 1 in the terms from part (a)", "lines": [{"text": "The terms are $x^2$, $5x-8$, $x+8$. For $x = 1$ they are $1$, $-3$, $9$."}, {"tex": "r &= \\frac{-3}{1}"}, {"tex": "r &= -3"}, {"text": "$|r| > 1$, so this series has no sum to infinity. Reject $x = 1$."}]}, {"title": "Test x = 8 in the terms from part (a)", "lines": [{"text": "For $x = 8$ the terms are $8^2$, $5(8)-8$, $8+8$, that is $64$, $32$, $16$."}, {"tex": "r &= \\frac{32}{64}"}, {"tex": "r &= \\frac{1}{2}"}, {"text": "$|r| < 1$, so the sum to infinity exists. Here $x = 8$, $a = 64$ and $r = \\tfrac{1}{2}$."}]}, {"title": "Use the sum to infinity formula", "lines": [{"tex": "S_\\infty &= \\frac{a}{1-r}"}, {"tex": "&= \\frac{64}{1 - \\frac{1}{2}}"}, {"tex": "&= \\frac{64}{\\frac{1}{2}}"}, {"tex": "&= 128"}]}], "final": "x = 8, \\quad S_\\infty = 128"}]}, {"skill": {"id": "seq-derive-sum-infinity", "title": "Derive S∞ as the limit of partial sums", "level": "HL", "input": "Sₙ formula", "output": "S∞ = a/(1 − r)", "example": "lim a(1 − rⁿ)/(1 − r) = a/(1 − r)", "needs": ["Sum an infinite geometric series"]}, "write": 3, "examParts": 0, "references": []}]