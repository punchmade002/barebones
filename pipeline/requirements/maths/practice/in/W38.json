[{"skill": {"id": "inf-confidence-width", "title": "Relate confidence level, sample size and interval width", "level": "HL", "input": "interval requirements", "output": "wider/narrower; n needed for a margin", "example": "halving the margin needs 4× the sample", "needs": ["Construct a 95% confidence interval for a mean (large sample)", "Construct a 95% confidence interval for a proportion"]}, "write": 1, "examParts": 2, "references": [{"part": "maths-pp-2018-higher-p2-q8#(b)(i)", "level": "higher", "marks": 5, "steps": [{"title": "Statement 1: Always true", "lines": [{"text": "A higher confidence level needs a larger $z$-value, so the margin of error, and the interval, gets wider."}]}, {"title": "Statement 2: Sometimes true", "lines": [{"tex": "\\text{SE} &= \\sqrt{\\frac{\\hat{p}(1-\\hat{p})}{n}}"}, {"text": "$\\hat{p}(1-\\hat{p})$ increases as $\\hat{p}$ rises towards $0.5$ and then decreases, so the standard error does not always increase."}]}, {"title": "Statement 3: Always true", "lines": [{"text": "With $n$ fixed, the standard error is the square root of $\\hat{p}(1-\\hat{p})$ divided by $n$, so it rises whenever $\\hat{p}(1-\\hat{p})$ rises."}]}, {"title": "Statement 4: Never true", "lines": [{"text": "Increasing $n$ makes $\\frac{\\hat{p}(1-\\hat{p})}{n}$ smaller, so the standard error always decreases."}]}], "final": "1\\text{ Always},\\ 2\\text{ Sometimes},\\ 3\\text{ Always},\\ 4\\text{ Never}"}, {"part": "maths-pp-2023-higher-p2-q8#(c)", "level": "higher", "marks": 10, "steps": [{"title": "Find the sample proportion and margin of error", "lines": [{"text": "The interval is centred on $\\hat{p} = 0.35$ and its upper limit is $0.435$."}, {"tex": "\\text{margin} &= 0.435 - 0.35"}, {"tex": "&= 0.085"}]}, {"title": "Find p-hat times (1 - p-hat)", "lines": [{"tex": "\\hat{p}(1 - \\hat{p}) &= 0.35 \\times 0.65"}, {"tex": "&= 0.2275"}]}, {"title": "Set up the margin of error equation", "lines": [{"tex": "1.96\\sqrt{\\frac{0.2275}{n}} &= 0.085"}]}, {"title": "Solve for n", "lines": [{"tex": "\\sqrt{\\frac{0.2275}{n}} &= \\frac{0.085}{1.96}"}, {"tex": "\\frac{0.2275}{n} &= \\left(\\frac{0.085}{1.96}\\right)^2"}, {"tex": "n &= \\frac{0.2275}{\\left(\\frac{0.085}{1.96}\\right)^2}"}, {"tex": "&= 120.96\\ldots"}, {"tex": "&\\approx 121"}]}], "final": "n = 121"}]}, {"skill": {"id": "trig-radians", "title": "Use radian measure", "level": "HL", "input": "angle in degrees or radians", "output": "converted angle", "example": "135° → 3π/4", "needs": []}, "write": 1, "examParts": 2, "references": [{"part": "maths-pp-2021-higher-p2-q9#(b)(iii)", "level": "higher", "marks": 5, "steps": [{"title": "Substitute t = 6.67", "lines": [{"text": "Make sure the calculator is in radian mode."}, {"tex": "V(6.67) &= 110\\sqrt{2}\\,\\sin(120\\pi \\times 6.67)"}, {"tex": "&= 147.95\\ldots"}]}], "final": "147.95 \\text{ Volts}"}, {"part": "maths-pp-2023-higher-p2-q7#(e)(i)", "level": "higher", "marks": 5, "steps": [{"title": "Substitute t = 0.5 into V(t)", "lines": [{"text": "Set the calculator to radian mode."}, {"tex": "V(0.5) &= 2 - 0.4\\cos\\left(\\frac{\\pi}{2} \\times 0.5\\right)"}, {"tex": "&= 2 - 0.4\\cos\\left(\\frac{\\pi}{4}\\right)"}, {"tex": "&= 1.7172\\ldots"}, {"tex": "&\\approx 1.717\\ \\text{litres}"}]}], "final": "1.717\\ \\text{litres}"}]}, {"skill": {"id": "trig-pythag-identity", "title": "Use cos²A + sin²A = 1 (formula 1)", "level": "HL", "input": "one ratio + quadrant", "output": "other ratios; simplified expression", "example": "sin A = 3/5, A acute → cos A = 4/5", "needs": ["Define sin θ, cos θ, tan θ for all θ (unit circle)"]}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2019-higher-p2-q4#(a)", "level": "higher", "marks": 10, "steps": [{"title": "Start from the addition formula", "lines": [{"text": "Use $\\cos(A+B) = \\cos A\\cos B - \\sin A\\sin B$ with $A = B = \\theta$."}, {"tex": "\\cos 2\\theta &= \\cos(\\theta+\\theta)"}, {"tex": "&= \\cos\\theta\\cos\\theta - \\sin\\theta\\sin\\theta"}, {"tex": "&= \\cos^2\\theta - \\sin^2\\theta"}]}, {"title": "Replace cos² using sin² + cos² = 1", "lines": [{"text": "Since $\\sin^2\\theta + \\cos^2\\theta = 1$, we have $\\cos^2\\theta = 1 - \\sin^2\\theta$."}, {"tex": "\\cos 2\\theta &= (1 - \\sin^2\\theta) - \\sin^2\\theta"}, {"tex": "&= 1 - 2\\sin^2\\theta"}]}], "final": "\\cos 2\\theta = 1 - 2\\sin^2\\theta"}]}, {"skill": {"id": "trig-exact-values", "title": "Use trig ratios in surd form", "level": "OL", "input": "30°, 45°, 60° and related angles", "output": "exact value", "example": "sin 135° → 1/√2", "needs": ["Define sin θ, cos θ, tan θ for all θ (unit circle)", "Simplify and operate on surds"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2021-higher-p1-q10#(b)(ii)", "level": "higher", "marks": 10, "steps": [{"title": "Find I(5)", "lines": [{"tex": "I(5) &= 1.5 + \\sin\\frac{5\\pi}{5}"}, {"tex": "&= 1.5 + \\sin\\pi"}, {"tex": "&= 1.5"}]}, {"title": "Find I(6)", "lines": [{"tex": "I(6) &= 1.5 + \\sin\\frac{6\\pi}{5}"}, {"tex": "&= 0.9122\\ldots"}]}, {"title": "Compare and explain", "lines": [{"tex": "0.9122 &< 1.5"}, {"text": "So $I(6) < I(5)$. The tree grew less in year 6 than in year 5: it is still growing, but more slowly."}]}], "final": "I(6) < I(5)"}]}]