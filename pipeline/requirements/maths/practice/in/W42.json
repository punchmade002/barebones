[{"skill": {"id": "trig-sine-ambiguous", "title": "Handle the ambiguous case of the sine rule", "level": "HL", "input": "two sides + non-included angle", "output": "both possible triangles", "example": "a = 6, b = 8, A = 40° → B ≈ 59.0° or 121.0°", "needs": ["Apply the sine rule", "Solve sin θ = k, cos θ = k, tan θ = k in a range"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2024-higher-p2-q3#(c)", "level": "higher", "marks": 10, "steps": [{"title": "Set up the sine rule", "lines": [{"text": "$|MK|$ is opposite $\\angle KLM = 25^\\circ$, and $|ML|$ is opposite $\\theta = \\angle LKM$."}, {"tex": "\\frac{\\sin\\theta}{|ML|} &= \\frac{\\sin|\\angle KLM|}{|MK|}"}, {"tex": "\\frac{\\sin\\theta}{45} &= \\frac{\\sin 25^\\circ}{15\\sqrt{3}}"}]}, {"title": "Solve for sin θ", "lines": [{"tex": "\\sin\\theta &= \\frac{45\\sin 25^\\circ}{15\\sqrt{3}}"}, {"tex": "&= \\frac{45(0.4226\\ldots)}{15\\sqrt{3}}"}, {"tex": "&= 0.73196\\ldots"}]}, {"title": "Find both angles between 0° and 180°", "lines": [{"text": "Sine is positive in the 1st and 2nd quadrants, so there are two angles."}, {"tex": "\\theta &= \\sin^{-1}(0.73196) = 47.05^\\circ"}, {"tex": "\\theta &= 180^\\circ - 47.05^\\circ = 132.95^\\circ"}]}, {"title": "Round to the nearest degree", "lines": [{"tex": "\\theta &= 47^\\circ \\ \\text{or}\\ 133^\\circ"}]}], "final": "\\theta = 47^\\circ \\ \\text{or} \\ 133^\\circ"}]}]