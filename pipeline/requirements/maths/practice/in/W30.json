[{"skill": {"id": "int-reciprocal", "title": "Integrate 1/x", "level": "HL", "input": "1/x", "output": "ln|x| + c", "example": "∫(2/x) dx → 2 ln|x| + c", "needs": ["Treat integration as reverse differentiation", "Convert between log and index form (incl. e and ln)"]}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2020-higher-p1-q6#(b)(ii)", "level": "higher", "marks": 5, "steps": [{"title": "Set up the area as an integral", "lines": [{"text": "The area under $h'(x)$ from $0$ to $A$ equals $\\ln 3$."}, {"tex": "\\int_0^A \\frac{1}{2x+3}\\,dx &= \\ln 3"}]}, {"title": "Integrate and substitute the limits", "lines": [{"tex": "\\left[\\tfrac{1}{2}\\ln(2x+3)\\right]_0^A &= \\ln 3"}, {"tex": "\\tfrac{1}{2}\\left(\\ln(2A+3) - \\ln 3\\right) &= \\ln 3"}]}, {"title": "Combine the logs", "lines": [{"tex": "\\tfrac{1}{2}\\ln\\left(\\frac{2A+3}{3}\\right) &= \\ln 3"}, {"tex": "\\ln\\left(\\frac{2A+3}{3}\\right) &= 2\\ln 3"}, {"tex": "\\ln\\left(\\frac{2A+3}{3}\\right) &= \\ln 9"}]}, {"title": "Remove the logs and solve", "lines": [{"tex": "\\frac{2A+3}{3} &= 9"}, {"tex": "2A + 3 &= 27"}, {"tex": "2A &= 24"}, {"tex": "A &= 12"}]}], "final": "A = 12"}]}, {"skill": {"id": "int-exponential", "title": "Integrate exponentials", "level": "HL", "input": "e^(ax), aˣ", "output": "(1/a)e^(ax) + c, aˣ/ln a + c", "example": "∫e^(2x) dx → ½e^(2x) + c", "needs": ["Treat integration as reverse differentiation", "Differentiate exponential functions"]}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2017-higher-p1-q6#(b)", "level": "higher", "marks": 10, "steps": [{"title": "Set up the area between the curves", "lines": [{"text": "From $x = 0$ the curves meet, and $g$ is above $h$ for $x > 0$, so the area runs from $x = 0$ to $x = 0.75$ with $g$ on top."}, {"tex": "A &= \\int_0^{0.75} e^{x}\\,dx - \\int_0^{0.75} e^{-x}\\,dx"}, {"tex": "&= \\int_0^{0.75} \\left(e^{x} - e^{-x}\\right)dx"}]}, {"title": "Integrate", "lines": [{"text": "$\\int e^{-x}\\,dx = -e^{-x}$, so 