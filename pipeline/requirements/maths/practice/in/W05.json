[{"skill": {"id": "alg-surd-expressions", "title": "Simplify algebraic expressions with surds", "level": "HL", "input": "expression with surds and brackets", "output": "simplified / rationalised form", "example": "(√x + 1)(√x − 1) → x − 1", "needs": ["Simplify and operate on surds", "Multiply out two brackets"]}, "write": 1, "examParts": 2, "references": [{"part": "maths-pp-2016-higher-p1-q9#(b)(iii)", "level": "higher", "marks": 5, "steps": [{"title": "Expand (1 + √5)³", "lines": [{"tex": "(1+\\sqrt5)^3 &= 1 + 3\\sqrt5 + 3(\\sqrt5)^2 + (\\sqrt5)^3"}, {"tex": "&= 1 + 3\\sqrt5 + 15 + 5\\sqrt5"}, {"tex": "&= 16 + 8\\sqrt5"}]}, {"title": "Expand (1 − √5)³", "lines": [{"tex": "(1-\\sqrt5)^3 &= 1 - 3\\sqrt5 + 3(\\sqrt5)^2 - (\\sqrt5)^3"}, {"tex": "&= 1 - 3\\sqrt5 + 15 - 5\\sqrt5"}, {"tex": "&= 16 - 8\\sqrt5"}]}, {"title": "Subtract to get the numerator", "lines": [{"tex": "(1+\\sqrt5)^3 - (1-\\sqrt5)^3 &= (16 + 8\\sqrt5) - (16 - 8\\sqrt5)"}, {"tex": "&= 16\\sqrt5"}]}, {"title": "Substitute n = 3 and simplify", "lines": [{"tex": "G_3 &= \\frac{16\\sqrt5}{2^3\\sqrt5}"}, {"tex": "&= \\frac{16\\sqrt5}{8\\sqrt5}"}, {"tex": "&= 2"}]}], "final": "G_3 = 2"}, {"part": "maths-pp-2020-higher-p1-q7#(c)", "level": "higher", "marks": 5, "steps": [{"title": "Substitute k = 3", "lines": [{"tex": "N_3 &= \\left(\\frac{(3+2\\sqrt{2})^3 - (3-2\\sqrt{2})^3}{4\\sqrt{2}}\\right)^2"}]}, {"title": "Expand (3 + 2√2) squared", "lines": [{"tex": "(3+2\\sqrt{2})^2 &= 9 + 12\\sqrt{2} + 8"}, {"tex": "&= 17 + 12\\sqrt{2}"}]}, {"title": "Expand (3 + 2√2) cubed", "lines": [{"tex": "(3+2\\sqrt{2})^3 &= (17 + 12\\sqrt{2})(3 + 2\\sqrt{2})"}, {"tex": "&= 51 + 34\\sqrt{2} + 36\\sqrt{2} + 48"}, {"tex": "&= 99 + 70\\sqrt{2}"}, {"text": "Changing the sign of $\\sqrt{2}$ gives $(3-2\\sqrt{2})^3 = 99 - 70\\sqrt{2}$."}]}, {"title": "Subtract and divide", "lines": [{"tex": "(3+2\\sqrt{2})^3 - (3-2\\sqrt{2})^3 &= (99 + 70\\sqrt{2}) - (99 - 70\\sqrt{2})"}, {"tex": "&= 140\\sqrt{2}"}, {"tex": "\\frac{140\\sqrt{2}}{4\\sqrt{2}} &= 35"}]}, {"title": "Square the result", "lines": [{"tex": "N_3 &= 35^2"}, {"tex": "&= 1225"}]}], "final": "N_3 = 1225"}]}, {"skill": {"id": "alg-fractions-add", "title": "Add/subtract algebraic fractions", "level": "OL", "input": "a/(bx+c) ± p/(qx+r)", "output": "single fraction", "example": "2/(x+1) + 3/(x−2) → (5x − 1)/((x+1)(x−2))", "needs": ["Operate on fractions", "Multiply out two brackets"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2024-higher-p1-q1#(b)", "level": "higher", "marks": 10, "steps": [{"title": "Write both fractions over the common denominator", "lines": [{"text": "The common denominator is $(2t+1)(12t)$."}, {"tex": "\\frac{4}{2t+1} - \\frac{7}{12t} &= \\frac{4(12t)}{(2t+1)(12t)} - \\frac{7(2t+1)}{(2t+1)(12t)}"}]}, {"title": "Combine into one fraction", "lines": [{"tex": "&= \\frac{4(12t) - 7(2t+1)}{(2t+1)(12t)}"}]}, {"title": "Expand the brackets in the numerator", "lines": [{"tex": "&= \\frac{48t - 14t - 7}{(2t+1)(12t)}"}]}, {"title": "Collect like terms in the numerator", "lines": [{"tex": "&= \\frac{34t - 7}{(2t+1)(12t)}"}]}], "final": "\\frac{34t - 7}{(2t+1)(12t)}"}]}, {"skill": {"id": "alg-poly-divide", "title": "Divide a polynomial by a linear or quadratic", "level": "HL", "input": "dividend, divisor", "output": "quotient (and remainder)", "example": "(x³ − 7x + 6) ÷ (x − 1) → x² + x − 6", "needs": ["Multiply polynomials"]}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2017-higher-p1-q5#(a)", "level": "higher", "marks": 15, "steps": [{"title": "Substitute $x = -3$ into $f(x)$", "lines": [{"tex": "f(-3) &= 2(-3)^3 + 5(-3)^2 - 4(-3) - 3"}, {"tex": "&= -54 + 45 + 12 - 3"}, {"tex": "&= 0"}, {"text": "Since $f(-3) = 0$, $x = -3$ is a root and $(x+3)$ is a factor."}]}, {"title": "Divide $f(x)$ by $(x+3)$: first term", "lines": [{"text": "Divide the leading terms."}, {"tex": "2x^3 \\div x &= 2x^2"}, {"text": "Multiply back and subtract."}, {"tex": "2x^2(x+3) &= 2x^3 + 6x^2"}, {"tex": "(2x^3 + 5x^2) - (2x^3 + 6x^2) &= -x^2"}]}, {"title": "Second term", "lines": [{"text": "Bring down $-4x$ and divide the leading terms."}, {"tex": "-x^2 \\div x &= -x"}, {"tex": "-x(x+3) &= -x^2 - 3x"}, {"tex": "(-x^2 - 4x) - (-x^2 - 3x) &= -x"}]}, {"title": "Third term", "lines": [{"text": "Bring down $-3$ and divide the leading terms."}, {"tex": "-x \\div x &= -1"}, {"tex": "-1(x+3) &= -x - 3"}, {"tex": "(-x - 3) - (-x - 3) &= 0"}, {"text": "The remainder is $0$, so the quotient is $2x^2 - x - 1$."}]}, {"title": "Factorise the quadratic", "lines": [{"tex": "f(x) &= (x+3)(2x^2 - x - 1)"}, {"tex": "&= (x+3)(2x+1)(x-1)"}]}, {"title": "Read off the roots", "lines": [{"text": "Set each factor equal to $0$."}, {"tex": "x + 3 &= 0"}, {"tex": "x &= -3"}, {"tex": "2x + 1 &= 0"}, {"tex": "x &= -\\frac{1}{2}"}, {"tex": "x - 1 &= 0"}, {"tex": "x &= 1"}]}], "final": "x = -3,\\ -\\frac{1}{2},\\ 1"}, {"part": "maths-pp-2022-higher-p1-q5#(b)(i)", "level": "higher", "marks": 15, "steps": [{"title": "Divide f(x) by (x + 1): first term", "lines": [{"text": "Divide the leading terms: $2x^3 \\div x = 2x^2$."}, {"tex": "2x^2(x + 1) &= 2x^3 + 2x^2"}, {"tex": "&= 2x^3 + 2x^2"}]}, {"title": "Subtract to leave the remainder so far", "lines": [{"tex": "(2x^3 - 21x^2 + 40x + 63) - (2x^3 + 2x^2) &= -23x^2 + 40x + 63"}, {"tex": "&= -23x^2 + 40x + 63"}]}, {"title": "Second term of the quotient", "lines": [{"text": "Divide the leading terms: $-23x^2 \\div x = -23x$."}, {"tex": "-23x(x + 1) &= -23x^2 - 23x"}, {"tex": "&= -23x^2 - 23x"}]}, {"title": "Subtract again", "lines": [{"tex": "(-23x^2 + 40x + 63) - (-23x^2 - 23x) &= 63x + 63"}, {"tex": "&= 63x + 63"}]}, {"title": "Third term of the quotient", "lines": [{"text": "Divide the leading terms: $63x \\div x = 63$."}, {"tex": "63(x + 1) &= 63x + 63"}, {"tex": "&= 63x + 63"}, {"text": "Subtracting leaves $0$, so the quotient is $2x^2 - 23x + 63$."}, {"tex": "f(x) &= (x + 1)(2x^2 - 23x + 63)"}]}, {"title": "Factorise the quadratic", "lines": [{"text": "Find two numbers with product $2 \\times 63 = 126$ and sum $-23$: they are $-14$ and $-9$."}, {"tex": "2x^2 - 23x + 63 &= 2x^2 - 14x - 9x + 63"}, {"tex": "&= 2x(x - 7) - 9(x - 7)"}, {"tex": "&= (2x - 9)(x - 7)"}]}, {"title": "Set f(x) = 0 and solve each factor", "lines": [{"tex": "(x + 1)(2x - 9)(x - 7) &= 0"}, {"tex": "x &= -1 \\quad \\text{or} \\quad x = \\frac{9}{2} \\quad \\text{or} \\quad x = 7"}]}], "final": "x = -1, \\ 4.5, \\ 7"}]}, {"skill": {"id": "alg-fractions-simplify", "title": "Multiply, divide and simplify rational expressions", "level": "HL", "input": "rational algebraic expressions", "output": "simplified fraction", "example": "(x² − 4)/(x² + x − 6) → (x + 2)/(x + 3)", "needs": ["Add/subtract algebraic fractions", "Factorise a quadratic trinomial"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2025-higher-p1-q10#(d)(ii)", "level": "higher", "marks": 10, "steps": [{"title": "Replace n by (t − 1)/2", "lines": [{"tex": "Q(n) &= \\frac{(n+1)^2}{(2n+1)^2}"}, {"tex": "&= \\frac{\\left(\\frac{t-1}{2}+1\\right)^2}{\\left(2\\cdot\\frac{t-1}{2}+1\\right)^2}"}]}, {"title": "Simplify the numerator bracket", "lines": [{"text": "Write $1$ as $\\frac{2}{2}$ and add."}, {"tex": "&= \\frac{\\left(\\frac{t-1+2}{2}\\right)^2}{\\left(2\\cdot\\frac{t-1}{2}+1\\right)^2}"}, {"tex": "&= \\frac{\\left(\\frac{t+1}{2}\\right)^2}{\\left(2\\cdot\\frac{t-1}{2}+1\\right)^2}"}]}, {"title": "Simplify the denominator bracket", "lines": [{"text": "The 2 cancels with the denominator 2."}, {"tex": "&= \\frac{\\left(\\frac{t+1}{2}\\right)^2}{(t-1+1)^2}"}, {"tex": "&= \\frac{\\left(\\frac{t+1}{2}\\right)^2}{t^2}"}]}, {"title": "Square the fraction in the numerator", "lines": [{"tex": "&= \\frac{\\frac{(t+1)^2}{2^2}}{t^2}"}, {"tex": "&= \\frac{\\frac{(t+1)^2}{4}}{t^2}"}, {"tex": "&= \\frac{(t+1)^2}{4t^2}"}]}, {"title": "Expand the numerator", "lines": [{"tex": "&= \\frac{t^2 + 2t + 1}{4t^2}"}]}], "final": "Q(n) = \\frac{t^2 + 2t + 1}{4t^2}"}]}]