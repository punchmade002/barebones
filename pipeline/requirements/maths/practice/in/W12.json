[{"skill": {"id": "cx-conjugate", "title": "Find the conjugate", "level": "OL", "input": "z = a + bi", "output": "z̄ = a − bi", "example": "3 − 4i → 3 + 4i", "needs": []}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2022-ordinary-p1-q1#(a), (b)", "level": "ordinary", "marks": 15, "steps": [{"title": "Read z₁ from the diagram", "lines": [{"text": "$z_1$ is at $(-2, -3)$: real part $-2$, imaginary part $-3$."}, {"tex": "z_1 &= -2 - 3i"}]}, {"title": "Find the complex conjugate", "lines": [{"text": "Change the sign of the imaginary part."}, {"tex": "\\overline{z_1} &= -2 + 3i"}]}, {"title": "Plot the conjugate", "lines": [{"text": "$\\overline{z_1}$ is at $(-2, 3)$: 2 left, 3 up. It is the reflection of $z_1$ in the real axis."}]}, {"title": "Plot z₂ and z₃", "lines": [{"text": "$z_2 = -5 + 3i$ is at $(-5, 3)$: 5 left, 3 up."}, {"text": "$z_3 = 4 - 2i$ is at $(4, -2)$: 4 right, 2 down."}]}], "final": "z_1 = -2 - 3i, \\quad \\overline{z_1} = -2 + 3i"}]}, {"skill": {"id": "cx-powers-i", "title": "Simplify powers of i", "level": "OL", "input": "iⁿ", "output": "1, i, −1 or −i", "example": "i⁷ → −i", "needs": ["Apply the laws of indices"]}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2019-ordinary-p1-q2#(b)", "level": "ordinary", "marks": 10, "steps": [{"title": "Substitute z = 2 + i into the equation", "lines": [{"text": "If $z_1$ is a solution, the left-hand side must equal $0$."}, {"tex": "z^2 - 4z + 5 &= (2 + i)^2 - 4(2 + i) + 5"}]}, {"title": "Expand the brackets", "lines": [{"tex": "&= 4 + 4i + i^2 - 8 - 4i + 5"}]}, {"title": "Replace i² with −1", "lines": [{"tex": "&= 4 + 4i - 1 - 8 - 4i + 5"}]}, {"title": "Collect like terms", "lines": [{"tex": "&= (4 - 1 - 8 + 5) + (4i - 4i)"}, {"tex": "&= 0"}, {"text": "The left-hand side is $0$, so $z_1 = 2 + i$ is a solution."}]}], "final": "z_1 = 2 + i \\text{ satisfies } z^2 - 4z + 5 = 0"}, {"part": "maths-pp-2020-higher-p1-q2#(a)", "level": "higher", "marks": 5, "steps": [{"title": "Multiply the first equation by i to find z₁", "lines": [{"tex": "iz_1 &= -4 + 3i"}, {"tex": "i(iz_1) &= i(-4 + 3i)"}, {"tex": "i^2 z_1 &= -4i + 3i^2"}, {"text": "Use $i^2=-1$."}, {"tex": "-z_1 &= -4i - 3"}, {"tex": "z_1 &= 3 + 4i"}]}, {"title": "Substitute z₁ into the second equation", "lines": [{"tex": "3z_1 - z_2 &= 11 + 17i"}, {"tex": "3(3 + 4i) - z_2 &= 11 + 17i"}, {"tex": "9 + 12i - z_2 &= 11 + 17i"}]}, {"title": "Solve for z₂", "lines": [{"tex": "-z_2 &= 11 + 17i - 9 - 12i"}, {"tex": "-z_2 &= 2 + 5i"}, {"tex": "z_2 &= -2 - 5i"}]}], "final": "z_1 = 3 + 4i, \\quad z_2 = -2 - 5i"}]}, {"skill": {"id": "num-surds", "title": "Simplify and operate on surds", "level": "OL", "input": "surd expression", "output": "simplified surd, rational denominator", "example": "√50 → 5√2; 1/(√3−1) → (√3+1)/2", "needs": ["Express a number as a product of primes"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2021-higher-p1-q3#(a)", "level": "higher", "marks": 10, "steps": [{"title": "Write the three face areas as equations", "lines": [{"text": "Each face area is the product of two of the dimensions."}, {"tex": "xz &= 2\\sqrt{2}"}, {"tex": "yz &= 8\\sqrt{6}"}, {"tex": "xy &= 4\\sqrt{3}"}]}, {"title": "Multiply the three equations", "lines": [{"text": "The volume is $xyz$, and the product of the three areas is $(xyz)^2$."}, {"tex": "(xz)(yz)(xy) &= (2\\sqrt{2})(8\\sqrt{6})(4\\sqrt{3})"}, {"tex": "x^2y^2z^2 &= 2 \\times 8 \\times 4 \\times \\sqrt{2 \\times 6 \\times 3}"}, {"tex": "&= 64\\sqrt{36}"}, {"tex": "&= 64 \\times 6"}, {"tex": "&= 384"}]}, {"title": "Take the square root to get the volume", "lines": [{"tex": "xyz &= \\sqrt{384}"}, {"tex": "&= \\sqrt{64 \\times 6}"}, {"tex": "&= 8\\sqrt{6}"}]}], "final": "V = 8\\sqrt{6}\\ \\text{cm}^3"}]}, {"skill": {"id": "cx-equate-parts", "title": "Equate real and imaginary parts", "level": "OL", "input": "equation in complex numbers with unknowns", "output": "values of unknowns", "example": "a + bi = (2 + i)² → a = 3, b = 4", "needs": ["Add, subtract and multiply complex numbers", "Solve two linear equations in two unknowns"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2021-higher-p1-q1#(b)", "level": "higher", "marks": 10, "steps": [{"title": "Let the square root be a + bi and square it", "lines": [{"text": "Suppose $\\sqrt{-5+12i} = a+bi$, so $(a+bi)^2 = -5+12i$."}, {"tex": "a^2 + 2abi + b^2i^2 &= -5 + 12i"}, {"tex": "(a^2 - b^2) + 2abi &= -5 + 12i"}]}, {"title": "Equate real parts and imaginary parts", "lines": [{"tex": "a^2 - b^2 &= -5"}, {"tex": "2ab &= 12"}, {"tex": "b &= \\frac{6}{a}"}]}, {"title": "Substitute b = 6/a into the real-part equation", "lines": [{"tex": "a^2 - \\left(\\frac{6}{a}\\right)^2 &= -5"}, {"tex": "a^2 - \\frac{36}{a^2} &= -5"}, {"tex": "a^4 - 36 &= -5a^2"}, {"tex": "a^4 + 5a^2 - 36 &= 0"}]}, {"title": "Factorise and solve for a", "lines": [{"tex": "(a^2+9)(a^2-4) &= 0"}, {"text": "$a^2 + 9 = 0$ has no real solution, since $a \\in \\mathbb{R}$."}, {"tex": "a^2 - 4 &= 0"}, {"tex": "a &= \\pm 2"}]}, {"title": "Find b for each value of a", "lines": [{"tex": "a = 2:\\quad b &= \\frac{6}{2} = 3"}, {"tex": "a = -2:\\quad b &= \\frac{6}{-2} = -3"}]}], "final": "2 + 3i \\text{ and } -2 - 3i"}]}]