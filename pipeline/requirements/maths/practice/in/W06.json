[{"skill": {"id": "ineq-double", "title": "Solve a combined (double) linear inequality", "level": "OL", "input": "k₁ ≤ ax + b < k₂", "output": "interval", "example": "−3 ≤ 2x + 1 < 5 → −2 ≤ x < 2", "needs": ["Solve a linear inequality"]}, "write": 3, "examParts": 0, "references": []}, {"skill": {"id": "ineq-quadratic", "title": "Solve a quadratic inequality", "level": "HL", "input": "ax² + bx + c ≤ k", "output": "interval(s)", "example": "x² − x − 6 ≤ 0 → −2 ≤ x ≤ 3", "needs": ["Solve a quadratic by factorising", "Graph a quadratic function"]}, "write": 1, "examParts": 2, "references": [{"part": "maths-pp-2021-higher-p1-q5#(a)(ii)", "level": "higher", "marks": 10, "steps": [{"title": "Differentiate g(x)", "lines": [{"tex": "g'(x) &= 36"}]}, {"title": "Form the inequality f'(x) > g'(x)", "lines": [{"tex": "6x^2 + 12x - 12 &> 36"}]}, {"title": "Rearrange to compare with zero", "lines": [{"tex": "6x^2 + 12x - 48 &> 0"}, {"tex": "x^2 + 2x - 8 &> 0"}]}, {"title": "Find the roots of the quadratic", "lines": [{"tex": "(x+4)(x-2) &> 0"}, {"text": "The roots are $x = -4$ and $x = 2$."}]}, {"title": "Read off where the quadratic is positive", "lines": [{"text": "The graph of $x^2+2x-8$ is a U-shape, so it is positive outside the roots."}, {"tex": "x &< -4 \\quad \\text{or} \\quad x > 2"}]}], "final": "x < -4 \\text{ or } x > 2"}, {"part": "maths-pp-2024-higher-p1-q10#(b)", "level": "higher", "marks": 10, "steps": [{"title": "Write the inequality for P'(x) > 24", "lines": [{"tex": "1.1 + 2.73x - 0.078x^2 &> 24"}]}, {"title": "Rearrange so one side is zero", "lines": [{"text": "Subtract 24 from both sides."}, {"tex": "-0.078x^2 + 2.73x - 22.9 &> 0"}, {"text": "Multiply both sides by $-1$ and reverse the inequality sign."}, {"tex": "0.078x^2 - 2.73x + 22.9 &< 0"}]}, {"title": "Find the roots with the quadratic formula", "lines": [{"text": "Solve $0.078x^2 - 2.73x + 22.9 = 0$ with $a = 0.078$, $b = -2.73$, $c = 22.9$."}, {"tex": "x &= \\frac{2.73 \\pm \\sqrt{(2.73)^2 - 4(0.078)(22.9)}}{2(0.078)}"}, {"tex": "&= \\frac{2.73 \\pm \\sqrt{7.4529 - 7.1448}}{0.156}"}, {"tex": "&= \\frac{2.73 \\pm \\sqrt{0.3081}}{0.156}"}, {"tex": "x &\\approx 21.06 \\text{ or } x \\approx 13.94"}]}, {"title": "Choose the values between the roots", "lines": [{"text": "The graph of $0.078x^2 - 2.73x + 22.9$ opens upwards, so it is below zero between the roots."}, {"tex": "13.94 &< x < 21.06"}]}, {"title": "Round each value to the nearest whole number", "lines": [{"tex": "14 &\\le x \\le 21"}]}], "final": "14 \\le x \\le 21"}]}, {"skill": {"id": "ineq-rational", "title": "Solve a rational inequality", "level": "HL", "input": "(ax + b)/(cx + d) ≤ k", "output": "interval(s), excluding x = −d/c", "example": "(x + 1)/(x − 2) < 2 → x < 2 or x > 5", "needs": ["Solve a quadratic inequality"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2018-higher-p1-q1#(b)", "level": "higher", "marks": 10, "steps": [{"title": "Multiply both sides by (x + 2)^2", "lines": [{"text": "$(x+2)^2$ is always positive (as $x \\ne -2$), so the inequality sign does not change."}, {"tex": "\\frac{2x-3}{x+2} &\\ge 3"}, {"tex": "(2x-3)(x+2) &\\ge 3(x+2)^2"}]}, {"title": "Expand both sides", "lines": [{"tex": "2x^2 + 4x - 3x - 6 &\\ge 3(x^2 + 4x + 4)"}, {"tex": "2x^2 + x - 6 &\\ge 3x^2 + 12x + 12"}]}, {"title": "Collect all terms on one side", "lines": [{"tex": "0 &\\ge 3x^2 - 2x^2 + 12x - x + 12 + 6"}, {"tex": "0 &\\ge x^2 + 11x + 18"}, {"tex": "x^2 + 11x + 18 &\\le 0"}]}, {"title": "Factorise to find the roots", "lines": [{"tex": "(x+2)(x+9) &\\le 0"}, {"text": "The roots are $x = -2$ and $x = -9$."}]}, {"title": "Choose the values between the roots", "lines": [{"text": "The product of two brackets is negative or zero only between the roots, since the $x^2$ coefficient is positive."}, {"tex": "-9 &\\le x \\le -2"}, {"text": "The original fraction is undefined at $x = -2$, so exclude it."}, {"tex": "-9 &\\le x < -2"}]}], "final": "-9 \\le x < -2"}]}, {"skill": {"id": "ineq-prove", "title": "Prove an algebraic inequality", "level": "HL", "input": "inequality in a, b", "output": "proof via a square ≥ 0", "example": "(a + b)² ≥ 4ab ⇐ (a − b)² ≥ 0", "needs": ["Multiply out two brackets"]}, "write": 3, "examParts": 0, "references": []}]