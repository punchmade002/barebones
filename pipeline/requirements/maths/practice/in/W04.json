[{"skill": {"id": "alg-binomial-expand", "title": "Expand with the binomial theorem", "level": "HL", "input": "(a + b)ⁿ, n ∈ N", "output": "full expansion", "example": "(1 + 2x)⁴ → 1 + 8x + 24x² + 32x³ + 16x⁴", "needs": ["Count selections and compute binomial coefficients", "Apply the laws of indices"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2025-higher-p1-q6#(a)", "level": "higher", "marks": 10, "steps": [{"title": "Write the binomial pattern for the first three terms", "lines": [{"text": "In $(a+b)^7$ the terms are $\\binom{7}{k}a^{7-k}b^k$ with $a=2p$, $b=3$ and $k=0,1,2$."}, {"tex": "(2p+3)^7 &= \\binom{7}{0}(2p)^7 + \\binom{7}{1}(2p)^6(3) + \\binom{7}{2}(2p)^5(3)^2 + \\cdots"}]}, {"title": "First term", "lines": [{"tex": "\\binom{7}{0}(2p)^7 &= 1\\times 128p^7"}, {"tex": "&= 128p^7"}]}, {"title": "Second term", "lines": [{"tex": "\\binom{7}{1}(2p)^6(3) &= 7\\times 64p^6\\times 3"}, {"tex": "&= 1344p^6"}]}, {"title": "Third term", "lines": [{"text": "$\\binom{7}{2} = \\frac{7\\times 6}{2} = 21$."}, {"tex": "\\binom{7}{2}(2p)^5(3)^2 &= 21\\times 32p^5\\times 9"}, {"tex": "&= 6048p^5"}]}, {"title": "Write the three terms together", "lines": [{"tex": "\\text{First 3 terms} &= 128p^7 + 1344p^6 + 6048p^5"}]}], "final": "128p^7 + 1344p^6 + 6048p^5"}]}, {"skill": {"id": "alg-binomial-term", "title": "Find a given term/coefficient of a binomial expansion", "level": "HL", "input": "(a + b)ⁿ + required power", "output": "general term Tᵣ₊₁ and its value", "example": "coefficient of x² in (2 + x)⁵ → 80", "needs": ["Expand with the binomial theorem"]}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2025-higher-p1-q6#(a)", "level": "higher", "marks": 10, "steps": [{"title": "Write the binomial pattern for the first three terms", "lines": [{"text": "In $(a+b)^7$ the terms are $\\binom{7}{k}a^{7-k}b^k$ with $a=2p$, $b=3$ and $k=0,1,2$."}, {"tex": "(2p+3)^7 &= \\binom{7}{0}(2p)^7 + \\binom{7}{1}(2p)^6(3) + \\binom{7}{2}(2p)^5(3)^2 + \\cdots"}]}, {"title": "First term", "lines": [{"tex": "\\binom{7}{0}(2p)^7 &= 1\\times 128p^7"}, {"tex": "&= 128p^7"}]}, {"title": "Second term", "lines": [{"tex": "\\binom{7}{1}(2p)^6(3) &= 7\\times 64p^6\\times 3"}, {"tex": "&= 1344p^6"}]}, {"title": "Third term", "lines": [{"text": "$\\binom{7}{2} = \\frac{7\\times 6}{2} = 21$."}, {"tex": "\\binom{7}{2}(2p)^5(3)^2 &= 21\\times 32p^5\\times 9"}, {"tex": "&= 6048p^5"}]}, {"title": "Write the three terms together", "lines": [{"tex": "\\text{First 3 terms} &= 128p^7 + 1344p^6 + 6048p^5"}]}], "final": "128p^7 + 1344p^6 + 6048p^5"}]}, {"skill": {"id": "alg-poly-multiply", "title": "Multiply polynomials", "level": "HL", "input": "two polynomials", "output": "expanded polynomial", "example": "(x − 1)(x² + x + 1) → x³ − 1", "needs": ["Multiply out two brackets"]}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2015-higher-p1-q7#(d)(i)", "level": "higher", "marks": 5, "steps": [{"title": "Write y and substitute -x - 5 into f", "lines": [{"text": "If $(x, y)$ is on the curve then $y = 0.0024x^3 + 0.018x^2$."}, {"tex": "f(-x-5) &= 0.0024(-x-5)^3 + 0.018(-x-5)^2"}]}, {"title": "Expand the brackets", "lines": [{"tex": "(-x-5)^3 &= -x^3 - 15x^2 - 75x - 125"}, {"tex": "(-x-5)^2 &= x^2 + 10x + 25"}]}, {"title": "Substitute and multiply out", "lines": [{"tex": "f(-x-5) &= 0.0024(-x^3 - 15x^2 - 75x - 125) + 0.018(x^2 + 10x + 25)"}, {"tex": "&= -0.0024x^3 - 0.036x^2 - 0.18x - 0.3 + 0.018x^2 + 0.18x + 0.45"}, {"tex": "&= -0.0024x^3 - 0.018x^2 + 0.15"}, {"tex": "&= -(0.0024x^3 + 0.018x^2) + 0.15"}, {"tex": "&= -y + 0.15"}]}, {"title": "Conclude", "lines": [{"text": "So $f(-x-5) = -y + 0.15$, which means $(-x-5,\\ -y+0.15)$ is on the curve."}]}], "final": "f(-x-5) = -y + 0.15"}, {"part": "maths-pp-2018-higher-p1-q2#(a)", "level": "higher", "marks": 10, "steps": [{"title": "Set the two common ratios equal", "lines": [{"text": "In a geometric series, $\\dfrac{T_2}{T_1} = \\dfrac{T_3}{T_2}$."}, {"tex": "\\frac{5x-8}{x^2} &= \\frac{x+8}{5x-8}"}]}, {"title": "Cross-multiply", "lines": [{"tex": "(5x-8)^2 &= x^2(x+8)"}]}, {"title": "Expand both sides", "lines": [{"tex": "(5x-8)(5x-8) &= x^3 + 8x^2"}, {"tex": "25x^2 - 80x + 64 &= x^3 + 8x^2"}]}, {"title": "Move every term to one side", "lines": [{"tex": "0 &= x^3 + 8x^2 - 25x^2 + 80x - 64"}, {"tex": "0 &= x^3 - 17x^2 + 80x - 64"}, {"tex": "x^3 - 17x^2 + 80x - 64 &= 0"}]}], "final": "x^3 - 17x^2 + 80x - 64 = 0"}]}, {"skill": {"id": "alg-factor-cubes", "title": "Factorise a sum/difference of two cubes", "level": "HL", "input": "a³ ± b³", "output": "(a ± b)(a² ∓ ab + b²)", "example": "8x³ − 27 → (2x − 3)(4x² + 6x + 9)", "needs": ["Multiply polynomials"]}, "write": 3, "examParts": 0, "references": []}]