[{"skill": {"id": "eq-rational-hl", "title": "Solve (ax+b)/(ex+f) ± (cx+d)/(qx+r) = k", "level": "HL", "input": "equation with algebraic numerators and denominators", "output": "x", "example": "(2x+1)/(x−1) − (x+3)/(x+1) = 1 → x = −5", "needs": ["Solve a/(bx+c) ± p/(qx+r) = e/f", "Solve a quadratic with the formula"]}, "write": 3, "examParts": 0, "references": []}, {"skill": {"id": "circ-line-origin", "title": "Find where a line meets a circle with centre (0, 0)", "level": "OL", "input": "line + x² + y² = r²", "output": "intersection points", "example": "y = x + 1, x² + y² = 25 → (3, 4), (−4, −3)", "needs": ["Solve one linear and one order-2 equation"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2023-ordinary-p2-q2#(b)", "level": "ordinary", "marks": 15, "steps": [{"title": "Make y the subject of the line", "lines": [{"tex": "5x - y - 13 &= 0"}, {"tex": "y &= 5x - 13"}]}, {"title": "Substitute y = 5x - 13 into the circle", "lines": [{"tex": "x^2 + y^2 &= 13"}, {"tex": "x^2 + (5x - 13)^2 &= 13"}]}, {"title": "Expand the bracket", "lines": [{"tex": "(5x - 13)^2 &= (5x - 13)(5x - 13)"}, {"tex": "&= 25x^2 - 65x - 65x + 169"}, {"tex": "&= 25x^2 - 130x + 169"}]}, {"title": "Simplify to a quadratic equation", "lines": [{"tex": "x^2 + 25x^2 - 130x + 169 &= 13"}, {"tex": "26x^2 - 130x + 169 &= 13"}, {"tex": "26x^2 - 130x + 156 &= 0"}, {"tex": "x^2 - 5x + 6 &= 0"}]}, {"title": "Factorise and solve for x", "lines": [{"tex": "x^2 - 5x + 6 &= 0"}, {"tex": "(x - 2)(x - 3) &= 0"}, {"tex": "x &= 2 \\text{ or } x = 3"}]}, {"title": "Find y when x = 2", "lines": [{"tex": "y &= 5(2) - 13"}, {"tex": "y &= -3"}]}, {"title": "Find y when x = 3", "lines": [{"tex": "y &= 5(3) - 13"}, {"tex": "y &= 2"}]}, {"title": "State the points of intersection", "lines": [{"text": "The line meets the circle at $(2, -3)$ and $(3, 2)$."}]}], "final": "(2, -3) \\text{ and } (3, 2)"}]}, {"skill": {"id": "circ-general-form", "title": "Use x² + y² + 2gx + 2fy + c = 0", "level": "HL", "input": "general equation", "output": "centre (−g, −f), r = √(g² + f² − c)", "example": "x² + y² − 4x + 6y − 12 = 0 → (2, −3), r = 5", "needs": ["Write/interpret (x − h)² + (y − k)² = r²"]}, "write": 1, "examParts": 2, "references": [{"part": "maths-pp-2022-higher-p2-q3#(a)", "level": "higher", "marks": 5, "steps": [{"title": "Complete the square to find the centre and radius", "lines": [{"text": "Group the $x$ terms and the $y$ terms, then complete each square."}, {"tex": "x^2 - 2x + y^2 + 8y + k &= 0"}, {"tex": "(x-1)^2 - 1 + (y+4)^2 - 16 + k &= 0"}, {"tex": "(x-1)^2 + (y+4)^2 &= 17 - k"}]}, {"title": "Use the radius", "lines": [{"text": "The right-hand side is $r^2$, and $r = 5\\sqrt{3}$."}, {"tex": "17 - k &= \\left(5\\sqrt{3}\\right)^2"}, {"tex": "17 - k &= 75"}, {"tex": "k &= 17 - 75"}, {"tex": "k &= -58"}]}], "final": "k = -58"}, {"part": "maths-pp-2024-higher-p2-q5#(a)(i)", "level": "higher", "marks": 10, "steps": [{"title": "Compare with the general circle equation", "lines": [{"text": "The general form is $x^2 + y^2 + 2gx + 2fy + c = 0$, with centre $(-g, -f)$ and radius $\\sqrt{g^2 + f^2 - c}$."}, {"tex": "2g &= 4 \\Rightarrow g = 2"}, {"tex": "2f &= -6 \\Rightarrow f = -3"}, {"tex": "c &= 5"}]}, {"title": "Write down the centre", "lines": [{"tex": "\\text{Centre} &= (-g, -f)"}, {"tex": "&= (-2, 3)"}]}, {"title": "Find the radius", "lines": [{"tex": "r &= \\sqrt{g^2 + f^2 - c}"}, {"tex": "&= \\sqrt{(2)^2 + (-3)^2 - 5}"}, {"tex": "&= \\sqrt{4 + 9 - 5}"}, {"tex": "&= \\sqrt{8}"}, {"tex": "&= 2\\sqrt{2}"}]}], "final": "\\text{Centre} = (-2, 3), \\quad r = 2\\sqrt{2}"}]}, {"skill": {"id": "circ-tangent-length", "title": "Find the length of a tangent from an external point", "level": "HL", "input": "circle + external point", "output": "√(x₁² + y₁² + 2gx₁ + 2fy₁ + c)", "example": "(7, 1) to x² + y² = 25 → 5", "needs": ["Use x² + y² + 2gx + 2fy + c = 0", "Apply Theorem 14: Pythagoras"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2020-higher-p2-q2#(a)", "level": "higher", "marks": 10, "steps": [{"title": "Find the centre and radius of c", "lines": [{"text": "Compare with $x^2 + y^2 + 2gx + 2fy + c = 0$: here $2g = -4$, $2f = 2$ and $c = -4$."}, {"tex": "g &= -2, \\quad f = 1"}, {"text": "The centre is $(-g, -f)$, so $A = (2, -1)$."}, {"tex": "r &= \\sqrt{g^2 + f^2 - c}"}, {"tex": "&= \\sqrt{4 + 1 + 4}"}, {"tex": "&= 3"}]}, {"title": "Find the distance from A to B", "lines": [{"tex": "|AB|^2 &= (5-2)^2 + (8-(-1))^2"}, {"tex": "&= 9 + 81"}, {"tex": "&= 90"}]}, {"title": "Use Pythagoras in triangle ATB", "lines": [{"text": "A tangent is perpendicular to the radius at the point of contact, so $\\angle ATB = 90^\\circ$."}, {"tex": "|BT|^2 &= |AB|^2 - |AT|^2"}, {"tex": "&= 90 - 9"}, {"tex": "&= 81"}, {"tex": "|BT| &= 9"}]}], "final": "|BT| = 9"}]}]