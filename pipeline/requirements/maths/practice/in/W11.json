[{"skill": {"id": "num-fractions", "title": "Operate on fractions", "level": "JC", "input": "fractions/mixed numbers", "output": "simplified fraction", "example": "2/3 + 5/6 → 3/2", "needs": []}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2023-ordinary-p1-q5#(b)(i)", "level": "ordinary", "marks": 10, "steps": [{"title": "Use time = distance ÷ speed", "lines": [{"tex": "\\text{Time} &= \\frac{120}{180}"}, {"tex": "&= \\frac{2}{3}"}]}], "final": "\\frac{2}{3} \\text{ hour}"}, {"part": "maths-pp-2023-ordinary-p1-q5#(b)(ii)", "level": "ordinary", "marks": 5, "steps": [{"title": "Time from A to B", "lines": [{"tex": "T_1 &= \\frac{2}{3}"}]}, {"title": "Time from B to A", "lines": [{"tex": "T_2 &= \\frac{120}{220}"}, {"tex": "&= \\frac{6}{11}"}]}, {"title": "Add the times and find the total distance", "lines": [{"text": "Total distance there and back is $2 \\times 120 = 240$ km."}, {"tex": "\\text{Total time} &= \\frac{2}{3} + \\frac{6}{11}"}, {"tex": "&= \\frac{22}{33} + \\frac{18}{33}"}, {"tex": "&= \\frac{40}{33}"}]}, {"title": "Average speed = total distance ÷ total time", "lines": [{"tex": "\\text{Average speed} &= \\frac{240}{\\frac{40}{33}}"}, {"tex": "&= 240 \\times \\frac{33}{40}"}, {"tex": "&= 198"}]}], "final": "198 \\text{ km/hour}"}]}, {"skill": {"id": "num-decimal-fraction", "title": "Convert decimals and fractions", "level": "OL", "input": "terminating/recurring decimal or fraction", "output": "equivalent form", "example": "0.375 → 3/8", "needs": ["Operate on fractions"]}, "write": 3, "examParts": 0, "references": []}, {"skill": {"id": "num-sets", "title": "Classify numbers into N, Z, Q, R, C", "level": "OL", "input": "a number", "output": "its smallest set; place on number line", "example": "√9 ∈ N, √2 ∈ R∖Q", "needs": []}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2023-ordinary-p1-q3#(b)(i), (ii), (iii)", "level": "ordinary", "marks": 5, "steps": [{"title": "(i) Real numbers up to 2.8", "lines": [{"text": "$x \\in \\mathbb{R}$ includes every point on the line. Put a closed dot at $2.8$ (because of $\\le$) and shade to the left with an arrow."}]}, {"title": "(ii) Integers up to 2.8", "lines": [{"text": "$x \\in \\mathbb{Z}$ means whole numbers only. Put a dot on each of $-4, -3, -2, -1, 0, 1, 2$ and continue to the left with an arrow. Do not shade between the dots."}]}, {"title": "(iii) Natural numbers up to 2.8", "lines": [{"text": "$x \\in \\mathbb{N}$ means $1, 2, 3, \\ldots$ (the scheme also accepts $0$). Only $1$ and $2$ are at most $2.8$, so put a dot on each of them and nothing else."}]}], "final": "\\text{(i) shaded line to } 2.8;\\ \\text{(ii) dots } \\ldots,-1,0,1,2;\\ \\text{(iii) dots } 1, 2"}]}, {"skill": {"id": "num-prime-factors", "title": "Express a number as a product of primes", "level": "OL", "input": "natural number", "output": "prime factorisation; HCF/LCM", "example": "360 → 2³·3²·5", "needs": []}, "write": 1, "examParts": 2, "references": [{"part": "maths-pp-2023-higher-p1-q9#(a)(i), (ii), (iii)", "level": "higher", "marks": 15, "steps": [{"title": "(i) List the factors of 2^4", "lines": [{"text": "The factors of $2^4$ are the powers of 2 from $2^0$ up to $2^4$."}, {"text": "They are $2^0, 2^1, 2^2, 2^3, 2^4$, that is $1, 2, 4, 8, 16$."}]}, {"title": "(ii) Count the factors of 3^7", "lines": [{"text": "The factors are $3^0, 3^1, 3^2, 3^3, 3^4, 3^5, 3^6, 3^7$."}, {"text": "That is 8 different factors."}]}, {"title": "(iii) Count the factors of 2^10 × 3^12", "lines": [{"text": "$2^{10}$ and $3^{12}$ share no factors, so every factor is a factor of $2^{10}$ times a factor of $3^{12}$."}, {"text": "$2^{10}$ has 11 factors ($2^0$ to $2^{10}$) and $3^{12}$ has 13 factors ($3^0$ to $3^{12}$)."}, {"tex": "\\text{factors} &= (10 + 1)(12 + 1)"}, {"tex": "&= 11 \\times 13"}, {"tex": "&= 143"}]}], "final": "\\text{(i) } 1, 2, 4, 8, 16 \\quad \\text{(ii) } 8 \\quad \\text{(iii) } 143"}, {"part": "maths-pp-2025-ordinary-p1-q1#(b)(i), (ii)", "level": "ordinary", "marks": 10, "steps": [{"title": "List the times each person finishes a window", "lines": [{"text": "Máiréad finishes at $9, 18, 27, 36, \\ldots$ minutes."}, {"text": "Diarmuid finishes at $12, 24, 36, \\ldots$ minutes."}, {"text": "The first time they match is $36$ minutes (the lowest common multiple of 9 and 12)."}]}, {"title": "Windows cleaned in 36 minutes together", "lines": [{"tex": "\\text{Máiréad: } 36 \\div 9 &= 4"}, {"tex": "\\text{Diarmuid: } 36 \\div 12 &= 3"}, {"tex": "\\text{Together: } 4 + 3 &= 7"}]}, {"title": "Find how many 36-minute blocks are needed for 35 windows", "lines": [{"tex": "35 \\div 7 &= 5"}]}, {"title": "Multiply by 36 minutes", "lines": [{"tex": "5 \\times 36 &= 180"}, {"text": "$180$ minutes is $3$ hours."}]}], "final": "\\text{(i) } 36 \\text{ minutes;}\\quad \\text{(ii) } 180 \\text{ minutes (3 hours)}"}]}]