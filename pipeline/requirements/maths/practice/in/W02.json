[{"skill": {"id": "alg-collect-like", "title": "Collect like terms", "level": "JC", "input": "expression", "output": "simplified expression", "example": "3x + 2y − x + 4y → 2x + 6y", "needs": []}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2015-ordinary-p1-q3#(a)", "level": "ordinary", "marks": 15, "steps": [{"title": "Multiply out each bracket", "lines": [{"tex": "3(4-5x) - 2(5-6x) &= 12 - 15x - 10 + 12x"}]}, {"title": "Collect like terms", "lines": [{"tex": "&= (12-10) + (-15x+12x)"}, {"tex": "&= 2 - 3x"}]}], "final": "2-3x"}]}, {"skill": {"id": "alg-expand-single", "title": "Expand a bracket by a term", "level": "JC", "input": "a(bx ± cy ± d)", "output": "expanded expression", "example": "3(2x − 5) → 6x − 15", "needs": ["Collect like terms"]}, "write": 1, "examParts": 2, "references": [{"part": "maths-pp-2015-ordinary-p1-q3#(a)", "level": "ordinary", "marks": 15, "steps": [{"title": "Multiply out each bracket", "lines": [{"tex": "3(4-5x) - 2(5-6x) &= 12 - 15x - 10 + 12x"}]}, {"title": "Collect like terms", "lines": [{"tex": "&= (12-10) + (-15x+12x)"}, {"tex": "&= 2 - 3x"}]}], "final": "2-3x"}, {"part": "maths-pp-2016-ordinary-p1-q8#(d)(i)", "level": "ordinary", "marks": 15, "steps": [{"title": "Write the area formula", "lines": [{"tex": "A &= xy"}]}, {"title": "Substitute y = 10.5 − x", "lines": [{"tex": "A &= x(10.5 - x)"}]}, {"title": "Multiply out the bracket", "lines": [{"tex": "A &= 10.5x - x^2"}]}], "final": "A = 10.5x - x^2"}]}, {"skill": {"id": "alg-factor-hcf", "title": "Factorise by highest common factor", "level": "JC", "input": "expression", "output": "factor × bracket", "example": "6x² − 9x → 3x(2x − 3)", "needs": []}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2020-higher-p1-q7#(b)(i)", "level": "higher", "marks": 5, "steps": [{"title": "Substitute the formula for T_n", "lines": [{"tex": "T_{n+1} &= \\frac{n(n+1)}{2} + (n+1)"}]}, {"title": "Write over a common denominator of 2", "lines": [{"tex": "&= \\frac{n(n+1)}{2} + \\frac{2(n+1)}{2}"}, {"tex": "&= \\frac{n(n+1) + 2(n+1)}{2}"}]}, {"title": "Factor out (n + 1)", "lines": [{"tex": "&= \\frac{(n+1)(n+2)}{2}"}]}], "final": "\\frac{(n+1)(n+2)}{2}"}, {"part": "maths-pp-2020-higher-p1-q7#(b)(ii)", "level": "higher", "marks": 5, "steps": [{"title": "Write the sum of the two consecutive terms", "lines": [{"tex": "T_{n+1} + T_n &= \\frac{(n+1)(n+2)}{2} + \\frac{n(n+1)}{2}"}]}, {"title": "Combine and factor out (n + 1)", "lines": [{"tex": "&= \\frac{(n+1)\\big[(n+2) + n\\big]}{2}"}, {"tex": "&= \\frac{(n+1)(2n+2)}{2}"}, {"tex": "&= \\frac{2(n+1)(n+1)}{2}"}]}, {"title": "Cancel the 2", "lines": [{"tex": "&= (n+1)^2"}, {"text": "$n+1 \\in \\mathbb{N}$, so the sum is a square $k^2$ with $k = n+1$."}]}], "final": "T_{n+1} + T_n = (n+1)^2"}]}, {"skill": {"id": "alg-factor-dots", "title": "Factorise a difference of two squares", "level": "OL", "input": "a² − b²", "output": "(a − b)(a + b)", "example": "9x² − 16 → (3x − 4)(3x + 4)", "needs": []}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2018-higher-p1-q6#(a)", "level": "higher", "marks": 10, "steps": [{"title": "Set the functions equal", "lines": [{"text": "The graphs meet where $k(x) = h(x)$."}, {"tex": "x^3 &= x"}, {"tex": "x^3 - x &= 0"}]}, {"title": "Factorise", "lines": [{"tex": "x(x^2 - 1) &= 0"}, {"tex": "x(x-1)(x+1) &= 0"}]}, {"title": "Solve and find the y-values", "lines": [{"tex": "x &= 0, \\; 1, \\; -1"}, {"text": "Since $h(x) = x$, the $y$-value equals the $x$-value at each point."}, {"text": "The points are $(-1, -1)$, $(0, 0)$ and $(1, 1)$."}]}], "final": "(-1,-1),\\ (0,0),\\ (1,1)"}, {"part": "maths-pp-2021-higher-p1-q1#(b)", "level": "higher", "marks": 10, "steps": [{"title": "Let the square root be a + bi and square it", "lines": [{"text": "Suppose $\\sqrt{-5+12i} = a+bi$, so $(a+bi)^2 = -5+12i$."}, {"tex": "a^2 + 2abi + b^2i^2 &= -5 + 12i"}, {"tex": "(a^2 - b^2) + 2abi &= -5 + 12i"}]}, {"title": "Equate real parts and imaginary parts", "lines": [{"tex": "a^2 - b^2 &= -5"}, {"tex": "2ab &= 12"}, {"tex": "b &= \\frac{6}{a}"}]}, {"title": "Substitute b = 6/a into the real-part equation", "lines": [{"tex": "a^2 - \\left(\\frac{6}{a}\\right)^2 &= -5"}, {"tex": "a^2 - \\frac{36}{a^2} &= -5"}, {"tex": "a^4 - 36 &= -5a^2"}, {"tex": "a^4 + 5a^2 - 36 &= 0"}]}, {"title": "Factorise and solve for a", "lines": [{"tex": "(a^2+9)(a^2-4) &= 0"}, {"text": "$a^2 + 9 = 0$ has no real solution, since $a \\in \\mathbb{R}$."}, {"tex": "a^2 - 4 &= 0"}, {"tex": "a &= \\pm 2"}]}, {"title": "Find b for each value of a", "lines": [{"tex": "a = 2:\\quad b &= \\frac{6}{2} = 3"}, {"tex": "a = -2:\\quad b &= \\frac{6}{-2} = -3"}]}], "final": "2 + 3i \\text{ and } -2 - 3i"}]}]