[{"skill": {"id": "quad-complete-square-use", "title": "Use completed-square form for roots and turning point", "level": "HL", "input": "a(x + p)² + q", "output": "roots, turning point, sketch", "example": "(x − 3)² + 2 → min (3, 2), no real roots", "needs": ["Express a quadratic in completed-square form"]}, "write": 1, "examParts": 2, "references": [{"part": "maths-pp-2017-higher-p1-q1#(b)", "level": "higher", "marks": 10, "steps": [{"title": "Read the minimum from the completed square", "lines": [{"text": "A square is never negative, so $2\\left(x - \\frac{7}{4}\\right)^2$ is smallest (zero) when $x - \\frac{7}{4} = 0$."}, {"tex": "x - \\frac{7}{4} &= 0"}, {"tex": "x &= \\frac{7}{4}"}]}, {"title": "Find the minimum value", "lines": [{"tex": "f\\left(\\frac{7}{4}\\right) &= 2(0)^2 - \\frac{129}{8}"}, {"tex": "&= -\\frac{129}{8}"}]}], "final": "\\left(\\frac{7}{4},\\; -\\frac{129}{8}\\right)"}, {"part": "maths-pp-2017-higher-p1-q1#(c)(ii)", "level": "higher", "marks": 5, "steps": [{"title": "Set the completed-square form equal to zero", "lines": [{"tex": "2\\left(x - \\frac{7}{4}\\right)^2 - \\frac{129}{8} &= 0"}, {"tex": "2\\left(x - \\frac{7}{4}\\right)^2 &= \\frac{129}{8}"}, {"tex": "\\left(x - \\frac{7}{4}\\right)^2 &= \\frac{129}{16}"}]}, {"title": "Take the square root of both sides", "lines": [{"tex": "x - \\frac{7}{4} &= \\pm\\sqrt{\\frac{129}{16}}"}, {"tex": "x &= \\frac{7}{4} \\pm \\sqrt{\\frac{129}{16}}"}]}], "final": "x = \\frac{7}{4} \\pm \\sqrt{\\frac{129}{16}}"}]}, {"skill": {"id": "sim-word-problem", "title": "Form simultaneous equations from a context", "level": "OL", "input": "verbal problem", "output": "equations, solution, interpretation", "example": "3 adults + 2 kids = €34, 2 adults + 3 kids = €31 → €8, €5", "needs": ["Solve two linear equations in two unknowns"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2022-higher-p2-q1#(c)", "level": "higher", "marks": 10, "steps": [{"title": "Equation from the first fraction", "lines": [{"text": "$\\frac{3}{5}$ of the class are girls."}, {"tex": "\\frac{g}{b+g} &= \\frac{3}{5}"}, {"tex": "5g &= 3(b+g)"}, {"tex": "5g &= 3b + 3g"}, {"tex": "2g &= 3b"}]}, {"title": "Equation after 4 boys and 4 girls join", "lines": [{"text": "There are now $g+4$ girls and $b+g+8$ students."}, {"tex": "\\frac{g+4}{b+g+8} &= \\frac{4}{7}"}, {"tex": "7(g+4) &= 4(b+g+8)"}, {"tex": "7g + 28 &= 4b + 4g + 32"}, {"tex": "3g - 4b &= 4"}]}, {"title": "Substitute b = 2g/3 to find g", "lines": [{"tex": "b &= \\frac{2g}{3}"}, {"tex": "3g - 4\\left(\\frac{2g}{3}\\right) &= 4"}, {"tex": "3g - \\frac{8g}{3} &= 4"}, {"tex": "\\frac{g}{3} &= 4"}, {"tex": "g &= 12"}]}, {"title": "Find b", "lines": [{"tex": "b &= \\frac{2(12)}{3}"}, {"tex": "b &= 8"}]}, {"title": "Check", "lines": [{"text": "Now $12$ boys and $16$ girls: $\\frac{16}{28} = \\frac{4}{7}$, as required."}]}], "final": "b = 8,\\ g = 12"}]}, {"skill": {"id": "sim-linear-quadratic-hl", "title": "Solve linear + order-2 with any coefficients", "level": "HL", "input": "linear + quadratic in x, y", "output": "intersection points", "example": "2x + 3y = 7, xy = 2 → (2, 1), (3/2, 4/3)", "needs": ["Solve one linear and one order-2 equation", "Solve a quadratic with the formula"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2016-higher-p1-q2#(b)", "level": "higher", "marks": 15, "steps": [{"title": "Make x the subject of the linear equation", "lines": [{"tex": "2x + 3y &= -1"}, {"tex": "2x &= -3y - 1"}, {"tex": "x &= \\frac{-3y - 1}{2}"}]}, {"title": "Substitute into the quadratic equation", "lines": [{"tex": "\\left(\\frac{-3y-1}{2}\\right)^2 + \\left(\\frac{-3y-1}{2}\\right)y + 2y^2 &= 4"}, {"text": "Multiply every term by 4 to clear the fractions."}, {"tex": "(-3y-1)^2 + 2y(-3y-1) + 8y^2 &= 16"}, {"tex": "9y^2 + 6y + 1 - 6y^2 - 2y + 8y^2 &= 16"}, {"tex": "11y^2 + 4y + 1 &= 16"}, {"tex": "11y^2 + 4y - 15 &= 0"}]}, {"title": "Factorise and solve for y", "lines": [{"tex": "(11y + 15)(y - 1) &= 0"}, {"tex": "y = -\\frac{15}{11} \\quad &\\text{or} \\quad y = 1"}]}, {"title": "Find x for each y using x = (-3y - 1)/2", "lines": [{"tex": "y = 1: \\quad x &= \\frac{-3(1) - 1}{2}"}, {"tex": "&= -2"}, {"tex": "y = -\\tfrac{15}{11}: \\quad x &= \\frac{-3\\left(-\\frac{15}{11}\\right) - 1}{2}"}, {"tex": "&= \\frac{\\frac{34}{11}}{2}"}, {"tex": "&= \\frac{17}{11}"}]}], "final": "(x, y) = \\left(\\frac{17}{11}, -\\frac{15}{11}\\right) \\text{ or } (-2, 1)"}]}, {"skill": {"id": "eq-rational", "title": "Solve a/(bx+c) ± p/(qx+r) = e/f", "level": "OL", "input": "equation with algebraic denominators", "output": "x (check denominators ≠ 0)", "example": "1/x + 1/(x+1) = 5/6 → x = 2 or −3/5", "needs": ["Add/subtract algebraic fractions", "Solve a quadratic by factorising"]}, "write": 1, "examParts": 2, "references": [{"part": "maths-pp-2018-ordinary-p1-q6#(b)", "level": "ordinary", "marks": 15, "steps": [{"title": "Multiply every term by the common denominator 2x(x + 3)", "lines": [{"text": "The denominators are $x+3$, $x$ and $2$, so the common denominator is $2x(x+3)$."}, {"tex": "2x(x+3)\\left(\\frac{5}{x+3} - \\frac{1}{x}\\right) &= \\frac{1}{2}\\,(2x)(x+3)"}]}, {"title": "Cancel the denominators", "lines": [{"tex": "10x - 2(x+3) &= x(x+3)"}]}, {"title": "Expand both sides", "lines": [{"tex": "10x - 2x - 6 &= x^2 + 3x"}, {"tex": "8x - 6 &= x^2 + 3x"}]}, {"title": "Move everything to one side", "lines": [{"tex": "0 &= x^2 + 3x - 8x + 6"}, {"tex": "x^2 - 5x + 6 &= 0"}]}, {"title": "Factorise and solve", "lines": [{"tex": "(x-2)(x-3) &= 0"}, {"tex": "x &= 2 \\text{ or } x = 3"}, {"text": "Both values are allowed, since neither is $-3$ or $0$."}]}], "final": "x = 2 \\text{ or } x = 3"}, {"part": "maths-pp-2019-higher-p1-q1#(b)", "level": "higher", "marks": 15, "steps": [{"title": "Find a common denominator", "lines": [{"text": "The denominators are $2x+1$, $5$ and $3x-1$, so the common denominator is $5(2x+1)(3x-1)$."}, {"tex": "\\frac{3}{2x+1} + \\frac{2}{5} &= \\frac{2}{3x-1}"}]}, {"title": "Multiply every term by the common denominator", "lines": [{"tex": "15(3x-1) + 2(2x+1)(3x-1) &= 10(2x+1)"}]}, {"title": "Multiply out each side", "lines": [{"tex": "(2x+1)(3x-1) &= 6x^2 - 2x + 3x - 1"}, {"tex": "&= 6x^2 + x - 1"}, {"tex": "45x - 15 + 2(6x^2 + x - 1) &= 20x + 10"}, {"tex": "45x - 15 + 12x^2 + 2x - 2 &= 20x + 10"}, {"tex": "12x^2 + 47x - 17 &= 20x + 10"}]}, {"title": "Rearrange to a quadratic equal to zero", "lines": [{"tex": "12x^2 + 27x - 27 &= 0"}, {"tex": "4x^2 + 9x - 9 &= 0"}]}, {"title": "Factorise and solve", "lines": [{"tex": "(x+3)(4x-3) &= 0"}, {"tex": "x &= -3 \\text{ or } x = \\tfrac{3}{4}"}]}], "final": "x = -3 \\text{ or } x = \\tfrac{3}{4}"}]}]