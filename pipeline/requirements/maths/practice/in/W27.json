[{"skill": {"id": "ind-laws", "title": "Apply the laws of indices", "level": "OL", "input": "expression with powers", "output": "simplified power", "example": "a³·a⁵ / a² → a⁶", "needs": []}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2022-ordinary-p1-q2#(b)", "level": "ordinary", "marks": 5, "steps": [{"title": "Simplify the power of a power", "lines": [{"text": "Multiply the indices: $(a^m)^n = a^{mn}$."}, {"tex": "(3^4)^5 &= 3^{4 \\times 5}"}, {"tex": "&= 3^{20}"}]}, {"title": "Divide the powers", "lines": [{"text": "Subtract the indices: $a^m \\div a^n = a^{m-n}$."}, {"tex": "\\frac{3^{20}}{3^6} &= 3^{20 - 6}"}, {"tex": "&= 3^{14}"}]}], "final": "3^{14}"}]}, {"skill": {"id": "ind-negative-fractional", "title": "Evaluate negative and fractional indices", "level": "OL", "input": "a^(−p/q)", "output": "value or root form", "example": "8^(−2/3) → 1/4", "needs": ["Apply the laws of indices"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2022-higher-p1-q9#(a)", "level": "higher", "marks": 5, "steps": [{"title": "Substitute t = 2.5", "lines": [{"tex": "\\text{Amount} &= 15(0.6)^{2.5}"}, {"tex": "&= 4.1828\\ldots"}, {"tex": "&\\approx 4.18"}]}], "final": "4.18 \\text{ mg}"}]}, {"skill": {"id": "ind-express-as-power", "title": "Write an expression as a power of a base", "level": "OL", "input": "expression with roots/fractions", "output": "base^k", "example": "√8 / 4 → 2^(−1/2)", "needs": ["Evaluate negative and fractional indices"]}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2020-ordinary-p1-q4#(b)", "level": "ordinary", "marks": 10, "steps": [{"title": "Write both sides as powers of 2", "lines": [{"text": "$8 = 2^3$, so $8^{2x} = (2^3)^{2x}$."}, {"tex": "2^{9x-1} &= 8^{2x}"}, {"tex": "2^{9x-1} &= (2^3)^{2x}"}]}, {"title": "Multiply the indices on the right", "lines": [{"text": "Use $(a^m)^n = a^{mn}$."}, {"tex": "2^{9x-1} &= 2^{6x}"}]}, {"title": "Equate the indices", "lines": [{"text": "The bases are equal, so the powers must be equal."}, {"tex": "9x - 1 &= 6x"}, {"tex": "9x - 6x &= 1"}, {"tex": "3x &= 1"}, {"tex": "x &= \\frac{1}{3}"}]}], "final": "x = \\frac{1}{3}"}, {"part": "maths-pp-2022-higher-p1-q4#(a)", "level": "higher", "marks": 10, "steps": [{"title": "Substitute u₁ and u₂ into the rule", "lines": [{"text": "Put $n = 2$ in $u_{n+1} = \\sqrt{\\dfrac{u_n}{u_{n-1}}}$, so $u_3 = \\sqrt{\\dfrac{u_2}{u_1}}$."}, {"tex": "u_3 &= \\sqrt{\\frac{64}{2}}"}, {"tex": "&= \\sqrt{32}"}]}, {"title": "Write 32 as a power of 2", "lines": [{"tex": "&= \\sqrt{2^5}"}]}, {"title": "Replace the square root with a power of one half", "lines": [{"tex": "&= \\left(2^5\\right)^{\\frac{1}{2}}"}, {"tex": "&= 2^{\\frac{5}{2}}"}]}], "final": "u_3 = 2^{\\frac{5}{2}}"}]}, {"skill": {"id": "log-definition", "title": "Convert between log and index form (incl. e and ln)", "level": "HL", "input": "log or exponential statement", "output": "equivalent form / value", "example": "log₂ 8 = 3 ⇔ 2³ = 8; eˣ = 5 ⇔ x = ln 5", "needs": ["Apply the laws of indices"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2023-higher-p1-q3#(c)(i), (ii)", "level": "higher", "marks": 10, "steps": [{"title": "(i) Say what log₆ m means", "lines": [{"text": "$\\log_6 m$ is the power you raise $6$ to in order to get $m$."}, {"tex": "\\log_6 m = x \\quad &\\text{means} \\quad 6^x = m"}]}, {"title": "(ii) Compare m with 6", "lines": [{"text": "$m > 6$ and $6 = 6^1$, so $m$ is bigger than $6^1$."}, {"text": "Powers of $6$ increase as the index increases, so the index for $m$ is bigger than $1$."}, {"tex": "\\log_6 m &> 1"}]}], "final": "\\text{(i) the power of 6 that gives } m; \\quad \\text{(ii) } \\log_6 m > 1"}]}]