[{"skill": {"id": "stat-srs-bias", "title": "Select a simple random sample and spot bias", "level": "OL", "input": "population + sampling method", "output": "SRS procedure; source of bias", "example": "phone poll at 11am → biased against workers", "needs": ["Distinguish population and sample; judge generalisation"]}, "write": 1, "examParts": 1, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual. The method: Spot the bias in the sampling method, then compute the fraction and percentage of the population left out. Earlier backups were dropped for doing this instead: Justifies a simple random sample and finds a selection probability with no bias to spot or percentage left out.", "references": [{"part": "practice-stat-srs-bias-2", "level": "ordinary", "marks": 5, "steps": [{"title": "Spot the bias", "lines": [{"text": "Phoning at 11 a.m. on a weekday leaves out people at work, so the sample is biased."}]}, {"title": "Write those left out as a fraction", "lines": [{"tex": "\\frac{180}{500} &= \\frac{9}{25}", "sym": "Rational(180,500)", "new": true}]}, {"title": "Convert to a percentage", "lines": [{"tex": "\\frac{9}{25} \\times 100 &= 36", "sym": "Rational(9,25)*100", "new": true}]}], "final": "36\\%"}, {"part": "practice-stat-srs-bias-3", "level": "ordinary", "marks": 5, "steps": [{"title": "Spot the bias", "lines": [{"text": "A website vote leaves out adults who do not use the internet, so the sample is biased."}]}, {"title": "Write those left out as a fraction", "lines": [{"tex": "\\frac{600}{2500} &= \\frac{6}{25}", "sym": "Rational(600,2500)", "new": true}]}, {"title": "Convert to a percentage", "lines": [{"tex": "\\frac{6}{25} \\times 100 &= 24", "sym": "Rational(6,25)*100", "new": true}]}], "final": "24\\%"}]}, {"skill": {"id": "trig-graph", "title": "Graph sin, cos and tan", "level": "HL", "input": "function + domain", "output": "graph with period and range", "example": "y = tan x has period π", "needs": ["Define sin θ, cos θ, tan θ for all θ (unit circle)", "Use radian measure"]}, "write": 1, "examParts": 4, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual. The method: Substitute each given value into the function to build the table, then plot the points and join them with a smooth curve. Earlier backups were dropped for doing this instead: Only plots given table values and joins them, with no substitution into the function.", "references": [{"part": "maths-pp-2022-higher-p1-q8#(a), (b)", "level": "higher", "marks": 15, "steps": [{"title": "Use h(t) = 72 - 60cos(πt/3) at each t", "lines": [{"text": "Work in radians. $h(1) = 42$ is given, so we find the other eight values."}]}, {"title": "Substitute t = 0", "lines": [{"tex": "h(0) &= 72 - 60\\cos\\left(0\\right)"}, {"tex": "&= 72 - 60\\left(1\\right)"}, {"tex": "&= 72 - 60"}, {"tex": "&= 12"}]}, {"title": "Substitute t = 2", "lines": [{"tex": "h(2) &= 72 - 60\\cos\\left(\\frac{2\\pi}{3}\\right)"}, {"tex": "&= 72 - 60\\left(-\\frac{1}{2}\\right)"}, {"tex": "&= 72 + 30"}, {"tex": "&= 102"}]}, {"title": "Substitute t = 3", "lines": [{"tex": "h(3) &= 72 - 60\\cos\\left(\\pi\\right)"}, {"tex": "&= 72 - 60\\left(-1\\right)"}, {"tex": "&= 72 + 60"}, {"tex": "&= 132"}]}, {"title": "Substitute t = 4", "lines": [{"tex": "h(4) &= 72 - 60\\cos\\left(\\frac{4\\pi}{3}\\right)"}, {"tex": "&= 72 - 60\\left(-\\frac{1}{2}\\right)"}, {"tex": "&= 72 + 30"}, {"tex": "&= 102"}]}, {"title": "Substitute t = 5", "lines": [{"tex": "h(5) &= 72 - 60\\cos\\left(\\frac{5\\pi}{3}\\right)"}, {"tex": "&= 72 - 60\\left(\\frac{1}{2}\\right)"}, {"tex": "&= 72 - 30"}, {"tex": "&= 42"}]}, {"title": "Substitute t = 6", "lines": [{"tex": "h(6) &= 72 - 60\\cos\\left(2\\pi\\right)"}, {"tex": "&= 72 - 60\\left(1\\right)"}, {"tex": "&= 72 - 60"}, {"tex": "&= 12"}]}, {"title": "Substitute t = 7", "lines": [{"tex": "h(7) &= 72 - 60\\cos\\left(\\frac{7\\pi}{3}\\right)"}, {"tex": "&= 72 - 60\\left(\\frac{1}{2}\\right)"}, {"tex": "&= 72 - 30"}, {"tex": "&= 42"}]}, {"title": "Substitute t = 8", "lines": [{"tex": "h(8) &= 72 - 60\\cos\\left(\\frac{8\\pi}{3}\\right)"}, {"tex": "&= 72 - 60\\left(-\\frac{1}{2}\\right)"}, {"tex": "&= 72 + 30"}, {"tex": "&= 102"}]}, {"title": "Plot the nine points and join them", "lines": [{"text": "Plot $(0,12), (1,42), (2,102), (3,132), (4,102), (5,42), (6,12), (7,42), (8,102)$."}, {"text": "Join them with a smooth wave-shaped curve: it starts at its lowest value 12, rises to 132 at $t = 3$, falls to 12 at $t = 6$, then rises again."}]}], "final": "\\text{Table: } 12,\\ 42,\\ 102,\\ 132,\\ 102,\\ 42,\\ 12,\\ 42,\\ 102"}, {"part": "practice-trig-graph-1", "level": "higher", "marks": 10, "steps": [{"title": "Use g(x) = 1 - 2sin x at each x", "lines": [{"text": "Work in radians. Find $g(x)$ at $x = 0, \\frac{\\pi}{6}, \\frac{\\pi}{2}, \\frac{5\\pi}{6}, \\pi, \\frac{7\\pi}{6}, \\frac{3\\pi}{2}, \\frac{11\\pi}{6}, 2\\pi$."}]}, {"title": "Substitute $x = 0$", "lines": [{"tex": "g\\left(0\\right) &= 1 - 2\\sin\\left(0\\right)", "sym": "1 - 2*sin(0)", "new": true}, {"tex": "&= 1 - 2\\left(0\\right)", "sym": "1 - 2*(0)"}, {"tex": "&= 1", "sym": "1"}]}, {"title": "Substitute $x = \\frac{\\pi}{6}$", "lines": [{"tex": "g\\left(\\frac{\\pi}{6}\\right) &= 1 - 2\\sin\\left(\\frac{\\pi}{6}\\right)", "sym": "1 - 2*sin(pi/6)", "new": true}, {"tex": "&= 1 - 2\\left(\\frac{1}{2}\\right)", "sym": "1 - 2*(Rational(1,2))"}, {"tex": "&= 0", "sym": "0"}]}, {"title": "Substitute $x = \\frac{\\pi}{2}$", "lines": [{"tex": "g\\left(\\frac{\\pi}{2}\\right) &= 1 - 2\\sin\\left(\\frac{\\pi}{2}\\right)", "sym": "1 - 2*sin(pi/2)", "new": true}, {"tex": "&= 1 - 2\\left(1\\right)", "sym": "1 - 2*(1)"}, {"tex": "&= -1", "sym": "-1"}]}, {"title": "Substitute $x = \\frac{5\\pi}{6}$", "lines": [{"tex": "g\\left(\\frac{5\\pi}{6}\\right) &= 1 - 2\\sin\\left(\\frac{5\\pi}{6}\\right)", "sym": "1 - 2*sin(5*pi/6)", "new": true}, {"tex": "&= 1 - 2\\left(\\frac{1}{2}\\right)", "sym": "1 - 2*(Rational(1,2))"}, {"tex": "&= 0", "sym": "0"}]}, {"title": "Substitute $x = \\pi$", "lines": [{"tex": "g\\left(\\pi\\right) &= 1 - 2\\sin\\left(\\pi\\right)", "sym": "1 - 2*sin(pi)", "new": true}, {"tex": "&= 1 - 2\\left(0\\right)", "sym": "1 - 2*(0)"}, {"tex": "&= 1", "sym": "1"}]}, {"title": "Substitute $x = \\frac{7\\pi}{6}$", "lines": [{"tex": "g\\left(\\frac{7\\pi}{6}\\right) &= 1 - 2\\sin\\left(\\frac{7\\pi}{6}\\right)", "sym": "1 - 2*sin(7*pi/6)", "new": true}, {"tex": "&= 1 - 2\\left(-\\frac{1}{2}\\right)", "sym": "1 - 2*(-Rational(1,2))"}, {"tex": "&= 2", "sym": "2"}]}, {"title": "Substitute $x = \\frac{3\\pi}{2}$", "lines": [{"tex": "g\\left(\\frac{3\\pi}{2}\\right) &= 1 - 2\\sin\\left(\\frac{3\\pi}{2}\\right)", "sym": "1 - 2*sin(3*pi/2)", "new": true}, {"tex": "&= 1 - 2\\left(-1\\right)", "sym": "1 - 2*(-1)"}, {"tex": "&= 3", "sym": "3"}]}, {"title": "Substitute $x = \\frac{11\\pi}{6}$", "lines": [{"tex": "g\\left(\\frac{11\\pi}{6}\\right) &= 1 - 2\\sin\\left(\\frac{11\\pi}{6}\\right)", "sym": "1 - 2*sin(11*pi/6)", "new": true}, {"tex": "&= 1 - 2\\left(-\\frac{1}{2}\\right)", "sym": "1 - 2*(-Rational(1,2))"}, {"tex": "&= 2", "sym": "2"}]}, {"title": "Substitute $x = 2\\pi$", "lines": [{"tex": "g\\left(2\\pi\\right) &= 1 - 2\\sin\\left(2\\pi\\right)", "sym": "1 - 2*sin(2*pi)", "new": true}, {"tex": "&= 1 - 2\\left(0\\right)", "sym": "1 - 2*(0)"}, {"tex": "&= 1", "sym": "1"}]}, {"title": "Plot the nine points and join them", "lines": [{"text": "Plot $(0,1), (\\frac{\\pi}{6},0), (\\frac{\\pi}{2},-1), (\\frac{5\\pi}{6},0), (\\pi,1), (\\frac{7\\pi}{6},2), (\\frac{3\\pi}{2},3), (\\frac{11\\pi}{6},2), (2\\pi,1)$."}, {"text": "Join them with a smooth wave: it falls from 1 to a minimum of $-1$ at $x = \\frac{\\pi}{2}$, rises to a maximum of 3 at $x = \\frac{3\\pi}{2}$ and returns to 1."}]}], "final": "\\text{Table: } 1,\\ 0,\\ -1,\\ 0,\\ 1,\\ 2,\\ 3,\\ 2,\\ 1"}]}, {"skill": {"id": "trig-unit-circle", "title": "Define sin θ, cos θ, tan θ for all θ (unit circle)", "level": "OL", "input": "any angle", "output": "value with correct sign (CAST, related angle)", "example": "cos 240° → −½", "needs": ["Use sin, cos, tan in a right-angled triangle"]}, "write": 1, "examParts": 4, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual. The method: Place the point on the unit circle from its angle, then read cos as the x co-ordinate and sin as the y co-ordinate using the related angle and quadrant signs. Earlier backups were dropped for doing this instead: Uses right-triangle ratios on a radius 5 circle to read a and b, with no quadrant or sign step.", "references": [{"part": "maths-pp-2023-higher-p2-q9#(c)(i)", "level": "higher", "marks": 5, "steps": [{"title": "Place Q on the unit circle using the angle", "lines": [{"text": "$|\\angle QOP| = 45^\\circ$ and $P = (-1, 0)$, so $OQ$ makes $135^\\circ$ with the positive $x$-axis."}, {"text": "On the unit circle, a point at angle $\\theta$ is $(\\cos\\theta, \\sin\\theta)$."}, {"tex": "Q &= (\\cos 135^\\circ, \\sin 135^\\circ)"}]}, {"title": "Find the x co-ordinate", "lines": [{"tex": "\\cos 135^\\circ &= -\\cos 45^\\circ"}, {"tex": "&= -\\frac{1}{\\sqrt{2}}"}]}, {"title": "Find the y co-ordinate", "lines": [{"tex": "\\sin 135^\\circ &= \\sin 45^\\circ"}, {"tex": "&= \\frac{1}{\\sqrt{2}}"}]}], "final": "Q = \\left(-\\frac{1}{\\sqrt{2}}, \\frac{1}{\\sqrt{2}}\\right)"}, {"part": "practice-trig-unit-circle-1", "level": "higher", "marks": 5, "steps": [{"title": "Place P on the unit circle using the angle", "lines": [{"text": "On the unit circle, a point at angle $\\theta$ is $(\\cos\\theta, \\sin\\theta)$."}, {"tex": "P &= (\\cos 210^\\circ, \\sin 210^\\circ)"}]}, {"title": "Find the x co-ordinate", "lines": [{"text": "$210^\\circ$ is in the third quadrant, where cos is negative. The related angle is $30^\\circ$."}, {"tex": "\\cos 210^\\circ", "sym": "cos(7*pi/6)", "new": true}, {"tex": "&= -\\cos 30^\\circ", "sym": "-cos(pi/6)"}, {"tex": "&= -\\frac{\\sqrt{3}}{2}", "sym": "-sqrt(3)/2"}]}, {"title": "Find the y co-ordinate", "lines": [{"text": "In the third quadrant sin is also negative."}, {"tex": "\\sin 210^\\circ", "sym": "sin(7*pi/6)", "new": true}, {"tex": "&= -\\sin 30^\\circ", "sym": "-sin(pi/6)"}, {"tex": "&= -\\frac{1}{2}", "sym": "-1/2"}]}], "final": "P = \\left(-\\frac{\\sqrt{3}}{2}, -\\frac{1}{2}\\right)"}]}]