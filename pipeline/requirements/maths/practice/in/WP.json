[{"skill": {"id": "circ-chord-length", "title": "Find a chord length or distance from centre", "level": "OL", "input": "radius + perpendicular distance (or chord)", "output": "chord length", "example": "r = 5, distance 3 → chord 8", "needs": ["Apply Theorem 21: Perpendicular from the centre bisects a chord; perpendicular bisector of a chord passes through the centre", "Apply Theorem 14: Pythagoras"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2021-higher-p2-q3#(a)", "level": "higher", "marks": 15, "steps": [{"title": "Find half the chord, |DB|", "lines": [{"text": "A line from the centre to the midpoint of a chord is perpendicular to the chord, so $CDB$ is a right-angled triangle with the right angle at $D$."}, {"tex": "|DB| &= \\frac{1}{2} \\times 4\\sqrt{3}"}, {"tex": "&= 2\\sqrt{3}"}]}, {"title": "Find |CD| using the distance formula", "lines": [{"tex": "|CD|^2 &= (3-1)^2 + (2-(-2))^2"}, {"tex": "&= 2^2 + 4^2"}, {"tex": "&= 20"}, {"tex": "|CD| &= \\sqrt{20}"}, {"tex": "&= 2\\sqrt{5}"}]}, {"title": "Use Pythagoras in triangle CDB", "lines": [{"text": "The radius is $r = |CB|$, the hypotenuse of the right-angled triangle."}, {"tex": "r^2 &= |CD|^2 + |DB|^2"}, {"tex": "&= (2\\sqrt{5})^2 + (2\\sqrt{3})^2"}, {"tex": "&= 20 + 12"}, {"tex": "&= 32"}]}, {"title": "Take the square root and simplify", "lines": [{"tex": "r &= \\sqrt{32}"}, {"tex": "&= \\sqrt{16 \\times 2}"}, {"tex": "&= 4\\sqrt{2}"}]}], "final": "r = 4\\sqrt{2}"}]}, {"skill": {"id": "cx-polar", "title": "Convert between rectangular and polar form", "level": "HL", "input": "a + bi", "output": "r(cos θ + i sin θ), θ in correct quadrant", "example": "1 + i√3 → 2(cos π/3 + i sin π/3)", "needs": ["Find the modulus as distance from the origin", "Define sin θ, cos θ, tan θ for all θ (unit circle)", "Use radian measure"]}, "write": 2, "examParts": 1, "references": [{"part": "maths-pp-2019-higher-p1-q5#(b)(i)", "level": "higher", "marks": 5, "steps": [{"title": "Find the modulus r", "lines": [{"tex": "r = |v| &= \\sqrt{2^2 + (2\\sqrt{3})^2}"}, {"tex": "&= \\sqrt{4 + 12}"}, {"tex": "&= 4"}]}, {"title": "Find the argument", "lines": [{"text": "$v = 2 - 2\\sqrt{3}\\,i$ is in the fourth quadrant (real part positive, imaginary part negative)."}, {"tex": "\\tan\\alpha &= \\frac{2\\sqrt{3}}{2} = \\sqrt{3}"}, {"tex": "\\alpha &= \\frac{\\pi}{3}"}, {"tex": "\\theta &= 2\\pi - \\frac{\\pi}{3} = \\frac{5\\pi}{3}"}]}, {"title": "Write v in polar form", "lines": [{"tex": "v &= 4\\left(\\cos\\frac{5\\pi}{3} + i\\sin\\frac{5\\pi}{3}\\right)"}]}], "final": "v = 4\\left(\\cos\\frac{5\\pi}{3} + i\\sin\\frac{5\\pi}{3}\\right)"}]}, {"skill": {"id": "diff-second", "title": "Find the second derivative", "level": "OL", "input": "f(x)", "output": "f″(x)", "example": "x³ − 3x → 6x", "needs": ["Differentiate a polynomial by rule"]}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2015-higher-p1-q7#(c)", "level": "higher", "marks": 10, "steps": [{"title": "Find the second derivative", "lines": [{"tex": "f'(x) &= 0.0072x^2 + 0.036x"}, {"tex": "f''(x) &= 0.0144x + 0.036"}]}, {"title": "Set f''(x) = 0 and solve", "lines": [{"text": "A point of inflection occurs where $f''(x) = 0$."}, {"tex": "0.0144x + 0.036 &= 0"}, {"tex": "0.0144x &= -0.036"}, {"tex": "x &= -2.5"}, {"text": "$f''(x)$ is a line with positive slope, so it changes sign at $x = -2.5$."}]}, {"title": "Find the y-coordinate", "lines": [{"tex": "f(-2.5) &= 0.0024(-2.5)^3 + 0.018(-2.5)^2"}, {"tex": "&= -0.0375 + 0.1125"}, {"tex": "&= 0.075"}, {"text": "So the point of inflection is $(-2.5, 0.075)$."}]}], "final": "(-2.5,\\ 0.075)"}, {"part": "maths-pp-2017-higher-p1-q5#(b)", "level": "higher", "marks": 5, "steps": [{"title": "Differentiate and set $f'(x) = 0$", "lines": [{"tex": "f'(x) &= 6x^2 + 10x - 4"}, {"tex": "6x^2 + 10x - 4 &= 0"}, {"tex": "3x^2 + 5x - 2 &= 0"}]}, {"title": "Factorise and solve", "lines": [{"tex": "(3x - 1)(x + 2) &= 0"}, {"tex": "x &= \\frac{1}{3} \\text{ or } x = -2"}]}, {"title": "Decide which is the maximum", "lines": [{"tex": "f''(x) &= 12x + 10"}, {"tex": "f''(-2) &= -14"}, {"text": "$f''(-2) < 0$, so $x = -2$ is a local maximum."}, {"tex": "f''\\left(\\tfrac{1}{3}\\right) &= 14"}, {"text": "$f''\\left(\\tfrac{1}{3}\\right) > 0$, so $x = \\tfrac{1}{3}$ is a local minimum."}]}, {"title": "Find $f(-2)$", "lines": [{"tex": "f(-2) &= 2(-2)^3 + 5(-2)^2 - 4(-2) - 3"}, {"tex": "&= -16 + 20 + 8 - 3"}, {"tex": "&= 9"}]}, {"title": "Find $f\\left(\\frac{1}{3}\\right)$", "lines": [{"tex": "f\\left(\\tfrac{1}{3}\\right) &= 2\\left(\\tfrac{1}{3}\\right)^3 + 5\\left(\\tfrac{1}{3}\\right)^2 - 4\\left(\\tfrac{1}{3}\\right) - 3"}, {"tex": "&= \\frac{2}{27} + \\frac{15}{27} - \\frac{36}{27} - \\frac{81}{27}"}, {"tex": "&= -\\frac{100}{27}"}]}], "final": "\\text{Local max } (-2,\\ 9),\\quad \\text{local min } \\left(\\tfrac{1}{3},\\ -\\tfrac{100}{27}\\right)"}]}, {"skill": {"id": "geo-thm19", "title": "Apply Theorem 19: Angle at the centre is twice the angle at the circle (JC-HL, assumed at LC HL)", "level": "HL", "input": "geometric diagram with unknown angles/lengths", "output": "unknown found, justified by citing Theorem 19", "example": "", "needs": []}, "write": 3, "examParts": 0, "references": [{"part": "maths-pp-2022-higher-p2-q6#(c)", "level": "higher", "marks": 5, "steps": [{"title": "Assume the opposite", "lines": [{"text": "Assume that $O$ is inside the triangle $PQR$."}, {"text": "Join $P$ to $O$ and $Q$ to $O$."}]}, {"title": "Bound the angle at the centre", "lines": [{"text": "If $O$ is inside the triangle, $\\angle POQ$ is an angle inside triangle $POQ$, so it is less than a straight angle."}, {"tex": "|\\angle POQ| &< 180^\\circ"}]}, {"title": "Compare with the angle at the circumference", "lines": [{"text": "The angle at the centre is twice the angle at the circumference on the same arc $PQ$, so $|\\angle PRQ|$ is half of $|\\angle POQ|$."}, {"tex": "|\\angle PRQ| &= \\frac{1}{2}|\\angle POQ|"}, {"tex": "&< \\frac{1}{2}(180^\\circ) = 90^\\circ"}]}, {"title": "State the contradiction", "lines": [{"text": "But the angle at $R$ is greater than $90^\\circ$. This contradicts the result above, so the assumption is false."}, {"text": "Therefore $O$ cannot be inside the triangle $PQR$."}]}], "final": "O \\text{ cannot be inside triangle } PQR"}]}]