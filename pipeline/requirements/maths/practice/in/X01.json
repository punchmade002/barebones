[{"skill": {"id": "cx-quadratic", "title": "Solve a quadratic with complex roots", "level": "HL", "input": "quadratic with b² − 4ac < 0", "output": "conjugate pair of roots", "example": "z² − 4z + 13 = 0 → 2 ± 3i", "needs": ["Solve a quadratic with the formula", "Simplify powers of i"]}, "write": 1, "examParts": 2, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual.", "references": [{"part": "maths-pp-2024-higher-p1-q2#(a)", "level": "higher", "marks": 5, "steps": [{"title": "Identify a, b and c", "lines": [{"tex": "z^2 + 12z + 261 &= 0"}, {"text": "Here $a = 1$, $b = 12$, $c = 261$."}]}, {"title": "Substitute into the quadratic formula", "lines": [{"tex": "z &= \\frac{-12 \\pm \\sqrt{12^2 - 4(1)(261)}}{2(1)}"}]}, {"title": "Simplify under the square root", "lines": [{"tex": "z &= \\frac{-12 \\pm \\sqrt{144 - 1044}}{2}"}, {"tex": "z &= \\frac{-12 \\pm \\sqrt{-900}}{2}"}]}, {"title": "Write the root using i", "lines": [{"text": "$\\sqrt{-900} = \\sqrt{900} \\times \\sqrt{-1} = 30i$."}, {"tex": "z &= \\frac{-12 \\pm 30i}{2}"}]}, {"title": "Divide each term by 2", "lines": [{"tex": "z &= -6 \\pm 15i"}, {"tex": "z &= -6 + 15i \\text{ or } z = -6 - 15i"}]}], "final": "-6 + 15i \\text{ and } -6 - 15i"}, {"part": "practice-cx-quadratic-1", "level": "higher", "marks": 10, "steps": [{"title": "Identify a, b and c", "lines": [{"tex": "4z^2 - 8z + 13 &= 0", "sym": "Eq(4*z**2-8*z+13,0)"}, {"text": "Here $a = 4$, $b = -8$, $c = 13$."}]}, {"title": "Substitute into the formula", "lines": [{"tex": "z &= \\frac{8 \\pm \\sqrt{(-8)^2 - 4(4)(13)}}{2(4)}", "sym": "Eq(z,(8+sqrt((-8)**2-4*4*13))/(2*4))", "new": true}]}, {"title": "Simplify under the square root", "lines": [{"tex": "z &= \\frac{8 \\pm \\sqrt{64 - 208}}{8}"}, {"tex": "&= \\frac{8 \\pm \\sqrt{-144}}{8}"}]}, {"title": "Write the root using i", "lines": [{"text": "$\\sqrt{-144} = 12i$."}, {"tex": "z &= \\frac{8 \\pm 12i}{8}"}]}, {"title": "Divide each term by 8", "lines": [{"tex": "z &= 1 \\pm \\frac{3}{2}i"}, {"text": "The roots are a conjugate pair."}]}], "final": "z = 1 + \\tfrac{3}{2}i \\text{ and } z = 1 - \\tfrac{3}{2}i"}]}, {"skill": {"id": "ind-negative-fractional", "title": "Evaluate negative and fractional indices", "level": "OL", "input": "a^(−p/q)", "output": "value or root form", "example": "8^(−2/3) → 1/4", "needs": ["Apply the laws of indices"]}, "write": 1, "examParts": 1, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual.", "references": [{"part": "practice-ind-negative-fractional-1", "level": "ordinary", "marks": 5, "steps": [{"title": "Remove the negative index", "lines": [{"text": "Use $a^{-n} = \\dfrac{1}{a^n}$."}, {"tex": "16^{-\\frac{3}{4}} &= \\frac{1}{16^{\\frac{3}{4}}}", "sym": "Eq(16**Rational(-3,4), 1/16**Rational(3,4))", "new": true}]}, {"title": "Take the fourth root of 16", "lines": [{"text": "The denominator of the index is the root: $a^{\\frac{1}{4}} = \\sqrt[4]{a}$."}, {"tex": "16^{\\frac{1}{4}} &= 2", "sym": "Eq(16**Rational(1,4), 2)", "new": true}]}, {"title": "Cube the result", "lines": [{"text": "The numerator of the index is the power."}, {"tex": "16^{\\frac{3}{4}} &= \\left(16^{\\frac{1}{4}}\\right)^3", "sym": "Eq(16**Rational(3,4), (16**Rational(1,4))**3)", "new": true}, {"tex": "&= 2^3", "sym": "Eq((16**Rational(1,4))**3, 2**3)"}, {"tex": "&= 8", "sym": "Eq(2**3, 8)"}]}, {"title": "Write the answer", "lines": [{"tex": "16^{-\\frac{3}{4}} &= \\frac{1}{8}", "sym": "Eq(16**Rational(-3,4), Rational(1,8))", "new": true}]}], "final": "\\frac{1}{8}"}, {"part": "practice-ind-negative-fractional-2", "level": "ordinary", "marks": 5, "steps": [{"title": "Flip the fraction", "lines": [{"text": "A negative index flips the fraction."}, {"tex": "\\left(\\frac{4}{9}\\right)^{-\\frac{3}{2}} &= \\left(\\frac{9}{4}\\right)^{\\frac{3}{2}}", "sym": "Eq(Rational(4,9)**Rational(-3,2), Rational(9,4)**Rational(3,2))", "new": true}]}, {"title": "Split into a root and a power", "lines": [{"text": "An index of $\\frac{3}{2}$ means square root, then cube."}, {"tex": "\\left(\\frac{9}{4}\\right)^{\\frac{3}{2}} &= \\left(\\sqrt{\\frac{9}{4}}\\right)^3", "sym": "Eq(Rational(9,4)**Rational(3,2), sqrt(Rational(9,4))**3)", "new": true}, {"tex": "&= \\left(\\frac{3}{2}\\right)^3", "sym": "Eq(sqrt(Rational(9,4))**3, Rational(3,2)**3)"}]}, {"title": "Cube the fraction", "lines": [{"tex": "\\left(\\frac{3}{2}\\right)^3 &= \\frac{27}{8}", "sym": "Eq(Rational(3,2)**3, Rational(27,8))", "new": true}]}], "final": "\\frac{27}{8}"}]}, {"skill": {"id": "stat-data-types", "title": "Classify data", "level": "OL", "input": "variable description", "output": "categorical (nominal/ordinal) or numerical (discrete/continuous); univariate/bivariate", "example": "shoe size → numerical discrete", "needs": []}, "write": 1, "examParts": 2, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual.", "references": [{"part": "maths-pp-2015-ordinary-p2-q9#(a)", "level": "ordinary", "marks": 5, "steps": [{"title": "Decide the type of data", "lines": [{"text": "Tick Numerical Continuous."}, {"text": "Height is a number that is measured, and it can take any value in a range, such as 164.37 cm, so it is continuous."}]}], "final": "\\text{Numerical Continuous}"}, {"part": "practice-stat-data-types-1", "level": "ordinary", "marks": 5, "steps": [{"title": "Recall what continuous means", "lines": [{"text": "Numerical continuous data is measured and can take any value in a range."}]}, {"title": "Classify each variable", "lines": [{"text": "Time to run 100 m: continuous. Mass of a parcel: continuous."}, {"text": "Number of goals and shoe size: numerical discrete. Eye colour: categorical."}]}, {"title": "Count the continuous ones", "lines": [{"tex": "\\text{Count} &= 1 + 1 &= 2", "sym": "1 + 1", "new": true}]}], "final": "2"}]}, {"skill": {"id": "trig-exact-values", "title": "Use trig ratios in surd form", "level": "OL", "input": "30°, 45°, 60° and related angles", "output": "exact value", "example": "sin 135° → 1/√2", "needs": ["Define sin θ, cos θ, tan θ for all θ (unit circle)", "Simplify and operate on surds"]}, "write": 1, "examParts": 1, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual.", "references": [{"part": "practice-trig-exact-values-2", "level": "ordinary", "marks": 5, "steps": [{"title": "Find the reference angle", "lines": [{"text": "$210^\\circ$ is in the third quadrant."}, {"tex": "\\text{reference angle} &= 210^\\circ - 180^\\circ", "sym": "210 - 180"}, {"tex": "&= 30^\\circ", "sym": "30"}]}, {"title": "Fix the sign", "lines": [{"text": "Cosine is negative in the third quadrant."}, {"tex": "\\cos 210^\\circ &= -\\cos 30^\\circ", "sym": "Eq(cos(7*pi/6), -cos(pi/6))", "new": true}]}, {"title": "Use the exact value", "lines": [{"tex": "&= -\\frac{\\sqrt{3}}{2}", "sym": "-sqrt(3)/2", "new": true}]}], "final": "-\\frac{\\sqrt{3}}{2}"}, {"part": "practice-trig-exact-values-1", "level": "ordinary", "marks": 5, "steps": [{"title": "Write each ratio as a surd or fraction", "lines": [{"tex": "\\sin 60^\\circ\\cos 30^\\circ + \\cos 60^\\circ\\sin 30^\\circ &= \\frac{\\sqrt{3}}{2}\\times\\frac{\\sqrt{3}}{2} + \\frac{1}{2}\\times\\frac{1}{2}", "sym": "sin(pi/3)*cos(pi/6)+cos(pi/3)*sin(pi/6)"}]}, {"title": "Multiply", "lines": [{"tex": "&= \\frac{3}{4} + \\frac{1}{4}", "sym": "Rational(3,4)+Rational(1,4)"}]}, {"title": "Add", "lines": [{"tex": "&= 1", "sym": "1"}]}], "final": "1"}]}, {"skill": {"id": "circ-tangents-from-point", "title": "Find tangents from an external point", "level": "HL", "input": "circle + external point", "output": "tangent slopes and equations", "example": "x² + y² = 5 from (0, 5) → y = ±2x + 5", "needs": ["Show a line is a tangent", "Find lines through a point at a given distance/angle"]}, "write": 1, "examParts": 1, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual.", "references": [{"part": "practice-circ-tangents-from-point-1", "level": "higher", "marks": 10, "steps": [{"title": "Write the line through $(0, 10)$ with slope $m$", "lines": [{"tex": "y &= mx + 10", "sym": "Eq(y, m*x + 10)", "new": true}, {"tex": "mx - y + 10 &= 0", "sym": "Eq(m*x - y + 10, 0)"}]}, {"title": "Distance from the centre $(0, 0)$ equals the radius $\\sqrt{10}$", "lines": [{"tex": "\\frac{|10|}{\\sqrt{m^2 + 1}} &= \\sqrt{10}", "sym": "Eq(10/sqrt(m**2 + 1), sqrt(10))", "new": true}]}, {"title": "Square both sides and solve", "lines": [{"tex": "100 &= 10(m^2 + 1)", "sym": "Eq(100, 10*(m**2 + 1))"}, {"tex": "m^2 + 1 &= 10", "sym": "Eq(m**2 + 1, 10)"}, {"tex": "m^2 &= 9", "sym": "Eq(m**2, 9)"}, {"tex": "m &= 3 \\text{ or } m = -3", "sym": "Or(Eq(m, 3), Eq(m, -3))"}]}], "final": "m = 3 \\text{ or } m = -3"}, {"part": "practice-circ-tangents-from-point-2", "level": "higher", "marks": 10, "steps": [{"title": "Find the centre and radius", "lines": [{"text": "Here $g = -2$, $f = -1$ and $c = -4$, so the centre is $(2, 1)$."}, {"tex": "r &= \\sqrt{(-2)^2 + (-1)^2 - (-4)}", "sym": "sqrt((-2)**2 + (-1)**2 - (-4))", "new": true}, {"tex": "&= 3", "sym": "3"}]}, {"title": "Write the line through $P$ with slope $m$", "lines": [{"tex": "y - 1 &= m(x + 3)", "sym": "Eq(y - 1, m*(x + 3))", "new": true}, {"tex": "mx - y + 3m + 1 &= 0", "sym": "Eq(m*x - y + 3*m + 1, 0)"}]}, {"title": "Distance from the centre equals the radius", "lines": [{"tex": "\\frac{|2m - 1 + 3m + 1|}{\\sqrt{m^2 + 1}} &= 3", "sym": "Eq(Abs(2*m - 1 + 3*m + 1)/sqrt(m**2 + 1), 3)", "new": true}, {"tex": "\\frac{5|m|}{\\sqrt{m^2 + 1}} &= 3", "sym": "Eq(5*Abs(m)/sqrt(m**2 + 1), 3)"}]}, {"title": "Square both sides and solve", "lines": [{"tex": "25m^2 &= 9(m^2 + 1)", "sym": "Eq(25*m**2, 9*(m**2 + 1))"}, {"tex": "16m^2 &= 9", "sym": "Eq(16*m**2, 9)"}, {"tex": "m &= \\frac{3}{4} \\text{ or } m = -\\frac{3}{4}", "sym": "Or(Eq(m, Rational(3, 4)), Eq(m, -Rational(3, 4)))"}]}], "final": "m = \\frac{3}{4} \\text{ or } m = -\\frac{3}{4}"}]}, {"skill": {"id": "line-collinear", "title": "Show points are collinear", "level": "OL", "input": "three points", "output": "equal slopes (or zero area)", "example": "(0, 1), (1, 3), (2, 5) → collinear", "needs": ["Find the slope from two points or an equation"]}, "write": 1, "examParts": 1, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual.", "references": [{"part": "practice-line-collinear-1", "level": "ordinary", "marks": 10, "steps": [{"title": "Find the slope of PQ", "lines": [{"text": "Slope formula for $P(-2,5)$ and $Q(1,2)$."}, {"tex": "m_{PQ} &= \\frac{2-5}{1-(-2)}", "sym": "(2-5)/(1-(-2))", "new": true}, {"tex": "&= \\frac{-3}{3}", "sym": "Rational(-3,3)"}, {"tex": "&= -1", "sym": "-1"}]}, {"title": "Find the slope of QR", "lines": [{"text": "Slope formula for $Q(1,2)$ and $R(4,-1)$."}, {"tex": "m_{QR} &= \\frac{-1-2}{4-1}", "sym": "(-1-2)/(4-1)", "new": true}, {"tex": "&= \\frac{-3}{3}", "sym": "Rational(-3,3)"}, {"tex": "&= -1", "sym": "-1"}]}, {"title": "Compare the slopes", "lines": [{"text": "$m_{PQ} = m_{QR} = -1$, and $Q$ is on both segments, so $P$, $Q$ and $R$ lie on one line."}]}], "final": "m_{PQ} = m_{QR} = -1 \\text{, so } P, Q, R \\text{ are collinear}"}, {"part": "practice-line-collinear-2", "level": "ordinary", "marks": 10, "steps": [{"title": "Find the slope of AB", "lines": [{"text": "Slope formula for $A(-3,-2)$ and $B(1,0)$."}, {"tex": "m_{AB} &= \\frac{0-(-2)}{1-(-3)}", "sym": "(0-(-2))/(1-(-3))", "new": true}, {"tex": "&= \\frac{2}{4}", "sym": "Rational(2,4)"}, {"tex": "&= \\frac12", "sym": "Rational(1,2)"}]}, {"title": "Find the slope of BC", "lines": [{"text": "Slope formula for $B(1,0)$ and $C(9,4)$."}, {"tex": "m_{BC} &= \\frac{4-0}{9-1}", "sym": "(4-0)/(9-1)", "new": true}, {"tex": "&= \\frac{4}{8}", "sym": "Rational(4,8)"}, {"tex": "&= \\frac12", "sym": "Rational(1,2)"}]}, {"title": "Compare the slopes", "lines": [{"text": "$m_{AB} = m_{BC} = \\frac12$, and $B$ is on both segments, so $A$, $B$ and $C$ lie on one line."}]}], "final": "m_{AB} = m_{BC} = \\tfrac12 \\text{, so } A, B, C \\text{ are collinear}"}]}, {"skill": {"id": "line-from-distance", "title": "Find lines through a point at a given distance/angle", "level": "HL", "input": "point + distance or angle condition", "output": "slope(s) via quadratic, line equations", "example": "through (0, 0), distance 2 from (4, 0) → m = ±1/√3", "needs": ["Find the perpendicular distance from a point to a line", "Solve a quadratic with the formula"]}, "write": 1, "examParts": 1, "note": "Use the SAME method as the references (they are the lesson so far); change one thing, as usual.", "references": [{"part": "practice-line-from-distance-1", "level": "higher", "marks": 15, "steps": [{"title": "Write the line through the origin", "lines": [{"text": "A line through $O(0,0)$ with slope $m$ is $y = mx$."}, {"tex": "mx - y &= 0", "sym": "Eq(m*x-y,0)", "new": true}]}, {"title": "Use the distance formula", "lines": [{"text": "Distance from $(7,1)$ to $mx - y = 0$ equals $5$."}, {"tex": "\\frac{|7m - 1|}{\\sqrt{m^2+1}} &= 5", "sym": "Eq(Abs(7*m-1)/sqrt(m**2+1), 5)", "new": true}, {"tex": "(7m-1)^2 &= 25(m^2+1)", "sym": "Eq((7*m-1)**2, 25*(m**2+1))", "new": true}]}, {"title": "Form the quadratic", "lines": [{"tex": "49m^2 - 14m + 1 &= 25m^2 + 25", "sym": "Eq(49*m**2-14*m+1, 25*m**2+25)"}, {"tex": "24m^2 - 14m - 24 &= 0", "sym": "Eq(24*m**2-14*m-24, 0)"}, {"tex": "12m^2 - 7m - 12 &= 0", "sym": "Eq(12*m**2-7*m-12, 0)"}]}, {"title": "Solve with the quadratic formula", "lines": [{"tex": "m &= \\frac{7 \\pm \\sqrt{49 + 576}}{24}", "sym": "[(7-sqrt(49+576))/24, (7+sqrt(49+576))/24]", "new": true}, {"tex": "&= \\frac{7 \\pm 25}{24}", "sym": "[(7-25)/24, (7+25)/24]"}, {"tex": "&= -\\frac34 \\text{ or } \\frac43", "sym": "[Rational(-3,4), Rational(4,3)]"}]}], "final": "m = -\\frac34 \\text{ or } m = \\frac43"}, {"part": "practice-line-from-distance-2", "level": "higher", "marks": 15, "steps": [{"title": "Write the line through A", "lines": [{"text": "Slope $m$ through $(2,3)$: $y - 3 = m(x - 2)$."}, {"tex": "y - 3 &= m(x-2)", "sym": "Eq(y-3, m*(x-2))", "new": true}, {"tex": "mx - y + 3 - 2m &= 0", "sym": "Eq(m*x-y+3-2*m, 0)"}]}, {"title": "Use the distance formula", "lines": [{"text": "Distance from $B(6,10)$ equals $1$."}, {"tex": "\\frac{|6m - 10 + 3 - 2m|}{\\sqrt{m^2+1}} &= 1", "sym": "Eq(Abs(6*m-10+3-2*m)/sqrt(m**2+1), 1)", "new": true}, {"tex": "\\frac{|4m - 7|}{\\sqrt{m^2+1}} &= 1", "sym": "Eq(Abs(4*m-7)/sqrt(m**2+1), 1)"}, {"tex": "(4m-7)^2 &= m^2+1", "sym": "Eq((4*m-7)**2, m**2+1)", "new": true}]}, {"title": "Form the quadratic", "lines": [{"tex": "16m^2 - 56m + 49 &= m^2 + 1", "sym": "Eq(16*m**2-56*m+49, m**2+1)"}, {"tex": "15m^2 - 56m + 48 &= 0", "sym": "Eq(15*m**2-56*m+48, 0)"}]}, {"title": "Solve with the quadratic formula", "lines": [{"tex": "m &= \\frac{56 \\pm \\sqrt{3136 - 2880}}{30}", "sym": "[(56-sqrt(3136-2880))/30, (56+sqrt(3136-2880))/30]", "new": true}, {"tex": "&= \\frac{56 \\pm 16}{30}", "sym": "[(56-16)/30, (56+16)/30]"}, {"tex": "&= \\frac43 \\text{ or } \\frac{12}{5}", "sym": "[Rational(4,3), Rational(12,5)]"}]}], "final": "m = \\frac43 \\text{ or } m = \\frac{12}{5}"}]}]