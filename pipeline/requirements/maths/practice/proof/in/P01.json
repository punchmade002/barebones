[{"id": "practice-alg-poly-multiply-3", "skill": "Multiply polynomials", "problem": {"question": "Show that $(x - 2)(x + 2)(x^2 + 4) = x^4 - 16$.", "level": "higher", "marks": 5, "workedSolution": {"steps": [{"title": "Multiply the first two brackets", "lines": [{"tex": "(x-2)(x+2) &= x^2 + 2x - 2x - 4", "sym": "Eq((x-2)*(x+2), x**2+2*x-2*x-4)"}, {"tex": "&= x^2 - 4", "sym": "Eq((x-2)*(x+2), x**2-4)"}]}, {"title": "Multiply the result by the third bracket", "lines": [{"tex": "(x-2)(x+2)(x^2+4) &= (x^2-4)(x^2+4)", "sym": "Eq((x-2)*(x+2)*(x**2+4), (x**2-4)*(x**2+4))", "new": true}, {"tex": "&= x^4 + 4x^2 - 4x^2 - 16", "sym": "Eq((x-2)*(x+2)*(x**2+4), x**4+4*x**2-4*x**2-16)"}, {"tex": "&= x^4 - 16", "sym": "Eq((x-2)*(x+2)*(x**2+4), x**4-16)"}]}], "finalAnswer": "x^4 - 16"}, "finalSym": "0", "answerSym": "simplify(expand((x - 2)*(x + 2)*(x**2 + 4)) - (x**4 - 16))"}}, {"id": "practice-ineq-prove-1", "skill": "Prove an algebraic inequality", "problem": {"question": "Prove that $a^2 + b^2 \\ge 2ab$ for all $a, b \\in \\mathbb{R}$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Look at the difference of the two sides", "lines": [{"text": "It is enough to show that $a^2 + b^2 - 2ab \\ge 0$."}]}, {"title": "Recognise a perfect square", "lines": [{"tex": "a^2 + b^2 - 2ab &= (a - b)^2", "sym": "Eq(a**2 + b**2 - 2*a*b, (a-b)**2)"}]}, {"title": "A square is never negative", "lines": [{"text": "For any real $a, b$, $(a-b)^2 \\ge 0$."}, {"tex": "a^2 + b^2 - 2ab &\\ge 0"}]}, {"title": "Conclude", "lines": [{"text": "Hence $a^2 + b^2 \\ge 2ab$ for all real $a$ and $b$."}]}], "finalAnswer": "a^2 + b^2 \\ge 2ab"}, "finalSym": "0", "answerSym": "simplify(a**2 + b**2 - 2*a*b - (a-b)**2)"}}, {"id": "practice-ineq-prove-2", "skill": "Prove an algebraic inequality", "problem": {"question": "Prove that $(a + b)^2 \\le 2(a^2 + b^2)$ for all $a, b \\in \\mathbb{R}$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Form the difference of the two sides", "lines": [{"text": "It is enough to show that $2(a^2+b^2) - (a+b)^2 \\ge 0$."}]}, {"title": "Multiply out the brackets", "lines": [{"tex": "2(a^2 + b^2) - (a+b)^2 &= 2a^2 + 2b^2 - (a^2 + 2ab + b^2)", "sym": "Eq(2*(a**2+b**2) - (a+b)**2, 2*a**2 + 2*b**2 - (a**2 + 2*a*b + b**2))"}, {"tex": "&= a^2 - 2ab + b^2", "sym": "Eq(2*a**2 + 2*b**2 - (a**2 + 2*a*b + b**2), a**2 - 2*a*b + b**2)"}]}, {"title": "Recognise a perfect square", "lines": [{"tex": "a^2 - 2ab + b^2 &= (a - b)^2", "sym": "Eq(a**2 - 2*a*b + b**2, (a-b)**2)"}]}, {"title": "A square is never negative", "lines": [{"text": "$(a-b)^2 \\ge 0$, so $2(a^2+b^2) - (a+b)^2 \\ge 0$. Hence $(a+b)^2 \\le 2(a^2+b^2)$."}]}], "finalAnswer": "(a+b)^2 \\le 2(a^2 + b^2)"}, "finalSym": "0", "answerSym": "expand(2*(a**2 + b**2) - (a+b)**2 - (a-b)**2)"}}, {"id": "practice-ineq-prove-3", "skill": "Prove an algebraic inequality", "problem": {"question": "$a$ and $b$ are positive real numbers. Prove that $\\dfrac{a}{b} + \\dfrac{b}{a} \\ge 2$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Write as a single fraction", "lines": [{"tex": "\\frac{a}{b} + \\frac{b}{a} &= \\frac{a^2 + b^2}{ab}", "sym": "Eq(a/b + b/a, (a**2 + b**2)/(a*b))"}]}, {"title": "Subtract 2 from both sides", "lines": [{"tex": "\\frac{a}{b} + \\frac{b}{a} - 2 &= \\frac{a^2 + b^2 - 2ab}{ab}", "sym": "Eq(a/b + b/a - 2, (a**2 + b**2 - 2*a*b)/(a*b))"}, {"tex": "&= \\frac{(a-b)^2}{ab}", "sym": "Eq((a**2 + b**2 - 2*a*b)/(a*b), (a-b)**2/(a*b))"}]}, {"title": "Check the sign", "lines": [{"text": "$(a-b)^2 \\ge 0$, and $ab > 0$ because $a, b > 0$. So the fraction is $\\ge 0$."}, {"tex": "\\frac{a}{b} + \\frac{b}{a} - 2 &\\ge 0"}]}, {"title": "Conclude", "lines": [{"text": "Hence $\\dfrac{a}{b} + \\dfrac{b}{a} \\ge 2$."}]}], "finalAnswer": "\\frac{a}{b} + \\frac{b}{a} \\ge 2"}, "finalSym": "0", "answerSym": "simplify(a/b + b/a - 2 - (a-b)**2/(a*b))"}}, {"id": "practice-circ-tangent-test-1", "skill": "Show a line is a tangent", "problem": {"question": "Show that the line $4x - 3y + 19 = 0$ is a tangent to the circle $x^2 + y^2 - 6x - 4y - 12 = 0$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Find the centre", "lines": [{"text": "Here $2g = -6$, $2f = -4$ and $c = -12$, so $g = -3$ and $f = -2$."}, {"text": "The centre is $(-g, -f) = (3, 2)$."}]}, {"title": "Find the radius", "lines": [{"tex": "r &= \\sqrt{(-3)^2 + (-2)^2 - (-12)}", "sym": "sqrt((-3)**2 + (-2)**2 - (-12))", "new": true}, {"tex": "&= \\sqrt{25}", "sym": "sqrt(25)"}, {"tex": "&= 5", "sym": "5"}]}, {"title": "Find the distance from the centre to the line", "lines": [{"tex": "d &= \\frac{|4(3) - 3(2) + 19|}{\\sqrt{4^2 + (-3)^2}}", "sym": "Abs(4*3 - 3*2 + 19)/sqrt(4**2 + (-3)**2)", "new": true}, {"tex": "&= \\frac{25}{5}", "sym": "25/5"}, {"tex": "&= 5", "sym": "5"}]}, {"title": "Compare", "lines": [{"text": "The distance from the centre to the line equals the radius, so the line is a tangent."}]}], "finalAnswer": "d = r = 5"}, "finalSym": "0", "answerSym": "Abs(4*3 - 3*2 + 19)/sqrt(4**2 + 3**2) - sqrt(3**2 + 2**2 + 12)"}}, {"id": "practice-circ-tangent-test-2", "skill": "Show a line is a tangent", "problem": {"question": "Show that the line $y = 2x - 9$ is a tangent to the circle $x^2 + y^2 - 2x + 4y = 0$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Find the centre", "lines": [{"text": "Here $2g = -2$, $2f = 4$ and $c = 0$, so $g = -1$ and $f = 2$."}, {"text": "The centre is $(1, -2)$."}]}, {"title": "Find the radius", "lines": [{"tex": "r &= \\sqrt{(-1)^2 + 2^2 - 0}", "sym": "sqrt((-1)**2 + 2**2 - 0)", "new": true}, {"tex": "&= \\sqrt{5}", "sym": "sqrt(5)"}]}, {"title": "Write the line as $ax + by + c = 0$", "lines": [{"tex": "2x - y - 9 &= 0", "sym": "Eq(2*x - y - 9, 0)", "new": true}]}, {"title": "Find the distance from the centre to the line", "lines": [{"tex": "d &= \\frac{|2(1) - (-2) - 9|}{\\sqrt{2^2 + (-1)^2}}", "sym": "Abs(2*1 - (-2) - 9)/sqrt(2**2 + (-1)**2)", "new": true}, {"tex": "&= \\frac{5}{\\sqrt{5}}", "sym": "5/sqrt(5)"}, {"tex": "&= \\sqrt{5}", "sym": "sqrt(5)"}]}, {"title": "Compare", "lines": [{"text": "The distance equals the radius, so the line is a tangent."}]}], "finalAnswer": "d = r = \\sqrt{5}"}, "finalSym": "0", "answerSym": "Abs(2*1 - (-2) - 9)/sqrt(2**2 + 1) - sqrt(1 + 4)"}}, {"id": "practice-circ-tangent-test-3", "skill": "Show a line is a tangent", "problem": {"question": "Show that the line $x + 2y + 10 = 0$ is a tangent to the circle $(x - 2)^2 + (y + 1)^2 = 20$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Read off the centre and radius", "lines": [{"text": "The centre is $(2, -1)$."}, {"tex": "r &= \\sqrt{20}", "sym": "sqrt(20)", "new": true}, {"tex": "&= 2\\sqrt{5}", "sym": "2*sqrt(5)"}]}, {"title": "Find the distance from the centre to the line", "lines": [{"tex": "d &= \\frac{|2 + 2(-1) + 10|}{\\sqrt{1^2 + 2^2}}", "sym": "Abs(2 + 2*(-1) + 10)/sqrt(1**2 + 2**2)", "new": true}, {"tex": "&= \\frac{10}{\\sqrt{5}}", "sym": "10/sqrt(5)"}, {"tex": "&= 2\\sqrt{5}", "sym": "2*sqrt(5)"}]}, {"title": "Compare", "lines": [{"text": "The distance equals the radius, so the line is a tangent."}]}], "finalAnswer": "d = r = 2\\sqrt{5}"}, "finalSym": "0", "answerSym": "Abs(2 + 2*(-1) + 10)/sqrt(1**2 + 2**2) - sqrt(20)"}}, {"id": "practice-line-collinear-1", "skill": "Show points are collinear", "problem": {"question": "Show that the points $P(-2, 5)$, $Q(1, 2)$ and $R(4, -1)$ are collinear.", "level": "ordinary", "marks": 10, "workedSolution": {"steps": [{"title": "Find the slope of PQ", "lines": [{"text": "Slope formula for $P(-2,5)$ and $Q(1,2)$."}, {"tex": "m_{PQ} &= \\frac{2-5}{1-(-2)}", "sym": "(2-5)/(1-(-2))", "new": true}, {"tex": "&= \\frac{-3}{3}", "sym": "Rational(-3,3)"}, {"tex": "&= -1", "sym": "-1"}]}, {"title": "Find the slope of QR", "lines": [{"text": "Slope formula for $Q(1,2)$ and $R(4,-1)$."}, {"tex": "m_{QR} &= \\frac{-1-2}{4-1}", "sym": "(-1-2)/(4-1)", "new": true}, {"tex": "&= \\frac{-3}{3}", "sym": "Rational(-3,3)"}, {"tex": "&= -1", "sym": "-1"}]}, {"title": "Compare the slopes", "lines": [{"text": "$m_{PQ} = m_{QR} = -1$, and $Q$ is on both segments, so $P$, $Q$ and $R$ lie on one line."}]}], "finalAnswer": "m_{PQ} = m_{QR} = -1 \\text{, so } P, Q, R \\text{ are collinear}"}, "finalSym": "0", "answerSym": "Rational(2-5,1-(-2)) - Rational(-1-2,4-1)"}}, {"id": "practice-line-collinear-2", "skill": "Show points are collinear", "problem": {"question": "Show that the points $A(-3, -2)$, $B(1, 0)$ and $C(9, 4)$ are collinear.", "level": "ordinary", "marks": 10, "workedSolution": {"steps": [{"title": "Find the slope of AB", "lines": [{"text": "Slope formula for $A(-3,-2)$ and $B(1,0)$."}, {"tex": "m_{AB} &= \\frac{0-(-2)}{1-(-3)}", "sym": "(0-(-2))/(1-(-3))", "new": true}, {"tex": "&= \\frac{2}{4}", "sym": "Rational(2,4)"}, {"tex": "&= \\frac12", "sym": "Rational(1,2)"}]}, {"title": "Find the slope of BC", "lines": [{"text": "Slope formula for $B(1,0)$ and $C(9,4)$."}, {"tex": "m_{BC} &= \\frac{4-0}{9-1}", "sym": "(4-0)/(9-1)", "new": true}, {"tex": "&= \\frac{4}{8}", "sym": "Rational(4,8)"}, {"tex": "&= \\frac12", "sym": "Rational(1,2)"}]}, {"title": "Compare the slopes", "lines": [{"text": "$m_{AB} = m_{BC} = \\frac12$, and $B$ is on both segments, so $A$, $B$ and $C$ lie on one line."}]}], "finalAnswer": "m_{AB} = m_{BC} = \\tfrac12 \\text{, so } A, B, C \\text{ are collinear}"}, "finalSym": "0", "answerSym": "Rational(0-(-2),1-(-3)) - Rational(4-0,9-1)"}}, {"id": "practice-cx-conjugate-properties-2", "skill": "Use conjugates of sums and products", "problem": {"question": "Let $z_1 = a + bi$ and $z_2 = c + di$, where $a, b, c, d \\in \\mathbb{R}$.\nProve that $\\overline{z_1 + z_2} = \\overline{z_1} + \\overline{z_2}$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Add z₁ and z₂", "lines": [{"tex": "z_1 + z_2 &= (a + bi) + (c + di)", "sym": "(a+b*I)+(c+d*I)"}, {"tex": "&= (a + c) + (b + d)i", "sym": "(a+c)+(b+d)*I"}]}, {"title": "Conjugate the sum", "lines": [{"text": "Change the sign of the imaginary part."}, {"tex": "\\overline{z_1 + z_2} &= (a + c) - (b + d)i", "sym": "(a+c)-(b+d)*I", "new": true}]}, {"title": "Conjugate each number first", "lines": [{"tex": "\\overline{z_1} &= a - bi", "sym": "a-b*I", "new": true}, {"tex": "\\overline{z_2} &= c - di", "sym": "c-d*I", "new": true}]}, {"title": "Add the conjugates", "lines": [{"tex": "\\overline{z_1} + \\overline{z_2} &= (a - bi) + (c - di)", "sym": "(a-b*I)+(c-d*I)", "new": true}, {"tex": "&= (a + c) - (b + d)i", "sym": "(a+c)-(b+d)*I"}]}, {"title": "Compare", "lines": [{"text": "Both equal $(a + c) - (b + d)i$, so the two sides are equal for all $z_1, z_2$."}]}], "finalAnswer": "\\overline{z_1 + z_2} = \\overline{z_1} + \\overline{z_2}"}, "finalSym": "0", "answerSym": "expand(((a+c)-(b+d)*I) - ((a-b*I)+(c-d*I)))"}}]