[{"id": "practice-seq-derive-sum-infinity-3", "skill": "Derive S∞ as the limit of partial sums", "problem": {"question": "Let $S_n = a + ar + ar^2 + \\dots + ar^{n-1}$.\nBy multiplying $S_n$ by $r$ and subtracting, prove that $S_n = \\frac{a(1-r^n)}{1-r}$ for $r \\neq 1$, and deduce that $S_\\infty = \\frac{a}{1-r}$ when $|r| < 1$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Multiply $S_n$ by $r$", "lines": [{"tex": "rS_n &= ar + ar^2 + \\dots + ar^{n-1} + ar^n"}]}, {"title": "Subtract: all middle terms cancel", "lines": [{"tex": "S_n - rS_n &= a - ar^n", "sym": "a - a*r**n", "new": true}, {"tex": "S_n(1-r) &= a(1-r^n)", "sym": "a*(1-r**n)"}]}, {"title": "Divide by $1 - r$ (so $r \\neq 1$)", "lines": [{"tex": "S_n &= \\frac{a(1-r^n)}{1-r}", "sym": "a*(1-r**n)/(1-r)", "new": true}]}, {"title": "Let $n \\to \\infty$ when $|r| < 1$", "lines": [{"text": "Then $r^n \\to 0$, so $1 - r^n \\to 1$."}, {"tex": "S_\\infty &= \\frac{a}{1-r}", "sym": "a/(1-r)", "new": true}]}], "finalAnswer": "S_n = \\frac{a(1-r^n)}{1-r}, \\quad S_\\infty = \\frac{a}{1-r}"}, "finalSym": "0", "answerSym": "simplify(a*(1-r**n)/(1-r)*(1-r) - a*(1-r**n))"}}, {"id": "practice-stat-distribution-shape-3", "skill": "Describe a distribution's shape", "problem": {"question": "Eleven students recorded the hours they spent online in a week:\n$4, 5, 6, 6, 7, 7, 7, 8, 8, 9, 10$\nThe dot plot is symmetric about the middle value. Find the mean minus the median.", "level": "ordinary", "marks": 5, "workedSolution": {"steps": [{"title": "Find the mean", "lines": [{"tex": "\\text{mean} &= \\frac{77}{11}", "sym": "Rational(4+5+6+6+7+7+7+8+8+9+10,11)", "new": true}, {"tex": "&= 7", "sym": "7"}]}, {"title": "Find the median", "lines": [{"text": "There are 11 values, so the median is the 6th value."}, {"tex": "\\text{median} &= 7", "sym": "7", "new": true}]}, {"title": "Subtract", "lines": [{"tex": "7 - 7 &= 0", "sym": "7 - 7", "new": true}, {"text": "The mean equals the median, as expected for a symmetric distribution."}]}], "finalAnswer": "0"}, "finalSym": "0", "answerSym": "Rational(4+5+6+6+7+7+7+8+8+9+10,11) - 7"}}, {"id": "practice-trig-derive-1-1", "skill": "Derive formula 1: cos²A + sin²A = 1", "problem": {"question": "$P$ is a point on the unit circle with centre $O$, in the first quadrant. $OP$ makes an angle $A$ with the positive $x$-axis, and $N$ is the foot of the perpendicular from $P$ to the $x$-axis.\nUse the definitions of $\\cos A$ and $\\sin A$ and Pythagoras' theorem to prove that $\\cos^2 A + \\sin^2 A = 1$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Read off the sides of the triangle", "lines": [{"text": "In right-angled triangle $ONP$, the hypotenuse $OP$ is a radius, so $OP = 1$."}, {"tex": "ON &= \\cos A"}, {"tex": "NP &= \\sin A"}]}, {"title": "Apply Pythagoras", "lines": [{"tex": "ON^2 + NP^2 &= OP^2"}, {"tex": "\\cos^2 A + \\sin^2 A &= 1^2"}]}, {"title": "Conclude", "lines": [{"tex": "\\cos^2 A + \\sin^2 A &= 1", "sym": "Eq(cos(A)**2 + sin(A)**2, 1)"}]}], "finalAnswer": "\\cos^2 A + \\sin^2 A = 1"}, "finalSym": "0", "answerSym": "simplify(cos(pi/6)**2 + sin(pi/6)**2 - 1)"}}, {"id": "practice-trig-derive-1-2", "skill": "Derive formula 1: cos²A + sin²A = 1", "problem": {"question": "A right-angled triangle has legs of length $a$ and $b$ and hypotenuse $c$. The angle $A$ is opposite the side of length $a$.\nUse the definitions of $\\sin A$ and $\\cos A$ and Pythagoras' theorem to prove that $\\cos^2 A + \\sin^2 A = 1$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Write the ratios", "lines": [{"tex": "\\sin A &= \\frac{a}{c}"}, {"tex": "\\cos A &= \\frac{b}{c}"}]}, {"title": "Square and add", "lines": [{"tex": "\\cos^2 A + \\sin^2 A &= \\frac{b^2}{c^2} + \\frac{a^2}{c^2}"}, {"tex": "&= \\frac{a^2 + b^2}{c^2}", "sym": "Eq(b**2/c**2 + a**2/c**2, (a**2 + b**2)/c**2)"}]}, {"title": "Use Pythagoras", "lines": [{"text": "Pythagoras gives $a^2 + b^2 = c^2$."}, {"tex": "\\cos^2 A + \\sin^2 A &= \\frac{c^2}{c^2}"}, {"tex": "&= 1", "sym": "Eq(c**2/c**2, 1)"}]}], "finalAnswer": "\\cos^2 A + \\sin^2 A = 1"}, "finalSym": "0", "answerSym": "Rational(3, 5)**2 + Rational(4, 5)**2 - 1"}}, {"id": "practice-trig-derive-1-3", "skill": "Derive formula 1: cos²A + sin²A = 1", "problem": {"question": "$P(x, y)$ is a point on the unit circle with centre $O$, with $x < 0$ and $y > 0$. $OP$ makes an angle $A$ with the positive $x$-axis, where $90^\\circ < A < 180^\\circ$.\nUsing the unit circle definitions of $\\cos A$ and $\\sin A$ and Pythagoras' theorem, prove that $\\cos^2 A + \\sin^2 A = 1$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "State the definitions", "lines": [{"tex": "\\cos A &= x"}, {"tex": "\\sin A &= y"}]}, {"title": "Make a right-angled triangle", "lines": [{"text": "Let $N$ be the foot of the perpendicular from $P$ to the $x$-axis. Then $ON = -x$ (a length, since $x < 0$), $NP = y$ and $OP = 1$."}, {"tex": "(-x)^2 + y^2 &= 1^2"}]}, {"title": "Remove the sign", "lines": [{"tex": "(-x)^2 &= x^2", "sym": "Eq((-x)**2, x**2)"}, {"tex": "x^2 + y^2 &= 1"}]}, {"title": "Substitute the definitions", "lines": [{"tex": "\\cos^2 A + \\sin^2 A &= 1", "sym": "Eq(cos(A)**2 + sin(A)**2, 1)"}]}], "finalAnswer": "\\cos^2 A + \\sin^2 A = 1"}, "finalSym": "0", "answerSym": "simplify(cos(2*pi/3)**2 + sin(2*pi/3)**2 - 1)"}}, {"id": "practice-trig-derive-2-1", "skill": "Derive formula 2: the sine rule", "problem": {"question": "In triangle $ABC$ the sides opposite $A$, $B$, $C$ are $a$, $b$, $c$.\nUse the area formula $\\tfrac{1}{2}ab\\sin C$ to prove that $\\dfrac{a}{\\sin A} = \\dfrac{b}{\\sin B}$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Write the area in two ways", "lines": [{"tex": "\\text{Area} &= \\tfrac{1}{2}bc\\sin A"}, {"tex": "\\text{Area} &= \\tfrac{1}{2}ac\\sin B"}]}, {"title": "Equate and cancel", "lines": [{"tex": "\\tfrac{1}{2}bc\\sin A &= \\tfrac{1}{2}ac\\sin B"}, {"text": "Multiply by $2$ and divide by $c$."}, {"tex": "\\frac{\\tfrac{1}{2}bc\\sin A}{\\tfrac{1}{2}c} &= b\\sin A", "sym": "Eq((b*c*sin(A)/2)/(c/2), b*sin(A))", "new": true}, {"tex": "b\\sin A &= a\\sin B"}]}, {"title": "Divide by $\\sin A\\sin B$", "lines": [{"tex": "\\frac{b}{\\sin B} &= \\frac{a}{\\sin A}"}]}], "finalAnswer": "\\frac{a}{\\sin A} = \\frac{b}{\\sin B}"}, "finalSym": "0", "answerSym": "Rational(3, 5)/3 - Rational(4, 5)/4"}}, {"id": "practice-trig-derive-2-2", "skill": "Derive formula 2: the sine rule", "problem": {"question": "In triangle $ABC$ the sides opposite $A$, $B$, $C$ are $a$, $b$, $c$.\nUse the area formula $\\tfrac{1}{2}ab\\sin C$ to prove that $\\dfrac{b}{\\sin B} = \\dfrac{c}{\\sin C}$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Write the area in two ways", "lines": [{"tex": "\\text{Area} &= \\tfrac{1}{2}ab\\sin C"}, {"tex": "\\text{Area} &= \\tfrac{1}{2}ac\\sin B"}]}, {"title": "Equate and cancel", "lines": [{"tex": "\\tfrac{1}{2}ab\\sin C &= \\tfrac{1}{2}ac\\sin B"}, {"text": "Multiply by $2$ and divide by $a$."}, {"tex": "\\frac{\\tfrac{1}{2}ab\\sin C}{\\tfrac{1}{2}a} &= b\\sin C", "sym": "Eq((a*b*sin(C)/2)/(a/2), b*sin(C))", "new": true}, {"tex": "b\\sin C &= c\\sin B"}]}, {"title": "Divide by $\\sin B\\sin C$", "lines": [{"tex": "\\frac{b}{\\sin B} &= \\frac{c}{\\sin C}"}]}], "finalAnswer": "\\frac{b}{\\sin B} = \\frac{c}{\\sin C}"}, "finalSym": "0", "answerSym": "4/(Rational(4, 5)) - 5/1"}}, {"id": "practice-trig-derive-2-3", "skill": "Derive formula 2: the sine rule", "problem": {"question": "In triangle $ABC$ the sides opposite $A$, $B$, $C$ are $a$, $b$, $c$.\nBy writing the area of the triangle in three ways, prove the sine rule: $\\dfrac{\\sin A}{a} = \\dfrac{\\sin B}{b} = \\dfrac{\\sin C}{c}$.", "level": "higher", "marks": 15, "workedSolution": {"steps": [{"title": "Write the area in three ways", "lines": [{"tex": "\\text{Area} &= \\tfrac{1}{2}bc\\sin A"}, {"tex": "\\text{Area} &= \\tfrac{1}{2}ac\\sin B"}, {"tex": "\\text{Area} &= \\tfrac{1}{2}ab\\sin C"}]}, {"title": "Equate them", "lines": [{"tex": "\\tfrac{1}{2}bc\\sin A &= \\tfrac{1}{2}ac\\sin B = \\tfrac{1}{2}ab\\sin C"}]}, {"title": "Divide each by $\\tfrac{1}{2}abc$", "lines": [{"tex": "\\frac{\\tfrac{1}{2}bc\\sin A}{\\tfrac{1}{2}abc} &= \\frac{\\sin A}{a}", "sym": "Eq((b*c*sin(A)/2)/(a*b*c/2), sin(A)/a)", "new": true}, {"tex": "\\frac{\\tfrac{1}{2}ac\\sin B}{\\tfrac{1}{2}abc} &= \\frac{\\sin B}{b}", "sym": "Eq((a*c*sin(B)/2)/(a*b*c/2), sin(B)/b)", "new": true}, {"tex": "\\frac{\\tfrac{1}{2}ab\\sin C}{\\tfrac{1}{2}abc} &= \\frac{\\sin C}{c}", "sym": "Eq((a*b*sin(C)/2)/(a*b*c/2), sin(C)/c)", "new": true}]}, {"title": "Conclude", "lines": [{"tex": "\\frac{\\sin A}{a} &= \\frac{\\sin B}{b} = \\frac{\\sin C}{c}"}]}], "finalAnswer": "\\frac{\\sin A}{a} = \\frac{\\sin B}{b} = \\frac{\\sin C}{c}"}, "finalSym": "0", "answerSym": "Rational(5, 13)/5 - Rational(1, 13)/1"}}, {"id": "practice-trig-products-sums-1", "skill": "Apply product-to-sum and sum-to-product formulae (17–24)", "problem": {"question": "Show that $\\dfrac{\\sin 5x + \\sin x}{\\cos 5x + \\cos x} = \\tan 3x$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Write the sum-to-product formulae", "lines": [{"tex": "\\sin P + \\sin Q &= 2\\sin\\frac{P + Q}{2}\\cos\\frac{P - Q}{2}"}, {"tex": "\\cos P + \\cos Q &= 2\\cos\\frac{P + Q}{2}\\cos\\frac{P - Q}{2}"}]}, {"title": "Apply them with $P = 5x$, $Q = x$", "lines": [{"tex": "\\frac{\\sin 5x + \\sin x}{\\cos 5x + \\cos x} &= \\frac{2\\sin 3x\\cos 2x}{2\\cos 3x\\cos 2x}", "sym": "Eq((sin(5*x) + sin(x))/(cos(5*x) + cos(x)), 2*sin(3*x)*cos(2*x)/(2*cos(3*x)*cos(2*x)))"}]}, {"title": "Cancel the common factor", "lines": [{"text": "Divide top and bottom by $2\\cos 2x$."}, {"tex": "\\frac{2\\sin 3x\\cos 2x}{2\\cos 3x\\cos 2x} &= \\frac{\\sin 3x}{\\cos 3x}", "sym": "Eq(2*sin(3*x)*cos(2*x)/(2*cos(3*x)*cos(2*x)), sin(3*x)/cos(3*x))", "new": true}, {"tex": "&= \\tan 3x", "sym": "Eq(sin(3*x)/cos(3*x), tan(3*x))", "new": true}]}], "finalAnswer": "\\frac{\\sin 5x + \\sin x}{\\cos 5x + \\cos x} = \\tan 3x"}, "finalSym": "0", "answerSym": "simplify(((sin(5*x) + sin(x))/(cos(5*x) + cos(x)) - tan(3*x)).rewrite(exp))"}}, {"id": "practice-trig-derive-3-1", "skill": "Derive formula 3: the cosine rule", "problem": {"question": "In triangle $ABC$, let $a = |BC|$, $b = |CA|$ and $c = |AB|$. The angle $A$ is acute. $D$ is the foot of the perpendicular from $C$ to $AB$, and $D$ lies between $A$ and $B$.\nProve that $a^2 = b^2 + c^2 - 2bc\\cos A$.", "level": "higher", "marks": 15, "workedSolution": {"steps": [{"title": "Find $CD$ and $AD$ in triangle $ACD$", "lines": [{"text": "Triangle $ACD$ is right-angled at $D$ and its hypotenuse is $AC = b$."}, {"tex": "AD &= b\\cos A", "sym": "Eq(AD, b*cos(A))", "new": true}, {"tex": "CD &= b\\sin A", "sym": "Eq(CD, b*sin(A))", "new": true}]}, {"title": "Find $DB$", "lines": [{"text": "$D$ lies between $A$ and $B$, so $DB = AB - AD$."}, {"tex": "DB &= c - b\\cos A", "sym": "Eq(DB, c - b*cos(A))", "new": true}]}, {"title": "Apply Pythagoras in triangle $BDC$", "lines": [{"tex": "a^2 &= CD^2 + DB^2", "sym": "Eq(a**2, CD**2 + DB**2)", "new": true}, {"tex": "&= (b\\sin A)^2 + (c - b\\cos A)^2", "sym": "Eq(a**2, (b*sin(A))**2 + (c - b*cos(A))**2)", "new": true}]}, {"title": "Expand the brackets", "lines": [{"tex": "a^2 &= b^2\\sin^2 A + c^2 - 2bc\\cos A + b^2\\cos^2 A", "sym": "Eq(a**2, b**2*sin(A)**2 + c**2 - 2*b*c*cos(A) + b**2*cos(A)**2)"}, {"tex": "&= b^2(\\sin^2 A + \\cos^2 A) + c^2 - 2bc\\cos A", "sym": "Eq(a**2, b**2*(sin(A)**2 + cos(A)**2) + c**2 - 2*b*c*cos(A))"}]}, {"title": "Use $\\cos^2 A + \\sin^2 A = 1$", "lines": [{"tex": "a^2 &= b^2 + c^2 - 2bc\\cos A", "sym": "Eq(a**2, b**2 + c**2 - 2*b*c*cos(A))"}]}], "finalAnswer": "a^2 = b^2 + c^2 - 2bc\\cos A"}, "finalSym": "0", "answerSym": "simplify((c - b*cos(A))**2 + (0 - b*sin(A))**2 - (b**2 + c**2 - 2*b*c*cos(A)))"}}]