[{"id": "practice-induction-geo-sum-1", "skill": "Prove the finite geometric series sum by induction", "problem": {"question": "Prove by induction that, for $r \\neq 1$ and all $n \\in \\mathbb{N}$,\n$a + ar + ar^2 + \\cdots + ar^{n-1} = \\dfrac{a(1 - r^n)}{1 - r}$.", "level": "higher", "marks": 15, "workedSolution": {"steps": [{"title": "Step P(1): test n = 1", "lines": [{"tex": "\\text{LHS} &= a", "sym": "a", "new": true}, {"tex": "\\text{RHS} &= \\frac{a(1 - r)}{1 - r} = a", "sym": "a*(1 - r)/(1 - r)"}, {"text": "LHS = RHS, so $P(1)$ is true."}]}, {"title": "Step P(k): assume true for n = k", "lines": [{"text": "Assume $a + ar + \\cdots + ar^{k-1} = \\dfrac{a(1 - r^k)}{1 - r}$."}]}, {"title": "Step P(k+1): state what must be proved", "lines": [{"text": "Show $a + ar + \\cdots + ar^{k-1} + ar^k = \\dfrac{a(1 - r^{k+1})}{1 - r}$."}]}, {"title": "Use P(k) on the left-hand side", "lines": [{"text": "Replace $a + \\cdots + ar^{k-1}$ using the assumption $P(k)$."}, {"tex": "\\text{LHS} &= \\frac{a(1 - r^k)}{1 - r} + ar^k", "sym": "a*(1 - r**k)/(1 - r) + a*r**k", "new": true}, {"tex": "&= \\frac{a(1 - r^k) + ar^k(1 - r)}{1 - r}", "sym": "(a*(1 - r**k) + a*r**k*(1 - r))/(1 - r)"}]}, {"title": "Expand and simplify the numerator", "lines": [{"tex": "&= \\frac{a - ar^k + ar^k - ar^{k+1}}{1 - r}", "sym": "(a - a*r**k + a*r**k - a*r**(k+1))/(1 - r)"}, {"tex": "&= \\frac{a(1 - r^{k+1})}{1 - r}", "sym": "a*(1 - r**(k+1))/(1 - r)"}, {"tex": "&= \\text{RHS}"}]}, {"title": "Conclude", "lines": [{"text": "$P(k+1)$ is true whenever $P(k)$ is true, and $P(1)$ is true. So the formula is true for all $n \\in \\mathbb{N}$."}]}], "finalAnswer": "a + ar + \\cdots + ar^{n-1} = \\frac{a(1 - r^n)}{1 - r}"}, "finalSym": "0", "answerSym": "simplify(summation(a*r**j, (j, 0, 4)) - a*(1 - r**5)/(1 - r))"}}, {"id": "practice-induction-geo-sum-2", "skill": "Prove the finite geometric series sum by induction", "problem": {"question": "Prove by induction that\n$3 + 6 + 12 + \\cdots + 3\\cdot 2^{n-1} = 3(2^n - 1)$\nfor all $n \\in \\mathbb{N}$.", "level": "higher", "marks": 15, "workedSolution": {"steps": [{"title": "Step P(1): test n = 1", "lines": [{"tex": "\\text{LHS} &= 3", "sym": "3", "new": true}, {"tex": "\\text{RHS} &= 3(2^1 - 1) = 3", "sym": "3*(2**1 - 1)"}, {"text": "LHS = RHS, so $P(1)$ is true."}]}, {"title": "Step P(k): assume true for n = k", "lines": [{"text": "Assume $3 + 6 + \\cdots + 3\\cdot 2^{k-1} = 3(2^k - 1)$."}]}, {"title": "Step P(k+1): state what must be proved", "lines": [{"text": "Show $3 + 6 + \\cdots + 3\\cdot 2^{k-1} + 3\\cdot 2^k = 3(2^{k+1} - 1)$."}]}, {"title": "Use P(k) on the left-hand side", "lines": [{"text": "Replace $3 + \\cdots + 3\\cdot 2^{k-1}$ using the assumption $P(k)$."}, {"tex": "\\text{LHS} &= 3(2^k - 1) + 3\\cdot 2^k", "sym": "3*(2**k - 1) + 3*2**k", "new": true}]}, {"title": "Factor out 3", "lines": [{"tex": "&= 3(2^k - 1 + 2^k)", "sym": "3*(2**k - 1 + 2**k)"}, {"tex": "&= 3(2\\cdot 2^k - 1)", "sym": "3*(2*2**k - 1)"}, {"tex": "&= 3(2^{k+1} - 1)", "sym": "3*(2**(k+1) - 1)"}, {"tex": "&= \\text{RHS}"}]}, {"title": "Conclude", "lines": [{"text": "$P(k+1)$ is true whenever $P(k)$ is true, and $P(1)$ is true. So the formula is true for all $n \\in \\mathbb{N}$."}]}], "finalAnswer": "3 + 6 + 12 + \\cdots + 3\\cdot 2^{n-1} = 3(2^n - 1)"}, "finalSym": "0", "answerSym": "simplify(summation(3*2**(j-1), (j, 1, 6)) - 3*(2**6 - 1))"}}, {"id": "practice-induction-geo-sum-3", "skill": "Prove the finite geometric series sum by induction", "problem": {"question": "Prove by induction that\n$1 + \\dfrac{1}{2} + \\dfrac{1}{4} + \\cdots + \\left(\\dfrac{1}{2}\\right)^{n-1} = 2 - \\left(\\dfrac{1}{2}\\right)^{n-1}$\nfor all $n \\in \\mathbb{N}$.", "level": "higher", "marks": 15, "workedSolution": {"steps": [{"title": "Step P(1): test n = 1", "lines": [{"tex": "\\text{LHS} &= 1", "sym": "1", "new": true}, {"tex": "\\text{RHS} &= 2 - \\left(\\tfrac{1}{2}\\right)^0 = 2 - 1 = 1", "sym": "2 - (Rational(1,2))**0"}, {"text": "LHS = RHS, so $P(1)$ is true."}]}, {"title": "Step P(k): assume true for n = k", "lines": [{"text": "Assume $1 + \\dfrac{1}{2} + \\cdots + \\left(\\dfrac{1}{2}\\right)^{k-1} = 2 - \\left(\\dfrac{1}{2}\\right)^{k-1}$."}]}, {"title": "Step P(k+1): state what must be proved", "lines": [{"text": "Show $1 + \\dfrac{1}{2} + \\cdots + \\left(\\dfrac{1}{2}\\right)^{k-1} + \\left(\\dfrac{1}{2}\\right)^k = 2 - \\left(\\dfrac{1}{2}\\right)^k$."}]}, {"title": "Use P(k) on the left-hand side", "lines": [{"text": "Replace $1 + \\cdots + \\left(\\frac{1}{2}\\right)^{k-1}$ using the assumption $P(k)$."}, {"tex": "\\text{LHS} &= 2 - \\left(\\tfrac{1}{2}\\right)^{k-1} + \\left(\\tfrac{1}{2}\\right)^k", "sym": "2 - Rational(1,2)**(k-1) + Rational(1,2)**k", "new": true}]}, {"title": "Write $\\left(\\frac{1}{2}\\right)^{k-1}$ as $2\\left(\\frac{1}{2}\\right)^k$ and simplify", "lines": [{"tex": "&= 2 - 2\\left(\\tfrac{1}{2}\\right)^k + \\left(\\tfrac{1}{2}\\right)^k", "sym": "2 - 2*Rational(1,2)**k + Rational(1,2)**k"}, {"tex": "&= 2 - \\left(\\tfrac{1}{2}\\right)^k", "sym": "2 - Rational(1,2)**k"}, {"tex": "&= \\text{RHS}"}]}, {"title": "Conclude", "lines": [{"text": "$P(k+1)$ is true whenever $P(k)$ is true, and $P(1)$ is true. So the formula is true for all $n \\in \\mathbb{N}$."}]}], "finalAnswer": "1 + \\frac{1}{2} + \\cdots + \\left(\\frac{1}{2}\\right)^{n-1} = 2 - \\left(\\frac{1}{2}\\right)^{n-1}"}, "finalSym": "0", "answerSym": "simplify(summation(Rational(1,2)**j, (j, 0, 5)) - (2 - Rational(1,2)**5))"}}, {"id": "practice-induction-divisibility-1", "skill": "Prove a divisibility result by induction", "problem": {"question": "Prove by induction that $7^n - 4^n$ is divisible by 3 for all $n \\in \\mathbb{N}$.", "level": "higher", "marks": 15, "workedSolution": {"steps": [{"title": "Check the statement is true for n = 1", "lines": [{"tex": "7^1 - 4^1 &= 3", "sym": "7**1 - 4**1", "new": true}, {"text": "3 is divisible by 3, so $P(1)$ is true."}]}, {"title": "Assume the statement is true for n = k", "lines": [{"text": "Assume $7^k - 4^k$ is divisible by 3, so $7^k - 4^k = 3M$ for some whole number $M$."}, {"tex": "7^k - 4^k &= 3M", "sym": "Eq(7**k - 4**k, 3*M)", "new": true}, {"tex": "7^k &= 3M + 4^k", "sym": "Eq(7**k, 3*M + 4**k)"}]}, {"title": "Write 7^(k+1) - 4^(k+1) using 7^k and 4^k", "lines": [{"tex": "7^{k+1} - 4^{k+1} &= 7(7^k) - 4(4^k)", "sym": "7*7**k - 4*4**k", "new": true}]}, {"title": "Substitute 7^k = 3M + 4^k", "lines": [{"tex": "7^{k+1} - 4^{k+1} &= 7(3M + 4^k) - 4(4^k)", "sym": "7*(3*M + 4**k) - 4*4**k", "new": true}, {"tex": "&= 21M + 7(4^k) - 4(4^k)", "sym": "21*M + 7*4**k - 4*4**k"}, {"tex": "&= 21M + 3(4^k)", "sym": "21*M + 3*4**k"}]}, {"title": "Factor out 3", "lines": [{"tex": "7^{k+1} - 4^{k+1} &= 3(7M + 4^k)", "sym": "3*(7*M + 4**k)"}, {"text": "$7M + 4^k$ is a whole number, so $7^{k+1} - 4^{k+1}$ is divisible by 3."}]}, {"title": "State the conclusion", "lines": [{"text": "$P(1)$ is true, and if $P(k)$ is true then $P(k+1)$ is true. By induction, $7^n - 4^n$ is divisible by 3 for all $n \\in \\mathbb{N}$."}]}], "finalAnswer": "7^n - 4^n \\text{ is divisible by } 3 \\text{ for all } n \\in \\mathbb{N}"}, "finalSym": "0", "answerSym": "Mod(7**5 - 4**5, 3)"}}, {"id": "practice-induction-inequality-1", "skill": "Prove an inequality by induction", "problem": {"question": "Prove by induction that $n! > 2^n$ for all $n \\in \\mathbb{N}$ with $n \\ge 4$.", "level": "higher", "marks": 15, "workedSolution": {"steps": [{"title": "State what is to be proved", "lines": [{"text": "Let $P(n)$ be the statement $n! > 2^n$, for $n \\ge 4$."}]}, {"title": "Step 1: show P(4) is true", "lines": [{"tex": "4! &= 24", "sym": "Eq(factorial(4), 24)", "new": true}, {"tex": "2^4 &= 16", "sym": "Eq(2**4, 16)", "new": true}, {"text": "$24 > 16$, so $P(4)$ is true."}]}, {"title": "Step 2: assume P(k) is true", "lines": [{"text": "Assume $k! > 2^k$ for some $k \\ge 4$."}]}, {"title": "Step 3: write down what P(k+1) says", "lines": [{"tex": "(k+1)! &> 2^{k+1}"}]}, {"title": "Use (k+1)! = (k+1) k! and the assumption", "lines": [{"tex": "(k+1)! &= (k+1)\\cdot k!", "sym": "Eq(factorial(k+1), (k+1)*factorial(k))", "new": true}, {"tex": "(k+1)\\cdot k! &> (k+1)\\cdot 2^k"}, {"text": "This multiplies both sides of the assumption by $k+1 > 0$."}]}, {"title": "Show (k+1)·2^k is bigger than 2^(k+1)", "lines": [{"text": "Since $k \\ge 4$, $k+1 \\ge 5 > 2$."}, {"tex": "(k+1)\\cdot 2^k &> 2\\cdot 2^k"}, {"tex": "2\\cdot 2^k &= 2^{k+1}", "sym": "Eq(2*2**k, 2**(k+1))", "new": true}, {"tex": "(k+1)! &> 2^{k+1}"}, {"text": "So $P(k+1)$ is true whenever $P(k)$ is true."}]}, {"title": "Step 4: conclusion", "lines": [{"text": "$P(4)$ is true, and $P(k)$ true implies $P(k+1)$ true. By induction, $P(n)$ is true for all $n \\ge 4$, $n \\in \\mathbb{N}$."}]}], "finalAnswer": "n! > 2^n \\text{ for all } n \\ge 4,\\ n \\in \\mathbb{N}"}, "finalSym": "0", "answerSym": "Max(0, 2**4 - factorial(4))"}}, {"id": "practice-induction-inequality-2", "skill": "Prove an inequality by induction", "problem": {"question": "Prove by induction that $2^n > 2n + 1$ for all $n \\in \\mathbb{N}$ with $n \\ge 3$.", "level": "higher", "marks": 15, "workedSolution": {"steps": [{"title": "State what is to be proved", "lines": [{"text": "Let $P(n)$ be the statement $2^n > 2n+1$, for $n \\ge 3$."}]}, {"title": "Step 1: show P(3) is true", "lines": [{"tex": "2^3 &= 8", "sym": "Eq(2**3, 8)", "new": true}, {"tex": "2(3)+1 &= 7", "sym": "Eq(2*3+1, 7)", "new": true}, {"text": "$8 > 7$, so $P(3)$ is true."}]}, {"title": "Step 2: assume P(k) is true", "lines": [{"text": "Assume $2^k > 2k+1$ for some $k \\ge 3$."}]}, {"title": "Step 3: write down what P(k+1) says", "lines": [{"tex": "2^{k+1} &> 2(k+1)+1", "sym": "Eq(2*(k+1)+1, 2*k+3)", "new": true}, {"tex": "2^{k+1} &> 2k+3"}]}, {"title": "Multiply the assumption by 2", "lines": [{"tex": "2\\cdot 2^k &> 2(2k+1)"}, {"tex": "2^{k+1} &> 4k+2", "sym": "Eq(2*2**k, 2**(k+1))", "new": true}]}, {"title": "Show 4k + 2 is bigger than 2k + 3", "lines": [{"tex": "(4k+2) - (2k+3) &= 2k-1", "sym": "Eq((4*k+2) - (2*k+3), 2*k-1)", "new": true}, {"tex": "2k-1 &\\ge 2(3)-1 = 5 > 0", "sym": "Eq(2*3-1, 5)", "new": true}, {"text": "So $4k+2 > 2k+3$ for $k \\ge 3$."}, {"tex": "2^{k+1} &> 4k+2 > 2k+3"}, {"text": "So $P(k+1)$ is true whenever $P(k)$ is true."}]}, {"title": "Step 4: conclusion", "lines": [{"text": "$P(3)$ is true, and $P(k)$ true implies $P(k+1)$ true. By induction, $P(n)$ is true for all $n \\ge 3$, $n \\in \\mathbb{N}$."}]}], "finalAnswer": "2^n > 2n+1 \\text{ for all } n \\ge 3,\\ n \\in \\mathbb{N}"}, "finalSym": "0", "answerSym": "Max(0, (2*3 + 1) - 2**3)"}}, {"id": "practice-proof-root2-irrational-1", "skill": "Prove √2 is irrational by contradiction", "problem": {"question": "Prove by contradiction that $\\sqrt{2}$ is irrational.\nIn your proof, show that if $p^2$ is even then $p$ is even by considering an odd number $p = 2m + 1$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Assume the opposite", "lines": [{"text": "Suppose $\\sqrt{2}$ is rational."}, {"text": "Then $\\sqrt{2} = \\frac{p}{q}$ where $p, q \\in \\mathbb{Z}$, $q \\ne 0$, and $p$, $q$ have no common factor."}]}, {"title": "Clear the fraction", "lines": [{"tex": "2 &= \\frac{p^2}{q^2}", "sym": "Eq(2, p**2/q**2)", "new": true}, {"tex": "p^2 &= 2q^2", "sym": "Eq(p**2, 2*q**2)", "new": true}, {"text": "So $p^2$ is even."}]}, {"title": "Show that an odd p has an odd square", "lines": [{"text": "Let $p = 2m+1$ be odd."}, {"tex": "p^2 &= (2m+1)^2", "sym": "Eq(p**2, (2*m+1)**2)", "new": true}, {"tex": "&= 4m^2 + 4m + 1", "sym": "Eq(p**2, 4*m**2 + 4*m + 1)", "new": true}, {"tex": "&= 2(2m^2 + 2m) + 1", "sym": "Eq(p**2, 2*(2*m**2 + 2*m) + 1)", "new": true}, {"text": "This is odd. So if $p^2$ is even, $p$ cannot be odd, so $p$ is even. Write $p = 2k$."}]}, {"title": "Show q is even", "lines": [{"tex": "2q^2 &= (2k)^2", "sym": "Eq(2*q**2, (2*k)**2)", "new": true}, {"tex": "2q^2 &= 4k^2", "sym": "Eq(2*q**2, 4*k**2)"}, {"tex": "q^2 &= 2k^2", "sym": "Eq(q**2, 2*k**2)"}, {"text": "So $q^2$ is even, and by the same argument $q$ is even."}]}, {"title": "Reach the contradiction", "lines": [{"text": "$p$ and $q$ are both even, so they have a common factor $2$. This contradicts the assumption that they have no common factor."}, {"text": "So $\\sqrt{2}$ is not rational."}]}], "finalAnswer": "\\sqrt{2} \\text{ is irrational}"}, "finalSym": "0", "answerSym": "expand((2*m+1)**2 - (4*m**2 + 4*m + 1))"}}, {"id": "practice-seq-verify-formula-1", "skill": "Verify and justify a formula from a number pattern", "problem": {"question": "Prove by induction that $1 + 4 + 7 + \\dots + (3n - 2) = \\frac{n(3n-1)}{2}$ for all $n \\in \\mathbb{N}$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Test the formula for $n = 1$", "lines": [{"tex": "\\text{LHS} &= 1", "sym": "1", "new": true}, {"tex": "\\text{RHS} &= \\frac{1(3-1)}{2} = 1", "sym": "1"}, {"text": "LHS = RHS, so the formula is true for $n = 1$."}]}, {"title": "Assume it is true for $n = k$", "lines": [{"text": "Assume $1 + 4 + \\dots + (3k-2) = \\frac{k(3k-1)}{2}$."}]}, {"title": "Add the next term for $n = k + 1$", "lines": [{"tex": "S_{k+1} &= \\frac{k(3k-1)}{2} + \\big(3(k+1) - 2\\big)", "sym": "k*(3*k-1)/2 + 3*(k+1) - 2", "new": true}, {"tex": "&= \\frac{k(3k-1) + 2(3k+1)}{2}", "sym": "(k*(3*k-1) + 2*(3*k+1))/2"}, {"tex": "&= \\frac{3k^2 + 5k + 2}{2}", "sym": "(3*k**2 + 5*k + 2)/2"}, {"tex": "&= \\frac{(k+1)(3k+2)}{2}", "sym": "(k+1)*(3*k+2)/2"}]}, {"title": "Compare with the formula at $n = k + 1$", "lines": [{"tex": "\\frac{(k+1)\\big(3(k+1)-1\\big)}{2} &= \\frac{(k+1)(3k+2)}{2}", "sym": "(k+1)*(3*(k+1)-1)/2", "new": true}, {"text": "This matches, so true for $n=k$ implies true for $n=k+1$. By induction the formula holds for all $n \\in \\mathbb{N}$."}]}], "finalAnswer": "1 + 4 + \\dots + (3n-2) = \\frac{n(3n-1)}{2}"}, "finalSym": "0", "answerSym": "simplify(summation(3*k - 2, (k, 1, n)) - n*(3*n - 1)/2)"}}, {"id": "practice-seq-derive-sum-infinity-1", "skill": "Derive S∞ as the limit of partial sums", "problem": {"question": "Given that the sum of the first $n$ terms of a geometric series is $S_n = \\frac{a(1-r^n)}{1-r}$, prove that if $|r| < 1$ then $S_\\infty = \\frac{a}{1-r}$.", "level": "higher", "marks": 10, "workedSolution": {"steps": [{"title": "Split the formula for $S_n$", "lines": [{"tex": "S_n &= \\frac{a(1-r^n)}{1-r}", "sym": "a*(1-r**n)/(1-r)", "new": true}, {"tex": "&= \\frac{a}{1-r} - \\frac{a\\,r^n}{1-r}", "sym": "a/(1-r) - a*r**n/(1-r)"}]}, {"title": "Let $n \\to \\infty$ when $|r| < 1$", "lines": [{"text": "If $|r| < 1$ then $r^n \\to 0$ as $n \\to \\infty$, for example $\\left(\\tfrac12\\right)^n \\to 0$."}, {"tex": "\\frac{a\\,r^n}{1-r} &\\to 0", "sym": "0", "new": true}]}, {"title": "Take the limit", "lines": [{"tex": "S_\\infty &= \\lim_{n \\to \\infty} S_n = \\frac{a}{1-r} - 0", "sym": "a/(1-r)", "new": true}, {"tex": "&= \\frac{a}{1-r}", "sym": "a/(1-r)"}]}], "finalAnswer": "S_\\infty = \\frac{a}{1-r}"}, "finalSym": "0", "answerSym": "simplify(limit(a*(1 - Rational(1,2)**n)/(1 - Rational(1,2)), n, oo) - a/(1 - Rational(1,2)))"}}, {"id": "practice-seq-derive-sum-infinity-2", "skill": "Derive S∞ as the limit of partial sums", "problem": {"question": "A geometric series has first term $6$ and common ratio $\\frac{2}{3}$.\nShow that $S_n = 18\\left(1 - \\left(\\frac{2}{3}\\right)^n\\right)$ and prove that $S_n$ gets closer and closer to $\\frac{a}{1-r}$ as $n \\to \\infty$.", "level": "higher", "marks": 5, "workedSolution": {"steps": [{"title": "Substitute into $S_n$", "lines": [{"tex": "S_n &= \\frac{6\\left(1-\\left(\\frac{2}{3}\\right)^n\\right)}{1 - \\frac{2}{3}}", "sym": "6*(1-Rational(2,3)**n)/(1-Rational(2,3))", "new": true}, {"tex": "&= 18\\left(1 - \\left(\\frac{2}{3}\\right)^n\\right)", "sym": "18*(1-Rational(2,3)**n)"}]}, {"title": "Let $n \\to \\infty$", "lines": [{"text": "Since $\\frac{2}{3} < 1$, $\\left(\\frac{2}{3}\\right)^n \\to 0$."}, {"tex": "S_\\infty &= 18(1 - 0) = 18", "sym": "18", "new": true}]}, {"title": "Compare with $\\frac{a}{1-r}$", "lines": [{"tex": "\\frac{a}{1-r} &= \\frac{6}{1/3} = 18", "sym": "6/(1-Rational(2,3))", "new": true}]}], "finalAnswer": "S_\\infty = 18 = \\frac{a}{1-r}"}, "finalSym": "0", "answerSym": "limit(6*(1 - Rational(2,3)**n)/(1 - Rational(2,3)), n, oo) - 18"}}]