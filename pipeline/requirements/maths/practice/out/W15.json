  "problems": [
   {
    "question": "The circle $x^2 + y^2 = 169$ passes through the point $(5, -12)$.\nFind the slope of the tangent to the circle at this point.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Differentiate both sides with respect to $x$",
       "lines": [
        {
         "tex": "x^2 + y^2 &= 169"
        },
        {
         "text": "Use the chain rule on $y^2$: $\\frac{d}{dx}(y^2) = 2y\\frac{dy}{dx}$."
        },
        {
         "tex": "2x + 2y\\frac{dy}{dx} &= 0"
        }
       ]
      },
      {
       "title": "Solve for $\\frac{dy}{dx}$",
       "lines": [
        {
         "tex": "\\frac{dy}{dx} &= -\\frac{x}{y}",
         "sym": "-x/y",
         "new": true
        }
       ]
      },
      {
       "title": "Substitute $(5, -12)$",
       "lines": [
        {
         "tex": "\\frac{dy}{dx} &= -\\frac{5}{-12}",
         "sym": "-5/(-12)",
         "new": true
        },
        {
         "tex": "&= \\frac{5}{12}",
         "sym": "Rational(5, 12)"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{5}{12}"
    },
    "finalSym": "Rational(5, 12)",
    "answerSym": "-Rational(5, -12)"
   },
   {
    "question": "The circle $(x-1)^2 + (y+2)^2 = 25$ passes through the point $(4, 2)$.\nFind the slope of the tangent to the circle at this point.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Differentiate both sides with respect to $x$",
       "lines": [
        {
         "text": "Use the chain rule on each bracket."
        },
        {
         "tex": "2(x - 1) + 2(y + 2)\\frac{dy}{dx} &= 0"
        }
       ]
      },
      {
       "title": "Solve for $\\frac{dy}{dx}$",
       "lines": [
        {
         "tex": "\\frac{dy}{dx} &= -\\frac{x - 1}{y + 2}",
         "sym": "-(x - 1)/(y + 2)",
         "new": true
        }
       ]
      },
      {
       "title": "Substitute $(4, 2)$",
       "lines": [
        {
         "tex": "\\frac{dy}{dx} &= -\\frac{3}{4}",
         "sym": "-Rational(3, 4)",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "-\\frac{3}{4}"
    },
    "finalSym": "-Rational(3, 4)",
    "answerSym": "-(4 - 1)/(2 + 2)"
   },
   {
