        },
        {
         "tex": "&= 2",
         "sym": "2"
        }
       ]
      }
     ],
     "finalAnswer": "2"
    },
    "finalSym": "2",
    "answerSym": "-(-4)/sqrt(20 - (-4)**2)"
   }
  ]
 },
 {
  "skill": "diff-curve-sketch",
  "problems": [
   {
    "question": "Find the coordinates of the local maximum and the local minimum of the curve $y = x^3 - 6x^2 + 9x$.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Differentiate",
       "lines": [
        {
         "tex": "y &= x^3 - 6x^2 + 9x"
        },
        {
         "tex": "\\frac{dy}{dx} &= 3x^2 - 12x + 9",
         "sym": "3*x**2 - 12*x + 9",
         "new": true
        }
       ]
      },
      {
       "title": "Set $\\frac{dy}{dx} = 0$",
       "lines": [
        {
         "tex": "3x^2 - 12x + 9 &= 0",
         "sym": "Eq(3*x**2 - 12*x + 9, 0)",
         "new": true
        },
        {
         "tex": "x^2 - 4x + 3 &= 0",
         "sym": "Eq(x**2 - 4*x + 3, 0)"
        },
        {
         "tex": "(x - 1)(x - 3) &= 0",
         "sym": "Eq((x - 1)*(x - 3), 0)"
        },
        {
         "tex": "x &= 1 \\quad \\text{or} \\quad x = 3",
         "sym": "Or(Eq(x, 1), Eq(x, 3))"
        }
       ]
      },
      {
       "title": "Find the $y$-values",
       "lines": [
        {
         "tex": "x = 1: \\quad y &= 1 - 6 + 9 = 4",
         "sym": "1 - 6 + 9",
         "new": true
        },
        {
         "tex": "x = 3: \\quad y &= 27 - 54 + 27 = 0",
         "sym": "27 - 54 + 27",
         "new": true
        }
       ]
      },
      {
       "title": "Classify using the second derivative",
       "lines": [
        {
         "tex": "\\frac{d^2y}{dx^2} &= 6x - 12",
         "sym": "6*x - 12",
         "new": true
        },
        {
         "text": "At $x = 1$: $6 - 12 = -6 < 0$, so $(1, 4)$ is a local maximum."
        },
        {
         "text": "At $x = 3$: $18 - 12 = 6 > 0$, so $(3, 0)$ is a local minimum."
        }
       ]
      }
     ],
     "finalAnswer": "\\text{Local max } (1, 4); \\ \\text{local min } (3, 0)"
    },
    "finalSym": "[(1, 4), (3, 0)]",
    "answerSym": "[(solve(diff(x**3 - 6*x**2 + 9*x, x), x)[0], (x**3 - 6*x**2 + 9*x).subs(x, solve(diff(x**3 - 6*x**2 + 9*x, x), x)[0])), (solve(diff(x**3 - 6*x**2 + 9*x, x), x)[1], (x**3 - 6*x**2 + 9*x).subs(x, solve(diff(x**3 - 6*x**2 + 9*x, x), x)[1]))]"
   }
  ]
 },
