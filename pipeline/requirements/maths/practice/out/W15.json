   {
    "question": "$f(x) = 2x^3 - 9x^2 + 12x$.\nFind the values of $x$ for which $f(x)$ is increasing.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Differentiate $f(x)$",
       "lines": [
        {
         "tex": "f(x) &= 2x^3 - 9x^2 + 12x"
        },
        {
         "tex": "f'(x) &= 6x^2 - 18x + 12",
         "sym": "6*x**2 - 18*x + 12",
         "new": true
        }
       ]
      },
      {
       "title": "Set up the inequality $f'(x) > 0$",
       "lines": [
        {
         "tex": "6x^2 - 18x + 12 &> 0",
         "sym": "6*x**2 - 18*x + 12 > 0",
         "new": true
        },
        {
         "tex": "x^2 - 3x + 2 &> 0",
         "sym": "x**2 - 3*x + 2 > 0"
        },
        {
         "tex": "(x - 1)(x - 2) &> 0",
         "sym": "(x - 1)*(x - 2) > 0"
        }
       ]
      },
      {
       "title": "Find the roots",
       "lines": [
        {
         "text": "$(x-1)(x-2) = 0$ gives two roots."
        },
        {
         "tex": "x &= 1 \\quad \\text{or} \\quad x = 2",
         "sym": "Or(Eq(x, 1), Eq(x, 2))",
         "new": true
        }
       ]
      },
      {
       "title": "Choose where $f'(x)$ is positive",
       "lines": [
        {
         "text": "The graph of $x^2 - 3x + 2$ is a U-shape, so it is positive outside the roots."
        },
        {
         "tex": "x &< 1 \\quad \\text{or} \\quad x > 2",
         "sym": "Or(x < 1, x > 2)",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "x < 1 \\ \\text{ or } \\ x > 2"
    },
    "finalSym": "Or(x < 1, x > 2)",
    "answerSym": "solve_univariate_inequality(diff(2*x**3 - 9*x**2 + 12*x, x) > 0, x, relational=True)"
   },
