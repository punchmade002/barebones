   {
    "question": "Find the points where the line $y = x - 1$ meets the circle $x^2 + y^2 - 6x + 2y + 5 = 0$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Substitute $y = x - 1$ into the circle",
       "lines": [
        {
         "tex": "x^2 + (x - 1)^2 - 6x + 2(x - 1) + 5 &= 0",
         "sym": "Eq(x**2 + (x - 1)**2 - 6*x + 2*(x - 1) + 5, 0)",
         "new": true
        }
       ]
      },
      {
       "title": "Collect terms",
       "lines": [
        {
         "tex": "2x^2 - 6x + 4 &= 0",
         "sym": "Eq(2*x**2 - 6*x + 4, 0)"
        },
        {
         "tex": "x^2 - 3x + 2 &= 0",
         "sym": "Eq(x**2 - 3*x + 2, 0)"
        }
       ]
      },
      {
       "title": "Factorise and solve",
       "lines": [
        {
         "tex": "(x - 1)(x - 2) &= 0",
         "sym": "Eq((x - 1)*(x - 2), 0)"
        },
        {
         "tex": "x &= 1 \\text{ or } x = 2",
         "sym": "Or(Eq(x, 1), Eq(x, 2))"
        }
       ]
      },
      {
       "title": "Find the $y$ values using $y = x - 1$",
       "lines": [
        {
         "text": "When $x = 1$, $y = 0$. When $x = 2$, $y = 1$."
        }
       ]
      }
     ],
     "finalAnswer": "(1, 0) \\text{ and } (2, 1)"
    },
    "finalSym": "[(1, 0), (2, 1)]",
    "answerSym": "solve([Eq(y, x - 1), Eq(x**2 + y**2 - 6*x + 2*y + 5, 0)], [x, y])"
   },
