     "steps": [
      {
       "title": "Whole numbers only",
       "lines": [
        {
         "text": "$x \\in \\mathbb{Z}$ means $x$ is a whole number, positive, negative or zero."
        }
       ]
      },
      {
       "title": "Read off the values between $-2.5$ and $1.5$",
       "lines": [
        {
         "text": "The smallest integer above $-2.5$ is $-2$. The largest integer up to $1.5$ is $1$."
        },
        {
         "tex": "x &\\in \\{-2, -1, 0, 1\\}",
         "sym": "[-2, -1, 0, 1]",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "-2, -1, 0, 1"
    },
    "finalSym": "[-2, -1, 0, 1]",
    "answerSym": "sorted(Intersection(Interval.Lopen(Rational(-5,2), Rational(3,2)), Range(-10, 10)))"
   }
  ]
 },
 {
  "skill": "num-prime-factors",
  "problems": [
   {
    "question": "Write 84 and 126 each as a product of prime numbers.\nHence find the highest common factor of 84 and 126.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Factorise 84",
       "lines": [
        {
         "tex": "84 &= 2 \\times 42",
         "sym": "Eq(84, 2*42)"
        },
        {
         "tex": "&= 2 \\times 2 \\times 21",
         "sym": "Eq(84, 2*2*21)"
        },
        {
         "tex": "&= 2^2 \\times 3 \\times 7",
         "sym": "Eq(84, 2**2*3*7)"
        }
       ]
      },
      {
       "title": "Factorise 126",
       "lines": [
        {
         "tex": "126 &= 2 \\times 63",
         "sym": "Eq(126, 2*63)",
         "new": true
        },
        {
         "tex": "&= 2 \\times 3 \\times 21",
         "sym": "Eq(126, 2*3*21)"
        },
        {
         "tex": "&= 2 \\times 3^2 \\times 7",
         "sym": "Eq(126, 2*3**2*7)"
        }
       ]
      },
      {
       "title": "Multiply the primes common to both, using the lower power of each",
       "lines": [
        {
         "text": "Common: $2^1$, $3^1$ and $7^1$."
        },
        {
         "tex": "\\text{HCF} &= 2 \\times 3 \\times 7",
         "sym": "2*3*7",
         "new": true
        },
        {
         "tex": "&= 42",
         "sym": "42"
        }
       ]
      }
     ],
     "finalAnswer": "42"
    },
    "finalSym": "42",
    "answerSym": "gcd(84, 126)"
   }
  ]
 }
]