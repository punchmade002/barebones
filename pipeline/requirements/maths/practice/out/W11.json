   {
    "question": "Write $0.\\dot{3}\\dot{6}$ as a fraction in its simplest form.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Let $x$ equal the decimal and multiply by 100",
       "lines": [
        {
         "text": "$x = 0.363636\\ldots$"
        },
        {
         "text": "$100x = 36.363636\\ldots$"
        }
       ]
      },
      {
       "title": "Subtract to remove the repeating part",
       "lines": [
        {
         "tex": "100x - x &= 36.\\dot{3}\\dot{6} - 0.\\dot{3}\\dot{6}"
        },
        {
         "tex": "99x &= 36",
         "sym": "Eq(100*x-x, 36)",
         "new": true
        }
       ]
      },
      {
       "title": "Solve for $x$ and simplify",
       "lines": [
        {
         "tex": "x &= \\frac{36}{99}",
         "sym": "Eq(x, 36/99)",
         "new": true
        },
        {
         "tex": "&= \\frac{4}{11}",
         "sym": "Eq(x, 4/11)"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{4}{11}"
    },
    "finalSym": "Rational(4,11)",
    "answerSym": "solve(Eq(100*x - x, 36), x)[0]"
   }
  ]
 },
 {
  "skill": "num-sets",
  "problems": [
   {
    "question": "The numbers $-7$, $\\frac{3}{4}$, $\\sqrt{25}$, $\\sqrt{10}$ and $\\frac{-12}{3}$ are given.\nWhich of them belong to $\\mathbb{Z}$ but do not belong to $\\mathbb{N}$?",
    "level": "ordinary",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Simplify each number",
       "lines": [
        {
         "tex": "\\sqrt{25} &= 5",
         "sym": "Eq(sqrt(25), 5)"
        },
        {
         "tex": "\\frac{-12}{3} &= -4",
         "sym": "Eq(-12/3, -4)"
        },
        {
         "text": "$\\frac{3}{4}$ is a fraction and $\\sqrt{10}$ is irrational, so neither is an integer."
        }
       ]
      },
      {
       "title": "Pick out the integers that are not natural numbers",
       "lines": [
        {
         "text": "$5 \\in \\mathbb{N}$, so it is excluded. The negative integers $-7$ and $-4$ are in $\\mathbb{Z}$ but not $\\mathbb{N}$."
        }
       ]
      }
     ],
     "finalAnswer": "-7, -4"
    },
    "finalSym": "[-7, -4]",
    "answerSym": "[-7, Rational(-12,3)]"
   },
   {
