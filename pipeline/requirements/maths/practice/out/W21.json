 {
  "skill": "fn-exp-model",
  "problems": [
   {
    "question": "A radioactive sample has a mass of $80$ g at time $t = 0$.\nAfter $5$ hours its mass is $20$ g.\nThe mass $m$ grams at time $t$ hours is modelled by $m = 80e^{kt}$.\nFind the exact value of $k$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Substitute t = 5 and m = 20",
       "lines": [
        {
         "tex": "20 &= 80e^{5k}",
         "sym": "Eq(20, 80*exp(5*k))",
         "new": true
        }
       ]
      },
      {
       "title": "Isolate the exponential",
       "lines": [
        {
         "tex": "e^{5k} &= \\frac{20}{80}",
         "sym": "Eq(exp(5*k), Rational(20,80))",
         "new": true
        },
        {
         "tex": "e^{5k} &= \\frac14",
         "sym": "Eq(exp(5*k), Rational(1,4))"
        }
       ]
      },
      {
       "title": "Take natural logs of both sides",
       "lines": [
        {
         "tex": "5k &= \\ln\\left(\\tfrac14\\right)",
         "sym": "Eq(5*k, log(Rational(1,4)))",
         "new": true
        },
        {
         "tex": "5k &= -\\ln 4",
         "sym": "Eq(5*k, -log(4))"
        },
        {
         "tex": "k &= -\\frac{\\ln 4}{5}",
         "sym": "Eq(k, -log(4)/5)"
        }
       ]
      },
      {
       "title": "Check with a decimal",
       "lines": [
        {
         "tex": "k &\\approx -0.277",
         "sym": "Eq(k, -0.277)",
         "new": true,
         "approx": true
        },
        {
         "text": "$k$ is negative, as the mass is decreasing."
        }
       ]
      }
     ],
     "finalAnswer": "k = -\\frac{\\ln 4}{5} \\approx -0.277"
    },
    "finalSym": "-log(4)/5",
    "answerSym": "expand_log(log(Rational(20,80))/5, force=True)"
   },
   {
    "question": "The value $V$ of a machine, in euro, $t$ years after it was bought is modelled by $V = a \\cdot b^{t}$, where $a$ and $b$ are positive constants.\nThe machine was worth $\\text{\u20ac}20\\,000$ after $1$ year and $\\text{\u20ac}12\\,800$ after $3$ years.\nFind the value of $a$ and the value of $b$.",
    "level": "higher",
    "marks": 15,
    "workedSolution": {
     "steps": [
      {
       "title": "Write an equation for each data point",
       "lines": [
        {
         "tex": "ab &= 20000",
         "sym": "Eq(a*b, 20000)",
         "new": true
        },
        {
         "tex": "ab^3 &= 12800",
         "sym": "Eq(a*b**3, 12800)",
         "new": true
        }
       ]
      },
      {
       "title": "Divide the second equation by the first",
       "lines": [
        {
         "tex": "\\frac{ab^3}{ab} &= \\frac{12800}{20000}",
         "sym": "Eq(a*b**3/(a*b), Rational(12800,20000))",
         "new": true
        },
        {
         "tex": "b^2 &= 0.64",
         "sym": "Eq(b**2, Rational(16,25))"
        }
       ]
      },
      {
       "title": "Take the positive square root",
       "lines": [
        {
         "tex": "b &= 0.8",
         "sym": "Eq(b, Rational(4,5))",
         "new": true
        }
       ]
      },
      {
       "title": "Substitute b into the first equation",
       "lines": [
        {
         "tex": "a(0.8) &= 20000",
         "sym": "Eq(a*Rational(4,5), 20000)",
         "new": true
        },
        {
         "tex": "a &= \\frac{20000}{0.8}",
         "sym": "Eq(a, 20000/Rational(4,5))"
        },
        {
         "tex": "a &= 25000",
         "sym": "Eq(a, 25000)"
        }
       ]
      }
     ],
     "finalAnswer": "a = 25\\,000, \\quad b = 0.8"
    },
    "finalSym": "(25000, Rational(4,5))",
    "answerSym": "(20000/sqrt(Rational(12800,20000)), sqrt(Rational(12800,20000)))"
   }
  ]
 },
