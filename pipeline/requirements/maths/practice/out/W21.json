   {
    "question": "The straight lines $AB$ and $CD$ intersect at the point $O$.\n$|\\angle AOC| = (3x + 10)^\\circ$ and $|\\angle BOD| = (5x - 30)^\\circ$.\nFind $|\\angle AOD|$.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Use vertically opposite angles",
       "lines": [
        {
         "text": "$\\angle AOC$ and $\\angle BOD$ are vertically opposite, so they are equal."
        },
        {
         "tex": "3x + 10 &= 5x - 30",
         "sym": "Eq(3*x+10, 5*x-30)",
         "new": true
        }
       ]
      },
      {
       "title": "Solve for x",
       "lines": [
        {
         "tex": "40 &= 2x",
         "sym": "Eq(40, 2*x)"
        },
        {
         "tex": "x &= 20",
         "sym": "Eq(x, 20)"
        }
       ]
      },
      {
       "title": "Find the angle AOC",
       "lines": [
        {
         "tex": "|\\angle AOC| &= 3(20) + 10",
         "sym": "3*20+10",
         "new": true
        },
        {
         "tex": "&= 70",
         "sym": "70"
        }
       ]
      },
      {
       "title": "Use the straight line AB",
       "lines": [
        {
         "text": "$\\angle AOC$ and $\\angle AOD$ lie on the straight line $CD$, so they add to $180^\\circ$."
        },
        {
         "tex": "|\\angle AOD| &= 180 - 70",
         "sym": "180-70",
         "new": true
        },
        {
         "tex": "&= 110",
         "sym": "110"
        }
       ]
      }
     ],
     "finalAnswer": "|\\angle AOD| = 110^\\circ"
    },
    "finalSym": "110",
    "answerSym": "180 - (3*x + 10).subs(x, solve(Eq(3*x + 10, 5*x - 30), x)[0])"
   },
   {
