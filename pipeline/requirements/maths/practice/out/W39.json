     "finalAnswer": "\\frac{\\sin 5x + \\sin x}{\\cos 5x + \\cos x} = \\tan 3x"
    },
    "finalSym": "0",
    "answerSym": "simplify(((sin(5*x) + sin(x))/(cos(5*x) + cos(x)) - tan(3*x)).rewrite(exp))"
   },
