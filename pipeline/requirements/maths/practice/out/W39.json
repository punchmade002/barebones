        },
        {
         "tex": "\\cos P + \\cos Q &= 2\\cos\\frac{P + Q}{2}\\cos\\frac{P - Q}{2}"
        }
       ]
      },
      {
       "title": "Apply them with $P = 5x$, $Q = x$",
       "lines": [
        {
         "tex": "\\frac{\\sin 5x + \\sin x}{\\cos 5x + \\cos x} &= \\frac{2\\sin 3x\\cos 2x}{2\\cos 3x\\cos 2x}",
         "sym": "Eq((sin(5*x) + sin(x))/(cos(5*x) + cos(x)), 2*sin(3*x)*cos(2*x)/(2*cos(3*x)*cos(2*x)))"
