  "problems": [
   {
    "question": "Prove by induction that $(\\cos\\theta - i\\sin\\theta)^n = \\cos n\\theta - i\\sin n\\theta$ for all $n \\in \\mathbb{N}$.",
    "level": "higher",
    "marks": 15,
    "workedSolution": {
     "steps": [
      {
       "title": "Test the result for n = 1",
       "lines": [
        {
         "text": "Let $P(n)$ be the statement $(\\cos\\theta - i\\sin\\theta)^n = \\cos n\\theta - i\\sin n\\theta$."
        },
        {
         "tex": "(\\cos\\theta - i\\sin\\theta)^1 &= \\cos\\theta - i\\sin\\theta"
        },
        {
         "text": "So $P(1)$ is true."
        }
       ]
      },
      {
       "title": "Assume the result is true for n = k",
       "lines": [
        {
         "tex": "(\\cos\\theta - i\\sin\\theta)^k &= \\cos k\\theta - i\\sin k\\theta"
        },
        {
         "text": "This is $P(k)$. We now test $P(k+1)$."
        }
       ]
      },
      {
       "title": "Write the (k + 1) power as a product",
       "lines": [
        {
         "tex": "(\\cos\\theta - i\\sin\\theta)^{k+1} &= (\\cos\\theta - i\\sin\\theta)^k(\\cos\\theta - i\\sin\\theta)"
        },
        {
         "tex": "&= (\\cos k\\theta - i\\sin k\\theta)(\\cos\\theta - i\\sin\\theta)"
        }
       ]
      },
      {
       "title": "Multiply out the brackets",
       "lines": [
        {
         "tex": "&= \\cos k\\theta\\cos\\theta - i\\cos k\\theta\\sin\\theta - i\\sin k\\theta\\cos\\theta + i^2\\sin k\\theta\\sin\\theta",
         "sym": "Eq((cos(k*theta) - I*sin(k*theta))*(cos(theta) - I*sin(theta)), cos(k*theta)*cos(theta) - I*cos(k*theta)*sin(theta) - I*sin(k*theta)*cos(theta) + I**2*sin(k*theta)*sin(theta))",
         "new": true
        },
        {
         "text": "Replace $i^2$ with $-1$ and group the real and imaginary parts."
        },
        {
         "tex": "&= [\\cos k\\theta\\cos\\theta - \\sin k\\theta\\sin\\theta] - i[\\cos k\\theta\\sin\\theta + \\sin k\\theta\\cos\\theta]",
         "sym": "Eq(cos(k*theta)*cos(theta) - I*cos(k*theta)*sin(theta) - I*sin(k*theta)*cos(theta) + I**2*sin(k*theta)*sin(theta), (cos(k*theta)*cos(theta) - sin(k*theta)*sin(theta)) - I*(cos(k*theta)*sin(theta) + sin(k*theta)*cos(theta)))",
         "new": true
        }
       ]
      },
      {
       "title": "Use the addition formulas",
       "lines": [
        {
         "text": "$\\cos(A+B) = \\cos A\\cos B - \\sin A\\sin B$ and $\\sin(A+B) = \\sin A\\cos B + \\cos A\\sin B$, with $A = k\\theta$ and $B = \\theta$."
        },
        {
         "tex": "&= \\cos(k\\theta + \\theta) - i\\sin(k\\theta + \\theta)",
         "sym": "Eq((cos(k*theta)*cos(theta) - sin(k*theta)*sin(theta)) - I*(cos(k*theta)*sin(theta) + sin(k*theta)*cos(theta)), cos(k*theta + theta) - I*sin(k*theta + theta))",
         "new": true
        },
        {
         "tex": "&= \\cos(k+1)\\theta - i\\sin(k+1)\\theta"
        },
        {
         "text": "So $P(k+1)$ is true."
        }
       ]
      },
      {
       "title": "State the conclusion",
       "lines": [
        {
         "text": "$P(1)$ is true. If $P(k)$ is true then $P(k+1)$ is true. Hence $P(n)$ is true for all $n \\in \\mathbb{N}$."
        }
       ]
      }
     ],
     "finalAnswer": "(\\cos\\theta - i\\sin\\theta)^n = \\cos n\\theta - i\\sin n\\theta"
    },
    "finalSym": "0",
    "answerSym": "simplify(expand((cos(pi/6) - I*sin(pi/6))**4 - (cos(4*pi/6) - I*sin(4*pi/6))))"
   },
   {
