        {
         "tex": "y &= (4)^2 - 6(4) + 4",
         "sym": "4**2 - 6*4 + 4",
         "new": true
        },
        {
         "tex": "&= -4",
         "sym": "-4"
        }
       ]
      }
     ],
     "finalAnswer": "(4, -4)"
    },
    "finalSym": "(4, -4)",
    "answerSym": "(solve(Eq(diff(x**2 - 6*x + 4, x), 2), x)[0], (x**2 - 6*x + 4).subs(x, solve(Eq(diff(x**2 - 6*x + 4, x), 2), x)[0]))"
   },
   {
    "question": "The tangent to the curve $y = x^3 - 3x^2 - 9x + 2$ is parallel to the line $y = -9x + 4$ at two points.\\nFind the coordinates of the two points.",
    "level": "ordinary",
    "marks": 15,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the slope of the line",
       "lines": [
        {
         "text": "The line $y = -9x + 4$ has slope $-9$, so the tangent has slope $-9$."
        }
       ]
      },
      {
       "title": "Differentiate the curve",
       "lines": [
        {
         "tex": "y &= x^3 - 3x^2 - 9x + 2",
         "sym": "x**3 - 3*x**2 - 9*x + 2"
        },
        {
         "tex": "\\frac{dy}{dx} &= 3x^2 - 6x - 9",
         "sym": "3*x**2 - 6*x - 9",
         "new": true
        }
       ]
      },
      {
       "title": "Set the slope equal to -9 and solve",
       "lines": [
        {
         "tex": "3x^2 - 6x - 9 &= -9",
         "sym": "Eq(3*x**2 - 6*x - 9, -9)",
         "new": true
        },
        {
         "tex": "3x^2 - 6x &= 0",
         "sym": "Eq(3*x**2 - 6*x, 0)"
        },
        {
         "tex": "3x(x - 2) &= 0",
         "sym": "Eq(3*x*(x - 2), 0)"
        },
        {
         "tex": "x &= 0 \\text{ or } x = 2",
         "sym": "Or(Eq(x, 0), Eq(x, 2))"
        }
       ]
      },
      {
       "title": "Find y for each x-value",
       "lines": [
        {
         "tex": "x = 0:\\quad y &= 2",
         "sym": "2",
         "new": true
        },
        {
         "tex": "x = 2:\\quad y &= 8 - 12 - 18 + 2",
         "sym": "8 - 12 - 18 + 2",
         "new": true
        },
        {
         "tex": "&= -20",
         "sym": "-20"
        }
       ]
      }
     ],
     "finalAnswer": "(0, 2) \\text{ and } (2, -20)"
    },
    "finalSym": "[(0, 2), (2, -20)]",
    "answerSym": "solve([Eq(diff(x**3 - 3*x**2 - 9*x + 2, x), -9), Eq(y, x**3 - 3*x**2 - 9*x + 2)], [x, y])"
   }
  ]
 }
