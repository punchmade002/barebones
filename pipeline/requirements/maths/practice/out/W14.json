 {
  "skill": "cx-conjugate-root",
  "problems": [
   {
    "question": "The polynomial $z^3 - 5z^2 + 9z - 5$ has real coefficients.\\nGiven that $2 - i$ is a root of $z^3 - 5z^2 + 9z - 5 = 0$, find all three roots.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Use the conjugate root theorem",
       "lines": [
        {
         "text": "The coefficients are real, so complex roots come in conjugate pairs."
        },
        {
         "tex": "\\overline{2 - i} &= 2 + i",
         "sym": "Eq(conjugate(2 - I), 2 + I)",
         "new": true
        }
       ]
      },
      {
       "title": "Find the quadratic factor from the pair",
       "lines": [
        {
         "text": "Sum of the pair, then product of the pair."
        },
        {
         "tex": "(2 - i) + (2 + i) &= 4",
         "sym": "Eq((2 - I) + (2 + I), 4)",
         "new": true
        },
        {
         "tex": "(2 - i)(2 + i) &= 4 - i^2 = 5",
         "sym": "Eq(expand((2 - I)*(2 + I)), 5)",
         "new": true
        },
        {
         "text": "So the quadratic factor is $z^2 - 4z + 5$."
        }
       ]
      },
      {
       "title": "Divide to find the linear factor",
       "lines": [
        {
         "text": "Compare constant terms: $5 \\times (\\text{constant}) = -5$, so the constant is $-1$."
        },
        {
         "tex": "z^3 - 5z^2 + 9z - 5 &= (z^2 - 4z + 5)(z - 1)",
         "sym": "Eq(z**3 - 5*z**2 + 9*z - 5, expand((z**2 - 4*z + 5)*(z - 1)))",
         "new": true
        }
       ]
      },
      {
       "title": "Read off the third root",
       "lines": [
        {
         "tex": "z - 1 &= 0",
         "sym": "Eq(z - 1, 0)",
         "new": true
        },
        {
         "tex": "z &= 1",
         "sym": "Eq(z, 1)"
        }
       ]
      }
     ],
     "finalAnswer": "z = 2 - i,\\ 2 + i,\\ 1"
    },
    "finalSym": "[2 - I, 2 + I, 1]",
    "answerSym": "solve(Eq(z**3 - 5*z**2 + 9*z - 5, 0), z)"
   }
  ]
 },
 {
  "skill": "cx-de-moivre-identity",
  "problems": [
   {
    "question": "Use De Moivre's theorem to show that\\n$\\cos 3\\theta = 4\\cos^3\\theta - 3\\cos\\theta$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Apply De Moivre's theorem",
       "lines": [
        {
         "tex": "(\\cos\\theta + i\\sin\\theta)^3 &= \\cos 3\\theta + i\\sin 3\\theta"
        }
       ]
      },
      {
       "title": "Expand with the binomial theorem",
       "lines": [
        {
         "tex": "(\\cos\\theta + i\\sin\\theta)^3 &= \\cos^3\\theta + 3\\cos^2\\theta(i\\sin\\theta) + 3\\cos\\theta(i\\sin\\theta)^2 + (i\\sin\\theta)^3",
         "sym": "Eq((cos(theta) + I*sin(theta))**3, cos(theta)**3 + 3*cos(theta)**2*(I*sin(theta)) + 3*cos(theta)*(I*sin(theta))**2 + (I*sin(theta))**3)",
         "new": true
        },
        {
         "tex": "&= (\\cos^3\\theta - 3\\cos\\theta\\sin^2\\theta) + i(3\\cos^2\\theta\\sin\\theta - \\sin^3\\theta)",
         "sym": "Eq(cos(theta)**3 + 3*cos(theta)**2*(I*sin(theta)) + 3*cos(theta)*(I*sin(theta))**2 + (I*sin(theta))**3, (cos(theta)**3 - 3*cos(theta)*sin(theta)**2) + I*(3*cos(theta)**2*sin(theta) - sin(theta)**3))",
         "new": true
        }
       ]
      },
      {
       "title": "Equate the real parts",
       "lines": [
        {
         "tex": "\\cos 3\\theta &= \\cos^3\\theta - 3\\cos\\theta\\sin^2\\theta",
         "sym": "Eq(cos(3*theta), cos(theta)**3 - 3*cos(theta)*sin(theta)**2)",
         "new": true
        }
       ]
      },
      {
       "title": "Replace sin squared using formula 1",
       "lines": [
        {
         "text": "$\\sin^2\\theta = 1 - \\cos^2\\theta$."
        },
        {
         "tex": "\\cos 3\\theta &= \\cos^3\\theta - 3\\cos\\theta(1 - \\cos^2\\theta)",
         "sym": "Eq(cos(3*theta), cos(theta)**3 - 3*cos(theta)*(1 - cos(theta)**2))",
         "new": true
        },
        {
         "tex": "&= \\cos^3\\theta - 3\\cos\\theta + 3\\cos^3\\theta",
         "sym": "Eq(cos(3*theta), cos(theta)**3 - 3*cos(theta) + 3*cos(theta)**3)"
        },
        {
         "tex": "&= 4\\cos^3\\theta - 3\\cos\\theta",
         "sym": "Eq(cos(3*theta), 4*cos(theta)**3 - 3*cos(theta))"
        }
       ]
      }
     ],
     "finalAnswer": "\\cos 3\\theta = 4\\cos^3\\theta - 3\\cos\\theta"
    },
    "finalSym": "0",
    "answerSym": "simplify(expand_trig(cos(3*theta)) - (4*cos(theta)**3 - 3*cos(theta)))"
   },
