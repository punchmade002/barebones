        },
        {
         "tex": "\\frac{dy}{dx} &= 2x - 6",
         "sym": "2*x - 6",
         "new": true
        }
       ]
      },
      {
       "title": "Set the slope equal to 2",
       "lines": [
        {
         "tex": "2x - 6 &= 2",
         "sym": "Eq(2*x - 6, 2)",
         "new": true
        },
        {
         "tex": "2x &= 8",
         "sym": "Eq(2*x, 8)"
        },
        {
         "tex": "x &= 4",
         "sym": "Eq(x, 4)"
        }
       ]
      },
      {
       "title": "Find y at this x-value",
