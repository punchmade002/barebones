        },
        {
         "tex": "&= 3\\sin\\theta - 4\\sin^3\\theta",
         "sym": "Eq(sin(3*theta), 3*sin(theta) - 4*sin(theta)**3)"
        }
       ]
      }
     ],
     "finalAnswer": "\\sin 3\\theta = 3\\sin\\theta - 4\\sin^3\\theta"
    },
    "finalSym": "0",
    "answerSym": "simplify(expand_trig(sin(3*theta)) - (3*sin(theta) - 4*sin(theta)**3))"
   }
  ]
