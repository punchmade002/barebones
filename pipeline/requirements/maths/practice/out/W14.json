         "sym": "Eq(r**(k + 1)*(cos(k*theta)*cos(theta) + I*cos(k*theta)*sin(theta) + I*sin(k*theta)*cos(theta) + I**2*sin(k*theta)*sin(theta)), r**(k + 1)*((cos(k*theta)*cos(theta) - sin(k*theta)*sin(theta)) + I*(cos(k*theta)*sin(theta) + sin(k*theta)*cos(theta))))",
         "new": true
        }
       ]
      },
      {
       "title": "Use the addition formulas",
