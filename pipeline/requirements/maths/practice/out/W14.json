        {
         "tex": "(\\cos\\theta + i\\sin\\theta)^3 &= \\cos^3\\theta + 3\\cos^2\\theta(i\\sin\\theta) + 3\\cos\\theta(i\\sin\\theta)^2 + (i\\sin\\theta)^3",
         "sym": "Eq((cos(theta) + I*sin(theta))**3, cos(theta)**3 + 3*cos(theta)**2*(I*sin(theta)) + 3*cos(theta)*(I*sin(theta))**2 + (I*sin(theta))**3)",
         "new": true
        },
        {
         "tex": "&= (\\cos^3\\theta - 3\\cos\\theta\\sin^2\\theta) + i(3\\cos^2\\theta\\sin\\theta - \\sin^3\\theta)",
         "sym": "Eq(cos(theta)**3 + 3*cos(theta)**2*(I*sin(theta)) + 3*cos(theta)*(I*sin(theta))**2 + (I*sin(theta))**3, (cos(theta)**3 - 3*cos(theta)*sin(theta)**2) + I*(3*cos(theta)**2*sin(theta) - sin(theta)**3))",
         "new": true
        }
       ]
      },
      {
       "title": "Equate the imaginary parts",
       "lines": [
        {
         "tex": "\\sin 3\\theta &= 3\\cos^2\\theta\\sin\\theta - \\sin^3\\theta",
         "sym": "Eq(sin(3*theta), 3*cos(theta)**2*sin(theta) - sin(theta)**3)",
         "new": true
        }
       ]
      },
      {
       "title": "Replace cos squared using formula 1",
       "lines": [
        {
         "text": "$\\cos^2\\theta = 1 - \\sin^2\\theta$."
        },
        {
         "tex": "\\sin 3\\theta &= 3(1 - \\sin^2\\theta)\\sin\\theta - \\sin^3\\theta",
         "sym": "Eq(sin(3*theta), 3*(1 - sin(theta)**2)*sin(theta) - sin(theta)**3)",
         "new": true
