        },
        {
         "tex": "&= r^{k+1}[\\cos(k\\theta + \\theta) + i\\sin(k\\theta + \\theta)]",
         "sym": "Eq(r**(k + 1)*((cos(k*theta)*cos(theta) - sin(k*theta)*sin(theta)) + I*(cos(k*theta)*sin(theta) + sin(k*theta)*cos(theta))), r**(k + 1)*(cos(k*theta + theta) + I*sin(k*theta + theta)))",
         "new": true
        },
        {
         "tex": "&= r^{k+1}[\\cos(k+1)\\theta + i\\sin(k+1)\\theta]"
        },
        {
         "text": "So $P(k+1)$ is true."
        }
       ]
      },
      {
       "title": "State the conclusion",
       "lines": [
        {
         "text": "$P(1)$ is true. If $P(k)$ is true then $P(k+1)$ is true. Hence $P(n)$ is true for all $n \\in \\mathbb{N}$."
        }
       ]
      }
     ],
     "finalAnswer": "[r(\\cos\\theta + i\\sin\\theta)]^n = r^n(\\cos n\\theta + i\\sin n\\theta)"
    },
    "finalSym": "0",
    "answerSym": "simplify(expand((2*(cos(pi/6) + I*sin(pi/6)))**3 - 2**3*(cos(3*pi/6) + I*sin(3*pi/6))))"
   }
  ]
