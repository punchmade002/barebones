  "skill": "trig-derive-7",
  "problems": [
   {
    "question": "Using the formula $\\cos(A - B) = \\cos A \\cos B + \\sin A \\sin B$, prove that\n$\\sin(A + B) = \\sin A \\cos B + \\cos A \\sin B$,\nwhere $A$ and $B$ are angles in radians.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Start from the known formula",
       "lines": [
        {
         "text": "We use $\\cos(A - B)$ and turn the sine into a cosine."
        },
        {
         "tex": "\\cos(A - B) &= \\cos A \\cos B + \\sin A \\sin B",
         "sym": "Eq(cos(A-B), cos(A)*cos(B)+sin(A)*sin(B))"
        }
       ]
      },
      {
       "title": "Write the sine as a cosine",
       "lines": [
        {
         "text": "$\\sin\\theta = \\cos\\left(\\frac{\\pi}{2} - \\theta\\right)$ for any angle $\\theta$."
        },
        {
         "tex": "\\sin(A+B) &= \\cos\\left(\\frac{\\pi}{2} - (A+B)\\right)",
         "sym": "Eq(sin(A+B), cos(pi/2-(A+B)))",
         "new": true
        },
        {
         "tex": "&= \\cos\\left(\\left(\\frac{\\pi}{2} - A\\right) - B\\right)",
         "sym": "Eq(sin(A+B), cos((pi/2-A)-B))"
        }
       ]
      },
      {
       "title": "Use the $\\cos(A-B)$ formula",
       "lines": [
        {
         "text": "Apply it with $\\frac{\\pi}{2} - A$ in place of $A$."
        },
        {
         "tex": "&= \\cos\\left(\\frac{\\pi}{2} - A\\right)\\cos B + \\sin\\left(\\frac{\\pi}{2} - A\\right)\\sin B",
         "sym": "Eq(sin(A+B), cos(pi/2-A)*cos(B)+sin(pi/2-A)*sin(B))"
        }
       ]
      },
      {
       "title": "Change back to functions of $A$",
       "lines": [
        {
         "text": "$\\cos\\left(\\frac{\\pi}{2} - A\\right) = \\sin A$ and $\\sin\\left(\\frac{\\pi}{2} - A\\right) = \\cos A$."
        },
        {
         "tex": "&= \\sin A \\cos B + \\cos A \\sin B",
         "sym": "Eq(sin(A+B), sin(A)*cos(B)+cos(A)*sin(B))"
        },
        {
         "text": "So $\\sin(A+B) = \\sin A \\cos B + \\cos A \\sin B$, as required."
        }
       ]
      }
     ],
     "finalAnswer": "\\sin(A+B) = \\sin A \\cos B + \\cos A \\sin B"
    },
    "finalSym": "0",
    "answerSym": "simplify(expand_trig(sin(A+B)) - (sin(A)*cos(B)+cos(A)*sin(B)))"
   },
   {
    "question": "Prove that $\\sin(x + y) = \\sin x \\cos y + \\cos x \\sin y$, starting from the formula\n$\\cos(x - y) = \\cos x \\cos y + \\sin x \\sin y$.\nGroup the angle as $(90^\\circ - y) - x$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Turn the sine into a cosine",
       "lines": [
        {
         "text": "$\\sin\\theta = \\cos(90^\\circ - \\theta)$ for any angle $\\theta$."
        },
        {
         "tex": "\\sin(x+y) &= \\cos\\big(90^\\circ - (x+y)\\big)",
         "sym": "Eq(sin(x+y), cos(pi/2-(x+y)))"
        },
        {
         "text": "Regroup so the angle looks like $P - Q$ with $P = 90^\\circ - y$ and $Q = x$."
        },
        {
         "tex": "&= \\cos\\big((90^\\circ - y) - x\\big)",
         "sym": "Eq(sin(x+y), cos((pi/2-y)-x))"
        }
       ]
      },
      {
       "title": "Use the $\\cos(P-Q)$ formula",
       "lines": [
        {
         "text": "$\\cos(P - Q) = \\cos P \\cos Q + \\sin P \\sin Q$ with $P = 90^\\circ - y$, $Q = x$."
        },
        {
         "tex": "&= \\cos(90^\\circ - y)\\cos x + \\sin(90^\\circ - y)\\sin x",
         "sym": "Eq(sin(x+y), cos(pi/2-y)*cos(x)+sin(pi/2-y)*sin(x))"
        }
       ]
      },
      {
       "title": "Change back to functions of $y$",
       "lines": [
        {
         "text": "$\\cos(90^\\circ - y) = \\sin y$ and $\\sin(90^\\circ - y) = \\cos y$."
        },
        {
         "tex": "&= \\sin y \\cos x + \\cos y \\sin x",
         "sym": "Eq(sin(x+y), sin(y)*cos(x)+cos(y)*sin(x))"
        }
       ]
      },
      {
       "title": "Write in the required order",
       "lines": [
        {
         "text": "Multiplication can be done in either order."
        },
        {
         "tex": "&= \\sin x \\cos y + \\cos x \\sin y",
         "sym": "Eq(sin(x+y), sin(x)*cos(y)+cos(x)*sin(y))"
        }
       ]
      }
     ],
     "finalAnswer": "\\sin(x+y) = \\sin x \\cos y + \\cos x \\sin y"
    },
    "finalSym": "0",
    "answerSym": "simplify(expand_trig(sin(x+y)) - (sin(x)*cos(y)+cos(x)*sin(y)))"
   }
  ]
