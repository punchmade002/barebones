 {
  "skill": "trig-triangle-problems",
  "problems": [
   {
    "question": "In the quadrilateral $ABCD$, $|AB| = 5$ cm, $|BC| = 8$ cm and $\\angle ABC = 60^\\circ$.\nThe diagonal $AC$ divides the quadrilateral into two triangles. In triangle $ACD$, $|CD| = 8$ cm and $\\angle ACD = 30^\\circ$.\nFind the area of the quadrilateral $ABCD$, correct to one decimal place.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Find $|AC|$ with the cosine rule",
       "lines": [
        {
         "text": "$AC$ is opposite the angle $60^\\circ$ in triangle $ABC$."
        },
        {
         "tex": "|AC|^2 &= 5^2 + 8^2 - 2(5)(8)\\cos 60^\\circ",
         "sym": "Eq(AC**2, 5**2+8**2-2*5*8*cos(pi/3))",
         "new": true
        },
        {
         "tex": "&= 25 + 64 - 40",
         "sym": "Eq(AC**2, 25+64-40)"
        },
        {
         "tex": "&= 49",
         "sym": "Eq(AC**2, 49)"
        },
        {
         "tex": "|AC| &= 7",
         "sym": "Eq(AC, 7)",
         "new": true
        }
       ]
      },
      {
       "title": "Area of triangle $ABC$",
       "lines": [
        {
         "text": "Use $\\frac{1}{2}ab\\sin C$ with the two sides at $B$."
        },
        {
         "tex": "\\text{Area} &= \\tfrac{1}{2}(5)(8)\\sin 60^\\circ",
         "sym": "Eq(Abc, Rational(1,2)*5*8*sin(pi/3))",
         "new": true
        },
        {
         "tex": "&= 10\\sqrt{3}",
         "sym": "Eq(Abc, 10*sqrt(3))"
        },
        {
         "tex": "&\\approx 17.32",
         "sym": "Eq(Abc, 17.32)",
         "approx": true
        }
       ]
      },
      {
       "title": "Area of triangle $ACD$",
       "lines": [
        {
         "text": "Use the two sides $|AC| = 7$ and $|CD| = 8$ with the angle between them."
        },
        {
         "tex": "\\text{Area} &= \\tfrac{1}{2}(7)(8)\\sin 30^\\circ",
         "sym": "Eq(Acd, Rational(1,2)*7*8*sin(pi/6))",
         "new": true
        },
        {
         "tex": "&= 14",
         "sym": "Eq(Acd, 14)"
        }
       ]
      },
      {
       "title": "Add the two areas",
       "lines": [
        {
         "tex": "\\text{Total} &= 17.32 + 14",
         "sym": "Eq(Tot, 17.32+14)",
         "new": true,
         "approx": true
        },
        {
         "tex": "&\\approx 31.3 \\text{ cm}^2",
         "sym": "Eq(Tot, 31.3)",
         "approx": true
        }
       ]
      }
     ],
     "finalAnswer": "31.3 \\text{ cm}^2"
    },
    "finalSym": "10*sqrt(3)+14",
    "answerSym": "Rational(1,2)*5*8*sin(pi/3)+Rational(1,2)*sqrt(5**2+8**2-2*5*8*cos(pi/3))*8*sin(pi/6)"
   },
   {
    "question": "In triangle $ABC$, $|AB| = 60$ m and $\\angle CAB = \\angle CBA = 30^\\circ$.\nD is a point such that $|AD| = 40$ m and $\\angle CAD = 60^\\circ$.\nFind the area of triangle $ACD$, in $\\text{m}^2$.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Find $\\angle ACB$",
       "lines": [
        {
         "text": "The angles of a triangle add to $180^\\circ$."
        },
        {
         "tex": "|\\angle ACB| &= 180^\\circ - 30^\\circ - 30^\\circ",
         "sym": "Eq(C, 180-30-30)",
         "new": true
        },
        {
         "tex": "&= 120^\\circ",
         "sym": "Eq(C, 120)"
        }
       ]
      },
      {
       "title": "Find $|AC|$ with the sine rule",
       "lines": [
        {
         "text": "$AC$ is opposite $\\angle ABC = 30^\\circ$, and $AB$ is opposite $\\angle ACB = 120^\\circ$."
        },
        {
         "tex": "\\frac{|AC|}{\\sin 30^\\circ} &= \\frac{60}{\\sin 120^\\circ}",
         "sym": "Eq(AC/sin(pi/6), 60/sin(2*pi/3))",
         "new": true
        },
        {
         "tex": "|AC| &= \\frac{60 \\sin 30^\\circ}{\\sin 120^\\circ}",
         "sym": "Eq(AC, 60*sin(pi/6)/sin(2*pi/3))"
        },
        {
         "tex": "&= \\frac{30}{\\frac{\\sqrt{3}}{2}}",
         "sym": "Eq(AC, 30/(sqrt(3)/2))"
        },
        {
         "tex": "&= 20\\sqrt{3}",
         "sym": "Eq(AC, 20*sqrt(3))"
        }
       ]
      },
      {
       "title": "Area of triangle $ACD$",
       "lines": [
        {
         "text": "Use the two sides at $A$, $|AC|$ and $|AD|$, with the angle $60^\\circ$ between them."
        },
        {
         "tex": "\\text{Area} &= \\tfrac{1}{2}(20\\sqrt{3})(40)\\sin 60^\\circ",
         "sym": "Eq(Ar, Rational(1,2)*20*sqrt(3)*40*sin(pi/3))",
         "new": true
        },
        {
         "tex": "&= 400\\sqrt{3} \\cdot \\frac{\\sqrt{3}}{2}",
         "sym": "Eq(Ar, 400*sqrt(3)*sqrt(3)/2)"
        },
        {
         "tex": "&= 600 \\text{ m}^2",
         "sym": "Eq(Ar, 600)"
        }
       ]
      }
     ],
     "finalAnswer": "600 \\text{ m}^2"
    },
    "finalSym": "600",
    "answerSym": "Rational(1,2)*(60*sin(pi/6)/sin(2*pi/3))*40*sin(pi/3)"
   },
