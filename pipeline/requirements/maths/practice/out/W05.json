[
 {
  "skill": "alg-surd-expressions",
  "problems": [
   {
    "question": "Simplify $\\frac{1}{\\sqrt{a}-\\sqrt{b}} - \\frac{1}{\\sqrt{a}+\\sqrt{b}}$, where $a > b > 0$.\nGive your answer as a single fraction with no surds in the denominator.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Write over a common denominator",
       "lines": [
        {
         "tex": "\\frac{1}{\\sqrt{a}-\\sqrt{b}} - \\frac{1}{\\sqrt{a}+\\sqrt{b}} &= \\frac{(\\sqrt{a}+\\sqrt{b}) - (\\sqrt{a}-\\sqrt{b})}{(\\sqrt{a}-\\sqrt{b})(\\sqrt{a}+\\sqrt{b})}",
         "sym": "1/(sqrt(a)-sqrt(b)) - 1/(sqrt(a)+sqrt(b))",
         "new": true
        }
       ]
      },
      {
       "title": "Simplify the numerator",
       "lines": [
        {
         "tex": "(\\sqrt{a}+\\sqrt{b}) - (\\sqrt{a}-\\sqrt{b}) &= \\sqrt{a}+\\sqrt{b}-\\sqrt{a}+\\sqrt{b}",
         "sym": "(sqrt(a)+sqrt(b)) - (sqrt(a)-sqrt(b))",
         "new": true
        },
        {
         "tex": "&= 2\\sqrt{b}",
         "sym": "2*sqrt(b)"
        }
       ]
      },
      {
       "title": "Simplify the denominator (difference of two squares)",
       "lines": [
        {
         "tex": "(\\sqrt{a}-\\sqrt{b})(\\sqrt{a}+\\sqrt{b}) &= (\\sqrt{a})^2 - (\\sqrt{b})^2",
         "sym": "(sqrt(a)-sqrt(b))*(sqrt(a)+sqrt(b))",
         "new": true
        },
        {
         "tex": "&= a - b",
         "sym": "a - b"
        }
       ]
      },
      {
       "title": "Put the numerator over the denominator",
       "lines": [
        {
         "tex": "\\frac{1}{\\sqrt{a}-\\sqrt{b}} - \\frac{1}{\\sqrt{a}+\\sqrt{b}} &= \\frac{2\\sqrt{b}}{a-b}",
         "sym": "2*sqrt(b)/(a-b)",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{2\\sqrt{b}}{a-b}"
    },
    "finalSym": "2*sqrt(b)/(a-b)",
    "answerSym": "simplify(1/(sqrt(a)-sqrt(b)) - 1/(sqrt(a)+sqrt(b)))"
   }
  ]
 },
 {
  "skill": "alg-fractions-add",
  "problems": [
   {
    "question": "Write $\\frac{3}{x+2} + \\frac{4}{x-1}$ as a single fraction.",
    "level": "ordinary",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the common denominator",
       "lines": [
        {
         "text": "The common denominator is $(x+2)(x-1)$."
        },
        {
         "tex": "\\frac{3}{x+2} + \\frac{4}{x-1} &= \\frac{3(x-1)}{(x+2)(x-1)} + \\frac{4(x+2)}{(x+2)(x-1)}",
         "sym": "3/(x+2)+4/(x-1)",
         "new": true
        }
       ]
      },
      {
       "title": "Combine into one fraction",
       "lines": [
        {
         "tex": "&= \\frac{3(x-1) + 4(x+2)}{(x+2)(x-1)}",
         "sym": "3/(x+2)+4/(x-1)"
        }
       ]
      },
      {
       "title": "Multiply out the brackets in the numerator",
       "lines": [
        {
         "tex": "&= \\frac{3x - 3 + 4x + 8}{(x+2)(x-1)}",
         "sym": "(3*x-3+4*x+8)/((x+2)*(x-1))"
        }
       ]
      },
      {
       "title": "Collect like terms",
       "lines": [
        {
         "tex": "&= \\frac{7x + 5}{(x+2)(x-1)}",
         "sym": "(7*x+5)/((x+2)*(x-1))"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{7x+5}{(x+2)(x-1)}"
    },
    "finalSym": "(7*x+5)/((x+2)*(x-1))",
    "answerSym": "together(3/(x+2) + 4/(x-1))"
   },
   {
    "question": "Write $\\frac{5}{2x+1} - \\frac{2}{x-3}$ as a single fraction.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the common denominator",
       "lines": [
        {
         "text": "The common denominator is $(2x+1)(x-3)$."
        },
        {
         "tex": "\\frac{5}{2x+1} - \\frac{2}{x-3} &= \\frac{5(x-3)}{(2x+1)(x-3)} - \\frac{2(2x+1)}{(2x+1)(x-3)}",
         "sym": "5/(2*x+1)-2/(x-3)",
         "new": true
        }
       ]
      },
      {
       "title": "Combine into one fraction",
       "lines": [
        {
         "text": "Keep the minus sign in front of the whole second term."
        },
        {
         "tex": "&= \\frac{5(x-3) - 2(2x+1)}{(2x+1)(x-3)}",
         "sym": "5/(2*x+1)-2/(x-3)"
        }
       ]
      },
      {
       "title": "Multiply out the brackets in the numerator",
       "lines": [
        {
         "tex": "&= \\frac{5x - 15 - 4x - 2}{(2x+1)(x-3)}",
         "sym": "(5*x-15-4*x-2)/((2*x+1)*(x-3))"
        }
       ]
      },
      {
       "title": "Collect like terms",
       "lines": [
        {
         "tex": "&= \\frac{x - 17}{(2x+1)(x-3)}",
         "sym": "(x-17)/((2*x+1)*(x-3))"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{x-17}{(2x+1)(x-3)}"
    },
    "finalSym": "(x-17)/((2*x+1)*(x-3))",
    "answerSym": "together(5/(2*x+1) - 2/(x-3))"
   }
  ]
 },
 {
  "skill": "alg-poly-divide",
  "problems": [
   {
    "question": "Divide $x^3 - 8$ by $x - 2$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "First term",
       "lines": [
        {
         "text": "Write $x^3 - 8$ as $x^3 + 0x^2 + 0x - 8$. Divide the leading terms."
        },
        {
         "tex": "x^3 \\div x &= x^2",
         "sym": "x**2",
         "new": true
        },
        {
         "tex": "x^2(x-2) &= x^3 - 2x^2",
         "sym": "x**3-2*x**2",
         "new": true
        },
        {
         "tex": "(x^3 + 0x^2 - 0x - 8) - (x^3 - 2x^2) &= 2x^2 - 8",
         "sym": "(x**3-8)-(x**3-2*x**2)",
         "new": true
        }
       ]
      },
      {
       "title": "Second term",
       "lines": [
        {
         "text": "Bring down the next term and divide the leading terms."
        },
        {
         "tex": "2x^2 \\div x &= 2x",
         "sym": "2*x",
         "new": true
        },
        {
         "tex": "2x(x-2) &= 2x^2 - 4x",
         "sym": "2*x**2-4*x",
         "new": true
        },
        {
         "tex": "(2x^2 - 8) - (2x^2 - 4x) &= 4x - 8",
         "sym": "(2*x**2-8)-(2*x**2-4*x)",
         "new": true
        }
       ]
      },
      {
       "title": "Third term",
       "lines": [
        {
         "tex": "4x \\div x &= 4",
         "sym": "4",
         "new": true
        },
        {
         "tex": "4(x-2) &= 4x - 8",
         "sym": "4*x-8",
         "new": true
        },
        {
         "tex": "(4x - 8) - (4x - 8) &= 0",
         "sym": "(4*x-8)-(4*x-8)",
         "new": true
        },
        {
         "text": "The remainder is $0$, so the quotient is $x^2 + 2x + 4$."
        }
       ]
      }
     ],
     "finalAnswer": "x^2 + 2x + 4"
    },
    "finalSym": "x**2+2*x+4",
    "answerSym": "quo(x**3 - 8, x - 2, x)"
   },
   {
    "question": "Divide $x^4 - 3x^3 + 2x^2 + x - 5$ by $x^2 - x + 1$.\nFind the quotient and the remainder.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "First term",
       "lines": [
        {
         "text": "Divide the leading terms."
        },
        {
         "tex": "x^4 \\div x^2 &= x^2",
         "sym": "x**2",
         "new": true
        },
        {
         "tex": "x^2(x^2 - x + 1) &= x^4 - x^3 + x^2",
         "sym": "x**4-x**3+x**2",
         "new": true
        },
        {
         "tex": "(x^4 - 3x^3 + 2x^2 + x - 5) - (x^4 - x^3 + x^2) &= -2x^3 + x^2 + x - 5",
         "sym": "(x**4-3*x**3+2*x**2+x-5)-(x**4-x**3+x**2)",
         "new": true
        }
       ]
      },
      {
       "title": "Second term",
       "lines": [
        {
         "tex": "-2x^3 \\div x^2 &= -2x",
         "sym": "-2*x",
         "new": true
        },
        {
         "tex": "-2x(x^2 - x + 1) &= -2x^3 + 2x^2 - 2x",
         "sym": "-2*x*(x**2-x+1)",
         "new": true
        },
        {
         "tex": "(-2x^3 + x^2 + x - 5) - (-2x^3 + 2x^2 - 2x) &= -x^2 + 3x - 5",
         "sym": "(-2*x**3+x**2+x-5)-(-2*x**3+2*x**2-2*x)",
         "new": true
        }
       ]
      },
      {
       "title": "Third term",
       "lines": [
        {
         "tex": "-x^2 \\div x^2 &= -1",
         "sym": "-1",
         "new": true
        },
        {
         "tex": "-1(x^2 - x + 1) &= -x^2 + x - 1",
         "sym": "-(x**2-x+1)",
         "new": true
        },
        {
         "tex": "(-x^2 + 3x - 5) - (-x^2 + x - 1) &= 2x - 4",
         "sym": "(-x**2+3*x-5)-(-x**2+x-1)",
         "new": true
        }
       ]
      },
      {
       "title": "Read off the quotient and remainder",
       "lines": [
        {
         "text": "The remainder $2x - 4$ has lower degree than the divisor, so we stop."
        },
        {
         "tex": "x^4 - 3x^3 + 2x^2 + x - 5 &= (x^2 - x + 1)(x^2 - 2x - 1) + (2x - 4)",
         "sym": "(x**2-x+1)*(x**2-2*x-1)+(2*x-4)",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "\\text{quotient } x^2 - 2x - 1,\\ \\text{remainder } 2x - 4"
    },
    "finalSym": "[x**2-2*x-1, 2*x-4]",
    "answerSym": "list(div(x**4 - 3*x**3 + 2*x**2 + x - 5, x**2 - x + 1, x))"
   },
   {
    "question": "Divide $6x^3 - 5x^2 - 3x + 2$ by $(2x - 1)$.\nHence find all the roots of $6x^3 - 5x^2 - 3x + 2 = 0$.",
    "level": "higher",
    "marks": 15,
    "workedSolution": {
     "steps": [
      {
       "title": "First term",
       "lines": [
        {
         "text": "Divide the leading terms."
        },
        {
         "tex": "6x^3 \\div 2x &= 3x^2",
         "sym": "3*x**2",
         "new": true
        },
        {
         "tex": "3x^2(2x-1) &= 6x^3 - 3x^2",
         "sym": "6*x**3-3*x**2",
         "new": true
        },
        {
         "tex": "(6x^3 - 5x^2 - 3x + 2) - (6x^3 - 3x^2) &= -2x^2 - 3x + 2",
         "sym": "(6*x**3-5*x**2-3*x+2)-(6*x**3-3*x**2)",
         "new": true
        }
       ]
      },
      {
       "title": "Second term",
       "lines": [
        {
         "tex": "-2x^2 \\div 2x &= -x",
         "sym": "-x",
         "new": true
        },
        {
         "tex": "-x(2x-1) &= -2x^2 + x",
         "sym": "-x*(2*x-1)",
         "new": true
        },
        {
         "tex": "(-2x^2 - 3x + 2) - (-2x^2 + x) &= -4x + 2",
         "sym": "(-2*x**2-3*x+2)-(-2*x**2+x)",
         "new": true
        }
       ]
      },
      {
       "title": "Third term",
       "lines": [
        {
         "tex": "-4x \\div 2x &= -2",
         "sym": "-2",
         "new": true
        },
        {
         "tex": "-2(2x-1) &= -4x + 2",
         "sym": "-2*(2*x-1)",
         "new": true
        },
        {
         "tex": "(-4x + 2) - (-4x + 2) &= 0",
         "sym": "(-4*x+2)-(-4*x+2)",
         "new": true
        },
        {
         "text": "The remainder is $0$, so the quotient is $3x^2 - x - 2$."
        },
        {
         "tex": "6x^3 - 5x^2 - 3x + 2 &= (2x-1)(3x^2 - x - 2)",
         "sym": "(2*x-1)*(3*x**2-x-2)",
         "new": true
        }
       ]
      },
      {
       "title": "Factorise the quadratic",
       "lines": [
        {
         "text": "Find two numbers with product $3 \\times (-2) = -6$ and sum $-1$: they are $-3$ and $2$."
        },
        {
         "tex": "3x^2 - x - 2 &= 3x^2 - 3x + 2x - 2",
         "sym": "3*x**2-3*x+2*x-2",
         "new": true
        },
        {
         "tex": "&= 3x(x - 1) + 2(x - 1)",
         "sym": "3*x*(x-1)+2*(x-1)"
        },
        {
         "tex": "&= (3x + 2)(x - 1)",
         "sym": "(3*x+2)*(x-1)"
        }
       ]
      },
      {
       "title": "Solve each factor",
       "lines": [
        {
         "tex": "(2x-1)(3x+2)(x-1) &= 0",
         "sym": "Eq((2*x-1)*(3*x+2)*(x-1), 0)",
         "new": true
        },
        {
         "tex": "x &= \\frac{1}{2},\\ -\\frac{2}{3},\\ 1",
         "sym": "[Rational(1,2), Rational(-2,3), 1]",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "x = -\\frac{2}{3},\\ \\frac{1}{2},\\ 1"
    },
    "finalSym": "[Rational(-2,3), Rational(1,2), 1]",
    "answerSym": "sorted(solve(Eq(6*x**3 - 5*x**2 - 3*x + 2, 0), x))"
   }
  ]
 },
 {
  "skill": "alg-fractions-simplify",
  "problems": [
   {
    "question": "Write $\\frac{x}{x^2-4} - \\frac{1}{x+2}$ as a single fraction in its simplest form.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Factorise the first denominator",
       "lines": [
        {
         "tex": "x^2 - 4 &= (x-2)(x+2)",
         "sym": "(x-2)*(x+2)",
         "new": true
        },
        {
         "text": "This is the common denominator, since $x+2$ is already a factor."
        }
       ]
      },
      {
       "title": "Write both fractions over the common denominator",
       "lines": [
        {
         "tex": "\\frac{x}{x^2-4} - \\frac{1}{x+2} &= \\frac{x}{(x-2)(x+2)} - \\frac{1\\cdot(x-2)}{(x+2)(x-2)}",
         "sym": "x/(x**2-4)-1/(x+2)",
         "new": true
        }
       ]
      },
      {
       "title": "Combine and simplify the numerator",
       "lines": [
        {
         "tex": "&= \\frac{x - (x-2)}{(x-2)(x+2)}",
         "sym": "x/(x**2-4)-1/(x+2)"
        },
        {
         "tex": "&= \\frac{x - x + 2}{(x-2)(x+2)}",
         "sym": "(x-x+2)/((x-2)*(x+2))"
        },
        {
         "tex": "&= \\frac{2}{(x-2)(x+2)}",
         "sym": "2/((x-2)*(x+2))"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{2}{(x-2)(x+2)}"
    },
    "finalSym": "2/((x-2)*(x+2))",
    "answerSym": "together(x/(x**2-4) - 1/(x+2))"
   },
   {
    "question": "Simplify $\\frac{x^2-x-6}{x^2-1} \\div \\frac{x^2-2x-3}{x^2+3x+2}$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Turn the division into a multiplication",
       "lines": [
        {
         "text": "Invert the second fraction."
        },
        {
         "tex": "\\frac{x^2-x-6}{x^2-1} \\div \\frac{x^2-2x-3}{x^2+3x+2} &= \\frac{x^2-x-6}{x^2-1} \\times \\frac{x^2+3x+2}{x^2-2x-3}",
         "sym": "(x**2-x-6)/(x**2-1) / ((x**2-2*x-3)/(x**2+3*x+2))"
        }
       ]
      },
      {
       "title": "Factorise every quadratic",
       "lines": [
        {
         "tex": "x^2 - x - 6 &= (x-3)(x+2)",
         "sym": "(x-3)*(x+2)",
         "new": true
        },
        {
         "tex": "x^2 - 1 &= (x-1)(x+1)",
         "sym": "(x-1)*(x+1)",
         "new": true
        },
        {
         "tex": "x^2 + 3x + 2 &= (x+1)(x+2)",
         "sym": "(x+1)*(x+2)",
         "new": true
        },
        {
         "tex": "x^2 - 2x - 3 &= (x-3)(x+1)",
         "sym": "(x-3)*(x+1)",
         "new": true
        }
       ]
      },
      {
       "title": "Substitute the factors",
       "lines": [
        {
         "tex": "&= \\frac{(x-3)(x+2)}{(x-1)(x+1)} \\times \\frac{(x+1)(x+2)}{(x-3)(x+1)}",
         "sym": "(x-3)*(x+2)/((x-1)*(x+1)) * (x+1)*(x+2)/((x-3)*(x+1))",
         "new": true
        }
       ]
      },
      {
       "title": "Cancel common factors",
       "lines": [
        {
         "text": "Cancel $(x-3)$ and one $(x+1)$ from top and bottom."
        },
        {
         "tex": "&= \\frac{(x+2)(x+2)}{(x-1)(x+1)}",
         "sym": "(x+2)*(x+2)/((x-1)*(x+1))"
        },
        {
         "tex": "&= \\frac{(x+2)^2}{(x-1)(x+1)}",
         "sym": "(x+2)**2/((x-1)*(x+1))"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{(x+2)^2}{(x-1)(x+1)}"
    },
    "finalSym": "(x+2)**2/((x-1)*(x+1))",
    "answerSym": "cancel(((x**2-x-6)/(x**2-1)) / ((x**2-2*x-3)/(x**2+3*x+2)))"
   }
  ]
 }
]