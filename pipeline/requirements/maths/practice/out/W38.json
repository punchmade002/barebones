  "problems": [
   {
    "question": "Find the exact value of $\\sin 60^\\circ \\cos 30^\\circ + \\cos 60^\\circ \\sin 30^\\circ$.",
    "level": "ordinary",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Write each ratio as a surd or fraction",
       "lines": [
        {
         "tex": "\\sin 60^\\circ\\cos 30^\\circ + \\cos 60^\\circ\\sin 30^\\circ &= \\frac{\\sqrt{3}}{2}\\times\\frac{\\sqrt{3}}{2} + \\frac{1}{2}\\times\\frac{1}{2}",
         "sym": "sin(pi/3)*cos(pi/6)+cos(pi/3)*sin(pi/6)"
        }
       ]
      },
      {
       "title": "Multiply",
       "lines": [
        {
         "tex": "&= \\frac{3}{4} + \\frac{1}{4}",
         "sym": "Rational(3,4)+Rational(1,4)"
        }
       ]
      },
      {
       "title": "Add",
       "lines": [
        {
         "tex": "&= 1",
         "sym": "1"
        }
       ]
      }
     ],
     "finalAnswer": "1"
    },
    "finalSym": "1",
    "answerSym": "sin(pi/3)*cos(pi/6)+cos(pi/3)*sin(pi/6)"
   },
   {
    "question": "Find the exact value of $\\cos 210^\\circ$.\\nGive your answer in surd form.",
    "level": "ordinary",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the reference angle",
       "lines": [
        {
         "text": "$210^\\circ$ is in the third quadrant."
        },
        {
         "tex": "\\text{reference angle} &= 210^\\circ - 180^\\circ",
         "sym": "210 - 180"
        },
        {
         "tex": "&= 30^\\circ",
         "sym": "30"
        }
       ]
      },
      {
       "title": "Fix the sign",
       "lines": [
        {
         "text": "Cosine is negative in the third quadrant."
        },
        {
         "tex": "\\cos 210^\\circ &= -\\cos 30^\\circ",
         "sym": "Eq(cos(7*pi/6), -cos(pi/6))",
         "new": true
        }
       ]
      },
      {
       "title": "Use the exact value",
       "lines": [
        {
         "tex": "&= -\\frac{\\sqrt{3}}{2}",
         "sym": "-sqrt(3)/2",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "-\\frac{\\sqrt{3}}{2}"
    },
    "finalSym": "-sqrt(3)/2",
    "answerSym": "cos(7*pi/6)"
   }
  ]
 }
