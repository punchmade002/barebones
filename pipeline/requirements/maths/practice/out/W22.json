    "question": "In triangle $ABC$, $|AB| = |AC|$. The side $BC$ is extended to a point $D$ beyond $C$ and $\\angle ACD = 130^\\circ$.\nFind $\\angle BAC$.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Find $\\angle ACB$",
       "lines": [
        {
         "text": "$B$, $C$ and $D$ lie on a straight line."
        },
        {
         "tex": "\\angle ACB &= 180^\\circ - 130^\\circ",
         "sym": "180 - 130",
         "new": true
        },
        {
         "tex": "&= 50^\\circ",
         "sym": "50"
        }
       ]
      },
      {
       "title": "Find $\\angle ABC$",
       "lines": [
        {
         "text": "$|AB| = |AC|$, so the base angles are equal."
        },
        {
         "tex": "\\angle ABC &= 50^\\circ",
         "sym": "50",
         "new": true
        }
       ]
      },
      {
       "title": "Use Theorem 6",
       "lines": [
        {
         "text": "The exterior angle $\\angle ACD$ equals $\\angle BAC + \\angle ABC$."
        },
        {
         "tex": "130 &= \\angle BAC + 50",
         "sym": "Eq(130, a + 50)",
         "new": true
        },
        {
         "tex": "\\angle BAC &= 130 - 50",
         "sym": "Eq(a, 130 - 50)"
        },
        {
         "tex": "&= 80^\\circ",
         "sym": "Eq(a, 80)"
        }
       ]
      }
     ],
     "finalAnswer": "\\angle BAC = 80^\\circ"
    },
    "finalSym": "80",
    "answerSym": "130 - (180 - 130)"
   }
  ]
 },
