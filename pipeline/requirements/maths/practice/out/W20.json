    "question": "Evaluate $\\lim_{x \\to -2} \\frac{x^2 + 5x + 6}{x + 2}$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Try substituting",
       "lines": [
        {
         "text": "$x = -2$ gives $\\frac{0}{0}$, so factorise the numerator."
        }
       ]
      },
      {
       "title": "Factorise and cancel",
       "lines": [
        {
         "tex": "\\frac{x^2+5x+6}{x+2} &= \\frac{(x+2)(x+3)}{x+2}",
         "sym": "Eq((x**2 + 5*x + 6)/(x + 2), ((x + 2)*(x + 3))/(x + 2))"
        },
        {
         "tex": "&= x + 3",
         "sym": "Eq((x**2 + 5*x + 6)/(x + 2), x + 3)"
        }
       ]
      },
      {
       "title": "Let x approach -2",
       "lines": [
        {
         "tex": "\\lim_{x\\to-2}(x+3) &= -2 + 3",
         "sym": "Eq(L, -2 + 3)",
         "new": true
        },
        {
         "tex": "&= 1",
         "sym": "Eq(L, 1)"
        }
       ]
      }
     ],
     "finalAnswer": "1"
    },
    "finalSym": "1",
    "answerSym": "limit((x**2 + 5*x + 6)/(x + 2), x, -2)"
   },
