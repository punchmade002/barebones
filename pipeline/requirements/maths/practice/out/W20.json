  "problems": [
   {
    "question": "A table of values is drawn up for $y = \\log_3 x$.\nFind the values of $y$ when $x = \\frac{1}{9},\\ 1,\\ 3,\\ 9$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Convert to index form",
       "lines": [
        {
         "text": "$y = \\log_3 x$ means $x = 3^y$. Find the power of $3$ that gives each $x$."
        }
       ]
      },
      {
       "title": "x = 1/9",
       "lines": [
        {
         "tex": "3^y &= \\frac{1}{9}",
         "sym": "Eq(3**y, Rational(1, 9))"
        },
        {
         "tex": "&= 3^{-2}",
         "sym": "Eq(3**y, 3**(-2))"
        },
        {
         "tex": "y &= -2",
         "sym": "Eq(y, -2)"
        }
       ]
      },
      {
       "title": "x = 1 and x = 3",
       "lines": [
        {
         "tex": "3^y &= 1 = 3^0 \\Rightarrow y = 0",
         "sym": "Eq(y, 0)",
         "new": true
        },
        {
         "tex": "3^y &= 3 = 3^1 \\Rightarrow y = 1",
         "sym": "Eq(y, 1)",
         "new": true
        }
       ]
      },
      {
       "title": "x = 9",
       "lines": [
        {
         "tex": "3^y &= 9 = 3^2",
         "sym": "Eq(3**y, 3**2)",
         "new": true
        },
        {
         "tex": "y &= 2",
         "sym": "Eq(y, 2)"
        }
       ]
      },
      {
       "title": "Read off the table",
       "lines": [
        {
         "text": "$x$: $\\frac19$, $1$, $3$, $9$. $y$: $-2$, $0$, $1$, $2$."
        }
       ]
      }
     ],
     "finalAnswer": "y:\\ -2,\\ 0,\\ 1,\\ 2"
    },
    "finalSym": "[-2, 0, 1, 2]",
    "answerSym": "[log(Rational(1, 9), 3), log(1, 3), log(3, 3), log(9, 3)]"
   },
