    "workedSolution": {
     "steps": [
      {
       "title": "Continuity condition",
       "lines": [
        {
         "text": "$f$ is continuous at $x = 3$ when $\\lim_{x\\to3} f(x) = f(3) = k$."
        }
       ]
      },
      {
       "title": "Factorise and cancel",
       "lines": [
        {
         "tex": "\\frac{x^2-x-6}{x-3} &= \\frac{(x-3)(x+2)}{x-3}",
         "sym": "Eq((x**2 - x - 6)/(x - 3), ((x - 3)*(x + 2))/(x - 3))"
        },
        {
         "tex": "&= x + 2",
         "sym": "Eq((x**2 - x - 6)/(x - 3), x + 2)"
        }
       ]
      },
      {
       "title": "Find the limit",
       "lines": [
        {
         "tex": "\\lim_{x\\to3}(x+2) &= 3 + 2",
         "sym": "Eq(L, 3 + 2)",
         "new": true
        },
        {
         "tex": "&= 5",
         "sym": "Eq(L, 5)"
        }
       ]
      },
      {
       "title": "Set k equal to the limit",
       "lines": [
        {
         "tex": "k &= 5",
         "sym": "Eq(k, 5)",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "k = 5"
    },
    "finalSym": "5",
    "answerSym": "limit((x**2 - x - 6)/(x - 3), x, 3)"
   }
  ]
