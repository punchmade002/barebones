   {
    "question": "The function $f:\\mathbb{R} \\to \\mathbb{R}$ is defined by $f(x) = \\frac{5 - 2x}{3}$.\nFind $f^{-1}(x)$, the inverse of $f$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Write y = f(x)",
       "lines": [
        {
         "tex": "y &= \\frac{5-2x}{3}",
         "sym": "Eq(y, (5 - 2*x)/3)"
        }
       ]
      },
      {
       "title": "Swap x and y",
       "lines": [
        {
         "tex": "x &= \\frac{5-2y}{3}",
         "sym": "Eq(x, (5 - 2*y)/3)",
         "new": true
        }
       ]
      },
      {
       "title": "Solve for y",
       "lines": [
        {
         "tex": "3x &= 5 - 2y",
         "sym": "Eq(3*x, 5 - 2*y)"
        },
        {
         "tex": "2y &= 5 - 3x",
         "sym": "Eq(2*y, 5 - 3*x)"
        },
        {
         "tex": "y &= \\frac{5-3x}{2}",
         "sym": "Eq(y, (5 - 3*x)/2)"
        }
       ]
      },
      {
       "title": "Write the inverse",
       "lines": [
        {
         "tex": "f^{-1}(x) &= \\frac{5-3x}{2}",
         "sym": "Eq(y, (5 - 3*x)/2)"
        }
       ]
      }
     ],
     "finalAnswer": "f^{-1}(x) = \\frac{5-3x}{2}"
    },
    "finalSym": "(5 - 3*x)/2",
    "answerSym": "solve(Eq((5 - 2*y)/3, x), y)[0]"
   },
   {
    "question": "$f(x) = \\frac{x+1}{x-2}$ is a bijective function from $\\mathbb{R}\\setminus\\{2\\}$ to $\\mathbb{R}\\setminus\\{1\\}$.\nFind $f^{-1}(x)$, the inverse of $f$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Write y = f(x) and swap x and y",
       "lines": [
        {
         "tex": "y &= \\frac{x+1}{x-2}",
         "sym": "Eq(y, (x + 1)/(x - 2))"
        },
        {
         "tex": "x &= \\frac{y+1}{y-2}",
         "sym": "Eq(x, (y + 1)/(y - 2))",
         "new": true
        }
       ]
      },
      {
       "title": "Clear the fraction",
       "lines": [
        {
         "tex": "x(y-2) &= y+1",
         "sym": "Eq(x*(y - 2), y + 1)"
        },
        {
         "tex": "xy - 2x &= y + 1",
         "sym": "Eq(x*y - 2*x, y + 1)"
        }
       ]
      },
      {
       "title": "Collect the y terms and factorise",
       "lines": [
        {
         "tex": "xy - y &= 2x + 1",
         "sym": "Eq(x*y - y, 2*x + 1)"
        },
        {
         "tex": "y(x-1) &= 2x + 1",
         "sym": "Eq(y*(x - 1), 2*x + 1)"
        }
       ]
      },
      {
       "title": "Solve for y",
       "lines": [
        {
         "tex": "y &= \\frac{2x+1}{x-1}",
         "sym": "Eq(y, (2*x + 1)/(x - 1))"
        }
       ]
      },
      {
       "title": "Write the inverse",
       "lines": [
        {
         "tex": "f^{-1}(x) &= \\frac{2x+1}{x-1}",
         "sym": "Eq(y, (2*x + 1)/(x - 1))"
        }
       ]
      }
     ],
     "finalAnswer": "f^{-1}(x) = \\frac{2x+1}{x-1}"
    },
    "finalSym": "(2*x + 1)/(x - 1)",
    "answerSym": "solve(Eq((y + 1)/(y - 2), x), y)[0]"
   }
  ]
 },
