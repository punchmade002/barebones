  "skill": "alg-factor-quadratic",
  "problems": [
   {
    "question": "Factorise $2x^2 - 7x + 6$.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Find two numbers with product $2 \\times 6 = 12$ and sum $-7$",
       "lines": [
        {
         "text": "The numbers are $-3$ and $-4$."
        }
       ]
      },
      {
       "title": "Split the middle term",
       "lines": [
        {
         "tex": "2x^2 - 7x + 6 &= 2x^2 - 4x - 3x + 6",
         "sym": "2*x**2-4*x-3*x+6"
        }
       ]
      },
      {
       "title": "Factorise by grouping",
       "lines": [
        {
         "tex": "&= 2x(x - 2) - 3(x - 2)",
         "sym": "2*x*(x-2)-3*(x-2)"
        },
        {
         "tex": "&= (2x - 3)(x - 2)",
         "sym": "(2*x-3)*(x-2)"
        }
       ]
      }
     ],
     "finalAnswer": "(2x - 3)(x - 2)"
    },
    "finalSym": "(2*x-3)*(x-2)",
    "answerSym": "factor(2*x**2 - 7*x + 6)"
   }
  ]
 },
 {
  "skill": "alg-fractions-simplify",
  "problems": [
   {
    "question": "Simplify $\\frac{2x^2+7x+3}{x^2-9} \\div \\frac{2x^2+x-1}{x^2-2x-3}$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Turn the division into a multiplication",
       "lines": [
        {
         "text": "Invert the second fraction."
        },
        {
         "tex": "\\frac{2x^2+7x+3}{x^2-9} \\div \\frac{2x^2+x-1}{x^2-2x-3} &= \\frac{2x^2+7x+3}{x^2-9} \\times \\frac{x^2-2x-3}{2x^2+x-1}",
         "sym": "(2*x**2+7*x+3)/(x**2-9) / ((2*x**2+x-1)/(x**2-2*x-3))"
        }
       ]
      },
      {
       "title": "Factorise every quadratic",
       "lines": [
        {
         "tex": "2x^2+7x+3 &= (2x+1)(x+3)",
         "sym": "(2*x+1)*(x+3)",
         "new": true
        },
        {
         "tex": "x^2-9 &= (x-3)(x+3)",
         "sym": "(x-3)*(x+3)",
         "new": true
        },
        {
         "tex": "x^2-2x-3 &= (x-3)(x+1)",
         "sym": "(x-3)*(x+1)",
         "new": true
        },
        {
         "tex": "2x^2+x-1 &= (2x-1)(x+1)",
         "sym": "(2*x-1)*(x+1)",
         "new": true
        }
       ]
      },
      {
       "title": "Substitute the factors",
       "lines": [
        {
         "tex": "&= \\frac{(2x+1)(x+3)}{(x-3)(x+3)} \\times \\frac{(x-3)(x+1)}{(2x-1)(x+1)}",
         "sym": "(2*x+1)*(x+3)/((x-3)*(x+3)) * (x-3)*(x+1)/((2*x-1)*(x+1))",
         "new": true
        }
       ]
      },
      {
       "title": "Cancel common factors",
       "lines": [
        {
         "text": "Cancel $(x+3)$, $(x-3)$ and $(x+1)$ from top and bottom."
        },
        {
         "tex": "&= \\frac{2x+1}{2x-1}",
         "sym": "(2*x+1)/(2*x-1)"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{2x+1}{2x-1}"
    },
    "finalSym": "(2*x+1)/(2*x-1)",
    "answerSym": "cancel((2*x**2+7*x+3)/(x**2-9) / ((2*x**2+x-1)/(x**2-2*x-3)))"
   }
  ]
 },
 {
  "skill": "alg-surd-expressions",
  "problems": [
   {
    "question": "Write $\\frac{1}{\\sqrt{x}+2} + \\frac{1}{\\sqrt{x}-2}$ as a single fraction in its simplest form.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Write over a common denominator",
       "lines": [
        {
         "tex": "\\frac{1}{\\sqrt{x}+2} + \\frac{1}{\\sqrt{x}-2} &= \\frac{(\\sqrt{x}-2) + (\\sqrt{x}+2)}{(\\sqrt{x}+2)(\\sqrt{x}-2)}",
         "sym": "1/(sqrt(x)+2) + 1/(sqrt(x)-2)",
         "new": true
        }
       ]
      },
      {
       "title": "Simplify the numerator",
       "lines": [
        {
         "tex": "(\\sqrt{x}-2) + (\\sqrt{x}+2) &= \\sqrt{x}-2+\\sqrt{x}+2",
         "sym": "(sqrt(x)-2) + (sqrt(x)+2)",
         "new": true
        },
        {
         "tex": "&= 2\\sqrt{x}",
         "sym": "2*sqrt(x)"
        }
       ]
      },
      {
       "title": "Simplify the denominator (difference of two squares)",
       "lines": [
        {
         "tex": "(\\sqrt{x}+2)(\\sqrt{x}-2) &= (\\sqrt{x})^2 - 2^2",
         "sym": "(sqrt(x)+2)*(sqrt(x)-2)",
         "new": true
        },
        {
         "tex": "&= x - 4",
         "sym": "x - 4"
        }
       ]
      },
      {
       "title": "Put the numerator over the denominator",
       "lines": [
        {
         "tex": "\\frac{1}{\\sqrt{x}+2} + \\frac{1}{\\sqrt{x}-2} &= \\frac{2\\sqrt{x}}{x-4}",
         "sym": "2*sqrt(x)/(x-4)",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{2\\sqrt{x}}{x-4}"
    },
    "finalSym": "2*sqrt(x)/(x-4)",
    "answerSym": "1/(sqrt(x)+2) + 1/(sqrt(x)-2)"
   },
   {
    "question": "Write $\\frac{\\sqrt{x}}{\\sqrt{x}+1} - \\frac{\\sqrt{x}}{\\sqrt{x}-1}$ as a single fraction in its simplest form.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Write over a common denominator",
       "lines": [
        {
         "tex": "\\frac{\\sqrt{x}}{\\sqrt{x}+1} - \\frac{\\sqrt{x}}{\\sqrt{x}-1} &= \\frac{\\sqrt{x}(\\sqrt{x}-1) - \\sqrt{x}(\\sqrt{x}+1)}{(\\sqrt{x}+1)(\\sqrt{x}-1)}",
         "sym": "sqrt(x)/(sqrt(x)+1) - sqrt(x)/(sqrt(x)-1)",
         "new": true
        }
       ]
      },
      {
       "title": "Simplify the numerator",
       "lines": [
        {
         "tex": "\\sqrt{x}(\\sqrt{x}-1) - \\sqrt{x}(\\sqrt{x}+1) &= (x - \\sqrt{x}) - (x + \\sqrt{x})",
         "sym": "sqrt(x)*(sqrt(x)-1) - sqrt(x)*(sqrt(x)+1)",
         "new": true
        },
        {
         "tex": "&= -2\\sqrt{x}",
         "sym": "-2*sqrt(x)"
        }
       ]
      },
      {
       "title": "Simplify the denominator (difference of two squares)",
       "lines": [
        {
         "tex": "(\\sqrt{x}+1)(\\sqrt{x}-1) &= (\\sqrt{x})^2 - 1^2",
         "sym": "(sqrt(x)+1)*(sqrt(x)-1)",
         "new": true
        },
        {
         "tex": "&= x - 1",
         "sym": "x - 1"
        }
       ]
      },
      {
       "title": "Put the numerator over the denominator",
       "lines": [
        {
         "tex": "\\frac{\\sqrt{x}}{\\sqrt{x}+1} - \\frac{\\sqrt{x}}{\\sqrt{x}-1} &= \\frac{-2\\sqrt{x}}{x-1}",
         "sym": "-2*sqrt(x)/(x-1)",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{-2\\sqrt{x}}{x-1}"
    },
    "finalSym": "-2*sqrt(x)/(x-1)",
    "answerSym": "sqrt(x)/(sqrt(x)+1) - sqrt(x)/(sqrt(x)-1)"
   }
  ]
 },
 {
  "skill": "circ-general-form",
  "problems": [
   {
    "question": "A circle has equation $x^2 + y^2 + 10x - 4y + 13 = 0$.\nFind the centre and the radius of the circle.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Compare with the general circle equation",
       "lines": [
        {
         "text": "The general form is $x^2 + y^2 + 2gx + 2fy + c = 0$, with centre $(-g, -f)$ and radius $\\sqrt{g^2 + f^2 - c}$."
        },
        {
         "tex": "2g &= 10",
         "sym": "Eq(2*g, 10)",
         "new": true
        },
        {
         "tex": "g &= 5",
         "sym": "Eq(g, 5)"
        },
        {
         "tex": "2f &= -4",
         "sym": "Eq(2*f, -4)",
         "new": true
        },
        {
         "tex": "f &= -2",
         "sym": "Eq(f, -2)"
        },
        {
         "tex": "c &= 13",
         "sym": "Eq(c, 13)",
         "new": true
        }
       ]
      },
      {
       "title": "Write down the centre",
       "lines": [
        {
         "tex": "\\text{Centre} &= (-g, -f)"
        },
        {
         "tex": "&= (-5, 2)",
         "sym": "(-5, 2)",
         "new": true
        }
       ]
      },
      {
       "title": "Find the radius",
       "lines": [
        {
         "tex": "r &= \\sqrt{g^2 + f^2 - c}"
        },
        {
         "tex": "&= \\sqrt{(5)^2 + (-2)^2 - 13}",
         "sym": "sqrt(5**2 + (-2)**2 - 13)",
         "new": true
        },
        {
         "tex": "&= \\sqrt{25 + 4 - 13}",
         "sym": "sqrt(25 + 4 - 13)"
        },
        {
         "tex": "&= \\sqrt{16}",
         "sym": "sqrt(16)"
        },
        {
         "tex": "&= 4",
         "sym": "4"
        }
       ]
      }
     ],
     "finalAnswer": "\\text{Centre} = (-5, 2), \\quad r = 4"
    },
    "finalSym": "[(-5, 2), 4]",
    "answerSym": "[(-10/2, -(-4)/2), sqrt((10/2)**2 + (-4/2)**2 - 13)]"
   }
  ]
 }
]