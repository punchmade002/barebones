 {
  "skill": "diff-slope-tangent",
  "problems": [
   {
    "question": "Find the equation of the tangent to the curve $y = x^3 - 4x$ at the point where $x = -1$.",
    "level": "ordinary",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the slope at x = -1",
       "lines": [
        {
         "text": "Differentiate, then substitute $x = -1$."
        },
        {
         "tex": "\\frac{dy}{dx} &= 3x^2 - 4",
         "sym": "3*x**2 - 4",
         "new": true
        },
        {
         "tex": "m &= 3(-1)^2 - 4 = -1",
         "sym": "3*(-1)**2 - 4",
         "new": true
        }
       ]
      },
      {
       "title": "Find the point on the curve",
       "lines": [
        {
         "tex": "y &= (-1)^3 - 4(-1) = 3",
         "sym": "(-1)**3 - 4*(-1)",
         "new": true
        },
        {
         "text": "The point is $(-1, 3)$."
        }
       ]
      },
      {
       "title": "Use the point-slope formula",
       "lines": [
        {
         "text": "With $m = -1$ and point $(-1, 3)$: $y - y_1 = m(x - x_1)$."
        },
        {
         "tex": "y - 3 &= -1(x + 1)",
         "sym": "Eq(y - 3, -1*(x + 1))",
         "new": true
        },
        {
         "tex": "y &= -x + 2",
         "sym": "Eq(y, -x + 2)"
        }
       ]
      }
     ],
     "finalAnswer": "y = -x + 2"
    },
    "finalSym": "Eq(y, -x + 2)",
    "answerSym": "Eq(y, diff(x**3 - 4*x, x).subs(x, -1)*(x + 1) + (x**3 - 4*x).subs(x, -1))"
   },
   {
    "question": "The curve $y = 2x^2 - 3x + 5$ passes through the point $(2, 7)$.\nFind the equation of the tangent to the curve at $(2, 7)$, in the form $ax + by + c = 0$.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Differentiate to find the slope",
       "lines": [
        {
         "tex": "\\frac{dy}{dx} &= 4x - 3",
         "sym": "4*x - 3",
         "new": true
        }
       ]
      },
      {
       "title": "Find the slope at x = 2",
       "lines": [
        {
         "tex": "m &= 4(2) - 3 = 5",
         "sym": "4*2 - 3",
         "new": true
        }
       ]
      },
      {
       "title": "Use the point-slope formula",
       "lines": [
        {
         "text": "With $m = 5$ and point $(2, 7)$: $y - y_1 = m(x - x_1)$."
        },
        {
         "tex": "y - 7 &= 5(x - 2)",
         "sym": "Eq(y - 7, 5*(x - 2))",
         "new": true
        }
       ]
      },
      {
       "title": "Rearrange",
       "lines": [
        {
         "tex": "y - 7 &= 5x - 10",
         "sym": "Eq(y - 7, 5*x - 10)"
        },
        {
         "tex": "0 &= 5x - y - 3",
         "sym": "Eq(0, 5*x - y - 3)"
        }
       ]
      }
     ],
     "finalAnswer": "5x - y - 3 = 0"
    },
    "finalSym": "Eq(5*x - y - 3, 0)",
    "answerSym": "Eq(diff(2*x**2 - 3*x + 5, x).subs(x, 2)*(x - 2) + 7 - y, 0)"
   }
  ]
 },
 {
  "skill": "fin-estimate",
  "problems": [
   {
    "question": "A tank holds $612.5$ litres of water. It is filled by a pump at a rate of $4.9$ litres per second.\nCalculate how many seconds it takes to fill the tank. Then round each number to 1 significant figure to estimate the time, and compare your estimate with your answer.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Calculate the exact time",
       "lines": [
        {
         "tex": "612.5 \\div 4.9 &= 125",
         "sym": "Rational(6125,10)/Rational(49,10)",
         "new": true
        }
       ]
      },
      {
       "title": "Round each number and estimate",
       "lines": [
        {
         "tex": "612.5 &\\approx 600",
         "sym": "600",
         "new": true,
         "approx": true
        },
        {
         "tex": "4.9 &\\approx 5",
         "sym": "5",
         "new": true,
         "approx": true
        },
        {
         "tex": "600 \\div 5 &= 120",
         "sym": "600/5",
         "new": true
        }
       ]
      },
      {
       "title": "Compare",
       "lines": [
        {
         "text": "The estimate of $120$ seconds is close to the exact time of $125$ seconds, so the answer is sensible."
        }
       ]
      }
     ],
     "finalAnswer": "125 \\text{ seconds (estimate } 120\\text{ seconds)}"
    },
    "finalSym": "125",
    "answerSym": "Rational(6125,10)/Rational(49,10)"
   }
  ]
 },
 {
  "skill": "fin-mortgage-derive",
  "problems": [
   {
    "question": "A loan of $L$ is repaid by $n$ equal annual repayments of $A$. The first repayment is made one year after the loan is taken out. The annual interest rate is $r$ (as a decimal).\nBy writing $L$ as the sum of the repayments in today's money, show that\n$A = \\dfrac{L\\,r(1+r)^n}{(1+r)^n - 1}$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Write the loan as the sum of the repayments in today's money",
       "lines": [
        {
         "text": "A repayment $A$ made at the end of year $k$ is worth $\\frac{A}{(1+r)^k}$ today. Today's value of all $n$ repayments is the loan $L$."
        },
        {
         "tex": "L &= \\frac{A}{1+r} + \\frac{A}{(1+r)^2} + \\cdots + \\frac{A}{(1+r)^n}"
        }
       ]
      },
      {
       "title": "Use the sum of a geometric series",
       "lines": [
        {
         "text": "Geometric with first term $a = \\frac{A}{1+r}$, common ratio $\\frac{1}{1+r}$ and $n$ terms, so $S_n = \\frac{a(1 - \\rho^n)}{1 - \\rho}$ with $\\rho = \\frac{1}{1+r}$."
        },
        {
         "tex": "L &= \\frac{\\frac{A}{1+r}\\left(1 - \\frac{1}{(1+r)^n}\\right)}{1 - \\frac{1}{1+r}}",
         "sym": "(A/(1+r))*(1 - 1/(1+r)**n)/(1 - 1/(1+r))",
         "new": true
        }
       ]
      },
      {
       "title": "Simplify the denominator",
       "lines": [
        {
         "tex": "1 - \\frac{1}{1+r} &= \\frac{1+r-1}{1+r}",
         "sym": "Eq(1 - 1/(1+r), (1+r-1)/(1+r))",
         "new": true
        },
        {
         "tex": "&= \\frac{r}{1+r}",
         "sym": "Eq(1 - 1/(1+r), r/(1+r))",
         "new": true
        }
       ]
      },
      {
       "title": "Cancel the factor 1/(1+r) and tidy up",
       "lines": [
        {
         "tex": "L &= \\frac{A\\left(1 - \\frac{1}{(1+r)^n}\\right)}{r}",
         "sym": "A*(1 - 1/(1+r)**n)/r",
         "new": true
        },
        {
         "tex": "&= \\frac{A\\left((1+r)^n - 1\\right)}{r(1+r)^n}",
         "sym": "A*((1+r)**n - 1)/(r*(1+r)**n)"
        }
       ]
      },
      {
       "title": "Make A the subject",
       "lines": [
        {
         "text": "Multiply both sides by $r(1+r)^n$, then divide both sides by $(1+r)^n - 1$."
        },
        {
         "tex": "L\\,r(1+r)^n &= A\\left((1+r)^n - 1\\right)",
         "sym": "Eq(L*r*(1+r)**n, A*((1+r)**n - 1))",
         "new": true
        },
        {
         "tex": "A &= \\frac{L\\,r(1+r)^n}{(1+r)^n - 1}",
         "sym": "Eq(A, L*r*(1+r)**n/((1+r)**n - 1))",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "A = \\frac{L\\,r(1+r)^n}{(1+r)^n - 1}"
    },
    "finalSym": "0",
    "answerSym": "simplify(summation(A/(1+r)**k, (k, 1, 5)) - A*((1+r)**5 - 1)/(r*(1+r)**5))"
   }
  ]
 },
