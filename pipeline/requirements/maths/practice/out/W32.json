  "skill": "seq-sigma",
  "problems": [
   {
    "question": "Evaluate $\\displaystyle\\sum_{r=1}^{12}(3r - 2)$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the first and last terms",
       "lines": [
        {
         "text": "The terms form an arithmetic series, so find the first term $a$ and last term $l$."
        },
        {
         "tex": "a &= 3(1) - 2 = 1",
         "sym": "3*1 - 2",
         "new": true
        },
        {
         "tex": "l &= 3(12) - 2 = 34",
         "sym": "3*12 - 2",
         "new": true
        }
       ]
      },
      {
       "title": "Count the terms",
       "lines": [
        {
         "tex": "n &= 12 - 1 + 1",
         "sym": "12 - 1 + 1",
         "new": true
        },
        {
         "tex": "&= 12",
         "sym": "12"
        }
       ]
      },
      {
       "title": "Use the sum formula",
       "lines": [
        {
         "tex": "S_{12} &= \\frac{12}{2}(a + l)",
         "sym": "Rational(12,2)*(1 + (34))",
         "new": true
        },
        {
         "tex": "&= \\frac{12}{2}(35)",
         "sym": "Rational(12,2)*(35)"
        },
        {
         "tex": "&= 210",
         "sym": "210"
        }
       ]
      }
     ],
     "finalAnswer": "210"
    },
    "finalSym": "210",
    "answerSym": "summation(3*r - 2, (r, 1, 12))"
   },
