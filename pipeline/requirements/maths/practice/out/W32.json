 {
  "skill": "prob-first-success",
  "problems": [
   {
    "question": "The probability that a spinner lands on red is $\\frac{1}{5}$.\nThe spinner is spun until it lands on red.\nFind the probability that it first lands on red on the 4th spin.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "List the four spins",
       "lines": [
        {
         "text": "First red on the 4th spin means not red, not red, not red, then red."
        },
        {
         "text": "$P(\\text{not red}) = 1 - \\frac{1}{5} = \\frac{4}{5}$."
        },
        {
         "tex": "P(\\text{not red}) &= 1 - \\frac{1}{5}",
         "sym": "1 - Rational(1,5)",
         "new": true
        },
        {
         "tex": "&= \\frac{4}{5}",
         "sym": "Rational(4,5)"
        }
       ]
      },
      {
       "title": "Multiply the probabilities",
       "lines": [
        {
         "tex": "P &= \\frac{4}{5}\\times\\frac{4}{5}\\times\\frac{4}{5}\\times\\frac{1}{5}",
         "sym": "Rational(4,5)**3*Rational(1,5)",
         "new": true
        },
        {
         "tex": "&= \\left(\\frac{4}{5}\\right)^3\\times\\frac{1}{5}",
         "sym": "Rational(4,5)**3*Rational(1,5)"
        },
        {
         "tex": "&= \\frac{64}{125}\\times\\frac{1}{5}",
         "sym": "Rational(64,125)*Rational(1,5)"
        },
        {
         "tex": "&= \\frac{64}{625}",
         "sym": "Rational(64,625)"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{64}{625}"
    },
    "finalSym": "Rational(64,625)",
    "answerSym": "(1 - Rational(1,5))**(4 - 1)*Rational(1,5)"
   }
  ]
 },
 {
  "skill": "prob-selection-restrictions",
  "problems": [
   {
    "question": "A committee of 5 people is to be chosen from 6 men and 7 women.\nThe committee must have exactly 2 men, and one particular woman, Maria, must be on it.\nIn how many ways can the committee be chosen?",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Choose the men",
       "lines": [
        {
         "text": "Choose 2 of the 6 men."
        },
        {
         "tex": "\\binom{6}{2} &= \\frac{6\\times 5}{2\\times 1}",
         "sym": "binomial(6,2)",
         "new": true
        },
        {
         "tex": "&= 15",
         "sym": "15"
        }
       ]
      },
      {
       "title": "Choose the women",
       "lines": [
        {
         "text": "Maria is already on the committee. The other 2 women come from the remaining 6."
        },
        {
         "tex": "\\binom{6}{2} &= \\frac{6\\times 5}{2\\times 1}",
         "sym": "binomial(6,2)",
         "new": true
        },
        {
         "tex": "&= 15",
         "sym": "15"
        }
       ]
      },
      {
       "title": "Multiply the two choices",
       "lines": [
        {
         "tex": "\\binom{6}{2}\\times\\binom{6}{2} &= 15\\times 15",
         "sym": "15*15",
         "new": true
        },
        {
         "tex": "&= 225",
         "sym": "225"
        }
       ]
      }
     ],
     "finalAnswer": "225"
    },
    "finalSym": "225",
    "answerSym": "binomial(6,2)*binomial(7 - 1,5 - 2 - 1)"
   }
  ]
 },
