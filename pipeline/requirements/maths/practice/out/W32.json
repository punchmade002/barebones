    "question": "The first four terms of a sequence are $5, 2, -1, -4, \\dots$\nShow that the sequence is arithmetic and write down its common difference.",
    "level": "ordinary",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the differences between consecutive terms",
       "lines": [
        {
         "tex": "T_2 - T_1 &= 2 - 5",
         "sym": "2 - 5",
         "new": true
        },
        {
         "tex": "&= -3",
         "sym": "-3"
        },
        {
         "tex": "T_3 - T_2 &= -1 - 2",
         "sym": "-1 - 2",
         "new": true
        },
        {
         "tex": "&= -3",
         "sym": "-3"
        },
        {
         "tex": "T_4 - T_3 &= -4 - (-1)",
         "sym": "-4 - (-1)",
         "new": true
        },
        {
         "tex": "&= -3",
         "sym": "-3"
        }
       ]
      },
      {
       "title": "Conclude",
       "lines": [
        {
         "text": "The difference is the same each time, so the sequence is arithmetic with common difference $d = -3$."
        }
       ]
      }
     ],
     "finalAnswer": "d = -3"
    },
    "finalSym": "-3",
    "answerSym": "-4 - (-1)"
   }
  ]
