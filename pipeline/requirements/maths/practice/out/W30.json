    "workedSolution": {
     "steps": [
      {
       "title": "Set up the area as an integral",
       "lines": [
        {
         "tex": "A &= \\int_0^{\\ln 3} 4e^{-2x}\\,dx",
         "sym": "integrate(4*exp(-2*x),(x,0,log(3)))",
         "new": true
        }
       ]
      },
      {
       "title": "Integrate",
       "lines": [
        {
         "text": "$\\int e^{-2x}\\,dx = -\\frac{1}{2}e^{-2x}$."
        },
        {
         "tex": "A &= \\left[-2e^{-2x}\\right]_0^{\\ln 3}"
        }
       ]
      },
      {
       "title": "Substitute the limits",
       "lines": [
        {
         "tex": "A &= -2e^{-2\\ln 3} + 2e^{0}",
         "sym": "-2*exp(-2*log(3)) + 2*exp(0)",
         "new": true
        },
        {
         "tex": "&= -2\\left(\\tfrac{1}{9}\\right) + 2",
         "sym": "-2*(Rational(1,9)) + 2"
        },
        {
         "tex": "&= \\tfrac{16}{9}",
         "sym": "Rational(16,9)"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{16}{9} \\text{ square units}"
    },
    "finalSym": "Rational(16,9)",
    "answerSym": "integrate(4*exp(-2*x),(x,0,log(3)))"
   },
   {
    "question": "Evaluate $\\int_0^2 3^x\\,dx$.\nGive your answer in the form $\\frac{k}{\\ln 3}$, where $k \\in \\mathbb{N}$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Integrate $3^x$",
       "lines": [
        {
         "text": "$\\int a^x\\,dx = \\frac{a^x}{\\ln a}$, here $a = 3$."
        },
        {
         "tex": "\\int_0^2 3^x\\,dx &= \\left[\\frac{3^x}{\\ln 3}\\right]_0^2"
        }
       ]
      },
      {
       "title": "Substitute the limits",
       "lines": [
        {
         "tex": "&= \\frac{3^2}{\\ln 3} - \\frac{3^0}{\\ln 3}",
         "sym": "3**2/log(3) - 3**0/log(3)",
         "new": true
        },
        {
         "tex": "&= \\frac{9 - 1}{\\ln 3}",
         "sym": "(9 - 1)/log(3)"
        },
        {
         "tex": "&= \\frac{8}{\\ln 3}",
         "sym": "8/log(3)"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{8}{\\ln 3}"
    },
    "finalSym": "8/log(3)",
    "answerSym": "integrate(3**x,(x,0,2))"
   }
  ]
 },
 {
