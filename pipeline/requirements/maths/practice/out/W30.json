   {
    "question": "Evaluate $\\int_0^{\\ln 2} e^{3x}\\,dx$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Integrate $e^{3x}$",
       "lines": [
        {
         "text": "$\\int e^{ax}\\,dx = \\frac{1}{a}e^{ax}$, here $a = 3$."
        },
        {
         "tex": "\\int_0^{\\ln 2} e^{3x}\\,dx &= \\left[\\tfrac{1}{3}e^{3x}\\right]_0^{\\ln 2}"
        }
       ]
      },
      {
       "title": "Substitute the limits",
       "lines": [
        {
         "tex": "&= \\tfrac{1}{3}e^{3\\ln 2} - \\tfrac{1}{3}e^{0}",
         "sym": "exp(3*log(2))/3 - exp(0)/3",
         "new": true
        }
       ]
      },
      {
       "title": "Use $e^{3\\ln 2} = e^{\\ln 8} = 8$",
       "lines": [
        {
         "tex": "&= \\tfrac{8}{3} - \\tfrac{1}{3}",
         "sym": "8/3 - 1/3"
        },
        {
         "tex": "&= \\tfrac{7}{3}",
         "sym": "7/3"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{7}{3}"
    },
    "finalSym": "7/3",
    "answerSym": "integrate(exp(3*x),(x,0,log(2)))"
   },
   {
    "question": "Find the area under the curve $y = 4e^{-2x}$ from $x = 0$ to $x = \\ln 3$.",
    "level": "higher",
