   {
    "question": "Evaluate $\\int_0^{\\pi/6} \\sin 3x\\,dx$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Integrate $\\sin 3x$",
       "lines": [
        {
         "text": "$\\int \\sin ax\\,dx = -\\frac{1}{a}\\cos ax$, here $a = 3$."
        },
        {
         "tex": "\\int_0^{\\pi/6} \\sin 3x\\,dx &= \\left[-\\tfrac{1}{3}\\cos 3x\\right]_0^{\\pi/6}"
        }
       ]
      },
      {
       "title": "Substitute the limits",
       "lines": [
        {
         "tex": "&= -\\tfrac{1}{3}\\cos\\left(\\tfrac{\\pi}{2}\\right) + \\tfrac{1}{3}\\cos 0",
         "sym": "-cos(pi/2)/3 + cos(0)/3",
         "new": true
        },
        {
         "tex": "&= 0 + \\tfrac{1}{3}",
         "sym": "0 + Rational(1,3)"
        },
        {
         "tex": "&= \\tfrac{1}{3}",
         "sym": "Rational(1,3)"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{1}{3}"
    },
    "finalSym": "Rational(1,3)",
    "answerSym": "integrate(sin(3*x),(x,0,pi/6))"
   },
   {
    "question": "Evaluate $\\int_0^{\\pi/2} \\left(4\\cos 2x - \\sin x\\right)dx$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Integrate each term",
       "lines": [
        {
         "text": "$\\int \\cos 2x\\,dx = \\frac{1}{2}\\sin 2x$ and $\\int \\sin x\\,dx = -\\cos x$."
        },
        {
         "tex": "\\int_0^{\\pi/2} \\left(4\\cos 2x - \\sin x\\right)dx &= \\left[2\\sin 2x + \\cos x\\right]_0^{\\pi/2}"
        }
       ]
      },
      {
       "title": "Substitute the limits",
       "lines": [
        {
         "tex": "&= \\left(2\\sin\\pi + \\cos\\tfrac{\\pi}{2}\\right) - \\left(2\\sin 0 + \\cos 0\\right)",
         "sym": "(2*sin(pi) + cos(pi/2)) - (2*sin(0) + cos(0))",
         "new": true
        },
        {
         "tex": "&= (0 + 0) - (0 + 1)",
         "sym": "(0 + 0) - (0 + 1)"
        },
        {
         "tex": "&= -1",
         "sym": "-1"
        }
       ]
      }
     ],
     "finalAnswer": "-1"
    },
    "finalSym": "-1",
    "answerSym": "integrate(4*cos(2*x) - sin(x),(x,0,pi/2))"
   }
  ]
 },
 {
  "skill": "int-find-function",
  "problems": [
   {
    "question": "The derivative of a function $f$ is $f'(x) = 6x^2 - 5 + \\frac{4}{x^2}$, where $x \\neq 0$.\nThe graph of $f$ passes through the point $(2, 1)$.\nFind $f(x)$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Write $f'(x)$ with a negative index",
       "lines": [
        {
         "tex": "f'(x) &= 6x^2 - 5 + 4x^{-2}",
         "sym": "6*x**2 - 5 + 4*x**(-2)"
        }
       ]
      },
      {
       "title": "Integrate to get $f(x)$",
       "lines": [
        {
         "tex": "f(x) &= \\int \\left(6x^2 - 5 + 4x^{-2}\\right)dx"
        },
        {
         "tex": "&= 2x^3 - 5x - 4x^{-1} + C",
         "sym": "2*x**3 - 5*x - 4/x + C",
         "new": true
        }
       ]
      },
      {
       "title": "Use the point $(2, 1)$ to find $C$",
       "lines": [
        {
         "text": "$f(2) = 1$."
        },
        {
         "tex": "2(2)^3 - 5(2) - \\frac{4}{2} + C &= 1",
         "sym": "Eq(2*2**3 - 5*2 - 4/2 + C, 1)",
         "new": true
        },
        {
         "tex": "16 - 10 - 2 + C &= 1",
         "sym": "Eq(16 - 10 - 2 + C, 1)"
        },
        {
         "tex": "4 + C &= 1",
         "sym": "Eq(4 + C, 1)"
        },
        {
         "tex": "C &= -3",
         "sym": "Eq(C, -3)"
        }
       ]
      },
      {
       "title": "Write $f(x)$ with $C = -3$",
       "lines": [
        {
         "tex": "f(x) &= 2x^3 - 5x - \\frac{4}{x} - 3",
         "sym": "2*x**3 - 5*x - 4/x - 3",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "f(x) = 2x^3 - 5x - \\frac{4}{x} - 3"
    },
    "finalSym": "2*x**3 - 5*x - 4/x - 3",
    "answerSym": "integrate(6*x**2 - 5 + 4/x**2, x) + 1 - integrate(6*x**2 - 5 + 4/x**2, x).subs(x, 2)"
   }
  ]
 }
