  "problems": [
   {
    "question": "Evaluate $\\int_2^6 \\frac{3}{x}\\,dx$.\nGive your answer in the form $k\\ln 3$, where $k \\in \\mathbb{N}$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Integrate $\\frac{3}{x}$",
       "lines": [
        {
         "text": "$\\int \\frac{1}{x}\\,dx = \\ln|x|$, so the constant 3 stays in front."
        },
        {
         "tex": "\\int_2^6 \\frac{3}{x}\\,dx &= \\left[3\\ln x\\right]_2^6"
        }
       ]
      },
      {
       "title": "Substitute the limits",
       "lines": [
        {
         "tex": "&= 3\\ln 6 - 3\\ln 2",
         "sym": "3*log(6) - 3*log(2)",
         "new": true
        }
       ]
      },
      {
       "title": "Combine the logs",
       "lines": [
        {
         "tex": "&= 3\\ln\\left(\\frac{6}{2}\\right)",
         "sym": "3*log(6/2)"
        },
        {
         "tex": "&= 3\\ln 3",
         "sym": "3*log(3)"
        }
       ]
      }
     ],
     "finalAnswer": "3\\ln 3"
    },
    "finalSym": "3*log(3)",
    "answerSym": "integrate(3/x,(x,2,6))"
   },
   {
    "question": "The curve $y = \\frac{6}{x}$ is drawn for $x > 0$.\nFind the area under the curve between $x = 1$ and $x = 4$.\nGive your answer in the form $k\\ln 2$, where $k \\in \\mathbb{N}$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Set up the area as an integral",
       "lines": [
        {
         "tex": "A &= \\int_1^4 \\frac{6}{x}\\,dx",
         "sym": "integrate(6/x,(x,1,4))",
         "new": true
        }
       ]
      },
      {
       "title": "Integrate and substitute the limits",
       "lines": [
        {
         "tex": "A &= \\left[6\\ln x\\right]_1^4"
        },
        {
         "tex": "&= 6\\ln 4 - 6\\ln 1",
         "sym": "6*log(4) - 6*log(1)",
         "new": true
        }
       ]
      },
      {
       "title": "Simplify using $\\ln 4 = 2\\ln 2$ and $\\ln 1 = 0$",
       "lines": [
        {
         "tex": "A &= 6(2\\ln 2) - 0",
         "sym": "6*(2*log(2)) - 0"
        },
        {
         "tex": "&= 12\\ln 2",
         "sym": "12*log(2)"
        }
       ]
      }
     ],
     "finalAnswer": "12\\ln 2 \\text{ square units}"
    },
    "finalSym": "12*log(2)",
    "answerSym": "integrate(6/x,(x,1,4))"
   },
   {
    "question": "Evaluate $\\int_1^4 \\frac{x+2}{x}\\,dx$.\nGive your answer in the form $a + b\\ln 2$, where $a, b \\in \\mathbb{N}$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Split the fraction",
       "lines": [
        {
         "tex": "\\frac{x+2}{x} &= 1 + \\frac{2}{x}",
         "sym": "Eq((x+2)/x, 1 + 2/x)"
        }
       ]
      },
      {
       "title": "Integrate each term",
       "lines": [
        {
         "tex": "\\int_1^4 \\left(1 + \\frac{2}{x}\\right)dx &= \\left[x + 2\\ln x\\right]_1^4"
        }
       ]
      },
      {
       "title": "Substitute the limits",
       "lines": [
        {
         "tex": "&= (4 + 2\\ln 4) - (1 + 2\\ln 1)",
         "sym": "(4 + 2*log(4)) - (1 + 2*log(1))",
         "new": true
        },
        {
         "tex": "&= 3 + 2\\ln 4",
         "sym": "3 + 2*log(4)"
        },
        {
         "tex": "&= 3 + 4\\ln 2",
         "sym": "3 + 4*log(2)"
        }
       ]
      }
     ],
     "finalAnswer": "3 + 4\\ln 2"
    },
    "finalSym": "3 + 4*log(2)",
    "answerSym": "integrate((x+2)/x,(x,1,4))"
   }
  ]
 },
 {
