    "question": "In triangle $ABC$, $|AB| = 10$ cm, $|BC| = 7$ cm and $\\angle BAC = 30^\\circ$.\nFind the two possible values of $\\angle ACB$, correct to the nearest degree.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Set up the sine rule",
       "lines": [
        {
         "text": "$|AB|$ is opposite $\\angle ACB = C$, and $|BC|$ is opposite $\\angle BAC = 30^\\circ$."
        },
        {
         "tex": "\\frac{\\sin C}{10} &= \\frac{\\sin 30^\\circ}{7}",
         "sym": "Eq(sin(C)/10, sin(pi/6)/7)",
         "new": true
        }
       ]
      },
      {
       "title": "Solve for $\\sin C$",
       "lines": [
        {
         "tex": "\\sin C &= \\frac{10\\sin 30^\\circ}{7}",
         "sym": "Eq(sin(C), 10*sin(pi/6)/7)"
        },
        {
         "tex": "&= \\frac{5}{7}",
         "sym": "Eq(sin(C), Rational(5,7))"
        }
       ]
      },
      {
       "title": "Find both angles between $0^\\circ$ and $180^\\circ$",
       "lines": [
        {
         "text": "Sine is positive in the 1st and 2nd quadrants, so there are two angles."
        },
        {
         "tex": "C &= \\sin^{-1}(5/7) = 45.58^\\circ",
         "sym": "Eq(C, asin(Rational(5,7))*180/pi)",
         "new": true
        },
        {
         "tex": "C &= 180^\\circ - 45.58^\\circ = 134.42^\\circ",
         "sym": "Eq(C, 180 - asin(Rational(5,7))*180/pi)",
         "new": true
        }
       ]
      },
      {
       "title": "Round to the nearest degree",
       "lines": [
        {
         "tex": "C &= 46^\\circ \\ \\text{or}\\ 134^\\circ"
        }
       ]
      }
     ],
     "finalAnswer": "C = 46^\\circ \\ \\text{or}\\ 134^\\circ"
    },
    "finalSym": "[46, 134]",
    "answerSym": "[floor(asin(Rational(5,7))*180/pi + Rational(1,2)), floor(180 - asin(Rational(5,7))*180/pi + Rational(1,2))]"
   },
