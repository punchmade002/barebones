  "skill": "fn-injective-surjective",
  "problems": [
   {
    "question": "Let $f: \\mathbb{R} \\to \\mathbb{R}$ be given by $f(x) = \\frac{x}{3} + 4$.\nProve that $f$ is injective.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Assume two inputs give the same output",
       "lines": [
        {
         "text": "$f$ is injective if $f(a) = f(b)$ forces $a = b$."
        },
        {
         "tex": "f(a) &= f(b)"
        },
        {
         "tex": "\\frac{a}{3} + 4 &= \\frac{b}{3} + 4",
         "sym": "Eq(a/3 + 4, b/3 + 4)",
         "new": true
        }
       ]
      },
      {
       "title": "Solve for a",
       "lines": [
        {
         "tex": "\\frac{a}{3} &= \\frac{b}{3}",
         "sym": "Eq(a/3, b/3)"
        },
        {
         "tex": "a &= b",
         "sym": "Eq(a, b)"
        },
        {
         "text": "Different inputs always give different outputs, so $f$ is injective."
        }
       ]
      }
     ],
     "finalAnswer": "f(a) = f(b) \\Rightarrow a = b \\text{, so } f \\text{ is injective}"
    },
    "finalSym": "0",
    "answerSym": "solve(Eq(a/3 + 4, b/3 + 4), a)[0] - b"
   }
  ]
 },
