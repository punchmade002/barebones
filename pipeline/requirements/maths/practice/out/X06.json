   {
    "question": "Complete the table for $f(x) = \\log_2 x$.\n$x$: $\\frac18$, $\\frac12$, $2$, $8$, $32$.\nWrite down the value of $f(x)$ for each $x$, ready to plot the graph.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Convert to index form",
       "lines": [
        {
         "text": "$y = \\log_2 x$ means $x = 2^y$. Find the power of $2$ that gives each $x$."
        }
       ]
      },
      {
       "title": "x = 1/8 and x = 1/2",
       "lines": [
        {
         "tex": "2^y &= \\frac18 = 2^{-3}",
         "sym": "Eq(2**y, 2**(-3))",
         "new": true
        },
        {
         "tex": "y &= -3",
         "sym": "Eq(y, -3)"
        },
        {
         "tex": "2^y &= \\frac12 = 2^{-1}",
         "sym": "Eq(2**y, 2**(-1))",
         "new": true
        },
        {
         "tex": "y &= -1",
         "sym": "Eq(y, -1)"
        }
       ]
      },
      {
       "title": "x = 2 and x = 8",
       "lines": [
        {
         "tex": "2^y &= 2 = 2^1",
         "sym": "Eq(2**y, 2**1)",
         "new": true
        },
        {
         "tex": "y &= 1",
         "sym": "Eq(y, 1)"
        },
        {
         "tex": "2^y &= 8 = 2^3",
         "sym": "Eq(2**y, 2**3)",
         "new": true
        },
        {
         "tex": "y &= 3",
         "sym": "Eq(y, 3)"
        }
       ]
      },
      {
       "title": "x = 32",
       "lines": [
        {
         "tex": "2^y &= 32 = 2^5",
         "sym": "Eq(2**y, 2**5)",
         "new": true
        },
        {
         "tex": "y &= 5",
         "sym": "Eq(y, 5)"
        }
       ]
      },
      {
       "title": "Read off the table",
       "lines": [
        {
         "text": "$x$: $\\frac18$, $\\frac12$, $2$, $8$, $32$. $f(x)$: $-3$, $-1$, $1$, $3$, $5$."
        }
       ]
      }
     ],
     "finalAnswer": "f(x):\\ -3,\\ -1,\\ 1,\\ 3,\\ 5"
    },
    "finalSym": "[-3, -1, 1, 3, 5]",
    "answerSym": "[log(Rational(1,8),2), log(Rational(1,2),2), log(2,2), log(8,2), log(32,2)]"
   }
