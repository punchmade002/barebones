       "lines": [
        {
         "tex": "(x^2+2x-3)(x^2-x+4) &= x^2(x^2-x+4) + 2x(x^2-x+4) - 3(x^2-x+4)",
         "sym": "Eq((x**2+2*x-3)*(x**2-x+4), x**2*(x**2-x+4) + 2*x*(x**2-x+4) - 3*(x**2-x+4))"
        }
       ]
      },
      {
       "title": "Expand each product",
       "lines": [
        {
         "tex": "&= (x^4 - x^3 + 4x^2) + (2x^3 - 2x^2 + 8x) + (-3x^2 + 3x - 12)",
         "sym": "Eq((x**2+2*x-3)*(x**2-x+4), (x**4-x**3+4*x**2) + (2*x**3-2*x**2+8*x) + (-3*x**2+3*x-12))"
        }
       ]
      },
      {
       "title": "Collect like terms",
       "lines": [
        {
         "tex": "&= x^4 + x^3 - x^2 + 11x - 12",
         "sym": "Eq((x**2+2*x-3)*(x**2-x+4), x**4+x**3-x**2+11*x-12)"
        }
       ]
      }
     ],
     "finalAnswer": "x^4 + x^3 - x^2 + 11x - 12"
    },
    "finalSym": "x**4 + x**3 - x**2 + 11*x - 12",
    "answerSym": "expand((x**2 + 2*x - 3)*(x**2 - x + 4))"
   },
