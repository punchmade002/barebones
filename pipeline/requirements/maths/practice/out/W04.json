   {
    "question": "Show that $(x - 2)(x + 2)(x^2 + 4) = x^4 - 16$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Multiply the first two brackets",
       "lines": [
        {
         "tex": "(x-2)(x+2) &= x^2 + 2x - 2x - 4",
         "sym": "Eq((x-2)*(x+2), x**2+2*x-2*x-4)"
        },
        {
         "tex": "&= x^2 - 4",
         "sym": "Eq((x-2)*(x+2), x**2-4)"
        }
       ]
      },
      {
       "title": "Multiply the result by the third bracket",
       "lines": [
        {
         "tex": "(x-2)(x+2)(x^2+4) &= (x^2-4)(x^2+4)",
         "sym": "Eq((x-2)*(x+2)*(x**2+4), (x**2-4)*(x**2+4))",
         "new": true
        },
        {
         "tex": "&= x^4 + 4x^2 - 4x^2 - 16",
         "sym": "Eq((x-2)*(x+2)*(x**2+4), x**4+4*x**2-4*x**2-16)"
        },
        {
         "tex": "&= x^4 - 16",
         "sym": "Eq((x-2)*(x+2)*(x**2+4), x**4-16)"
        }
       ]
      }
     ],
     "finalAnswer": "x^4 - 16"
    },
    "finalSym": "0",
    "answerSym": "simplify(expand((x - 2)*(x + 2)*(x**2 + 4)) - (x**4 - 16))"
   }
  ]
