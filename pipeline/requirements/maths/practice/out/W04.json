 {
  "skill": "alg-factor-cubes",
  "problems": [
   {
    "question": "Factorise $27x^3 + 8$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Write each term as a cube",
       "lines": [
        {
         "tex": "27x^3 + 8 &= (3x)^3 + 2^3",
         "sym": "Eq(27*x**3+8, (3*x)**3+2**3)"
        }
       ]
      },
      {
       "title": "Use $a^3 + b^3 = (a+b)(a^2 - ab + b^2)$ with $a=3x$, $b=2$",
       "lines": [
        {
         "tex": "&= (3x+2)\\left((3x)^2 - (3x)(2) + 2^2\\right)",
         "sym": "Eq(27*x**3+8, (3*x+2)*((3*x)**2-(3*x)*2+2**2))"
        }
       ]
      },
      {
       "title": "Simplify the second bracket",
       "lines": [
        {
         "tex": "&= (3x+2)(9x^2 - 6x + 4)",
         "sym": "Eq(27*x**3+8, (3*x+2)*(9*x**2-6*x+4))"
        }
       ]
      }
     ],
     "finalAnswer": "(3x+2)(9x^2-6x+4)"
    },
    "finalSym": "(3*x+2)*(9*x**2-6*x+4)",
    "answerSym": "factor(27*x**3 + 8)"
   },
   {
