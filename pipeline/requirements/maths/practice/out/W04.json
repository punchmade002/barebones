       "lines": [
        {
         "tex": "x^3 - 64y^3 &= x^3 - (4y)^3",
         "sym": "Eq(x**3-64*y**3, x**3-(4*y)**3)"
        }
       ]
      },
      {
       "title": "Use $a^3 - b^3 = (a-b)(a^2 + ab + b^2)$ with $a=x$, $b=4y$",
       "lines": [
        {
         "tex": "&= (x-4y)\\left(x^2 + x(4y) + (4y)^2\\right)",
         "sym": "Eq(x**3-64*y**3, (x-4*y)*(x**2+x*4*y+(4*y)**2))"
        }
       ]
      },
      {
       "title": "Simplify the second bracket",
       "lines": [
        {
         "tex": "&= (x-4y)(x^2 + 4xy + 16y^2)",
         "sym": "Eq(x**3-64*y**3, (x-4*y)*(x**2+4*x*y+16*y**2))"
        }
       ]
      }
     ],
     "finalAnswer": "(x-4y)(x^2+4xy+16y^2)"
    },
    "finalSym": "(x-4*y)*(x**2+4*x*y+16*y**2)",
    "answerSym": "factor(x**3 - 64*y**3)"
   },
   {
    "question": "Factorise fully $54x^3 - 2$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Take out the common factor 2",
       "lines": [
        {
         "tex": "54x^3 - 2 &= 2(27x^3 - 1)",
         "sym": "Eq(54*x**3-2, 2*(27*x**3-1))"
        }
       ]
      },
      {
       "title": "Write the bracket as a difference of cubes",
       "lines": [
        {
         "tex": "&= 2\\left((3x)^3 - 1^3\\right)",
         "sym": "Eq(54*x**3-2, 2*((3*x)**3-1**3))"
        }
       ]
      },
      {
       "title": "Use $a^3 - b^3 = (a-b)(a^2 + ab + b^2)$ with $a=3x$, $b=1$",
       "lines": [
        {
         "tex": "&= 2(3x-1)\\left((3x)^2 + (3x)(1) + 1^2\\right)",
         "sym": "Eq(54*x**3-2, 2*(3*x-1)*((3*x)**2+(3*x)*1+1**2))"
        }
       ]
      },
      {
       "title": "Simplify the second bracket",
       "lines": [
        {
         "tex": "&= 2(3x-1)(9x^2 + 3x + 1)",
         "sym": "Eq(54*x**3-2, 2*(3*x-1)*(9*x**2+3*x+1))"
        }
       ]
      }
     ],
     "finalAnswer": "2(3x-1)(9x^2+3x+1)"
    },
    "finalSym": "2*(3*x-1)*(9*x**2+3*x+1)",
    "answerSym": "factor(54*x**3 - 2)"
   }
  ]
 }
]