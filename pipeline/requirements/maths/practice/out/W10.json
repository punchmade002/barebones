         "new": true
        },
        {
         "tex": "k &= 6",
         "sym": "Eq(k, 6)"
        }
       ]
      }
     ],
     "finalAnswer": "k = 6"
    },
    "finalSym": "[6]",
    "answerSym": "solve(Eq(k/3, Rational(8-2,4-1)), k)"
   },
   {
    "question": "The line $4x + (k+1)y = 9$ is parallel to the line $6x - 3y = 2$.\nFind the value of $k$.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the slope of $6x - 3y = 2$",
       "lines": [
        {
         "tex": "6x - 3y &= 2",
         "sym": "Eq(6*x-3*y,2)",
         "new": true
        },
        {
         "tex": "3y &= 6x - 2",
         "sym": "Eq(3*y,6*x-2)"
        },
        {
         "tex": "y &= 2x - \\frac23",
         "sym": "Eq(y,2*x-Rational(2,3))"
        },
        {
         "text": "So the slope is $2$."
        }
       ]
      },
      {
       "title": "Find the slope of $4x + (k+1)y = 9$",
       "lines": [
        {
         "tex": "(k+1)y &= -4x + 9",
         "sym": "Eq((k+1)*y,-4*x+9)",
         "new": true
        },
        {
         "tex": "y &= -\\frac{4}{k+1}x + \\frac{9}{k+1}",
         "sym": "Eq(y,-4/(k+1)*x+9/(k+1))"
        },
        {
         "text": "So the slope is $-\\frac{4}{k+1}$."
        }
       ]
      },
      {
       "title": "Parallel lines have equal slopes",
       "lines": [
        {
         "tex": "-\\frac{4}{k+1} &= 2",
         "sym": "Eq(-4/(k+1), 2)",
         "new": true
        },
        {
         "tex": "-4 &= 2(k+1)",
         "sym": "Eq(-4, 2*(k+1))"
        },
        {
         "tex": "-4 &= 2k + 2",
         "sym": "Eq(-4, 2*k+2)"
        },
        {
         "tex": "2k &= -6",
         "sym": "Eq(2*k, -6)"
        },
        {
         "tex": "k &= -3",
         "sym": "Eq(k, -3)"
        }
       ]
      }
     ],
     "finalAnswer": "k = -3"
    },
    "finalSym": "[-3]",
    "answerSym": "solve(Eq(-4/(k+1), Rational(6,3)), k)"
   }
  ]
 },
 {
  "skill": "line-from-distance",
  "problems": [
   {
    "question": "Find the slopes of the two lines through the origin that are at a perpendicular distance of $5$ from the point $(7, 1)$.",
    "level": "higher",
    "marks": 15,
    "workedSolution": {
     "steps": [
      {
       "title": "Write the line through the origin",
       "lines": [
        {
         "text": "A line through $O(0,0)$ with slope $m$ is $y = mx$."
        },
        {
         "tex": "mx - y &= 0",
         "sym": "Eq(m*x-y,0)",
         "new": true
        }
       ]
      },
      {
       "title": "Use the distance formula",
       "lines": [
        {
         "text": "Distance from $(7,1)$ to $mx - y = 0$ equals $5$."
        },
        {
         "tex": "\\frac{|7m - 1|}{\\sqrt{m^2+1}} &= 5",
         "sym": "Eq(Abs(7*m-1)/sqrt(m**2+1), 5)",
         "new": true
        },
        {
         "tex": "(7m-1)^2 &= 25(m^2+1)",
         "sym": "Eq((7*m-1)**2, 25*(m**2+1))",
         "new": true
        }
       ]
      },
      {
       "title": "Form the quadratic",
       "lines": [
        {
         "tex": "49m^2 - 14m + 1 &= 25m^2 + 25",
         "sym": "Eq(49*m**2-14*m+1, 25*m**2+25)"
        },
        {
         "tex": "24m^2 - 14m - 24 &= 0",
         "sym": "Eq(24*m**2-14*m-24, 0)"
        },
        {
         "tex": "12m^2 - 7m - 12 &= 0",
         "sym": "Eq(12*m**2-7*m-12, 0)"
        }
       ]
      },
      {
       "title": "Solve with the quadratic formula",
       "lines": [
        {
         "tex": "m &= \\frac{7 \\pm \\sqrt{49 + 576}}{24}",
         "sym": "[(7-sqrt(49+576))/24, (7+sqrt(49+576))/24]",
         "new": true
        },
        {
         "tex": "&= \\frac{7 \\pm 25}{24}",
         "sym": "[(7-25)/24, (7+25)/24]"
        },
        {
         "tex": "&= -\\frac34 \\text{ or } \\frac43",
         "sym": "[Rational(-3,4), Rational(4,3)]"
        }
       ]
      }
     ],
     "finalAnswer": "m = -\\frac34 \\text{ or } m = \\frac43"
    },
    "finalSym": "[Rational(-3,4), Rational(4,3)]",
    "answerSym": "solve(Eq((7*m-1)**2/(m**2+1), 25), m)"
   },
   {
    "question": "A straight pipe starts at the point $A(2, 3)$ and must pass at a perpendicular distance of exactly $1$ from a post at $B(6, 10)$.\nFind the slopes of the two possible lines for the pipe.",
    "level": "higher",
    "marks": 15,
    "workedSolution": {
     "steps": [
      {
       "title": "Write the line through A",
       "lines": [
        {
         "text": "Slope $m$ through $(2,3)$: $y - 3 = m(x - 2)$."
        },
        {
         "tex": "y - 3 &= m(x-2)",
         "sym": "Eq(y-3, m*(x-2))",
         "new": true
        },
        {
         "tex": "mx - y + 3 - 2m &= 0",
         "sym": "Eq(m*x-y+3-2*m, 0)"
        }
       ]
      },
      {
       "title": "Use the distance formula",
       "lines": [
        {
         "text": "Distance from $B(6,10)$ equals $1$."
        },
        {
         "tex": "\\frac{|6m - 10 + 3 - 2m|}{\\sqrt{m^2+1}} &= 1",
         "sym": "Eq(Abs(6*m-10+3-2*m)/sqrt(m**2+1), 1)",
         "new": true
        },
        {
         "tex": "\\frac{|4m - 7|}{\\sqrt{m^2+1}} &= 1",
         "sym": "Eq(Abs(4*m-7)/sqrt(m**2+1), 1)"
        },
        {
         "tex": "(4m-7)^2 &= m^2+1",
         "sym": "Eq((4*m-7)**2, m**2+1)",
         "new": true
        }
       ]
      },
      {
       "title": "Form the quadratic",
       "lines": [
        {
         "tex": "16m^2 - 56m + 49 &= m^2 + 1",
         "sym": "Eq(16*m**2-56*m+49, m**2+1)"
        },
        {
         "tex": "15m^2 - 56m + 48 &= 0",
         "sym": "Eq(15*m**2-56*m+48, 0)"
        }
       ]
      },
      {
       "title": "Solve with the quadratic formula",
       "lines": [
        {
         "tex": "m &= \\frac{56 \\pm \\sqrt{3136 - 2880}}{30}",
         "sym": "[(56-sqrt(3136-2880))/30, (56+sqrt(3136-2880))/30]",
         "new": true
        },
        {
         "tex": "&= \\frac{56 \\pm 16}{30}",
         "sym": "[(56-16)/30, (56+16)/30]"
        },
        {
         "tex": "&= \\frac43 \\text{ or } \\frac{12}{5}",
         "sym": "[Rational(4,3), Rational(12,5)]"
        }
       ]
      }
     ],
     "finalAnswer": "m = \\frac43 \\text{ or } m = \\frac{12}{5}"
    },
    "finalSym": "[Rational(4,3), Rational(12,5)]",
    "answerSym": "solve(Eq((m*(6-2)-(10-3))**2/(m**2+1), 1), m)"
   }
  ]
 },
 {
  "skill": "num-order-operations",
