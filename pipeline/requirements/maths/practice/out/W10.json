   {
    "question": "Evaluate $20 - 3 \\times (4 - 7)^2 + 5$.",
    "level": "ordinary",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Brackets first",
       "lines": [
        {
         "tex": "20 - 3 \\times (4-7)^2 + 5 &= 20 - 3 \\times (-3)^2 + 5",
         "sym": "20 - 3*(-3)**2 + 5"
        }
       ]
      },
      {
       "title": "Then the power",
       "lines": [
        {
         "tex": "&= 20 - 3 \\times 9 + 5",
         "sym": "20 - 3*9 + 5"
        }
       ]
      },
      {
       "title": "Then multiply",
       "lines": [
        {
         "tex": "&= 20 - 27 + 5",
         "sym": "20 - 27 + 5"
        }
       ]
      },
      {
       "title": "Then add and subtract from left to right",
       "lines": [
        {
         "tex": "&= -7 + 5",
         "sym": "-7 + 5"
        },
        {
         "tex": "&= -2",
         "sym": "-2"
        }
       ]
      }
     ],
     "finalAnswer": "-2"
    },
    "finalSym": "-2",
    "answerSym": "20 - 3*(4-7)**2 + 5"
   },
   {
    "question": "Evaluate $\\left(\\frac12\\right)^2 + 6 \\times \\frac13 - \\frac34$.",
    "level": "ordinary",
