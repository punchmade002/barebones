  "skill": "line-collinear",
  "problems": [
   {
    "question": "Show that the points $P(-2, 5)$, $Q(1, 2)$ and $R(4, -1)$ are collinear.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the slope of PQ",
       "lines": [
        {
         "text": "Slope formula for $P(-2,5)$ and $Q(1,2)$."
        },
        {
         "tex": "m_{PQ} &= \\frac{2-5}{1-(-2)}",
         "sym": "(2-5)/(1-(-2))",
         "new": true
        },
        {
         "tex": "&= \\frac{-3}{3}",
         "sym": "Rational(-3,3)"
        },
        {
         "tex": "&= -1",
         "sym": "-1"
        }
       ]
      },
      {
       "title": "Find the slope of QR",
       "lines": [
        {
         "text": "Slope formula for $Q(1,2)$ and $R(4,-1)$."
        },
        {
         "tex": "m_{QR} &= \\frac{-1-2}{4-1}",
         "sym": "(-1-2)/(4-1)",
         "new": true
        },
        {
         "tex": "&= \\frac{-3}{3}",
         "sym": "Rational(-3,3)"
        },
        {
         "tex": "&= -1",
         "sym": "-1"
        }
       ]
      },
      {
       "title": "Compare the slopes",
       "lines": [
        {
         "text": "$m_{PQ} = m_{QR} = -1$, and $Q$ is on both segments, so $P$, $Q$ and $R$ lie on one line."
        }
       ]
      }
     ],
     "finalAnswer": "m_{PQ} = m_{QR} = -1 \\text{, so } P, Q, R \\text{ are collinear}"
    },
    "finalSym": "0",
    "answerSym": "Rational(2-5,1-(-2)) - Rational(-1-2,4-1)"
   },
