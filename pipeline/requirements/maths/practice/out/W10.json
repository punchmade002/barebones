     "steps": [
      {
       "title": "Powers first",
       "lines": [
        {
         "tex": "\\left(\\frac12\\right)^2 + 6 \\times \\frac13 - \\frac34 &= \\frac14 + 6 \\times \\frac13 - \\frac34",
         "sym": "Rational(1,4) + 6*Rational(1,3) - Rational(3,4)"
        }
       ]
      },
      {
       "title": "Then multiply",
       "lines": [
        {
         "tex": "&= \\frac14 + 2 - \\frac34",
         "sym": "Rational(1,4) + 2 - Rational(3,4)"
        }
       ]
      },
      {
       "title": "Write over a common denominator",
       "lines": [
        {
         "tex": "&= \\frac14 + \\frac84 - \\frac34",
         "sym": "Rational(1,4) + Rational(8,4) - Rational(3,4)"
        }
       ]
      },
      {
       "title": "Add and subtract",
       "lines": [
        {
         "tex": "&= \\frac64",
         "sym": "Rational(6,4)"
        },
        {
         "tex": "&= \\frac32",
         "sym": "Rational(3,2)"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac32"
    },
    "finalSym": "Rational(3,2)",
    "answerSym": "Rational(1,2)**2 + 6*Rational(1,3) - Rational(3,4)"
   },
   {
    "question": "Evaluate $\\dfrac{(5 - 2)^3 + 9}{4 \\times 3 - 6} - \\sqrt{49}$.",
    "level": "ordinary",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Brackets and powers on the top",
       "lines": [
        {
         "tex": "(5-2)^3 + 9 &= 3^3 + 9",
         "sym": "3**3 + 9",
         "new": true
        },
        {
         "tex": "&= 27 + 9",
         "sym": "27 + 9"
        },
        {
         "tex": "&= 36",
         "sym": "36"
        }
       ]
      },
      {
       "title": "Multiply on the bottom",
       "lines": [
        {
         "tex": "4 \\times 3 - 6 &= 12 - 6",
         "sym": "12 - 6",
         "new": true
        },
        {
         "tex": "&= 6",
         "sym": "6"
        }
       ]
      },
      {
       "title": "Divide, and find the root",
       "lines": [
        {
         "tex": "\\frac{36}{6} - \\sqrt{49} &= 6 - 7",
         "sym": "6 - 7",
         "new": true
        }
       ]
      },
      {
       "title": "Subtract",
       "lines": [
        {
         "tex": "6 - 7 &= -1",
         "sym": "-1"
        }
       ]
      }
     ],
     "finalAnswer": "-1"
    },
    "finalSym": "-1",
    "answerSym": "((5-2)**3 + 9)/(4*3 - 6) - sqrt(49)"
   }
  ]
 }
