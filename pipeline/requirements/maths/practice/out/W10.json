    "workedSolution": {
     "steps": [
      {
       "title": "Find the slope of AB",
       "lines": [
        {
         "tex": "m &= \\frac{8-2}{4-1}",
         "sym": "(8-2)/(4-1)",
         "new": true
        },
        {
         "tex": "&= \\frac{6}{3}",
         "sym": "Rational(6,3)"
        },
        {
         "tex": "&= 2",
         "sym": "2"
        }
       ]
      },
      {
       "title": "Find the slope of the first line",
       "lines": [
        {
         "tex": "kx - 3y + 4 &= 0",
         "sym": "Eq(k*x-3*y+4,0)",
