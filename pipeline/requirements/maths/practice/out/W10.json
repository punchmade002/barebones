 {
  "skill": "line-unknown-coefficient",
  "problems": [
   {
    "question": "The line $2x + ky = 7$ is perpendicular to the line $3x - 2y = 4$.\nFind the value of $k$.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the slope of each line",
       "lines": [
        {
         "text": "Make $y$ the subject of each equation."
        },
        {
         "tex": "2x + ky &= 7",
         "sym": "Eq(2*x+k*y,7)",
         "new": true
        },
        {
         "tex": "y &= -\\frac{2}{k}x + \\frac{7}{k}",
         "sym": "Eq(y, -2/k*x + 7/k)",
         "new": false
        },
        {
         "text": "So $m_1 = -\\frac{2}{k}$."
        },
        {
         "tex": "3x - 2y &= 4",
         "sym": "Eq(3*x-2*y,4)",
         "new": true
        },
        {
         "tex": "y &= \\frac32 x - 2",
         "sym": "Eq(y, Rational(3,2)*x - 2)"
        },
        {
         "text": "So $m_2 = \\frac32$."
        }
       ]
      },
      {
       "title": "Use the perpendicular condition",
       "lines": [
        {
         "text": "Perpendicular lines have $m_1 m_2 = -1$."
        },
        {
         "tex": "-\\frac{2}{k} \\cdot \\frac32 &= -1",
         "sym": "Eq(-2/k*Rational(3,2), -1)",
         "new": true
        },
        {
         "tex": "-\\frac{3}{k} &= -1",
         "sym": "Eq(-3/k, -1)"
        }
       ]
      },
      {
       "title": "Solve for k",
       "lines": [
        {
         "tex": "k &= 3",
         "sym": "Eq(k, 3)"
        }
       ]
      }
     ],
     "finalAnswer": "k = 3"
    },
    "finalSym": "[3]",
    "answerSym": "solve(Eq((-2/k)*Rational(3,2), -1), k)"
   },
   {
    "question": "The line $kx - 3y + 4 = 0$ is parallel to the line through $A(1, 2)$ and $B(4, 8)$.\nFind the value of $k$.",
    "level": "ordinary",
