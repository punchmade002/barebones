        },
        {
         "tex": "&\\approx 67.6602",
         "sym": "67.6602",
         "approx": true
        }
       ]
      },
      {
       "title": "Multiply by 150",
       "lines": [
        {
         "tex": "\\text{Total} &= 150 \\times 67.6602",
         "sym": "150*67.6602",
         "new": true,
         "approx": true
        },
        {
         "tex": "&\\approx 10149.03",
         "sym": "10149.03",
         "approx": true
        }
       ]
      }
     ],
     "finalAnswer": "\\text{€}10149.03"
    },
    "finalSym": "10149.03",
    "answerSym": "150*(Rational(1004,1000)**60 - 1)/(Rational(1004,1000) - 1)"
   }
  ]
