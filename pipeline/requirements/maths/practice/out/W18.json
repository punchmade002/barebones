 {
  "skill": "fin-annuity-pv",
  "problems": [
   {
    "question": "A pension fund pays $\\text{€}12\\,000$ at the end of each year for 15 years. Money is discounted at $4\\%$ per year.\\nFind the present value of all 15 payments, correct to the nearest euro.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Present value of each payment",
       "lines": [
        {
         "text": "A payment made after $k$ years is divided by $1.04$ once for each year."
        },
        {
         "text": "$PV = \\dfrac{12000}{1.04} + \\dfrac{12000}{1.04^2} + \\cdots + \\dfrac{12000}{1.04^{15}}$"
        }
       ]
      },
      {
       "title": "Identify the geometric series",
       "lines": [
        {
         "text": "Geometric with $n = 15$ terms."
        },
        {
         "tex": "a &= \\frac{12000}{1.04}",
         "sym": "12000/1.04",
         "new": true
        },
        {
         "tex": "r &= \\frac{1}{1.04}",
         "sym": "1/1.04",
         "new": true
        }
       ]
      },
      {
       "title": "Use the sum formula",
       "lines": [
        {
         "tex": "S_{15} &= \\frac{a(1 - r^n)}{1 - r}",
         "sym": "(12000/1.04)*(1 - (1/1.04)**15)/(1 - 1/1.04)",
         "new": true
        },
        {
         "tex": "&= \\frac{\\frac{12000}{1.04}\\left(1 - \\left(\\frac{1}{1.04}\\right)^{15}\\right)}{1 - \\frac{1}{1.04}}",
         "sym": "(12000/1.04)*(1 - (1/1.04)**15)/(1 - 1/1.04)"
        }
       ]
      },
      {
       "title": "Evaluate",
       "lines": [
        {
         "tex": "PV &\\approx 133\\,420.65",
         "sym": "133420.65",
         "approx": true
        },
        {
         "text": "To the nearest euro this is $\\text{€}133\\,421$."
        },
        {
         "tex": "PV &\\approx 133\\,421",
         "sym": "133421",
         "approx": true
        }
       ]
      }
     ],
     "finalAnswer": "\\text{€}133\\,421"
    },
    "finalSym": "133421",
    "answerSym": "round(sum(12000/Rational(104,100)**k for k in range(1,16)))"
   }
  ]
 },
 {
  "skill": "fin-mortgage-derive",
  "problems": [
   {
    "question": "A loan of $\\text{€}P$ is repaid by $t$ equal monthly repayments of $\\text{€}A$. The first repayment is made immediately and each of the others is made at the end of each following month. The monthly interest rate is $i$.\\nBy writing $P$ as the sum of the present values of the repayments, prove that\\n$$A = \\frac{P\\,i(1+i)^{t-1}}{(1+i)^t - 1}.$$",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Write the loan as the sum of the repayments in today's money",
       "lines": [
        {
         "text": "The first repayment is made now, so it is worth $A$. A repayment made after $k$ months is worth $\\frac{A}{(1+i)^k}$ today."
        },
        {
         "tex": "P &= A + \\frac{A}{1+i} + \\frac{A}{(1+i)^2} + \\cdots + \\frac{A}{(1+i)^{t-1}}"
        }
       ]
      },
      {
       "title": "Identify the geometric series",
       "lines": [
        {
         "text": "Geometric with first term $a = A$, common ratio $r = \\frac{1}{1+i}$ and $t$ terms."
        },
        {
         "tex": "P &= \\frac{A\\left(1 - \\left(\\frac{1}{1+i}\\right)^t\\right)}{1 - \\frac{1}{1+i}}",
         "sym": "A*(1 - (1/(1+i))**t)/(1 - 1/(1+i))",
         "new": true
        }
       ]
      },
      {
       "title": "Simplify the denominator",
       "lines": [
        {
         "tex": "1 - \\frac{1}{1+i} &= \\frac{1+i-1}{1+i}",
         "sym": "Eq(1 - 1/(1+i), (1+i-1)/(1+i))",
         "new": true
        },
        {
         "tex": "&= \\frac{i}{1+i}",
         "sym": "Eq(1 - 1/(1+i), i/(1+i))",
         "new": true
        }
       ]
      },
      {
       "title": "Divide by the fraction and tidy up",
       "lines": [
        {
         "tex": "P &= \\frac{A(1+i)\\left(1 - \\frac{1}{(1+i)^t}\\right)}{i}",
         "sym": "A*(1+i)*(1 - 1/(1+i)**t)/i",
         "new": true
        },
        {
         "tex": "&= \\frac{A(1+i)\\left((1+i)^t - 1\\right)}{i(1+i)^t}",
         "sym": "A*(1+i)*((1+i)**t - 1)/(i*(1+i)**t)"
        },
        {
         "tex": "&= \\frac{A\\left((1+i)^t - 1\\right)}{i(1+i)^{t-1}}",
         "sym": "A*((1+i)**t - 1)/(i*(1+i)**(t-1))"
        }
       ]
      },
      {
       "title": "Make A the subject",
       "lines": [
        {
         "text": "Multiply both sides by $i(1+i)^{t-1}$, then divide by $(1+i)^t - 1$."
        },
        {
         "tex": "A &= \\frac{P\\,i(1+i)^{t-1}}{(1+i)^t - 1}",
         "sym": "Eq(A, P*i*(1+i)**(t-1)/((1+i)**t - 1))",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "A = \\frac{P\\,i(1+i)^{t-1}}{(1+i)^t - 1}"
    },
    "finalSym": "0",
    "answerSym": "simplify(summation(1/Rational(101,100)**k,(k,0,11)) - (Rational(101,100)**12 - 1)/(Rational(1,100)*Rational(101,100)**11))"
   }
  ]
 },
