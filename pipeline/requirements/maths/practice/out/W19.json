       "lines": [
        {
         "text": "As $t$ gets very large, $e^{-0.2t}$ gets closer and closer to $0$."
        },
        {
         "tex": "\\lim_{t \\to \\infty} e^{-0.2t} &= 0",
         "sym": "Eq(limit(exp(-t/5), t, oo), 0)",
         "new": true
        }
       ]
      },
      {
       "title": "Put this into $T(t)$",
       "lines": [
        {
         "tex": "T(t) &\\to 5 + 40(0)",
         "sym": "5 + 40*0",
         "new": true
        },
        {
         "tex": "&= 5",
         "sym": "5"
        }
       ]
      }
     ],
     "finalAnswer": "5"
    },
    "finalSym": "5",
    "answerSym": "limit(5 + 40*exp(-t/5), t, oo)"
   }
  ]
