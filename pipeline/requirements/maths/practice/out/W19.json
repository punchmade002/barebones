 {
  "skill": "fn-composite",
  "problems": [
   {
    "question": "$f(x) = 3x - 2$ and $g(x) = x^2 + 1$.\nFind $g(f(x))$, in the form $ax^2 + bx + c$.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Put $f(x)$ in place of $x$ in $g$",
       "lines": [
        {
         "tex": "g(f(x)) &= g(3x - 2)"
        },
        {
         "tex": "&= (3x - 2)^2 + 1",
         "sym": "(3*x - 2)**2 + 1",
         "new": true
        }
       ]
      },
      {
       "title": "Multiply out the bracket",
       "lines": [
        {
         "tex": "&= (3x-2)(3x-2) + 1",
         "sym": "(3*x - 2)*(3*x - 2) + 1"
        },
        {
         "tex": "&= 9x^2 - 12x + 4 + 1",
         "sym": "9*x**2 - 12*x + 4 + 1"
        }
       ]
      },
      {
       "title": "Collect like terms",
       "lines": [
        {
         "tex": "&= 9x^2 - 12x + 5",
         "sym": "9*x**2 - 12*x + 5"
        }
       ]
      }
     ],
     "finalAnswer": "9x^2 - 12x + 5"
    },
    "finalSym": "9*x**2 - 12*x + 5",
    "answerSym": "expand((x**2 + 1).subs(x, 3*x - 2))"
   }
  ]
 },
 {
  "skill": "fn-injective-surjective",
  "problems": [
   {
    "question": "$f: \\mathbb{R} \\to \\mathbb{R}$ is defined by $f(x) = x^2 - 6x + 5$.\nShow that $f$ is not injective by finding a value $b \\neq 0$ such that $f(b) = f(0)$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Find $f(0)$",
       "lines": [
        {
         "tex": "f(0) &= 0^2 - 6(0) + 5 = 5",
         "sym": "Eq(0**2 - 6*0 + 5, 5)",
         "new": true
        }
       ]
      },
      {
       "title": "Look for another input with the same output",
       "lines": [
        {
         "text": "$f$ is injective only if $f(a) = f(b)$ forces $a = b$. Set $f(b) = 5$."
        },
        {
         "tex": "b^2 - 6b + 5 &= 5",
         "sym": "Eq(b**2 - 6*b + 5, 5)",
         "new": true
        },
        {
         "tex": "b^2 - 6b &= 0",
         "sym": "Eq(b**2 - 6*b, 0)"
        },
        {
         "tex": "b(b - 6) &= 0",
         "sym": "Eq(b*(b - 6), 0)"
        }
       ]
      },
      {
       "title": "Choose the value other than 0",
       "lines": [
        {
         "tex": "b &= 0 \\text{ or } b = 6",
         "sym": "Or(Eq(b, 0), Eq(b, 6))",
         "new": true
        },
        {
         "text": "Since $b \\neq 0$, $b = 6$. Then $f(6) = 36 - 36 + 5 = 5 = f(0)$ with $6 \\neq 0$, so $f$ is not injective."
        }
       ]
      }
     ],
     "finalAnswer": "b = 6"
    },
    "finalSym": "6",
    "answerSym": "Max(*solve(Eq(x**2 - 6*x + 5, 5), x))"
   }
  ]
 }
]