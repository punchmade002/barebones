   {
    "question": "In triangle $ABC$, $D$ is on $[AB]$ and $E$ is on $[AC]$ with $DE \\parallel BC$.\n$|AD| = 6$ cm, $|DB| = 4$ cm and $|AE| = 9$ cm.\nFind $|EC|$.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "State the ratio (Theorem 12)",
       "lines": [
        {
         "text": "$DE \\parallel BC$, so $DE$ divides $[AB]$ and $[AC]$ in the same ratio (Theorem 12)."
        },
        {
         "tex": "\\frac{|AD|}{|DB|} &= \\frac{|AE|}{|EC|}"
        },
        {
         "tex": "\\frac{6}{4} &= \\frac{9}{|EC|}",
         "sym": "Eq(Rational(6,4), 9/EC)",
         "new": true
        }
       ]
      },
      {
       "title": "Solve for $|EC|$",
       "lines": [
        {
         "tex": "6|EC| &= 36",
         "sym": "Eq(6*EC, 36)"
        },
        {
         "tex": "|EC| &= 6",
         "sym": "Eq(EC, 6)"
        }
       ]
      }
     ],
     "finalAnswer": "|EC| = 6 \\text{ cm}"
    },
    "finalSym": "6",
    "answerSym": "9*4/6"
   },
   {
    "question": "In triangle $ABC$, $|AC| = 15$ cm.\nThe point $D$ is on $[AB]$ and $E$ is on $[AC]$ with $DE \\parallel BC$.\n$|AD| : |DB| = 4 : 6$.\nFind $|AE|$.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Set up the ratio (Theorem 12)",
       "lines": [
        {
         "text": "$DE \\parallel BC$, so $|AE| : |EC| = |AD| : |DB| = 4 : 6$ (Theorem 12)."
        },
        {
         "text": "Let $|AE| = x$, so $|EC| = 15 - x$."
        },
        {
         "tex": "\\frac{x}{15 - x} &= \\frac{4}{6}",
         "sym": "Eq(x/(15 - x), Rational(4,6))",
         "new": true
        }
       ]
      },
      {
       "title": "Cross-multiply and solve",
       "lines": [
        {
         "tex": "6x &= 4(15 - x)",
         "sym": "Eq(6*x, 4*(15 - x))"
        },
        {
         "tex": "10x &= 60",
         "sym": "Eq(10*x, 60)"
        },
        {
         "tex": "x &= 6",
         "sym": "Eq(x, 6)"
        }
       ]
      }
     ],
     "finalAnswer": "|AE| = 6 \\text{ cm}"
    },
    "finalSym": "6",
    "answerSym": "15*4/(4 + 6)"
   }
  ]
 },
