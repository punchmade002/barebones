  "problems": [
   {
    "question": "A school buys $198$ books at €$4.95$ each.\nCalculate the exact total cost. Then check your answer is sensible by rounding $198$ to $200$ and $4.95$ to $5$ and estimating the cost.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Calculate the exact cost",
       "lines": [
        {
         "tex": "198 \\times 4.95 &= 980.1",
         "sym": "198*Rational(495,100)",
         "new": true
        }
       ]
      },
      {
       "title": "Round each number and estimate",
       "lines": [
        {
         "tex": "198 &\\approx 200",
         "sym": "200",
         "new": true,
         "approx": true
        },
        {
         "tex": "4.95 &\\approx 5",
         "sym": "5",
         "new": true,
         "approx": true
        },
        {
         "tex": "200 \\times 5 &= 1000",
         "sym": "200*5",
         "new": true
        }
       ]
      },
      {
       "title": "Compare",
       "lines": [
        {
         "text": "The estimate €$1000$ is close to the exact cost €$980.10$, so the answer is sensible."
        }
       ]
      }
     ],
     "finalAnswer": "\\text{€}980.10 \\text{ (estimate €}1000\\text{)}"
    },
    "finalSym": "Rational(9801,10)",
    "answerSym": "Rational(198)*Rational(495,100)"
   }
  ]
 },
 {
  "skill": "fin-present-value",
  "problems": [
   {
    "question": "Ciara will receive €$22{,}050$ in 2 years' time.\nThe interest rate is $5\\%$ per year, compounded annually.\nFind the present value of this sum.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Write the compound interest formula",
       "lines": [
        {
         "tex": "F &= P(1 + i)^t",
         "sym": "Eq(F, P*(1 + i)**t)",
         "new": true
        },
        {
         "text": "Here $F = 22050$, $i = 0.05$ and $t = 2$."
        }
       ]
      },
      {
       "title": "Substitute and solve for $P$",
       "lines": [
        {
         "tex": "22050 &= P(1.05)^2",
         "sym": "Eq(22050, P*Rational(105,100)**2)",
         "new": true
        },
        {
         "tex": "P &= \\frac{22050}{1.05^2}",
         "sym": "Eq(P, 22050/Rational(105,100)**2)",
         "new": true
        },
        {
         "tex": "&= 20000",
         "sym": "Eq(P, 20000)"
        }
       ]
      }
     ],
     "finalAnswer": "\\text{€}20{,}000"
    },
    "finalSym": "20000",
    "answerSym": "Rational(22050)/(1 + Rational(5,100))**2"
   },
   {
    "question": "A club is promised a prize of €$6{,}655$ in 3 years' time.\nThe interest rate is $10\\%$ per year, compounded annually.\nFind the amount that, invested now, would grow to the prize.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "State what is known",
       "lines": [
        {
         "text": "Future value $F = 6655$, rate $i = 0.1$, time $t = 3$ years. Let $P$ be the amount invested now."
        }
       ]
      },
      {
       "title": "Use the compound interest formula",
       "lines": [
        {
         "tex": "6655 &= P(1.1)^3",
         "sym": "Eq(6655, P*Rational(11,10)**3)",
         "new": true
        }
       ]
      },
      {
       "title": "Divide by $1.1^3$",
       "lines": [
        {
         "tex": "P &= \\frac{6655}{1.1^3}",
         "sym": "Eq(P, 6655/Rational(11,10)**3)",
         "new": true
        },
        {
         "tex": "&= \\frac{6655}{1.331}",
         "sym": "Eq(P, 6655/Rational(1331,1000))"
        },
        {
         "tex": "&= 5000",
         "sym": "Eq(P, 5000)"
        }
       ]
      }
     ],
     "finalAnswer": "\\text{€}5000"
    },
    "finalSym": "5000",
    "answerSym": "Rational(6655)/(1 + Rational(1,10))**3"
   }
  ]
 }
