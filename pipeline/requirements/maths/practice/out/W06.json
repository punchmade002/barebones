   {
    "question": "Solve the inequality $\\dfrac{x - 1}{x + 3} \\ge 2$, where $x \\in \\mathbb{R}$, $x \\ne -3$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Multiply both sides by $(x+3)^2$",
       "lines": [
        {
         "text": "$(x+3)^2$ is positive (as $x \\ne -3$), so the inequality sign does not change."
        },
        {
         "tex": "\\frac{x-1}{x+3} &\\ge 2",
         "sym": "(x-1)/(x+3) >= 2"
        },
        {
         "tex": "(x-1)(x+3) &\\ge 2(x+3)^2",
         "sym": "(x-1)*(x+3) >= 2*(x+3)**2",
         "new": true
        }
       ]
      },
      {
       "title": "Expand both sides",
       "lines": [
        {
         "tex": "x^2 + 2x - 3 &\\ge 2x^2 + 12x + 18",
         "sym": "x**2 + 2*x - 3 >= 2*x**2 + 12*x + 18"
        }
       ]
      },
      {
       "title": "Collect all terms on one side",
       "lines": [
        {
         "tex": "0 &\\ge x^2 + 10x + 21",
         "sym": "0 >= x**2 + 10*x + 21"
        },
        {
         "tex": "x^2 + 10x + 21 &\\le 0",
         "sym": "x**2 + 10*x + 21 <= 0"
        }
       ]
      },
      {
       "title": "Factorise to find the roots",
       "lines": [
        {
         "tex": "(x+3)(x+7) &\\le 0",
         "sym": "(x+3)*(x+7) <= 0"
        },
        {
         "text": "The roots are $x = -3$ and $x = -7$."
        }
       ]
      },
      {
       "title": "Choose the values between the roots",
       "lines": [
        {
         "text": "The quadratic is negative or zero between its roots."
        },
        {
         "tex": "-7 &\\le x \\le -3",
         "sym": "And(-7 <= x, x <= -3)"
        },
        {
         "text": "The fraction is undefined at $x = -3$, so exclude it."
        },
        {
         "tex": "-7 &\\le x < -3",
         "sym": "And(-7 <= x, x < -3)",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "-7 \\le x < -3"
    },
    "finalSym": "And(-7 <= x, x < -3)",
    "answerSym": "reduce_inequalities((x-1)/(x+3) >= 2, x)"
   },
   {
