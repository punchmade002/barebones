   {
    "question": "Prove that $a^2 + b^2 \\ge 2ab$ for all $a, b \\in \\mathbb{R}$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Look at the difference of the two sides",
       "lines": [
        {
         "text": "It is enough to show that $a^2 + b^2 - 2ab \\ge 0$."
        }
       ]
      },
      {
       "title": "Recognise a perfect square",
       "lines": [
        {
         "tex": "a^2 + b^2 - 2ab &= (a - b)^2",
         "sym": "Eq(a**2 + b**2 - 2*a*b, (a-b)**2)"
        }
       ]
      },
      {
       "title": "A square is never negative",
       "lines": [
        {
         "text": "For any real $a, b$, $(a-b)^2 \\ge 0$."
        },
        {
         "tex": "a^2 + b^2 - 2ab &\\ge 0"
        }
       ]
      },
      {
       "title": "Conclude",
       "lines": [
        {
         "text": "Hence $a^2 + b^2 \\ge 2ab$ for all real $a$ and $b$."
        }
       ]
      }
     ],
     "finalAnswer": "a^2 + b^2 \\ge 2ab"
    },
    "finalSym": "0",
    "answerSym": "simplify(a**2 + b**2 - 2*a*b - (a-b)**2)"
   },
   {
    "question": "Prove that $(a + b)^2 \\le 2(a^2 + b^2)$ for all $a, b \\in \\mathbb{R}$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Form the difference of the two sides",
       "lines": [
        {
         "text": "It is enough to show that $2(a^2+b^2) - (a+b)^2 \\ge 0$."
        }
       ]
      },
      {
       "title": "Multiply out the brackets",
       "lines": [
        {
         "tex": "2(a^2 + b^2) - (a+b)^2 &= 2a^2 + 2b^2 - (a^2 + 2ab + b^2)",
         "sym": "Eq(2*(a**2+b**2) - (a+b)**2, 2*a**2 + 2*b**2 - (a**2 + 2*a*b + b**2))"
        },
        {
         "tex": "&= a^2 - 2ab + b^2",
         "sym": "Eq(2*a**2 + 2*b**2 - (a**2 + 2*a*b + b**2), a**2 - 2*a*b + b**2)"
        }
       ]
      },
      {
       "title": "Recognise a perfect square",
       "lines": [
        {
         "tex": "a^2 - 2ab + b^2 &= (a - b)^2",
         "sym": "Eq(a**2 - 2*a*b + b**2, (a-b)**2)"
        }
       ]
      },
      {
       "title": "A square is never negative",
       "lines": [
        {
         "text": "$(a-b)^2 \\ge 0$, so $2(a^2+b^2) - (a+b)^2 \\ge 0$. Hence $(a+b)^2 \\le 2(a^2+b^2)$."
        }
       ]
      }
     ],
     "finalAnswer": "(a+b)^2 \\le 2(a^2 + b^2)"
    },
    "finalSym": "0",
    "answerSym": "expand(2*(a**2 + b**2) - (a+b)**2 - (a-b)**2)"
   },
   {
    "question": "$a$ and $b$ are positive real numbers. Prove that $\\dfrac{a}{b} + \\dfrac{b}{a} \\ge 2$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Write as a single fraction",
       "lines": [
        {
         "tex": "\\frac{a}{b} + \\frac{b}{a} &= \\frac{a^2 + b^2}{ab}",
         "sym": "Eq(a/b + b/a, (a**2 + b**2)/(a*b))"
        }
       ]
      },
      {
       "title": "Subtract 2 from both sides",
       "lines": [
        {
         "tex": "\\frac{a}{b} + \\frac{b}{a} - 2 &= \\frac{a^2 + b^2 - 2ab}{ab}",
         "sym": "Eq(a/b + b/a - 2, (a**2 + b**2 - 2*a*b)/(a*b))"
        },
        {
         "tex": "&= \\frac{(a-b)^2}{ab}",
         "sym": "Eq((a**2 + b**2 - 2*a*b)/(a*b), (a-b)**2/(a*b))"
        }
       ]
      },
      {
       "title": "Check the sign",
       "lines": [
        {
         "text": "$(a-b)^2 \\ge 0$, and $ab > 0$ because $a, b > 0$. So the fraction is $\\ge 0$."
        },
        {
         "tex": "\\frac{a}{b} + \\frac{b}{a} - 2 &\\ge 0"
        }
       ]
      },
      {
       "title": "Conclude",
       "lines": [
        {
         "text": "Hence $\\dfrac{a}{b} + \\dfrac{b}{a} \\ge 2$."
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{a}{b} + \\frac{b}{a} \\ge 2"
    },
    "finalSym": "0",
    "answerSym": "simplify(a/b + b/a - 2 - (a-b)**2/(a*b))"
   }
  ]
 }
