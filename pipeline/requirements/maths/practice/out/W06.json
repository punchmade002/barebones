   {
    "question": "Find the values of $x \\in \\mathbb{R}$ for which $3x^2 + x \\le 14$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Rearrange to compare with zero",
       "lines": [
        {
         "tex": "3x^2 + x &\\le 14",
         "sym": "3*x**2 + x <= 14"
        },
        {
         "tex": "3x^2 + x - 14 &\\le 0",
         "sym": "3*x**2 + x - 14 <= 0"
        }
       ]
      },
      {
       "title": "Factorise to find the roots",
       "lines": [
        {
         "tex": "(3x + 7)(x - 2) &\\le 0",
         "sym": "(3*x+7)*(x-2) <= 0"
        },
        {
         "text": "The roots are $x = -\\frac{7}{3}$ and $x = 2$."
        }
       ]
      },
      {
       "title": "Read off where the quadratic is negative",
       "lines": [
        {
         "text": "The graph of $3x^2 + x - 14$ is a U-shape, so it is below or on the axis between the roots."
        },
        {
         "tex": "-\\frac{7}{3} &\\le x \\le 2",
         "sym": "And(-Rational(7,3) <= x, x <= 2)"
        }
       ]
      }
     ],
     "finalAnswer": "-\\frac{7}{3} \\le x \\le 2"
    },
    "finalSym": "And(-Rational(7,3) <= x, x <= 2)",
    "answerSym": "reduce_inequalities(3*x**2 + x <= 14, x)"
   }
  ]
 },
