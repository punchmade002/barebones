        },
        {
         "tex": "\\frac{2x+1}{x-3} &< 1",
         "sym": "(2*x+1)/(x-3) < 1"
        },
        {
         "tex": "(2x+1)(x-3) &< (x-3)^2",
         "sym": "(2*x+1)*(x-3) < (x-3)**2",
         "new": true
        }
       ]
      },
      {
       "title": "Expand both sides",
       "lines": [
        {
         "tex": "2x^2 - 5x - 3 &< x^2 - 6x + 9",
         "sym": "2*x**2 - 5*x - 3 < x**2 - 6*x + 9"
        }
       ]
      },
      {
       "title": "Collect all terms on one side",
       "lines": [
        {
         "tex": "x^2 + x - 12 &< 0",
         "sym": "x**2 + x - 12 < 0"
        }
       ]
      },
      {
       "title": "Factorise to find the roots",
       "lines": [
        {
         "tex": "(x+4)(x-3) &< 0",
         "sym": "(x+4)*(x-3) < 0"
        },
        {
         "text": "The roots are $x = -4$ and $x = 3$."
        }
       ]
      },
      {
       "title": "Choose the values between the roots",
       "lines": [
        {
         "text": "The quadratic is negative between its roots. Since the inequality is strict, $x = 3$ is already excluded."
        },
        {
         "tex": "-4 &< x < 3",
         "sym": "And(-4 < x, x < 3)"
        }
       ]
      }
     ],
     "finalAnswer": "-4 < x < 3"
    },
    "finalSym": "And(-4 < x, x < 3)",
    "answerSym": "reduce_inequalities((2*x+1)/(x-3) < 1, x)"
   }
  ]
 },
