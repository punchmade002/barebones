 {
  "skill": "diff-apply-hl",
  "problems": [
   {
    "question": "A cup of coffee cools in a room. Its temperature, $T$ degrees Celsius, $t$ minutes after it is poured is $T(t) = 20 + 70e^{-0.1t}$.\nFind the value of $t$ for which the temperature is falling at a rate of $3.5$ degrees per minute.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Differentiate to get the rate",
       "lines": [
        {
         "tex": "T'(t) &= -7e^{-0.1t}",
         "sym": "-7*exp(-t/10)",
         "new": true
        }
       ]
      },
      {
       "title": "Set the rate equal to $-3.5$",
       "lines": [
        {
         "tex": "-7e^{-0.1t} &= -3.5",
         "sym": "Eq(-7*exp(-t/10), -Rational(7,2))",
         "new": true
        },
        {
         "tex": "e^{-0.1t} &= \\frac{1}{2}",
         "sym": "Eq(exp(-t/10), Rational(1,2))"
        }
       ]
      },
      {
       "title": "Take natural logs and solve",
       "lines": [
        {
         "tex": "-0.1t &= \\ln\\left(\\tfrac{1}{2}\\right) = -\\ln 2",
         "sym": "Eq(-t/10, -log(2))",
         "new": true
        },
        {
         "tex": "t &= 10\\ln 2",
         "sym": "Eq(t, 10*log(2))"
        }
       ]
      }
     ],
     "finalAnswer": "t = 10\\ln 2 \\approx 6.93 \\text{ minutes}"
    },
    "finalSym": "10*log(2)",
    "answerSym": "solve(Eq(diff(20 + 70*exp(-t/10), t), -Rational(7,2)), t)[0]"
   },
   {
    "question": "The concentration of a drug in the blood, in mg per litre, $t$ hours after it is taken is $C(t) = 12te^{-t/2}$, for $t \\ge 0$.\nFind the value of $t$ at which the concentration is greatest. Justify your answer.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Differentiate using the product rule",
       "lines": [
        {
         "tex": "C'(t) &= 12e^{-t/2} + 12t\\left(-\\tfrac{1}{2}\\right)e^{-t/2}",
         "sym": "12*exp(-t/2) + 12*t*(-Rational(1,2))*exp(-t/2)",
         "new": true
        },
        {
         "tex": "&= 12e^{-t/2}\\left(1 - \\tfrac{t}{2}\\right)",
         "sym": "12*exp(-t/2)*(1 - t/2)"
        }
       ]
      },
      {
       "title": "Set $C'(t) = 0$",
       "lines": [
        {
         "tex": "12e^{-t/2}\\left(1 - \\tfrac{t}{2}\\right) &= 0",
         "sym": "Eq(12*exp(-t/2)*(1 - t/2), 0)",
         "new": true
        },
        {
         "text": "$e^{-t/2}$ is never $0$, so the bracket must be $0$."
        },
        {
         "tex": "1 - \\tfrac{t}{2} &= 0",
         "sym": "Eq(1 - t/2, 0)",
         "new": true
        },
        {
         "tex": "t &= 2",
         "sym": "Eq(t, 2)"
        }
       ]
      },
      {
       "title": "Differentiate again to classify",
       "lines": [
        {
         "tex": "C''(t) &= 12e^{-t/2}\\left(\\tfrac{t}{4} - 1\\right)",
         "sym": "12*exp(-t/2)*(t/4 - 1)",
         "new": true
        }
       ]
      },
      {
       "title": "Evaluate at $t = 2$",
       "lines": [
        {
         "tex": "C''(2) &= -12e^{-1} < 0",
         "sym": "-12*exp(-1)",
         "new": true
        },
        {
         "text": "$C''(2) < 0$, so $t = 2$ gives a maximum."
        }
       ]
      }
     ],
     "finalAnswer": "t = 2 \\text{ hours}"
    },
    "finalSym": "2",
    "answerSym": "solve(diff(12*t*exp(-t/2), t), t)[0]"
   }
  ]
 },
