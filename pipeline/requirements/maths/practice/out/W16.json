 {
  "skill": "diff-quotient",
  "problems": [
   {
    "question": "$f(x) = \\dfrac{x^2}{x - 2}$, for $x \\ne 2$.\nFind the values of $x$ at which the tangent to the curve $y = f(x)$ is horizontal.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Name $u$ and $v$ and differentiate each",
       "lines": [
        {
         "tex": "u &= x^2, \\quad u' = 2x",
         "sym": "2*x",
         "new": true
        },
        {
         "tex": "v &= x - 2, \\quad v' = 1",
         "sym": "1",
         "new": true
        }
       ]
      },
      {
       "title": "Substitute into the quotient rule",
       "lines": [
        {
         "tex": "f'(x) &= \\frac{(x-2)(2x) - x^2(1)}{(x-2)^2}",
         "sym": "((x - 2)*2*x - x**2)/(x - 2)**2",
         "new": true
        }
       ]
      },
      {
       "title": "Simplify the numerator",
       "lines": [
        {
         "tex": "&= \\frac{x^2 - 4x}{(x-2)^2}",
         "sym": "(x**2 - 4*x)/(x - 2)**2"
        },
        {
         "tex": "&= \\frac{x(x-4)}{(x-2)^2}",
         "sym": "x*(x - 4)/(x - 2)**2"
        }
       ]
      },
      {
       "title": "Set $f'(x) = 0$",
       "lines": [
        {
         "tex": "x(x-4) &= 0",
         "sym": "Eq(x*(x - 4), 0)",
         "new": true
        },
        {
         "tex": "x &= 0 \\text{ or } x = 4",
         "sym": "Or(Eq(x, 0), Eq(x, 4))"
        }
       ]
      }
     ],
     "finalAnswer": "x = 0 \\text{ or } x = 4"
    },
    "finalSym": "[0, 4]",
    "answerSym": "solve(diff(x**2/(x - 2), x), x)"
   }
  ]
 }
]