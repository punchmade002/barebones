         "new": true
        },
        {
         "tex": "&= -2x^{-\\frac{4}{3}}",
         "sym": "-2*x**(-Rational(4,3))"
        }
       ]
      },
      {
       "title": "Substitute $x = 8$",
       "lines": [
        {
         "tex": "f'(8) &= -2(8)^{-\\frac{4}{3}} = -\\frac{2}{16}",
         "sym": "-2*8**(-Rational(4,3))",
         "new": true
        },
        {
         "tex": "&= -\\frac{1}{8}",
         "sym": "-Rational(1,8)"
        }
       ]
      }
     ],
     "finalAnswer": "f'(8) = -\\frac{1}{8}"
    },
    "finalSym": "-Rational(1,8)",
    "answerSym": "diff(6/x**Rational(1,3), x).subs(x, 8)"
   },
   {
    "question": "$g(x) = \\dfrac{x^2 + 3}{\\sqrt{x}}$, for $x > 0$.\nFind $g'(4)$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Divide through and write as powers",
       "lines": [
        {
         "tex": "g(x) &= x^{\\frac{3}{2}} + 3x^{-\\frac{1}{2}}",
         "sym": "x**Rational(3,2) + 3*x**(-Rational(1,2))",
         "new": true
        }
       ]
      },
      {
       "title": "Differentiate term by term",
       "lines": [
        {
         "tex": "g'(x) &= \\tfrac{3}{2}x^{\\frac{1}{2}} - \\tfrac{3}{2}x^{-\\frac{3}{2}}",
         "sym": "Rational(3,2)*x**Rational(1,2) - Rational(3,2)*x**(-Rational(3,2))",
         "new": true
        }
       ]
      },
      {
       "title": "Substitute $x = 4$",
       "lines": [
        {
         "tex": "g'(4) &= \\tfrac{3}{2}(2) - \\tfrac{3}{2}\\cdot\\tfrac{1}{8}",
         "sym": "Rational(3,2)*2 - Rational(3,2)*Rational(1,8)",
         "new": true
        },
        {
         "tex": "&= 3 - \\tfrac{3}{16} = \\tfrac{45}{16}",
         "sym": "Rational(45,16)"
        }
       ]
      }
     ],
     "finalAnswer": "g'(4) = \\frac{45}{16}"
    },
    "finalSym": "Rational(45,16)",
    "answerSym": "diff((x**2 + 3)/sqrt(x), x).subs(x, 4)"
   }
  ]
 },
