         "new": true
        }
       ]
      },
      {
       "title": "Collect like terms",
       "lines": [
        {
         "tex": "&= 2x^2 + 6x - 8",
         "sym": "2*x**2+6*x-8"
        }
       ]
      }
     ],
     "finalAnswer": "2x^2 + 6x - 8"
    },
    "finalSym": "2*x**2+6*x-8",
    "answerSym": "expand((3*x**2+2*x-5)-(x**2-4*x+3))"
   },
   {
    "question": "Simplify $(2x^2 - x + 4) + (x^2 + 5x - 9) - (3x^2 - 2x + 1)$.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Remove the brackets, changing signs in the last one",
       "lines": [
        {
         "tex": "&2x^2 - x + 4 + x^2 + 5x - 9 - 3x^2 + 2x - 1",
         "sym": "2*x**2-x+4+x**2+5*x-9-3*x**2+2*x-1",
         "new": true
        }
       ]
      },
      {
       "title": "Collect the $x^2$ terms",
       "lines": [
        {
         "tex": "2x^2 + x^2 - 3x^2 &= 0",
         "sym": "2*x**2+x**2-3*x**2",
         "new": true
        }
       ]
      },
      {
       "title": "Collect the $x$ terms and the numbers",
       "lines": [
        {
         "tex": "-x + 5x + 2x &= 6x",
         "sym": "-x+5*x+2*x",
         "new": true
        },
        {
         "tex": "4 - 9 - 1 &= -6",
         "sym": "4-9-1",
         "new": true
        }
       ]
      },
      {
       "title": "Write the result",
       "lines": [
        {
         "tex": "&= 6x - 6",
         "sym": "6*x-6",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "6x - 6"
    },
    "finalSym": "6*x-6",
    "answerSym": "expand((2*x**2-x+4)+(x**2+5*x-9)-(3*x**2-2*x+1))"
   }
  ]
