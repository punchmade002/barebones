  "problems": [
   {
    "question": "Multiply out $(4x - 3)(x + 5)$ and simplify.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Multiply each term in the first bracket by the second",
       "lines": [
        {
         "tex": "(4x-3)(x+5) &= 4x(x+5) - 3(x+5)",
         "sym": "(4*x-3)*(x+5)",
         "new": true
        }
       ]
      },
      {
       "title": "Expand each part",
       "lines": [
        {
         "tex": "&= 4x^2 + 20x - 3x - 15",
         "sym": "4*x**2+20*x-3*x-15"
        }
       ]
      },
      {
       "title": "Collect like terms",
       "lines": [
        {
         "tex": "&= 4x^2 + 17x - 15",
         "sym": "4*x**2+17*x-15"
        }
       ]
      }
     ],
     "finalAnswer": "4x^2 + 17x - 15"
    },
    "finalSym": "4*x**2+17*x-15",
    "answerSym": "expand((4*x-3)*(x+5))"
   }
  ]
