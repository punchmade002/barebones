        },
        {
         "text": "So $|\\angle BCA| = |\\angle DAC|$."
        },
        {
         "tex": "2x + 10 &= 3x - 20",
         "sym": "Eq(2*x + 10, 3*x - 20)",
         "new": true
        }
       ]
      },
      {
       "title": "Solve for $x$",
       "lines": [
        {
         "tex": "30 &= x",
         "sym": "Eq(30, x)"
