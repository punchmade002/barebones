        {
         "tex": "x &= 30",
         "sym": "Eq(x, 30)"
        }
       ]
      },
      {
       "title": "Check",
       "lines": [
        {
         "text": "Each angle is $70^\\circ$."
        },
        {
         "tex": "2(30) + 10 &= 70",
         "sym": "2*30 + 10",
         "new": true
        },
        {
         "tex": "3(30) - 20 &= 70",
         "sym": "3*30 - 20",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "x = 30"
    },
    "finalSym": "[30]",
    "answerSym": "solve(Eq(2*x + 10, 3*x - 20), x)"
   }
  ]
