    "question": "$ABCD$ is a parallelogram.\n$|\\angle CAB| = 35^\\circ$ and $|\\angle ACB| = 70^\\circ$.\nFind $|\\angle ADC|$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Find $|\\angle ABC|$ in triangle $ABC$",
       "lines": [
        {
         "text": "The angles of a triangle add to $180^\\circ$."
        },
        {
         "tex": "|\\angle ABC| &= 180 - 35 - 70",
         "sym": "180 - 35 - 70"
        },
        {
         "tex": "&= 75^\\circ",
         "sym": "75"
        }
       ]
      },
      {
       "title": "Use Corollary 1",
       "lines": [
        {
         "text": "The diagonal $[AC]$ divides the parallelogram into two congruent triangles, $ABC$ and $CDA$, with $B$ matching $D$."
        },
        {
         "text": "So the angles at $B$ and $D$ are equal."
        },
        {
         "tex": "|\\angle ADC| &= |\\angle ABC| = 75^\\circ",
         "sym": "75",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "75^\\circ"
    },
    "finalSym": "75",
    "answerSym": "180 - 35 - 70"
   },
   {
    "question": "$PQRS$ is a parallelogram with $|PQ| = 8$ cm, $|QR| = 6$ cm and diagonal $|PR| = 10$ cm.\nFind the area of $PQRS$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the semi-perimeter of triangle $PQR$",
       "lines": [
        {
         "tex": "s &= \\frac{8 + 6 + 10}{2}",
         "sym": "(8 + 6 + 10)/2"
        },
        {
         "tex": "&= 12",
         "sym": "12"
        }
       ]
      },
      {
       "title": "Find the area of triangle $PQR$",
       "lines": [
        {
         "text": "Use Heron's formula."
        },
        {
         "tex": "|\\triangle PQR| &= \\sqrt{12(12-8)(12-6)(12-10)}",
         "sym": "sqrt(12*(12-8)*(12-6)*(12-10))"
        },
        {
         "tex": "&= \\sqrt{576}",
         "sym": "sqrt(576)"
        },
        {
         "tex": "&= 24 \\text{ cm}^2",
         "sym": "24"
        }
       ]
      },
      {
       "title": "Use Corollary 1",
       "lines": [
        {
         "text": "The diagonal $[PR]$ divides the parallelogram into two congruent triangles, so the parallelogram has twice the area of triangle $PQR$."
        },
        {
         "tex": "|PQRS| &= 2 \\times 24",
         "sym": "2*24"
        },
        {
         "tex": "&= 48 \\text{ cm}^2",
         "sym": "48"
        }
       ]
      }
     ],
     "finalAnswer": "48 \\text{ cm}^2"
    },
    "finalSym": "48",
    "answerSym": "2*Rational(1,2)*8*6*sin(acos(Rational(8**2 + 6**2 - 10**2, 2*8*6)))"
   },
