    "question": "In triangle $ABC$, $D$ is on $[AB]$ and $E$ is on $[AC]$ with $DE \\parallel BC$.\n$|AD| = 4$ cm, $|DB| = 2$ cm and $|DE| = 6$ cm.\nFind $|BC|$.",
    "level": "ordinary",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Show the triangles are similar",
       "lines": [
        {
         "text": "$DE \\parallel BC$, so $|\\angle ADE| = |\\angle ABC|$ (corresponding angles). Angle $A$ is common."
        },
        {
         "text": "Triangles $ADE$ and $ABC$ are equiangular, so they are similar."
        }
       ]
      },
      {
       "title": "Find $|AB|$",
       "lines": [
        {
         "tex": "|AB| &= 4 + 2",
         "sym": "4 + 2"
        },
        {
         "tex": "&= 6 \\text{ cm}",
         "sym": "6"
        }
       ]
      },
      {
       "title": "Write the ratio of corresponding sides (Theorem 13)",
       "lines": [
        {
         "text": "$D \\leftrightarrow B$ and $E \\leftrightarrow C$, so $[DE]$ corresponds to $[BC]$ and $[AD]$ to $[AB]$."
        },
        {
         "tex": "\\frac{|BC|}{|DE|} &= \\frac{|AB|}{|AD|}"
        },
        {
         "tex": "\\frac{|BC|}{6} &= \\frac{6}{4}",
         "sym": "Eq(a/6, Rational(6,4))",
         "new": true
        }
       ]
      },
      {
       "title": "Solve for $|BC|$",
       "lines": [
        {
         "tex": "|BC| &= 6 \\times \\frac{6}{4}",
         "sym": "Eq(a, 6*Rational(6,4))"
        },
        {
         "tex": "&= 9 \\text{ cm}",
         "sym": "Eq(a, 9)"
        }
       ]
      }
     ],
     "finalAnswer": "9 \\text{ cm}"
    },
    "finalSym": "9",
    "answerSym": "6*(4 + 2)/4"
   }
  ]
 }
