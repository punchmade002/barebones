         "sym": "(x-3)*(x**2-2*x-1)",
         "new": true
        },
        {
         "tex": "&= x^3 - 5x^2 + 5x + 3",
         "sym": "x**3-5*x**2+5*x+3"
        }
       ]
      }
     ],
     "finalAnswer": "x^3 - 5x^2 + 5x + 3 = 0"
    },
    "finalSym": "Eq(x**3 - 5*x**2 + 5*x + 3, 0)",
    "answerSym": "Eq(expand((x-3)*(x-1-sqrt(2))*(x-1+sqrt(2))), 0)"
   }
  ]
 },
 {
  "skill": "cubic-unknown-coefficient",
  "problems": [
   {
    "question": "$(x - 1)$ and $(x + 2)$ are factors of $f(x) = x^3 + px^2 + qx - 6$.\nFind the value of $p$ and the value of $q$.",
    "level": "higher",
    "marks": 15,
    "workedSolution": {
     "steps": [
      {
       "title": "Use the factor theorem for (x − 1)",
       "lines": [
        {
         "text": "Since $(x - 1)$ is a factor, $f(1) = 0$."
        },
        {
         "tex": "1 + p + q - 6 &= 0",
         "sym": "Eq(1+p+q-6,0)",
         "new": true
        },
        {
         "tex": "p + q &= 5",
         "sym": "Eq(p+q,5)"
        }
       ]
      },
      {
       "title": "Use the factor theorem for (x + 2)",
       "lines": [
        {
         "text": "Since $(x + 2)$ is a factor, $f(-2) = 0$."
        },
        {
         "tex": "-8 + 4p - 2q - 6 &= 0",
         "sym": "Eq(-8+4*p-2*q-6,0)",
         "new": true
        },
        {
         "tex": "4p - 2q &= 14",
         "sym": "Eq(4*p-2*q,14)"
        },
        {
         "tex": "2p - q &= 7",
         "sym": "Eq(2*p-q,7)"
        }
       ]
      },
      {
       "title": "Add the two equations to eliminate q",
       "lines": [
        {
         "tex": "(p + q) + (2p - q) &= 5 + 7",
         "sym": "Eq((p+q)+(2*p-q),5+7)",
         "new": true
        },
        {
         "tex": "3p &= 12",
         "sym": "Eq(3*p,12)"
        },
        {
         "tex": "p &= 4",
         "sym": "Eq(p,4)"
        }
       ]
      },
      {
       "title": "Find q",
       "lines": [
        {
         "tex": "4 + q &= 5",
         "sym": "Eq(4+q,5)",
         "new": true
        },
        {
         "tex": "q &= 1",
         "sym": "Eq(q,1)"
        }
       ]
      }
     ],
     "finalAnswer": "p = 4, \\quad q = 1"
    },
    "finalSym": "(4, 1)",
    "answerSym": "linsolve([Eq(1**3 + p*1**2 + q*1 - 6, 0), Eq((-2)**3 + p*(-2)**2 + q*(-2) - 6, 0)], (p, q)).args[0]"
   }
  ]
 }
]