         "new": true
        },
        {
         "tex": "&= 2x^3 + x^2 - 13x + 6",
         "sym": "2*x**3+x**2-13*x+6"
        }
       ]
      }
     ],
     "finalAnswer": "2x^3 + x^2 - 13x + 6 = 0"
    },
    "finalSym": "Eq(2*x**3 + x**2 - 13*x + 6, 0)",
    "answerSym": "Eq(expand((2*x-1)*(x+3)*(x-2)), 0)"
   },
   {
    "question": "A cubic equation with integer coefficients has roots $3$, $1 + \\sqrt{2}$ and $1 - \\sqrt{2}$.\nFind the equation in the form $x^3 + bx^2 + cx + d = 0$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Form the quadratic from the two surd roots",
       "lines": [
        {
         "tex": "(x - 1 - \\sqrt{2})(x - 1 + \\sqrt{2}) &= (x - 1)^2 - (\\sqrt{2})^2",
         "sym": "(x-1-sqrt(2))*(x-1+sqrt(2))",
         "new": true
        },
        {
         "tex": "&= x^2 - 2x + 1 - 2",
         "sym": "(x-1)**2 - 2"
        },
        {
         "tex": "&= x^2 - 2x - 1",
         "sym": "x**2-2*x-1"
        }
       ]
      },
      {
       "title": "Multiply by the factor for the root 3",
