        },
        {
         "tex": "(2x - 1)(x + 3)(x - 2) &= 0",
         "sym": "Eq((2*x-1)*(x+3)*(x-2),0)",
         "new": true
        }
       ]
      },
      {
       "title": "Multiply the last two factors",
       "lines": [
        {
         "tex": "(x + 3)(x - 2) &= x^2 - 2x + 3x - 6",
         "sym": "(x+3)*(x-2)"
        },
        {
         "tex": "&= x^2 + x - 6",
         "sym": "x**2+x-6"
        }
       ]
      },
      {
       "title": "Multiply by the first factor",
