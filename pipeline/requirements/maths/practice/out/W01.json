 {
  "skill": "cubic-factor-theorem",
  "problems": [
   {
    "question": "Given that $(2x - 1)$ is a factor of $f(x) = 4x^2 + tx - 3$, find the value of $t$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Use the factor theorem",
       "lines": [
        {
         "text": "If $2x - 1$ is a factor, then $x = \\tfrac12$ is a root, so $f(\\tfrac12) = 0$."
        },
        {
         "tex": "2x - 1 &= 0",
         "sym": "Eq(2*x-1,0)",
         "new": true
        },
        {
         "tex": "x &= \\tfrac12",
         "sym": "Eq(x,Rational(1,2))"
        }
       ]
      },
      {
       "title": "Substitute x = 1/2 into f(x)",
       "lines": [
        {
         "tex": "f(\\tfrac12) &= 4(\\tfrac12)^2 + t(\\tfrac12) - 3",
         "sym": "4*Rational(1,2)**2 + t*Rational(1,2) - 3",
         "new": true
        },
        {
         "tex": "&= 1 + \\tfrac{t}{2} - 3",
         "sym": "1 + t/2 - 3"
        },
        {
         "tex": "&= \\tfrac{t}{2} - 2",
         "sym": "t/2 - 2"
        }
       ]
      },
      {
       "title": "Set f(1/2) = 0 and solve for t",
       "lines": [
        {
         "tex": "\\tfrac{t}{2} - 2 &= 0",
         "sym": "Eq(t/2-2,0)",
         "new": true
        },
        {
         "tex": "t &= 4",
         "sym": "Eq(t,4)"
        }
       ]
      }
     ],
     "finalAnswer": "t = 4"
    },
    "finalSym": "4",
    "answerSym": "solve(Eq(4*Rational(1,2)**2 + t*Rational(1,2) - 3, 0), t)[0]"
   }
  ]
 },
 {
  "skill": "cubic-find-root",
  "problems": [
   {
    "question": "The cubic $f(x) = x^3 - 3x^2 + 4x - 2$ has exactly one real root, and it is an integer.\nFind this root.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "List the possible integer roots",
       "lines": [
        {
         "text": "An integer root must divide the constant term $-2$, so try $\\pm 1, \\pm 2$."
        }
       ]
      },
      {
       "title": "Test x = 1",
       "lines": [
        {
         "tex": "f(1) &= 1^3 - 3(1)^2 + 4(1) - 2",
         "sym": "1**3 - 3*1**2 + 4*1 - 2",
         "new": true
        },
        {
         "tex": "&= 1 - 3 + 4 - 2",
         "sym": "1-3+4-2"
        },
        {
         "tex": "&= 0",
         "sym": "0"
        }
       ]
      },
      {
       "title": "Conclude",
       "lines": [
        {
         "text": "$f(1) = 0$, so $(x - 1)$ is a factor and $x = 1$ is a root. The other factor, $x^2 - 2x + 2$, has no real roots."
        }
       ]
      }
     ],
     "finalAnswer": "x = 1"
    },
    "finalSym": "1",
    "answerSym": "real_roots(x**3 - 3*x**2 + 4*x - 2)[0]"
   },
   {
    "question": "The cubic $f(x) = x^3 - 3x^2 - 4x + 12$ has three integer roots, exactly one of which is negative.\nFind the negative root.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "List the possible integer roots",
       "lines": [
        {
         "text": "A root must divide the constant term $12$. Try small values, positive and negative."
        }
       ]
      },
      {
       "title": "Test x = −1",
       "lines": [
        {
         "tex": "f(-1) &= (-1)^3 - 3(-1)^2 - 4(-1) + 12",
         "sym": "(-1)**3 - 3*(-1)**2 - 4*(-1) + 12",
         "new": true
        },
        {
         "tex": "&= -1 - 3 + 4 + 12",
         "sym": "-1-3+4+12"
        },
        {
         "tex": "&= 12",
         "sym": "12"
        },
        {
         "text": "$f(-1) \\neq 0$, so $x = -1$ is not a root."
        }
       ]
      },
      {
       "title": "Test x = −2",
       "lines": [
        {
         "tex": "f(-2) &= (-2)^3 - 3(-2)^2 - 4(-2) + 12",
         "sym": "(-2)**3 - 3*(-2)**2 - 4*(-2) + 12",
         "new": true
        },
        {
         "tex": "&= -8 - 12 + 8 + 12",
         "sym": "-8-12+8+12"
        },
        {
         "tex": "&= 0",
         "sym": "0"
        },
        {
         "text": "So $(x + 2)$ is a factor and $x = -2$ is a root."
        }
       ]
      }
     ],
     "finalAnswer": "x = -2"
    },
    "finalSym": "-2",
    "answerSym": "Min(*solve(x**3 - 3*x**2 - 4*x + 12, x))"
   },
   {
    "question": "Find the integer root of $f(x) = 2x^3 - 3x^2 - 11x + 6$ that is greater than $0$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "List the possible roots",
       "lines": [
        {
         "text": "A whole-number root must divide the constant term $6$. Try $1, 2, 3, 6$ in turn."
        }
       ]
      },
      {
       "title": "Test x = 1",
       "lines": [
        {
         "tex": "f(1) &= 2 - 3 - 11 + 6",
         "sym": "2-3-11+6",
         "new": true
        },
        {
         "tex": "&= -6",
         "sym": "-6"
        },
        {
         "text": "Not a root."
        }
       ]
      },
      {
       "title": "Test x = 2",
       "lines": [
        {
         "tex": "f(2) &= 2(8) - 3(4) - 11(2) + 6",
         "sym": "2*8-3*4-11*2+6",
         "new": true
        },
        {
         "tex": "&= 16 - 12 - 22 + 6",
         "sym": "16-12-22+6"
        },
        {
         "tex": "&= -12",
         "sym": "-12"
        },
        {
         "text": "Not a root."
        }
       ]
      },
      {
       "title": "Test x = 3",
       "lines": [
        {
         "tex": "f(3) &= 2(27) - 3(9) - 11(3) + 6",
         "sym": "2*27-3*9-11*3+6",
         "new": true
        },
        {
         "tex": "&= 54 - 27 - 33 + 6",
         "sym": "54-27-33+6"
        },
        {
         "tex": "&= 0",
         "sym": "0"
        },
        {
         "text": "So $(x - 3)$ is a factor and $x = 3$ is a root."
        }
       ]
      }
     ],
     "finalAnswer": "x = 3"
    },
    "finalSym": "3",
    "answerSym": "Max(*solve(2*x**3 - 3*x**2 - 11*x + 6, x))"
   }
  ]
 },
 {
  "skill": "cubic-form-from-roots",
  "problems": [
   {
    "question": "Find the cubic equation, with integer coefficients, that has roots $2$, $-1$ and $4$.\nGive your answer in the form $x^3 + bx^2 + cx + d = 0$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Write a factor for each root",
       "lines": [
        {
         "tex": "(x - 2)(x + 1)(x - 4) &= 0",
         "sym": "Eq((x-2)*(x+1)*(x-4),0)",
         "new": true
        }
       ]
      },
      {
       "title": "Multiply the first two factors",
       "lines": [
        {
         "tex": "(x - 2)(x + 1) &= x^2 + x - 2x - 2",
         "sym": "(x-2)*(x+1)"
        },
        {
         "tex": "&= x^2 - x - 2",
         "sym": "x**2-x-2"
        }
       ]
      },
      {
       "title": "Multiply by the third factor",
       "lines": [
        {
         "tex": "(x^2 - x - 2)(x - 4) &= x^3 - 4x^2 - x^2 + 4x - 2x + 8",
         "sym": "(x**2-x-2)*(x-4)",
         "new": true
        },
        {
         "tex": "&= x^3 - 5x^2 + 2x + 8",
         "sym": "x**3-5*x**2+2*x+8"
        }
       ]
      }
     ],
     "finalAnswer": "x^3 - 5x^2 + 2x + 8 = 0"
    },
    "finalSym": "Eq(x**3 - 5*x**2 + 2*x + 8, 0)",
    "answerSym": "Eq(expand((x-2)*(x+1)*(x-4)), 0)"
   },
   {
    "question": "Find the cubic equation, with integer coefficients, that has roots $\\tfrac12$, $-3$ and $2$.\nGive your answer in the form $ax^3 + bx^2 + cx + d = 0$, where $a > 0$.",
