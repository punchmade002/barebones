 {
  "skill": "induction-inequality",
  "problems": [
   {
    "question": "Prove by induction that $n! > 2^n$ for all $n \\in \\mathbb{N}$ with $n \\ge 4$.",
    "level": "higher",
    "marks": 15,
    "workedSolution": {
     "steps": [
      {
       "title": "State what is to be proved",
       "lines": [
        {
         "text": "Let $P(n)$ be the statement $n! > 2^n$, for $n \\ge 4$."
        }
       ]
      },
      {
       "title": "Step 1: show P(4) is true",
       "lines": [
        {
         "tex": "4! &= 24",
         "sym": "Eq(factorial(4), 24)",
         "new": true
        },
        {
         "tex": "2^4 &= 16",
         "sym": "Eq(2**4, 16)",
         "new": true
        },
        {
         "text": "$24 > 16$, so $P(4)$ is true."
        }
       ]
      },
      {
       "title": "Step 2: assume P(k) is true",
       "lines": [
        {
         "text": "Assume $k! > 2^k$ for some $k \\ge 4$."
        }
       ]
      },
      {
       "title": "Step 3: write down what P(k+1) says",
       "lines": [
        {
         "tex": "(k+1)! &> 2^{k+1}"
        }
       ]
      },
      {
       "title": "Use (k+1)! = (k+1) k! and the assumption",
       "lines": [
        {
         "tex": "(k+1)! &= (k+1)\\cdot k!",
         "sym": "Eq(factorial(k+1), (k+1)*factorial(k))",
         "new": true
        },
        {
         "tex": "(k+1)\\cdot k! &> (k+1)\\cdot 2^k"
        },
        {
         "text": "This multiplies both sides of the assumption by $k+1 > 0$."
        }
       ]
      },
      {
       "title": "Show (k+1)·2^k is bigger than 2^(k+1)",
       "lines": [
        {
         "text": "Since $k \\ge 4$, $k+1 \\ge 5 > 2$."
        },
        {
         "tex": "(k+1)\\cdot 2^k &> 2\\cdot 2^k"
        },
        {
         "tex": "2\\cdot 2^k &= 2^{k+1}",
         "sym": "Eq(2*2**k, 2**(k+1))",
         "new": true
        },
        {
         "tex": "(k+1)! &> 2^{k+1}"
        },
        {
         "text": "So $P(k+1)$ is true whenever $P(k)$ is true."
        }
       ]
      },
      {
       "title": "Step 4: conclusion",
       "lines": [
        {
         "text": "$P(4)$ is true, and $P(k)$ true implies $P(k+1)$ true. By induction, $P(n)$ is true for all $n \\ge 4$, $n \\in \\mathbb{N}$."
        }
       ]
      }
     ],
     "finalAnswer": "n! > 2^n \\text{ for all } n \\ge 4,\\ n \\in \\mathbb{N}"
    },
    "finalSym": "0",
    "answerSym": "Max(0, 2**4 - factorial(4))"
   },
   {
    "question": "Prove by induction that $2^n > 2n + 1$ for all $n \\in \\mathbb{N}$ with $n \\ge 3$.",
    "level": "higher",
    "marks": 15,
    "workedSolution": {
     "steps": [
      {
       "title": "State what is to be proved",
       "lines": [
        {
         "text": "Let $P(n)$ be the statement $2^n > 2n+1$, for $n \\ge 3$."
        }
       ]
      },
      {
       "title": "Step 1: show P(3) is true",
       "lines": [
        {
         "tex": "2^3 &= 8",
         "sym": "Eq(2**3, 8)",
         "new": true
        },
        {
         "tex": "2(3)+1 &= 7",
         "sym": "Eq(2*3+1, 7)",
         "new": true
        },
        {
         "text": "$8 > 7$, so $P(3)$ is true."
        }
       ]
      },
      {
       "title": "Step 2: assume P(k) is true",
       "lines": [
        {
         "text": "Assume $2^k > 2k+1$ for some $k \\ge 3$."
        }
       ]
      },
      {
       "title": "Step 3: write down what P(k+1) says",
       "lines": [
        {
         "tex": "2^{k+1} &> 2(k+1)+1",
         "sym": "Eq(2*(k+1)+1, 2*k+3)",
         "new": true
        },
        {
         "tex": "2^{k+1} &> 2k+3"
        }
       ]
      },
      {
       "title": "Multiply the assumption by 2",
       "lines": [
        {
         "tex": "2\\cdot 2^k &> 2(2k+1)"
        },
        {
         "tex": "2^{k+1} &> 4k+2",
         "sym": "Eq(2*2**k, 2**(k+1))",
         "new": true
        }
       ]
      },
      {
       "title": "Show 4k + 2 is bigger than 2k + 3",
       "lines": [
        {
         "tex": "(4k+2) - (2k+3) &= 2k-1",
         "sym": "Eq((4*k+2) - (2*k+3), 2*k-1)",
         "new": true
        },
        {
         "tex": "2k-1 &\\ge 2(3)-1 = 5 > 0",
         "sym": "Eq(2*3-1, 5)",
         "new": true
        },
        {
         "text": "So $4k+2 > 2k+3$ for $k \\ge 3$."
        },
        {
         "tex": "2^{k+1} &> 4k+2 > 2k+3"
        },
        {
         "text": "So $P(k+1)$ is true whenever $P(k)$ is true."
        }
       ]
      },
      {
       "title": "Step 4: conclusion",
       "lines": [
        {
         "text": "$P(3)$ is true, and $P(k)$ true implies $P(k+1)$ true. By induction, $P(n)$ is true for all $n \\ge 3$, $n \\in \\mathbb{N}$."
        }
       ]
      }
     ],
     "finalAnswer": "2^n > 2n+1 \\text{ for all } n \\ge 3,\\ n \\in \\mathbb{N}"
    },
    "finalSym": "0",
    "answerSym": "Max(0, (2*3 + 1) - 2**3)"
   }
  ]
