 {
  "skill": "proof-root2-irrational",
  "problems": [
   {
    "question": "Prove by contradiction that $\\sqrt{2}$ is irrational.\nIn your proof, show that if $p^2$ is even then $p$ is even by considering an odd number $p = 2m + 1$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Assume the opposite",
       "lines": [
        {
         "text": "Suppose $\\sqrt{2}$ is rational."
        },
        {
         "text": "Then $\\sqrt{2} = \\frac{p}{q}$ where $p, q \\in \\mathbb{Z}$, $q \\ne 0$, and $p$, $q$ have no common factor."
        }
       ]
      },
      {
       "title": "Clear the fraction",
       "lines": [
        {
         "tex": "2 &= \\frac{p^2}{q^2}",
         "sym": "Eq(2, p**2/q**2)",
         "new": true
        },
        {
         "tex": "p^2 &= 2q^2",
         "sym": "Eq(p**2, 2*q**2)",
         "new": true
        },
        {
         "text": "So $p^2$ is even."
        }
       ]
      },
      {
       "title": "Show that an odd p has an odd square",
       "lines": [
        {
         "text": "Let $p = 2m+1$ be odd."
        },
        {
         "tex": "p^2 &= (2m+1)^2",
         "sym": "Eq(p**2, (2*m+1)**2)",
         "new": true
        },
        {
         "tex": "&= 4m^2 + 4m + 1",
         "sym": "Eq(p**2, 4*m**2 + 4*m + 1)",
         "new": true
        },
        {
         "tex": "&= 2(2m^2 + 2m) + 1",
         "sym": "Eq(p**2, 2*(2*m**2 + 2*m) + 1)",
         "new": true
        },
        {
         "text": "This is odd. So if $p^2$ is even, $p$ cannot be odd, so $p$ is even. Write $p = 2k$."
        }
       ]
      },
      {
       "title": "Show q is even",
       "lines": [
        {
         "tex": "2q^2 &= (2k)^2",
         "sym": "Eq(2*q**2, (2*k)**2)",
         "new": true
        },
        {
         "tex": "2q^2 &= 4k^2",
         "sym": "Eq(2*q**2, 4*k**2)"
        },
        {
         "tex": "q^2 &= 2k^2",
         "sym": "Eq(q**2, 2*k**2)"
        },
        {
         "text": "So $q^2$ is even, and by the same argument $q$ is even."
        }
       ]
      },
      {
       "title": "Reach the contradiction",
       "lines": [
        {
         "text": "$p$ and $q$ are both even, so they have a common factor $2$. This contradicts the assumption that they have no common factor."
        },
        {
         "text": "So $\\sqrt{2}$ is not rational."
        }
       ]
      }
     ],
     "finalAnswer": "\\sqrt{2} \\text{ is irrational}"
    },
    "finalSym": "0",
    "answerSym": "expand((2*m+1)**2 - (4*m**2 + 4*m + 1))"
   }
  ]
 },
 {
  "skill": "int-reverse",
  "problems": [
   {
    "question": "By differentiating $x^5 - 2x^3 + x$, find $\\int (5x^4 - 6x^2 + 1)\\,dx$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Differentiate the given expression",
       "lines": [
        {
         "tex": "\\frac{d}{dx}\\left(x^5 - 2x^3 + x\\right) &= 5x^4 - 6x^2 + 1",
         "sym": "Eq(diff(x**5 - 2*x**3 + x, x), 5*x**4 - 6*x**2 + 1)",
         "new": true
        }
       ]
      },
      {
       "title": "Reverse it",
       "lines": [
        {
         "text": "The derivative of $x^5 - 2x^3 + x$ is exactly the function to be integrated, so integrating undoes the differentiation."
        },
        {
         "tex": "\\int (5x^4 - 6x^2 + 1)\\,dx &= x^5 - 2x^3 + x + c"
        }
       ]
      }
     ],
     "finalAnswer": "x^5 - 2x^3 + x + c"
    },
    "finalSym": "x**5 - 2*x**3 + x",
    "answerSym": "integrate(5*x**4 - 6*x**2 + 1, x)"
   },
   {
    "question": "Given that $\\frac{d}{dx}\\left(x^{-2}\\right) = -2x^{-3}$, find $\\int \\frac{6}{x^3}\\,dx$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Write the integrand as a power",
       "lines": [
        {
         "tex": "\\frac{6}{x^3} &= 6x^{-3}",
         "sym": "Eq(6/x**3, 6*x**(-3))",
         "new": true
        }
       ]
      },
      {
       "title": "Match it to the given derivative",
       "lines": [
        {
         "text": "$-2x^{-3}$ is the derivative of $x^{-2}$. We need $6x^{-3}$, which is $-3$ times $-2x^{-3}$."
        },
        {
         "tex": "\\frac{d}{dx}\\left(-3x^{-2}\\right) &= -3(-2x^{-3}) = 6x^{-3}",
         "sym": "Eq(diff(-3*x**(-2), x), 6*x**(-3))",
         "new": true
        }
       ]
      },
      {
       "title": "Reverse it",
       "lines": [
        {
         "tex": "\\int \\frac{6}{x^3}\\,dx &= -3x^{-2} + c"
        },
        {
         "text": "That is $-\\frac{3}{x^2} + c$."
        }
       ]
      }
     ],
     "finalAnswer": "-\\frac{3}{x^2} + c"
    },
    "finalSym": "-3*x**(-2)",
    "answerSym": "integrate(6/x**3, x)"
   },
   {
