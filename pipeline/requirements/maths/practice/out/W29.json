         "new": true
        }
       ]
      },
      {
       "title": "Scale it to get the integrand",
       "lines": [
        {
         "text": "We want $x^{1/2} = \\sqrt{x}$, so multiply by $\\frac{2}{3}$."
        },
        {
         "tex": "\\frac{d}{dx}\\left(\\frac{2}{3}x^{3/2}\\right) &= \\frac{2}{3}\\cdot\\frac{3}{2}x^{1/2} = x^{1/2}",
