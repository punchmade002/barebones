         "new": true
        }
       ]
      },
      {
       "title": "Reverse it",
       "lines": [
        {
         "tex": "\\int \\sqrt{x}\\,dx &= \\frac{2}{3}x^{3/2} + c"
        }
       ]
      }
     ],
     "finalAnswer": "\\frac{2}{3}x^{3/2} + c"
    },
    "finalSym": "Rational(2,3)*x**Rational(3,2)",
    "answerSym": "integrate(sqrt(x), x)"
   }
  ]
 },
 {
  "skill": "int-power",
  "problems": [
   {
    "question": "Find $\\int \\left(6\\sqrt{x} + \\frac{8}{x^3}\\right)dx$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Write each term as a power of x",
       "lines": [
        {
         "tex": "6\\sqrt{x} &= 6x^{1/2}",
         "sym": "Eq(6*sqrt(x), 6*x**Rational(1,2))",
         "new": true
        },
        {
         "tex": "\\frac{8}{x^3} &= 8x^{-3}",
         "sym": "Eq(8/x**3, 8*x**(-3))",
         "new": true
        }
       ]
      },
      {
       "title": "Integrate each term: add 1 to the power, divide by the new power",
       "lines": [
        {
         "text": "Use $\\int x^n\\,dx = \\frac{x^{n+1}}{n+1}$."
        },
        {
         "tex": "\\int 6x^{1/2}\\,dx &= \\frac{6x^{3/2}}{3/2} = 4x^{3/2}",
         "sym": "Eq(6*x**Rational(3,2)/Rational(3,2), 4*x**Rational(3,2))",
         "new": true
        },
        {
         "tex": "\\int 8x^{-3}\\,dx &= \\frac{8x^{-2}}{-2} = -4x^{-2}",
         "sym": "Eq(8*x**(-2)/(-2), -4*x**(-2))",
         "new": true
        }
       ]
      },
      {
       "title": "Combine and add the constant",
       "lines": [
        {
         "tex": "\\int \\left(6\\sqrt{x} + \\frac{8}{x^3}\\right)dx &= 4x^{3/2} - 4x^{-2} + c"
        }
       ]
      }
     ],
     "finalAnswer": "4x^{3/2} - \\frac{4}{x^2} + c"
    },
    "finalSym": "4*x**Rational(3,2) - 4*x**(-2)",
    "answerSym": "integrate(6*sqrt(x) + 8/x**3, x)"
   }
  ]
 }
