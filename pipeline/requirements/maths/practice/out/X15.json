 {
  "skill": "trig-unit-circle",
  "problems": [
   {
    "question": "$P$ is a point on the unit circle, centre $O = (0, 0)$.\nThe line $OP$ makes an angle of $210^\\circ$ with the positive $x$-axis, measured anticlockwise.\nFind the co-ordinates of $P$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Place P on the unit circle using the angle",
       "lines": [
        {
         "text": "On the unit circle, a point at angle $\\theta$ is $(\\cos\\theta, \\sin\\theta)$."
        },
        {
         "tex": "P &= (\\cos 210^\\circ, \\sin 210^\\circ)"
        }
       ]
      },
      {
       "title": "Find the x co-ordinate",
       "lines": [
        {
         "text": "$210^\\circ$ is in the third quadrant, where cos is negative. The related angle is $30^\\circ$."
        },
        {
         "tex": "\\cos 210^\\circ",
         "sym": "cos(7*pi/6)",
         "new": true
        },
        {
         "tex": "&= -\\cos 30^\\circ",
         "sym": "-cos(pi/6)"
        },
        {
         "tex": "&= -\\frac{\\sqrt{3}}{2}",
         "sym": "-sqrt(3)/2"
        }
       ]
      },
      {
       "title": "Find the y co-ordinate",
       "lines": [
        {
         "text": "In the third quadrant sin is also negative."
        },
        {
         "tex": "\\sin 210^\\circ",
         "sym": "sin(7*pi/6)",
         "new": true
        },
        {
         "tex": "&= -\\sin 30^\\circ",
         "sym": "-sin(pi/6)"
        },
        {
         "tex": "&= -\\frac{1}{2}",
         "sym": "-1/2"
        }
       ]
      }
     ],
     "finalAnswer": "P = \\left(-\\frac{\\sqrt{3}}{2}, -\\frac{1}{2}\\right)"
    },
    "finalSym": "(-sqrt(3)/2, -1/2)",
    "answerSym": "(cos(7*pi/6), sin(7*pi/6))"
   }
  ]
 }
]