    "question": "Express $\\frac{7\\pi}{6}$ radians in degrees.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Use the conversion factor",
       "lines": [
        {
         "text": "$\\pi$ radians $= 180^\\circ$, so multiply by $\\frac{180}{\\pi}$."
        },
        {
         "tex": "\\frac{7\\pi}{6} \\times \\frac{180}{\\pi} &= \\frac{7 \\times 180}{6}",
         "sym": "7*pi/6*180/pi",
         "new": true
        },
        {
         "tex": "&= 210^\\circ",
         "sym": "210"
        }
       ]
      }
     ],
     "finalAnswer": "210^\\circ"
    },
    "finalSym": "210",
    "answerSym": "7*pi/6*180/pi"
