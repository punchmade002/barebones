   {
    "question": "Factorise $12x^2y - 18xy^2$.",
    "level": "ordinary",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the highest common factor",
       "lines": [
        {
         "text": "The HCF of 12 and 18 is $6$. Both terms contain $x$ and $y$ at least once, so the HCF is $6xy$."
        }
       ]
      },
      {
       "title": "Write each term as the HCF times something",
       "lines": [
        {
         "tex": "12x^2y - 18xy^2 &= 6xy\\cdot 2x - 6xy\\cdot 3y",
         "sym": "6*x*y*2*x-6*x*y*3*y"
        }
       ]
      },
      {
       "title": "Take the HCF outside a bracket",
       "lines": [
        {
         "tex": "&= 6xy(2x - 3y)",
         "sym": "6*x*y*(2*x-3*y)"
        }
       ]
      }
     ],
     "finalAnswer": "6xy(2x - 3y)"
    },
    "finalSym": "6*x*y*(2*x - 3*y)",
    "answerSym": "factor(12*x**2*y - 18*x*y**2)"
   },
   {
    "question": "Factorise $8a^3 - 12a^2 + 4a$.",
    "level": "ordinary",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the highest common factor",
       "lines": [
        {
         "text": "The HCF of 8, 12 and 4 is $4$, and every term contains $a$, so the HCF is $4a$."
        }
       ]
      },
      {
       "title": "Write each term as the HCF times something",
       "lines": [
        {
         "tex": "8a^3 - 12a^2 + 4a &= 4a\\cdot 2a^2 - 4a\\cdot 3a + 4a\\cdot 1",
         "sym": "4*a*2*a**2-4*a*3*a+4*a*1"
        }
       ]
      },
      {
       "title": "Take the HCF outside a bracket",
       "lines": [
        {
         "tex": "&= 4a(2a^2 - 3a + 1)",
         "sym": "4*a*(2*a**2-3*a+1)"
        }
       ]
      }
     ],
     "finalAnswer": "4a(2a^2 - 3a + 1)"
    },
    "finalSym": "4*a*(2*a**2 - 3*a + 1)",
    "answerSym": "factor(8*a**3 - 12*a**2 + 4*a)"
   },
   {
    "question": "The total surface area of a closed cylinder with radius $r$ and height $h$ is given by $A = 2\\pi r^2 + 2\\pi rh$.\nWrite the right-hand side as a product of $2\\pi r$ and a bracket.",
    "level": "ordinary",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the highest common factor",
       "lines": [
        {
         "text": "Both terms contain $2\\pi r$, so the HCF is $2\\pi r$."
        }
       ]
      },
      {
       "title": "Write each term as the HCF times something",
       "lines": [
        {
         "tex": "A &= 2\\pi r\\cdot r + 2\\pi r\\cdot h",
         "sym": "2*pi*r*r+2*pi*r*h"
        }
       ]
      },
      {
       "title": "Take the HCF outside a bracket",
       "lines": [
        {
         "tex": "&= 2\\pi r(r + h)",
         "sym": "2*pi*r*(r+h)"
        }
       ]
      }
     ],
     "finalAnswer": "A = 2\\pi r(r + h)"
    },
    "finalSym": "2*pi*r*(r + h)",
    "answerSym": "factor(2*pi*r**2 + 2*pi*r*h)"
   }
  ]
 },
