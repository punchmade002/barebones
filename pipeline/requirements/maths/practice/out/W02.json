       "lines": [
        {
         "tex": "9x^2 - 25 &= 0",
         "sym": "Eq(9*x**2-25,0)"
        },
        {
         "tex": "(3x)^2 - 5^2 &= 0",
         "sym": "Eq((3*x)**2-5**2,0)"
        },
        {
         "tex": "(3x - 5)(3x + 5) &= 0",
         "sym": "Eq((3*x-5)*(3*x+5),0)"
        }
       ]
      },
      {
       "title": "Set each factor equal to zero",
       "lines": [
        {
         "tex": "3x - 5 = 0 \\quad&\\text{or}\\quad 3x + 5 = 0",
         "sym": "Or(Eq(3*x-5,0),Eq(3*x+5,0))"
        }
       ]
      },
      {
       "title": "Solve for $x$",
       "lines": [
        {
         "tex": "x = \\frac{5}{3} \\quad&\\text{or}\\quad x = -\\frac{5}{3}",
         "sym": "Or(Eq(x,Rational(5,3)),Eq(x,-Rational(5,3)))",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "x = \\frac{5}{3} \\text{ or } x = -\\frac{5}{3}"
    },
    "finalSym": "[Rational(5,3), -Rational(5,3)]",
    "answerSym": "solve(Eq(9*x**2 - 25, 0), x)"
   }
