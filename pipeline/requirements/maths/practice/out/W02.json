    "workedSolution": {
     "steps": [
      {
       "title": "Write as a difference of two squares",
       "lines": [
        {
         "tex": "4x^2 - 25 &= (2x)^2 - 5^2",
         "sym": "(2*x)**2-5**2"
        }
       ]
      },
      {
       "title": "Use $a^2 - b^2 = (a - b)(a + b)$ with $a = 2x$ and $b = 5$",
       "lines": [
        {
         "tex": "&= (2x - 5)(2x + 5)",
         "sym": "(2*x-5)*(2*x+5)"
        }
       ]
      }
     ],
     "finalAnswer": "(2x - 5)(2x + 5)"
    },
    "finalSym": "(2*x - 5)*(2*x + 5)",
    "answerSym": "factor(4*x**2 - 25)"
   },
