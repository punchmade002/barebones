 {
  "skill": "seq-derive-sum-infinity",
  "problems": [
   {
    "question": "Given that the sum of the first $n$ terms of a geometric series is $S_n = \\frac{a(1-r^n)}{1-r}$, prove that if $|r| < 1$ then $S_\\infty = \\frac{a}{1-r}$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Split the formula for $S_n$",
       "lines": [
        {
         "tex": "S_n &= \\frac{a(1-r^n)}{1-r}",
         "sym": "a*(1-r**n)/(1-r)",
         "new": true
        },
        {
         "tex": "&= \\frac{a}{1-r} - \\frac{a\\,r^n}{1-r}",
         "sym": "a/(1-r) - a*r**n/(1-r)"
        }
       ]
      },
      {
       "title": "Let $n \\to \\infty$ when $|r| < 1$",
       "lines": [
        {
         "text": "If $|r| < 1$ then $r^n \\to 0$ as $n \\to \\infty$, for example $\\left(\\tfrac12\\right)^n \\to 0$."
        },
        {
         "tex": "\\frac{a\\,r^n}{1-r} &\\to 0",
         "sym": "0",
         "new": true
        }
       ]
      },
      {
       "title": "Take the limit",
       "lines": [
        {
         "tex": "S_\\infty &= \\lim_{n \\to \\infty} S_n = \\frac{a}{1-r} - 0",
         "sym": "a/(1-r)",
         "new": true
        },
        {
         "tex": "&= \\frac{a}{1-r}",
         "sym": "a/(1-r)"
        }
       ]
      }
     ],
     "finalAnswer": "S_\\infty = \\frac{a}{1-r}"
    },
    "finalSym": "0",
    "answerSym": "simplify(limit(a*(1 - Rational(1,2)**n)/(1 - Rational(1,2)), n, oo) - a/(1 - Rational(1,2)))"
   },
   {
    "question": "A geometric series has first term $6$ and common ratio $\\frac{2}{3}$.\\nShow that $S_n = 18\\left(1 - \\left(\\frac{2}{3}\\right)^n\\right)$ and prove that $S_n$ gets closer and closer to $\\frac{a}{1-r}$ as $n \\to \\infty$.",
