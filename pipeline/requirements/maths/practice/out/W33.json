   {
    "question": "Let $S_n = a + ar + ar^2 + \\dots + ar^{n-1}$.\\nBy multiplying $S_n$ by $r$ and subtracting, prove that $S_n = \\frac{a(1-r^n)}{1-r}$ for $r \\neq 1$, and deduce that $S_\\infty = \\frac{a}{1-r}$ when $|r| < 1$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Multiply $S_n$ by $r$",
       "lines": [
        {
         "tex": "rS_n &= ar + ar^2 + \\dots + ar^{n-1} + ar^n"
        }
       ]
      },
      {
       "title": "Subtract: all middle terms cancel",
       "lines": [
        {
         "tex": "S_n - rS_n &= a - ar^n",
         "sym": "a - a*r**n",
         "new": true
        },
        {
         "tex": "S_n(1-r) &= a(1-r^n)",
         "sym": "a*(1-r**n)"
        }
       ]
      },
      {
       "title": "Divide by $1 - r$ (so $r \\neq 1$)",
       "lines": [
        {
         "tex": "S_n &= \\frac{a(1-r^n)}{1-r}",
         "sym": "a*(1-r**n)/(1-r)",
         "new": true
        }
       ]
      },
      {
       "title": "Let $n \\to \\infty$ when $|r| < 1$",
       "lines": [
        {
         "text": "Then $r^n \\to 0$, so $1 - r^n \\to 1$."
        },
        {
         "tex": "S_\\infty &= \\frac{a}{1-r}",
         "sym": "a/(1-r)",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "S_n = \\frac{a(1-r^n)}{1-r}, \\quad S_\\infty = \\frac{a}{1-r}"
    },
    "finalSym": "0",
    "answerSym": "simplify(a*(1-r**n)/(1-r)*(1-r) - a*(1-r**n))"
   }
  ]
