 {
  "skill": "eq-rational-hl",
  "problems": [
   {
    "question": "Solve for $x$:\n$\\dfrac{2x+1}{x+2} + \\dfrac{x-1}{x-3} = 1$",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Multiply every term by $(x+2)(x-3)$",
       "lines": [
        {
         "tex": "\\frac{2x+1}{x+2} + \\frac{x-1}{x-3} &= 1",
         "sym": "Eq((2*x+1)/(x+2) + (x-1)/(x-3), 1)"
        },
        {
         "tex": "(2x+1)(x-3) + (x-1)(x+2) &= (x+2)(x-3)",
         "sym": "Eq((2*x+1)*(x-3) + (x-1)*(x+2), (x+2)*(x-3))"
        }
       ]
      },
      {
       "title": "Expand each product",
       "lines": [
        {
         "tex": "2x^2 - 5x - 3 + x^2 + x - 2 &= x^2 - x - 6",
         "sym": "Eq(2*x**2 - 5*x - 3 + x**2 + x - 2, x**2 - x - 6)"
        },
        {
         "tex": "3x^2 - 4x - 5 &= x^2 - x - 6",
         "sym": "Eq(3*x**2 - 4*x - 5, x**2 - x - 6)"
        }
       ]
      },
      {
       "title": "Collect into a quadratic equation",
       "lines": [
        {
         "tex": "2x^2 - 3x + 1 &= 0",
         "sym": "Eq(2*x**2 - 3*x + 1, 0)"
        }
       ]
      },
      {
       "title": "Solve with the quadratic formula",
       "lines": [
        {
         "text": "Here $a = 2$, $b = -3$, $c = 1$."
        },
        {
         "tex": "x &= \\frac{3 \\pm \\sqrt{(-3)^2 - 4(2)(1)}}{2(2)}",
         "sym": "[(3 + sqrt((-3)**2 - 4*2*1))/4, (3 - sqrt((-3)**2 - 4*2*1))/4]",
         "new": true
        },
        {
         "tex": "&= \\frac{3 \\pm 1}{4}",
         "sym": "[(3 + 1)/4, (3 - 1)/4]"
        },
        {
         "tex": "x &= 1 \\text{ or } x = \\tfrac{1}{2}",
         "sym": "[1, Rational(1, 2)]"
        }
       ]
      }
     ],
     "finalAnswer": "x = 1 \\text{ or } x = \\tfrac{1}{2}"
    },
    "finalSym": "[1, Rational(1, 2)]",
    "answerSym": "solve(Eq((2*x+1)/(x+2) + (x-1)/(x-3), 1), x)"
   },
   {
    "question": "Solve for $x$:\n$\\dfrac{3x}{x+1} - \\dfrac{2x-1}{x-1} = -1$",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Multiply every term by $(x+1)(x-1)$",
       "lines": [
        {
         "tex": "\\frac{3x}{x+1} - \\frac{2x-1}{x-1} &= -1",
         "sym": "Eq(3*x/(x+1) - (2*x-1)/(x-1), -1)"
        },
        {
         "tex": "3x(x-1) - (2x-1)(x+1) &= -(x+1)(x-1)",
         "sym": "Eq(3*x*(x-1) - (2*x-1)*(x+1), -(x+1)*(x-1))"
        }
       ]
      },
      {
       "title": "Expand, taking care with the minus sign",
       "lines": [
        {
         "tex": "3x^2 - 3x - (2x^2 + x - 1) &= -(x^2 - 1)",
         "sym": "Eq(3*x**2 - 3*x - (2*x**2 + x - 1), -(x**2 - 1))"
        },
        {
         "tex": "x^2 - 4x + 1 &= -x^2 + 1",
         "sym": "Eq(x**2 - 4*x + 1, -x**2 + 1)"
        }
       ]
      },
      {
       "title": "Collect into a quadratic equation",
       "lines": [
        {
         "tex": "2x^2 - 4x &= 0",
         "sym": "Eq(2*x**2 - 4*x, 0)"
        },
        {
         "tex": "2x(x - 2) &= 0",
         "sym": "Eq(2*x*(x - 2), 0)"
        }
       ]
      },
      {
       "title": "Solve for $x$",
       "lines": [
        {
         "tex": "x &= 0 \\text{ or } x = 2",
         "sym": "Or(Eq(x, 0), Eq(x, 2))"
        }
       ]
      }
     ],
     "finalAnswer": "x = 0 \\text{ or } x = 2"
    },
    "finalSym": "[0, 2]",
    "answerSym": "solve(Eq(3*x/(x+1) - (2*x-1)/(x-1), -1), x)"
   },
   {
    "question": "Solve for $x$:\n$\\dfrac{2x}{x-1} = 1 - \\dfrac{x+1}{x+2}$",
