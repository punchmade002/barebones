     "steps": [
      {
       "title": "Multiply every term by $(x-1)(x+2)$",
       "lines": [
        {
         "tex": "\\frac{2x}{x-1} &= 1 - \\frac{x+1}{x+2}",
         "sym": "Eq(2*x/(x-1), 1 - (x+1)/(x+2))"
        },
        {
         "tex": "2x(x+2) &= (x-1)(x+2) - (x+1)(x-1)",
         "sym": "Eq(2*x*(x+2), (x-1)*(x+2) - (x+1)*(x-1))"
        }
       ]
      },
      {
       "title": "Expand each product",
       "lines": [
        {
         "tex": "2x^2 + 4x &= x^2 + x - 2 - (x^2 - 1)",
         "sym": "Eq(2*x**2 + 4*x, x**2 + x - 2 - (x**2 - 1))"
        },
        {
         "tex": "2x^2 + 4x &= x - 1",
         "sym": "Eq(2*x**2 + 4*x, x - 1)"
        }
       ]
      },
      {
       "title": "Collect into a quadratic equation",
       "lines": [
        {
         "tex": "2x^2 + 3x + 1 &= 0",
         "sym": "Eq(2*x**2 + 3*x + 1, 0)"
        }
       ]
      },
      {
       "title": "Solve with the quadratic formula",
       "lines": [
        {
         "text": "Here $a = 2$, $b = 3$, $c = 1$."
        },
        {
         "tex": "x &= \\frac{-3 \\pm \\sqrt{3^2 - 4(2)(1)}}{2(2)}",
         "sym": "[(-3 + sqrt(3**2 - 4*2*1))/4, (-3 - sqrt(3**2 - 4*2*1))/4]",
         "new": true
        },
        {
         "tex": "&= \\frac{-3 \\pm 1}{4}",
         "sym": "[(-3 + 1)/4, (-3 - 1)/4]"
        },
        {
         "tex": "x &= -\\tfrac{1}{2} \\text{ or } x = -1",
         "sym": "[Rational(-1, 2), -1]"
        }
       ]
      }
     ],
     "finalAnswer": "x = -\\tfrac{1}{2} \\text{ or } x = -1"
    },
    "finalSym": "[Rational(-1, 2), -1]",
    "answerSym": "solve(Eq(2*x/(x-1), 1 - (x+1)/(x+2)), x)"
   }
  ]
