 {
  "skill": "circ-line-origin",
  "problems": [
   {
    "question": "Find the coordinates of the two points where the line $x - y + 2 = 0$ meets the circle $x^2 + y^2 = 10$.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Make $y$ the subject of the line",
       "lines": [
        {
         "tex": "x - y + 2 &= 0",
         "sym": "Eq(x - y + 2, 0)"
        },
        {
         "tex": "y &= x + 2",
         "sym": "Eq(y, x + 2)"
        }
       ]
      },
      {
       "title": "Substitute into the circle",
       "lines": [
        {
         "tex": "x^2 + y^2 &= 10",
         "sym": "Eq(x**2 + y**2, 10)",
         "new": true
        },
        {
         "tex": "x^2 + (x + 2)^2 &= 10",
         "sym": "Eq(x**2 + (x + 2)**2, 10)"
        }
       ]
      },
      {
       "title": "Expand and simplify to a quadratic",
       "lines": [
        {
         "tex": "x^2 + x^2 + 4x + 4 &= 10",
         "sym": "Eq(x**2 + x**2 + 4*x + 4, 10)"
        },
        {
         "tex": "2x^2 + 4x - 6 &= 0",
         "sym": "Eq(2*x**2 + 4*x - 6, 0)"
        },
        {
         "tex": "x^2 + 2x - 3 &= 0",
         "sym": "Eq(x**2 + 2*x - 3, 0)"
        }
       ]
      },
      {
       "title": "Factorise and solve for $x$",
       "lines": [
        {
         "tex": "(x + 3)(x - 1) &= 0",
         "sym": "Eq((x + 3)*(x - 1), 0)"
        },
        {
         "tex": "x &= -3 \\text{ or } x = 1",
         "sym": "Or(Eq(x, -3), Eq(x, 1))"
        }
       ]
      },
      {
       "title": "Find $y$ when $x = -3$",
       "lines": [
        {
         "tex": "y &= -3 + 2",
         "sym": "Eq(y, -3 + 2)",
         "new": true
        },
        {
         "tex": "y &= -1",
         "sym": "Eq(y, -1)"
        }
       ]
      },
      {
       "title": "Find $y$ when $x = 1$",
       "lines": [
        {
         "tex": "y &= 1 + 2",
         "sym": "Eq(y, 1 + 2)",
         "new": true
        },
        {
         "tex": "y &= 3",
         "sym": "Eq(y, 3)"
        }
       ]
      },
      {
       "title": "State the points of intersection",
       "lines": [
        {
         "text": "The line meets the circle at $(-3, -1)$ and $(1, 3)$."
        }
       ]
      }
     ],
     "finalAnswer": "(-3, -1) \\text{ and } (1, 3)"
    },
    "finalSym": "[(-3, -1), (1, 3)]",
    "answerSym": "solve([x - y + 2, x**2 + y**2 - 10], [x, y])"
   },
   {
    "question": "The line $2x + y - 5 = 0$ meets the circle $x^2 + y^2 = 25$ at two points.\nFind the coordinates of the two points.",
    "level": "ordinary",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Make $y$ the subject of the line",
       "lines": [
        {
         "tex": "2x + y - 5 &= 0",
         "sym": "Eq(2*x + y - 5, 0)"
        },
        {
         "tex": "y &= 5 - 2x",
         "sym": "Eq(y, 5 - 2*x)"
        }
       ]
      },
      {
       "title": "Substitute into the circle",
       "lines": [
        {
         "tex": "x^2 + y^2 &= 25",
         "sym": "Eq(x**2 + y**2, 25)",
         "new": true
        },
        {
         "tex": "x^2 + (5 - 2x)^2 &= 25",
         "sym": "Eq(x**2 + (5 - 2*x)**2, 25)"
        }
       ]
      },
      {
       "title": "Expand and simplify to a quadratic",
       "lines": [
        {
         "tex": "x^2 + 25 - 20x + 4x^2 &= 25",
         "sym": "Eq(x**2 + 25 - 20*x + 4*x**2, 25)"
        },
        {
         "tex": "5x^2 - 20x &= 0",
         "sym": "Eq(5*x**2 - 20*x, 0)"
        },
        {
         "tex": "x^2 - 4x &= 0",
         "sym": "Eq(x**2 - 4*x, 0)"
        }
       ]
      },
      {
       "title": "Factorise and solve for $x$",
       "lines": [
        {
         "tex": "x(x - 4) &= 0",
         "sym": "Eq(x*(x - 4), 0)"
        },
        {
         "tex": "x &= 0 \\text{ or } x = 4",
         "sym": "Or(Eq(x, 0), Eq(x, 4))"
        }
       ]
      },
      {
       "title": "Find $y$ when $x = 0$",
       "lines": [
        {
         "tex": "y &= 5 - 2(0)",
         "sym": "Eq(y, 5 - 2*0)",
         "new": true
        },
        {
         "tex": "y &= 5",
         "sym": "Eq(y, 5)"
        }
       ]
      },
      {
       "title": "Find $y$ when $x = 4$",
       "lines": [
        {
         "tex": "y &= 5 - 2(4)",
         "sym": "Eq(y, 5 - 2*4)",
         "new": true
        },
        {
         "tex": "y &= -3",
         "sym": "Eq(y, -3)"
        }
       ]
      },
      {
       "title": "State the points of intersection",
       "lines": [
        {
         "text": "The line meets the circle at $(0, 5)$ and $(4, -3)$."
        }
       ]
      }
     ],
     "finalAnswer": "(0, 5) \\text{ and } (4, -3)"
    },
    "finalSym": "[(0, 5), (4, -3)]",
    "answerSym": "solve([2*x + y - 5, x**2 + y**2 - 25], [x, y])"
   }
  ]
 },
 {
  "skill": "circ-general-form",
  "problems": [
   {
    "question": "The circle $c$ has equation $x^2 + y^2 + 6x - 4y - 12 = 0$.\nFind the centre and the radius of $c$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Compare with the general circle equation",
       "lines": [
        {
         "text": "The general form is $x^2 + y^2 + 2gx + 2fy + c = 0$, with centre $(-g, -f)$ and radius $\\sqrt{g^2 + f^2 - c}$."
        },
        {
         "tex": "2g &= 6",
         "sym": "Eq(2*g, 6)",
         "new": true
        },
        {
         "tex": "g &= 3",
         "sym": "Eq(g, 3)"
        },
        {
         "tex": "2f &= -4",
         "sym": "Eq(2*f, -4)",
         "new": true
        },
        {
         "tex": "f &= -2",
         "sym": "Eq(f, -2)"
        },
        {
         "tex": "c &= -12",
         "sym": "Eq(c, -12)",
         "new": true
        }
       ]
      },
      {
       "title": "Write down the centre",
       "lines": [
        {
         "tex": "\\text{Centre} &= (-g, -f)"
        },
        {
         "tex": "&= (-3, 2)",
         "sym": "(-3, 2)",
         "new": true
        }
       ]
      },
      {
       "title": "Find the radius",
       "lines": [
        {
         "tex": "r &= \\sqrt{g^2 + f^2 - c}"
        },
        {
         "tex": "&= \\sqrt{(3)^2 + (-2)^2 - (-12)}",
         "sym": "sqrt(3**2 + (-2)**2 - (-12))",
         "new": true
        },
        {
         "tex": "&= \\sqrt{9 + 4 + 12}",
         "sym": "sqrt(9 + 4 + 12)"
        },
        {
         "tex": "&= \\sqrt{25}",
         "sym": "sqrt(25)"
        },
        {
         "tex": "&= 5",
         "sym": "5"
        }
       ]
      }
     ],
     "finalAnswer": "\\text{Centre} = (-3, 2), \\quad r = 5"
    },
    "finalSym": "[(-3, 2), 5]",
    "answerSym": "[(-3, 2), sqrt(3**2 + (-2)**2 + 12)]"
   }
  ]
 },
 {
  "skill": "circ-tangent-length",
  "problems": [
   {
    "question": "The circle $c$ has equation $x^2 + y^2 - 4x + 6y - 12 = 0$.\nThe point $P(7, 0)$ lies outside $c$. A tangent from $P$ touches $c$ at the point $T$.\nFind $|PT|$.",
    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the centre and radius of $c$",
       "lines": [
        {
         "text": "Compare with $x^2 + y^2 + 2gx + 2fy + c = 0$: here $2g = -4$, $2f = 6$ and $c = -12$."
        },
        {
         "tex": "g &= -2, \\quad f = 3"
        },
        {
         "text": "The centre is $(-g, -f)$, so $A = (2, -3)$."
        },
        {
         "tex": "r^2 &= g^2 + f^2 - c"
        },
        {
         "tex": "&= 4 + 9 + 12",
         "sym": "4 + 9 + 12",
         "new": true
        },
        {
         "tex": "&= 25",
         "sym": "25"
        }
       ]
      },
      {
       "title": "Find the distance from $A$ to $P$",
       "lines": [
        {
         "tex": "|AP|^2 &= (7 - 2)^2 + (0 - (-3))^2",
         "sym": "(7 - 2)**2 + (0 - (-3))**2",
         "new": true
        },
        {
         "tex": "&= 25 + 9",
         "sym": "25 + 9"
        },
        {
         "tex": "&= 34",
         "sym": "34"
        }
       ]
      },
      {
       "title": "Use Pythagoras in triangle $ATP$",
       "lines": [
        {
         "text": "A tangent is perpendicular to the radius at the point of contact, so $\\angle ATP = 90^\\circ$."
        },
        {
         "tex": "|PT|^2 &= |AP|^2 - |AT|^2",
         "sym": "Eq(PT**2, AP**2 - AT**2)",
         "new": true
        },
        {
         "tex": "&= 34 - 25",
         "sym": "34 - 25",
         "new": true
        },
        {
         "tex": "&= 9",
         "sym": "9"
        },
        {
         "tex": "|PT| &= 3",
         "sym": "Eq(PT, 3)",
         "new": true
        }
       ]
      }
     ],
     "finalAnswer": "|PT| = 3"
    },
    "finalSym": "3",
    "answerSym": "sqrt(7**2 + 0**2 - 4*7 + 6*0 - 12)"
   },
