    "level": "higher",
    "marks": 10,
    "workedSolution": {
     "steps": [
      {
       "title": "Use g(x) = 1 - 2sin x at each x",
       "lines": [
        {
         "text": "Work in radians. Find $g(x)$ at $x = 0, \\frac{\\pi}{6}, \\frac{\\pi}{2}, \\frac{5\\pi}{6}, \\pi, \\frac{7\\pi}{6}, \\frac{3\\pi}{2}, \\frac{11\\pi}{6}, 2\\pi$."
        }
       ]
      },
      {
       "title": "Substitute $x = 0$",
