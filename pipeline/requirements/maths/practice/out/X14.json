 {
  "skill": "trig-graph-abc",
  "problems": [
   {
    "question": "The height, in metres, of a seat on a Ferris wheel above the ground, $t$ seconds after the ride starts, is\n$h(t) = 8 - 6\\sin\\left(\\frac{\\pi t}{10}\\right)$, where the angle is in radians.\nFind the period and the range of $h$.",
    "level": "higher",
    "marks": 5,
    "workedSolution": {
     "steps": [
      {
       "title": "Find the period",
       "lines": [
        {
         "text": "For $\\sin(ct)$ the period is $\\dfrac{2\\pi}{c}$. Here $c = \\dfrac{\\pi}{10}$."
        },
        {
         "tex": "\\text{Period} &= \\frac{2\\pi}{\\pi/10}",
         "sym": "2*pi/(pi/10)",
         "new": true
        },
        {
         "tex": "&= 2\\pi \\times \\frac{10}{\\pi}",
         "sym": "2*pi*10/pi"
        },
        {
         "tex": "&= 20\\text{ seconds}",
         "sym": "20"
        }
       ]
      },
      {
       "title": "Find the range",
       "lines": [
        {
         "text": "$\\sin$ always lies between $-1$ and $1$, so the $-6\\sin(\\cdot)$ term lies between $-6$ and $6$."
        },
        {
         "tex": "\\text{Minimum} &= 8 - 6",
         "sym": "8-6",
         "new": true
        },
        {
         "tex": "&= 2",
         "sym": "2"
        },
        {
         "tex": "\\text{Maximum} &= 8 + 6",
         "sym": "8+6",
         "new": true
        },
        {
         "tex": "&= 14",
         "sym": "14"
        }
       ]
      }
     ],
     "finalAnswer": "\\text{Period} = 20\\text{ seconds},\\quad \\text{Range} = [2,\\,14]\\text{ m}"
    },
    "finalSym": "[20, 2, 14]",
    "answerSym": "[2*pi/(pi/10), 8 - Abs(-6), 8 + Abs(-6)]"
   }
  ]
 }
]