    "level": "higher",
    "year": null,
    "question": "Find $\\int \\cos^2 3x \\,dx$.",
    "marks": 10,
    "steps": [
     {
      "title": "Use the half-angle formula",
      "lines": [
       {
        "text": "$\\cos^2 A = \\dfrac{1 + \\cos 2A}{2}$. Here $A = 3x$, so $2A = 6x$."
       },
       {
        "tex": "\\cos^2 3x &= \\frac{1 + \\cos 6x}{2}"
       }
      ]
     },
     {
      "title": "Write the integral with the formula",
      "lines": [
       {
        "tex": "\\int \\cos^2 3x\\,dx &= \\int \\left(\\frac{1}{2} + \\frac{1}{2}\\cos 6x\\right) dx"
       }
      ]
     },
     {
      "title": "Integrate each term",
      "lines": [
       {
        "text": "$\\int \\cos 6x\\,dx = \\dfrac{\\sin 6x}{6}$."
       },
       {
        "tex": "&= \\frac{x}{2} + \\frac{1}{2}\\cdot\\frac{\\sin 6x}{6} + c"
       },
       {
        "tex": "&= \\frac{x}{2} + \\frac{\\sin 6x}{12} + c"
       }
      ]
     }
    ],
    "final": "\\frac{x}{2} + \\frac{\\sin 6x}{12} + c"
   },
   {
    "part": "practice-int-trig-identity-2",
    "level": "higher",
    "year": null,
    "question": "Find $\\int \\sin 5x \\cos 3x \\,dx$.",
    "marks": 10,
    "steps": [
     {
      "title": "Use the product-to-sum formula",
      "lines": [
       {
        "text": "$\\sin A\\cos B = \\tfrac{1}{2}\\left[\\sin(A+B) + \\sin(A-B)\\right]$. Here $A = 5x$ and $B = 3x$."
       },
       {
        "tex": "\\sin 5x \\cos 3x &= \\frac{1}{2}\\left[\\sin 8x + \\sin 2x\\right]"
       }
      ]
     },
     {
      "title": "Write the integral with the formula",
      "lines": [
       {
        "tex": "\\int \\sin 5x\\cos 3x\\,dx &= \\frac{1}{2}\\int (\\sin 8x + \\sin 2x)\\,dx"
       }
      ]
     },
     {
      "title": "Integrate each term",
      "lines": [
       {
        "text": "$\\int \\sin kx\\,dx = -\\dfrac{\\cos kx}{k}$."
       },
       {
        "tex": "&= \\frac{1}{2}\\left[-\\frac{\\cos 8x}{8} - \\frac{\\cos 2x}{2}\\right] + c"
       },
       {
        "tex": "&= -\\frac{\\cos 8x}{16} - \\frac{\\cos 2x}{4} + c"
       }
      ]
     }
    ],
    "final": "-\\frac{\\cos 8x}{16} - \\frac{\\cos 2x}{4} + c"
   },
   {
    "part": "practice-int-trig-identity-3",
    "level": "higher",
    "year": null,
    "question": "Find $\\int (\\sin x + \\cos x)^2 \\,dx$.",
    "marks": 10,
    "steps": [
     {
      "title": "Expand the square",
      "lines": [
       {
        "tex": "(\\sin x + \\cos x)^2 &= \\sin^2 x + 2\\sin x\\cos x + \\cos^2 x"
       }
      ]
     },
     {
      "title": "Use the identities",
      "lines": [
       {
        "text": "$\\sin^2 x + \\cos^2 x = 1$ and $2\\sin x\\cos x = \\sin 2x$."
       },
       {
        "tex": "&= 1 + \\sin 2x"
       }
      ]
     },
     {
      "title": "Integrate each term",
      "lines": [
       {
        "text": "$\\int \\sin 2x\\,dx = -\\dfrac{\\cos 2x}{2}$."
       },
       {
        "tex": "\\int (1 + \\sin 2x)\\,dx &= x - \\frac{\\cos 2x}{2} + c"
       }
      ]
     }
    ],
    "final": "x - \\frac{\\cos 2x}{2} + c"
   }
  ]
 },
