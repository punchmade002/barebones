    "steps": [
     {
      "title": "Integrate $\\sin 3x$",
      "lines": [
       {
        "text": "$\\int \\sin ax\\,dx = -\\frac{1}{a}\\cos ax$, here $a = 3$."
       },
       {
        "tex": "\\int_0^{\\pi/6} \\sin 3x\\,dx &= \\left[-\\tfrac{1}{3}\\cos 3x\\right]_0^{\\pi/6}"
       }
      ]
     },
     {
      "title": "Substitute the limits",
      "lines": [
       {
        "tex": "&= -\\tfrac{1}{3}\\cos\\left(\\tfrac{\\pi}{2}\\right) + \\tfrac{1}{3}\\cos 0"
       },
       {
        "tex": "&= 0 + \\tfrac{1}{3}"
       },
       {
        "tex": "&= \\tfrac{1}{3}"
       }
      ]
     }
    ],
