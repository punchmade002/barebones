    "part": "practice-int-trig-2",
    "level": "higher",
    "year": null,
    "question": "Evaluate $\\int_0^{\\pi/2} \\left(4\\cos 2x - \\sin x\\right)dx$.",
    "marks": 5,
    "steps": [
     {
      "title": "Integrate each term",
      "lines": [
       {
        "text": "$\\int \\cos 2x\\,dx = \\frac{1}{2}\\sin 2x$ and $\\int \\sin x\\,dx = -\\cos x$."
       },
       {
        "tex": "\\int_0^{\\pi/2} \\left(4\\cos 2x - \\sin x\\right)dx &= \\left[2\\sin 2x + \\cos x\\right]_0^{\\pi/2}"
       }
      ]
     },
     {
      "title": "Substitute the limits",
      "lines": [
       {
        "tex": "&= \\left(2\\sin\\pi + \\cos\\tfrac{\\pi}{2}\\right) - \\left(2\\sin 0 + \\cos 0\\right)"
       },
       {
        "tex": "&= (0 + 0) - (0 + 1)"
       },
       {
        "tex": "&= -1"
       }
      ]
     }
    ],
    "final": "-1"
   }
  ]
