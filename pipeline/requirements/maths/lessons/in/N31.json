      "lines": [
       {
        "text": "$PR$ is opposite the angle $120^\\circ$ in triangle $PQR$."
       },
       {
        "tex": "|PR|^2 &= 3^2 + 5^2 - 2(3)(5)\\cos 120^\\circ"
       },
       {
        "tex": "&= 9 + 25 + 15"
       },
       {
        "tex": "&= 49"
       },
       {
        "tex": "|PR| &= 7"
       }
      ]
     },
     {
      "title": "Set up the sine rule in triangle $PRS$",
      "lines": [
       {
        "text": "$PS$ is opposite $\\angle PRS = 45^\\circ$, and $PR$ is opposite $\\angle PSR = 30^\\circ$."
       },
       {
        "tex": "\\frac{|PS|}{\\sin 45^\\circ} &= \\frac{7}{\\sin 30^\\circ}"
       }
      ]
     },
     {
      "title": "Solve for $|PS|$",
      "lines": [
       {
        "tex": "|PS| &= \\frac{7 \\sin 45^\\circ}{\\sin 30^\\circ}"
       },
       {
        "tex": "&= 7\\sqrt{2}"
       },
       {
        "tex": "&\\approx 9.9 \\text{ cm}"
       }
      ]
     }
    ],
