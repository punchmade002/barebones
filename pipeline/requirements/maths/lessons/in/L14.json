    "level": "higher",
    "year": 2024,
    "marks": 5,
    "steps": [
     {
      "title": "Identify the binomial set-up",
      "lines": [
       {
        "text": "Each customer either used the pool (probability $\\frac{1}{5}$) or did not (probability $\\frac{4}{5}$)."
       },
       {
        "text": "We want 2 successes in 6 trials, so $n = 6$, $r = 2$."
       }
      ]
     },
     {
      "title": "Substitute into the binomial formula",
      "lines": [
       {
        "tex": "P(2) &= \\binom{6}{2}\\left(\\frac{1}{5}\\right)^2\\left(\\frac{4}{5}\\right)^4"
       },
       {
        "tex": "&= 15 \\times \\frac{1}{25} \\times \\frac{256}{625}"
       },
       {
        "tex": "&= \\frac{768}{3125}"
       },
       {
        "tex": "&= 0.24576"
       }
      ]
     }
    ],
    "final": "\\frac{768}{3125} = 0.24576"
   },
   {
    "part": "maths-pp-2021-higher-p2-q1#(c)",
    "level": "higher",
    "year": 2021,
    "marks": 5,
    "steps": [
     {
      "title": "Set up the remaining ten players",
      "lines": [
       {
        "text": "The goalkeeper is left footed, so 10 players remain, each left footed with probability 0.15."
       },
       {
        "text": "At least 8 right footed out of 10 means 0, 1 or 2 left footed."
       }
      ]
     },
     {
      "title": "Find P(0), P(1) and P(2)",
      "lines": [
       {
        "tex": "P(0) &= 0.85^{10}"
       },
       {
        "tex": "&= 0.1969\\ldots"
       },
       {
        "tex": "P(1) &= \\binom{10}{1}(0.15)(0.85)^9"
       },
       {
        "tex": "&= 0.3474\\ldots"
       },
       {
        "tex": "P(2) &= \\binom{10}{2}(0.15)^2(0.85)^8"
       },
       {
        "tex": "&= 0.2759\\ldots"
       }
      ]
     },
     {
      "title": "Add the three probabilities",
      "lines": [
       {
        "tex": "P(\\text{at least 8 right}) &= 0.1969 + 0.3474 + 0.2759"
       },
       {
        "tex": "&= 0.8202"
       },
       {
        "tex": "&\\approx 0.82"
       }
      ]
     }
    ],
    "final": "0.82"
   },
   {
    "part": "maths-pp-2025-higher-p2-q9#(b)",
    "level": "higher",
    "year": 2025,
    "marks": 5,
    "steps": [
     {
      "title": "Choose the model and find the other probability",
      "lines": [
       {
        "text": "Each person either has diabetes (probability 0.067) or not. Use the binomial formula with $n = 5$."
       },
       {
        "text": "It is easier to find $P(2 \\text{ or more}) = 1 - P(0) - P(1)$."
       },
       {
        "tex": "P(\\text{no diabetes}) &= 1 - 0.067"
       },
       {
        "tex": "&= 0.933"
       }
      ]
     },
     {
      "title": "Find P(0)",
      "lines": [
       {
        "tex": "P(0) &= \\binom{5}{0}(0.933)^5"
       },
       {
        "tex": "&= 0.706982\\ldots"
       }
      ]
     },
     {
      "title": "Find P(1)",
      "lines": [
       {
        "tex": "P(1) &= \\binom{5}{1}(0.933)^4(0.067)"
       },
       {
        "tex": "&= 0.253847\\ldots"
       }
      ]
     },
     {
      "title": "Subtract from 1",
      "lines": [
       {
        "tex": "P(2 \\text{ or more}) &= 1 - \\left(0.706982\\ldots + 0.253847\\ldots\\right)"
       },
       {
        "tex": "&= 1 - 0.960829\\ldots"
       },
       {
        "tex": "&= 0.039171\\ldots"
       },
       {
        "tex": "&\\approx 0.0392"
       }
      ]
     }
    ],
    "final": "0.0392"
   }
  ]
 }
]