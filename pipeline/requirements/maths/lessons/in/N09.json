[
 {
  "skill": {
   "id": "fin-mortgage-derive",
   "title": "Derive the mortgage repayment formula",
   "level": "HL",
   "input": "loan = sum of PVs of repayments",
   "output": "formula"
  },
  "candidates": [
   {
    "part": "maths-pp-2017-higher-p1-q8#(a)",
    "level": "higher",
    "year": 2017,
    "marks": 5,
    "steps": [
     {
      "title": "Write the loan as the sum of the repayments in today's money",
      "lines": [
       {
        "text": "A repayment $A$ made at the end of period $k$ is worth $\\frac{A}{(1+i)^k}$ today. Today's value of all $t$ repayments is the loan $P$."
       },
       {
        "tex": "P &= \\frac{A}{1+i} + \\frac{A}{(1+i)^2} + \\cdots + \\frac{A}{(1+i)^t}"
       }
      ]
     },
     {
      "title": "Use the sum of a geometric series",
      "lines": [
       {
        "text": "This is a geometric series with first term $a = \\frac{A}{1+i}$, common ratio $r = \\frac{1}{1+i}$ and $t$ terms, so $S_t = \\frac{a(1 - r^t)}{1 - r}$."
       },
       {
        "tex": "P &= \\frac{\\frac{A}{1+i}\\left(1 - \\left(\\frac{1}{1+i}\\right)^t\\right)}{1 - \\frac{1}{1+i}}"
       },
       {
        "tex": "&= \\frac{\\frac{A}{1+i}\\left(1 - \\frac{1}{(1+i)^t}\\right)}{1 - \\frac{1}{1+i}}"
       }
      ]
     },
     {
      "title": "Simplify the denominator",
      "lines": [
       {
        "tex": "1 - \\frac{1}{1+i} &= \\frac{1+i-1}{1+i}"
       },
       {
        "tex": "&= \\frac{i}{1+i}"
       }
      ]
     },
     {
      "title": "Cancel the factor 1/(1+i) and tidy up",
      "lines": [
       {
        "tex": "P &= \\frac{\\frac{A}{1+i}\\left(1 - \\frac{1}{(1+i)^t}\\right)}{\\frac{i}{1+i}}"
       },
       {
        "tex": "&= \\frac{A\\left(1 - \\frac{1}{(1+i)^t}\\right)}{i}"
       },
       {
        "tex": "&= \\frac{A\\left(\\frac{(1+i)^t - 1}{(1+i)^t}\\right)}{i}"
       },
       {
        "tex": "&= \\frac{A\\left((1+i)^t - 1\\right)}{i(1+i)^t}"
       }
      ]
     },
     {
      "title": "Make A the subject",
      "lines": [
       {
        "text": "Multiply both sides by $i(1+i)^t$, then divide both sides by $(1+i)^t - 1$."
       },
       {
        "tex": "P\\, i(1+i)^t &= A\\left((1+i)^t - 1\\right)"
       },
       {
        "tex": "A &= \\frac{P\\, i(1+i)^t}{(1+i)^t - 1}"
       }
      ]
     }
    ],
    "final": "A = \\frac{P\\, i(1+i)^t}{(1+i)^t - 1}"
   },
   {
    "part": "practice-fin-mortgage-derive-1",
    "level": "higher",
    "year": null,
    "question": "A loan of $\\text{€}P$ is repaid by $t$ equal monthly repayments of $\\text{€}A$. The first repayment is made immediately and each of the others is made at the end of each following month. The monthly interest rate is $i$.\nBy writing $P$ as the sum of the present values of the repayments, prove that\n$A = \\frac{P\\,i(1+i)^{t-1}}{(1+i)^t - 1}.$",
    "marks": 10,
    "steps": [
     {
      "title": "Write the loan as the sum of the repayments in today's money",
      "lines": [
       {
        "text": "The first repayment is made now, so it is worth $A$. A repayment made after $k$ months is worth $\\frac{A}{(1+i)^k}$ today."
       },
       {
        "tex": "P &= A + \\frac{A}{1+i} + \\frac{A}{(1+i)^2} + \\cdots + \\frac{A}{(1+i)^{t-1}}"
       }
      ]
     },
     {
      "title": "Identify the geometric series",
      "lines": [
       {
        "text": "Geometric with first term $a = A$, common ratio $r = \\frac{1}{1+i}$ and $t$ terms."
       },
       {
        "tex": "P &= \\frac{A\\left(1 - \\left(\\frac{1}{1+i}\\right)^t\\right)}{1 - \\frac{1}{1+i}}"
       }
      ]
     },
     {
      "title": "Simplify the denominator",
      "lines": [
       {
        "tex": "1 - \\frac{1}{1+i} &= \\frac{1+i-1}{1+i}"
       },
       {
        "tex": "&= \\frac{i}{1+i}"
       }
      ]
     },
     {
      "title": "Divide by the fraction and tidy up",
      "lines": [
       {
        "tex": "P &= \\frac{A(1+i)\\left(1 - \\frac{1}{(1+i)^t}\\right)}{i}"
       },
       {
        "tex": "&= \\frac{A(1+i)\\left((1+i)^t - 1\\right)}{i(1+i)^t}"
       },
       {
        "tex": "&= \\frac{A\\left((1+i)^t - 1\\right)}{i(1+i)^{t-1}}"
       }
      ]
     },
     {
      "title": "Make A the subject",
      "lines": [
       {
        "text": "Multiply both sides by $i(1+i)^{t-1}$, then divide by $(1+i)^t - 1$."
       },
       {
        "tex": "A &= \\frac{P\\,i(1+i)^{t-1}}{(1+i)^t - 1}"
       }
      ]
     }
    ],
    "final": "A = \\frac{P\\,i(1+i)^{t-1}}{(1+i)^t - 1}"
   },
   {
    "part": "maths-pp-2024-higher-p1-q7#(b)(i), (ii)",
    "level": "higher",
    "year": 2024,
    "marks": 15,
    "steps": [
     {
      "title": "Write the monthly rate as a decimal",
      "lines": [
       {
        "text": "Each month the debt grows by a factor of $1 + 0.00279 = 1.00279$."
       },
       {
        "tex": "0.279\\% &= 0.00279"
       }
      ]
     },
     {
      "title": "Present value of repayment 1",
      "lines": [
       {
        "text": "A payment made after $n$ months is divided by $1.00279$ once for each month."
       },
       {
        "tex": "PV_1 &= \\frac{1647.75}{1.00279}"
       }
      ]
     },
     {
      "title": "Present value of repayment 2",
      "lines": [
       {
        "tex": "PV_2 &= \\frac{1647.75}{(1.00279)^2}"
       }
      ]
     },
     {
      "title": "Present value of repayment 3",
      "lines": [
       {
        "tex": "PV_3 &= \\frac{1647.75}{(1.00279)^3}"
       }
      ]
     },
     {
      "title": "Set up the amount borrowed as a sum",
      "lines": [
       {
        "text": "The loan equals the sum of the present values of all $25 \\times 12 = 300$ repayments."
       },
       {
        "tex": "P &= \\frac{1647.75}{1.00279} + \\frac{1647.75}{(1.00279)^2} + \\cdots + \\frac{1647.75}{(1.00279)^{300}}"
       }
      ]
     },
     {
      "title": "Identify the geometric series",
      "lines": [
       {
        "text": "This is a geometric series with $n = 300$, first term $a$ and common ratio $r$."
       },
       {
        "tex": "a &= \\frac{1647.75}{1.00279}"
       },
       {
        "tex": "r &= \\frac{1}{1.00279}"
       }
      ]
     },
     {
      "title": "Substitute into the geometric sum formula",
      "lines": [
       {
        "text": "$S_n = \\dfrac{a(1 - r^n)}{1 - r}$"
       },
       {
        "tex": "P &= \\frac{\\frac{1647.75}{1.00279}\\left[1 - \\left(\\frac{1}{1.00279}\\right)^{300}\\right]}{1 - \\frac{1}{1.00279}}"
       }
      ]
     },
     {
      "title": "Evaluate and round",
      "lines": [
       {
        "tex": "P &= 334\\,562.61\\ldots"
       },
       {
        "tex": "P &\\approx 334\\,563"
       }
      ]
     }
    ],
    "final": "\\text{€}334\\,563"
   }
  ]
 },
