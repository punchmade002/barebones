 {
  "skill": {
   "id": "fn-composite",
   "title": "Form a composite function",
   "level": "OL",
   "input": "f(x), g(x)",
   "output": "f(g(x))"
  },
  "candidates": [
   {
    "part": "practice-fn-composite-1",
    "level": "ordinary",
    "year": null,
    "question": "$f(x) = 3x - 2$ and $g(x) = x^2 + 1$.\nFind $g(f(x))$, in the form $ax^2 + bx + c$.",
    "marks": 10,
    "steps": [
     {
      "title": "Put $f(x)$ in place of $x$ in $g$",
      "lines": [
       {
        "tex": "g(f(x)) &= g(3x - 2)"
       },
       {
        "tex": "&= (3x - 2)^2 + 1"
       }
      ]
     },
     {
      "title": "Multiply out the bracket",
      "lines": [
       {
        "tex": "&= (3x-2)(3x-2) + 1"
       },
       {
        "tex": "&= 9x^2 - 12x + 4 + 1"
       }
      ]
     },
     {
      "title": "Collect like terms",
      "lines": [
       {
        "tex": "&= 9x^2 - 12x + 5"
       }
      ]
     }
    ],
    "final": "9x^2 - 12x + 5"
   },
   {
    "part": "maths-pp-2020-higher-p1-q3#(a)",
    "level": "higher",
    "year": 2020,
    "marks": 10,
    "steps": [
     {
      "title": "Work out f(g(x))",
      "lines": [
       {
        "text": "Put $g(x)$ in place of $x$ in $f(x) = 6x - 5$."
       },
       {
        "tex": "f(g(x)) &= f\\left(\\frac{x+5}{6}\\right)"
       },
       {
        "tex": "&= 6\\left(\\frac{x+5}{6}\\right) - 5"
       },
       {
        "tex": "&= x + 5 - 5"
       },
       {
        "tex": "&= x"
       }
      ]
     },
     {
      "title": "Work out g(f(x))",
      "lines": [
       {
        "text": "Put $f(x)$ in place of $x$ in $g(x) = \\frac{x+5}{6}$."
       },
       {
        "tex": "g(f(x)) &= g(6x - 5)"
       },
       {
        "tex": "&= \\frac{(6x - 5) + 5}{6}"
       },
       {
        "tex": "&= \\frac{6x}{6}"
       },
       {
        "tex": "&= x"
       }
      ]
     },
     {
      "title": "Compare the two results",
      "lines": [
       {
        "text": "Both compositions simplify to $x$, so they are equal."
       }
      ]
     }
    ],
    "final": "f(g(x)) = g(f(x)) = x \\text{, so yes they are equal}"
   },
   {
    "part": "maths-pp-2024-higher-p1-q6#(b)(iii)",
    "level": "higher",
    "year": 2024,
    "marks": 10,
    "steps": [
     {
      "title": "Substitute f(x) into g",
      "lines": [
       {
        "text": "$g$ takes the square root and then the natural log, so replace $x$ in $g$ by $e^{9x}$."
       },
       {
        "tex": "g(f(x)) &= \\ln\\sqrt{e^{9x}}"
       }
      ]
     },
     {
      "title": "Write the square root as a power",
      "lines": [
       {
        "tex": "&= \\ln\\left(e^{9x}\\right)^{\\frac{1}{2}}"
       },
       {
        "tex": "&= \\ln e^{\\frac{9x}{2}}"
       }
      ]
     },
     {
      "title": "Cancel the log with the exponential",
      "lines": [
       {
        "text": "$\\ln e^{k} = k$."
       },
       {
        "tex": "&= \\frac{9x}{2}"
       }
      ]
     }
    ],
    "final": "g(f(x)) = \\frac{9x}{2}"
   }
  ]
