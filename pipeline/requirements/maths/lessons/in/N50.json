        "tex": "&= 0.2275"
       }
      ]
     },
     {
      "title": "Set up the margin of error equation",
      "lines": [
       {
        "tex": "1.96\\sqrt{\\frac{0.2275}{n}} &= 0.085"
       }
      ]
     },
     {
      "title": "Solve for n",
      "lines": [
       {
        "tex": "\\sqrt{\\frac{0.2275}{n}} &= \\frac{0.085}{1.96}"
       },
       {
        "tex": "\\frac{0.2275}{n} &= \\left(\\frac{0.085}{1.96}\\right)^2"
       },
       {
        "tex": "n &= \\frac{0.2275}{\\left(\\frac{0.085}{1.96}\\right)^2}"
       },
       {
        "tex": "&= 120.96\\ldots"
       },
       {
        "tex": "&\\approx 121"
       }
      ]
     }
    ],
    "final": "n = 121"
   },
