  "candidates": [
   {
    "part": "practice-trig-prove-identity-1",
    "level": "higher",
    "year": null,
    "question": "Prove that $\\dfrac{\\sin 3A + \\sin A}{\\cos 3A + \\cos A} = \\tan 2A$.",
    "marks": 10,
    "steps": [
     {
      "title": "Sum-to-product on the numerator",
      "lines": [
       {
        "tex": "\\sin 3A + \\sin A &= 2\\sin\\left(\\frac{3A + A}{2}\\right)\\cos\\left(\\frac{3A - A}{2}\\right)"
       },
       {
        "tex": "&= 2\\sin 2A\\cos A"
       }
      ]
     },
     {
      "title": "Sum-to-product on the denominator",
      "lines": [
       {
        "tex": "\\cos 3A + \\cos A &= 2\\cos\\left(\\frac{3A + A}{2}\\right)\\cos\\left(\\frac{3A - A}{2}\\right)"
       },
       {
        "tex": "&= 2\\cos 2A\\cos A"
       }
      ]
     },
     {
      "title": "Divide and cancel",
      "lines": [
       {
        "tex": "\\frac{\\sin 3A + \\sin A}{\\cos 3A + \\cos A} &= \\frac{2\\sin 2A\\cos A}{2\\cos 2A\\cos A}"
       },
       {
        "tex": "&= \\frac{\\sin 2A}{\\cos 2A}"
       }
      ]
     },
     {
      "title": "Write as a tangent",
      "lines": [
       {
        "tex": "&= \\tan 2A"
       }
      ]
     }
    ],
    "final": "\\dfrac{\\sin 3A + \\sin A}{\\cos 3A + \\cos A} = \\tan 2A"
   },
   {
    "part": "practice-trig-prove-identity-2",
    "level": "higher",
    "year": null,
    "question": "Prove that $\\dfrac{1 - \\tan^2 A}{1 + \\tan^2 A} = \\cos 2A$.",
    "marks": 10,
    "steps": [
     {
      "title": "Write $\\tan A$ as $\\frac{\\sin A}{\\cos A}$",
      "lines": [
       {
        "tex": "\\frac{1 - \\tan^2 A}{1 + \\tan^2 A} &= \\frac{1 - \\dfrac{\\sin^2 A}{\\cos^2 A}}{1 + \\dfrac{\\sin^2 A}{\\cos^2 A}}"
       }
      ]
     },
     {
      "title": "Multiply top and bottom by $\\cos^2 A$",
      "lines": [
       {
        "tex": "&= \\frac{\\cos^2 A - \\sin^2 A}{\\cos^2 A + \\sin^2 A}"
       }
      ]
     },
     {
      "title": "Use $\\cos^2 A + \\sin^2 A = 1$",
      "lines": [
       {
        "tex": "&= \\cos^2 A - \\sin^2 A"
       }
      ]
     },
     {
      "title": "Use the double angle formula",
      "lines": [
       {
        "text": "$\\cos 2A = \\cos^2 A - \\sin^2 A$."
       },
       {
        "tex": "&= \\cos 2A"
       }
      ]
     }
    ],
    "final": "\\dfrac{1 - \\tan^2 A}{1 + \\tan^2 A} = \\cos 2A"
   },
   {
    "part": "maths-pp-2015-higher-p2-q5#(a)",
    "level": "higher",
    "year": 2015,
    "marks": 15,
    "steps": [
     {
      "title": "Write tan in terms of sin and cos",
      "lines": [
       {
        "tex": "\\tan(A+B) &= \\frac{\\sin(A+B)}{\\cos(A+B)}"
       }
      ]
     },
     {
      "title": "Expand the compound angle formulae",
      "lines": [
       {
        "text": "Use $\\sin(A+B)=\\sin A\\cos B+\\cos A\\sin B$ and $\\cos(A+B)=\\cos A\\cos B-\\sin A\\sin B$."
       },
       {
        "tex": "&= \\frac{\\sin A\\cos B+\\cos A\\sin B}{\\cos A\\cos B-\\sin A\\sin B}"
       }
      ]
     },
     {
      "title": "Divide top and bottom by $\\cos A\\cos B$",
      "lines": [
       {
        "tex": "&= \\frac{\\dfrac{\\sin A\\cos B}{\\cos A\\cos B}+\\dfrac{\\cos A\\sin B}{\\cos A\\cos B}}{\\dfrac{\\cos A\\cos B}{\\cos A\\cos B}-\\dfrac{\\sin A\\sin B}{\\cos A\\cos B}}"
       }
      ]
     },
     {
      "title": "Cancel common factors",
      "lines": [
       {
        "tex": "&= \\frac{\\dfrac{\\sin A}{\\cos A}+\\dfrac{\\sin B}{\\cos B}}{1-\\dfrac{\\sin A}{\\cos A}\\cdot\\dfrac{\\sin B}{\\cos B}}"
       }
      ]
     },
     {
      "title": "Replace $\\frac{\\sin}{\\cos}$ by $\\tan$",
      "lines": [
       {
        "tex": "&= \\frac{\\tan A+\\tan B}{1-\\tan A\\tan B}"
       }
      ]
     }
    ],
    "final": "\\tan(A+B) = \\frac{\\tan A+\\tan B}{1-\\tan A\\tan B}"
   }
  ]
 },
