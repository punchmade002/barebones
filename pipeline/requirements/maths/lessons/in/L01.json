      ]
     },
     {
      "title": "Apply De Moivre's theorem for the cube root",
      "lines": [
       {
        "tex": "z &= \\left[8(\\cos(\\pi + 2n\\pi) + i\\sin(\\pi + 2n\\pi))\\right]^{\\frac{1}{3}}"
       },
       {
        "tex": "&= 8^{\\frac{1}{3}}\\left(\\cos\\frac{\\pi+2n\\pi}{3} + i\\sin\\frac{\\pi+2n\\pi}{3}\\right)"
       },
       {
        "tex": "&= 2\\left(\\cos\\frac{\\pi+2n\\pi}{3} + i\\sin\\frac{\\pi+2n\\pi}{3}\\right)"
       }
