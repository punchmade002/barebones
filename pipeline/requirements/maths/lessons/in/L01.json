    "year": 2022,
    "marks": 15,
    "steps": [
     {
      "title": "Divide f(x) by (x + 1): first term",
      "lines": [
       {
        "text": "Divide the leading terms: $2x^3 \\div x = 2x^2$."
       },
       {
        "tex": "2x^2(x + 1) &= 2x^3 + 2x^2"
       },
       {
        "tex": "&= 2x^3 + 2x^2"
       }
      ]
     },
     {
      "title": "Subtract to leave the remainder so far",
      "lines": [
       {
        "tex": "(2x^3 - 21x^2 + 40x + 63) - (2x^3 + 2x^2) &= -23x^2 + 40x + 63"
       },
       {
        "tex": "&= -23x^2 + 40x + 63"
       }
      ]
     },
     {
      "title": "Second term of the quotient",
      "lines": [
       {
        "text": "Divide the leading terms: $-23x^2 \\div x = -23x$."
       },
       {
        "tex": "-23x(x + 1) &= -23x^2 - 23x"
       },
       {
        "tex": "&= -23x^2 - 23x"
       }
      ]
     },
     {
      "title": "Subtract again",
      "lines": [
       {
        "tex": "(-23x^2 + 40x + 63) - (-23x^2 - 23x) &= 63x + 63"
       },
       {
        "tex": "&= 63x + 63"
       }
      ]
     },
     {
      "title": "Third term of the quotient",
      "lines": [
       {
        "text": "Divide the leading terms: $63x \\div x = 63$."
       },
       {
        "tex": "63(x + 1) &= 63x + 63"
       },
       {
        "tex": "&= 63x + 63"
       },
       {
        "text": "Subtracting leaves $0$, so the quotient is $2x^2 - 23x + 63$."
       },
       {
        "tex": "f(x) &= (x + 1)(2x^2 - 23x + 63)"
       }
      ]
     },
     {
      "title": "Factorise the quadratic",
      "lines": [
       {
        "text": "Find two numbers with product $2 \\times 63 = 126$ and sum $-23$: they are $-14$ and $-9$."
       },
       {
        "tex": "2x^2 - 23x + 63 &= 2x^2 - 14x - 9x + 63"
       },
       {
        "tex": "&= 2x(x - 7) - 9(x - 7)"
       },
       {
        "tex": "&= (2x - 9)(x - 7)"
       }
      ]
     },
     {
      "title": "Set f(x) = 0 and solve each factor",
      "lines": [
       {
        "tex": "(x + 1)(2x - 9)(x - 7) &= 0"
       },
       {
        "tex": "x &= -1 \\quad \\text{or} \\quad x = \\frac{9}{2} \\quad \\text{or} \\quad x = 7"
       }
      ]
     }
    ],
    "final": "x = -1, \\ 4.5, \\ 7"
   }
  ]
