   {
    "part": "practice-fn-inverse-2",
    "level": "higher",
    "year": null,
    "question": "$f(x) = \\frac{x+1}{x-2}$ is a bijective function from $\\mathbb{R}\\setminus\\{2\\}$ to $\\mathbb{R}\\setminus\\{1\\}$.\nFind $f^{-1}(x)$, the inverse of $f$.",
    "marks": 10,
    "steps": [
     {
      "title": "Write y = f(x) and swap x and y",
      "lines": [
       {
        "tex": "y &= \\frac{x+1}{x-2}"
       },
       {
        "tex": "x &= \\frac{y+1}{y-2}"
       }
      ]
     },
     {
      "title": "Clear the fraction",
      "lines": [
       {
        "tex": "x(y-2) &= y+1"
       },
       {
        "tex": "xy - 2x &= y + 1"
       }
      ]
     },
     {
      "title": "Collect the y terms and factorise",
      "lines": [
       {
        "tex": "xy - y &= 2x + 1"
       },
       {
        "tex": "y(x-1) &= 2x + 1"
       }
      ]
     },
     {
      "title": "Solve for y",
      "lines": [
       {
        "tex": "y &= \\frac{2x+1}{x-1}"
       }
      ]
     },
     {
      "title": "Write the inverse",
      "lines": [
       {
        "tex": "f^{-1}(x) &= \\frac{2x+1}{x-1}"
       }
      ]
     }
    ],
    "final": "f^{-1}(x) = \\frac{2x+1}{x-1}"
   }
  ]
