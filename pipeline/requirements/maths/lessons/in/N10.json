  "candidates": [
   {
    "part": "maths-pp-2016-higher-p1-q5#(b)(i)",
    "level": "higher",
    "year": 2016,
    "marks": 5,
    "steps": [
     {
      "title": "Assume two inputs give the same output",
      "lines": [
       {
        "text": "$f$ is injective if $f(a) = f(b)$ forces $a = b$."
       },
       {
        "tex": "f(a) &= f(b)"
       },
       {
        "tex": "3a - 2 &= 3b - 2"
       }
      ]
     },
     {
      "title": "Solve for a",
      "lines": [
       {
        "tex": "3a &= 3b"
       },
       {
        "tex": "a &= b"
       },
       {
        "text": "Different inputs always give different outputs, so $f$ is injective."
       }
      ]
     }
    ],
    "final": "f(a) = f(b) \\Rightarrow a = b \\text{, so } f \\text{ is injective}"
   },
