    "question": "Find the slopes of the two lines through the origin that are at a perpendicular distance of $5$ from the point $(7, 1)$.",
    "marks": 15,
    "steps": [
     {
      "title": "Write the line through the origin",
      "lines": [
       {
        "text": "A line through $O(0,0)$ with slope $m$ is $y = mx$."
