    "level": "higher",
    "year": 2021,
    "marks": 10,
    "steps": [
     {
      "title": "Find the two-tailed p-value",
      "lines": [
       {
        "text": "Round $|z|$ to $1.79$. The test is two-tailed, so $p = 2\\left[1 - P(z < 1.79)\\right]$."
       },
       {
        "text": "From the tables, $P(z < 1.79) = 0.9633$."
       },
       {
        "tex": "p &= 2(1 - 0.9633)"
       },
       {
        "tex": "&= 2(0.0367)"
       },
       {
        "tex": "&= 0.0734"
       }
      ]
     },
     {
      "title": "Compare with the 5% level and conclude",
      "lines": [
       {
        "text": "$0.0734 > 0.05$, so we do not reject the null hypothesis."
       },
       {
        "text": "There is not enough evidence to say the news report's claim of 21 hours is incorrect."
       }
      ]
     }
    ],
    "final": "p = 0.0734; \\text{ not enough evidence to reject the claim}"
   },
   {
