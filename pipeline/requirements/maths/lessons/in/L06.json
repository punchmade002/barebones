     {
      "title": "Apply 20% depreciation for 3 years",
      "lines": [
       {
        "text": "Losing $20\\%$ each year leaves $80\\% = 0.8$ of the value each year."
       },
       {
        "tex": "\\text{value} &= 32000(0.8)^3"
