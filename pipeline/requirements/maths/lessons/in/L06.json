      "lines": [
       {
        "text": "In the right-angled triangle, $|BC| = 17.5$ is opposite $A$ and $|AB| = 15$ is adjacent."
       },
       {
        "tex": "\\tan A &= \\frac{17.5}{15}"
       },
       {
        "tex": "A &= \\tan^{-1}\\left(\\frac{17.5}{15}\\right)"
