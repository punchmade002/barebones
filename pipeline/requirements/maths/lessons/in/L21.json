      "title": "Divide by 1.96 and square both sides",
      "lines": [
       {
        "tex": "\\sqrt{\\frac{\\hat{p}(1-\\hat{p})}{2500}} &= \\frac{0.01568}{1.96}"
       },
       {
        "tex": "\\sqrt{\\frac{\\hat{p}(1-\\hat{p})}{2500}} &= 0.008"
       },
       {
        "tex": "\\frac{\\hat{p}(1-\\hat{p})}{2500} &= 0.000064"
       }
      ]
     },
     {
      "title": "Form a quadratic in p-hat",
      "lines": [
       {
        "tex": "\\hat{p}(1-\\hat{p}) &= 0.16"
       },
       {
        "tex": "\\hat{p} - \\hat{p}^2 &= 0.16"
       },
       {
        "tex": "\\hat{p}^2 - \\hat{p} + 0.16 &= 0"
       }
      ]
     },
     {
      "title": "Solve with the quadratic formula",
      "lines": [
       {
        "tex": "\\hat{p} &= \\frac{1 \\pm \\sqrt{1 - 4(0.16)}}{2}"
       },
       {
        "tex": "\\hat{p} &= \\frac{1 \\pm \\sqrt{0.36}}{2}"
       },
       {
        "tex": "\\hat{p} &= \\frac{1 \\pm 0.6}{2}"
       },
