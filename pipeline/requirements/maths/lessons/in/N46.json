      "lines": [
       {
        "text": "$\\sin x$ lies between $-1$ and $1$, and the modulus removes the negatives."
       },
       {
        "tex": "0 \\le |\\sin x| &\\le 1"
       }
      ]
     },
     {
      "title": "Multiply by 4",
      "lines": [
       {
        "tex": "0 \\le 4|\\sin x| &\\le 4"
       }
      ]
     },
     {
      "title": "Subtract 1",
      "lines": [
       {
        "tex": "-1 \\le 4|\\sin x| - 1 &\\le 3"
       },
       {
        "text": "This matches the graph: the lowest points are at $y = -1$ and the highest at $y = 3$."
       }
      ]
     }
    ],
    "final": "\\text{Period} = \\pi, \\quad \\text{Range} = [-1, 3]"
