      "lines": [
       {
        "text": "Success on throw $n+1$ happens after a success on throw $n$ (then $0.8$) or after a failure (then $0.6$)."
       },
       {
        "tex": "p_{n+1} &= 0.8\\,p_n + 0.6(1 - p_n)"
       },
       {
        "tex": "&= 0.8\\,p_n + 0.6 - 0.6\\,p_n"
       },
       {
        "tex": "&= 0.6 + 0.2\\,p_n"
       }
      ]
     }
