 {
  "skill": {
   "id": "seq-derive-sum-infinity",
   "title": "Derive S∞ as the limit of partial sums",
   "level": "HL",
   "input": "Sₙ formula",
   "output": "S∞ = a/(1 − r)"
  },
  "candidates": [
   {
    "part": "practice-seq-derive-sum-infinity-1",
    "level": "higher",
    "year": null,
    "question": "Given that the sum of the first $n$ terms of a geometric series is $S_n = \\frac{a(1-r^n)}{1-r}$, prove that if $|r| < 1$ then $S_\\infty = \\frac{a}{1-r}$.",
    "marks": 10,
    "steps": [
     {
      "title": "Split the formula for $S_n$",
      "lines": [
       {
        "tex": "S_n &= \\frac{a(1-r^n)}{1-r}"
       },
       {
        "tex": "&= \\frac{a}{1-r} - \\frac{a\\,r^n}{1-r}"
       }
      ]
     },
     {
      "title": "Let $n \\to \\infty$ when $|r| < 1$",
      "lines": [
       {
        "text": "If $|r| < 1$ then $r^n \\to 0$ as $n \\to \\infty$, for example $\\left(\\tfrac12\\right)^n \\to 0$."
       },
       {
        "tex": "\\frac{a\\,r^n}{1-r} &\\to 0"
       }
      ]
     },
     {
      "title": "Take the limit",
      "lines": [
       {
        "tex": "S_\\infty &= \\lim_{n \\to \\infty} S_n = \\frac{a}{1-r} - 0"
       },
       {
        "tex": "&= \\frac{a}{1-r}"
       }
      ]
     }
    ],
    "final": "S_\\infty = \\frac{a}{1-r}"
   },
   {
    "part": "practice-seq-derive-sum-infinity-2",
    "level": "higher",
    "year": null,
    "question": "A geometric series has first term $6$ and common ratio $\\frac{2}{3}$.\nShow that $S_n = 18\\left(1 - \\left(\\frac{2}{3}\\right)^n\\right)$ and prove that $S_n$ gets closer and closer to $\\frac{a}{1-r}$ as $n \\to \\infty$.",
    "marks": 5,
    "steps": [
     {
      "title": "Substitute into $S_n$",
      "lines": [
       {
        "tex": "S_n &= \\frac{6\\left(1-\\left(\\frac{2}{3}\\right)^n\\right)}{1 - \\frac{2}{3}}"
       },
       {
        "tex": "&= 18\\left(1 - \\left(\\frac{2}{3}\\right)^n\\right)"
       }
      ]
     },
     {
      "title": "Let $n \\to \\infty$",
      "lines": [
       {
        "text": "Since $\\frac{2}{3} < 1$, $\\left(\\frac{2}{3}\\right)^n \\to 0$."
       },
       {
        "tex": "S_\\infty &= 18(1 - 0) = 18"
       }
      ]
     },
     {
      "title": "Compare with $\\frac{a}{1-r}$",
      "lines": [
       {
        "tex": "\\frac{a}{1-r} &= \\frac{6}{1/3} = 18"
       }
      ]
     }
    ],
    "final": "S_\\infty = 18 = \\frac{a}{1-r}"
   },
   {
    "part": "practice-seq-derive-sum-infinity-3",
    "level": "higher",
    "year": null,
    "question": "Let $S_n = a + ar + ar^2 + \\dots + ar^{n-1}$.\nBy multiplying $S_n$ by $r$ and subtracting, prove that $S_n = \\frac{a(1-r^n)}{1-r}$ for $r \\neq 1$, and deduce that $S_\\infty = \\frac{a}{1-r}$ when $|r| < 1$.",
    "marks": 10,
    "steps": [
     {
      "title": "Multiply $S_n$ by $r$",
      "lines": [
       {
        "tex": "rS_n &= ar + ar^2 + \\dots + ar^{n-1} + ar^n"
       }
      ]
     },
     {
      "title": "Subtract: all middle terms cancel",
      "lines": [
       {
        "tex": "S_n - rS_n &= a - ar^n"
       },
       {
        "tex": "S_n(1-r) &= a(1-r^n)"
       }
      ]
     },
     {
      "title": "Divide by $1 - r$ (so $r \\neq 1$)",
      "lines": [
       {
        "tex": "S_n &= \\frac{a(1-r^n)}{1-r}"
       }
      ]
     },
     {
      "title": "Let $n \\to \\infty$ when $|r| < 1$",
      "lines": [
       {
        "text": "Then $r^n \\to 0$, so $1 - r^n \\to 1$."
       },
       {
        "tex": "S_\\infty &= \\frac{a}{1-r}"
       }
      ]
     }
    ],
    "final": "S_n = \\frac{a(1-r^n)}{1-r}, \\quad S_\\infty = \\frac{a}{1-r}"
   }
  ]
 }
