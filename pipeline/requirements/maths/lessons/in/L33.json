      "lines": [
       {
        "text": "P lies on both lines, so substitute the equation of $l$ into $4x + 3y = 25$."
       },
       {
        "tex": "4x + 3m(x - 6) &= 25"
       },
       {
        "tex": "4x + 3mx - 18m &= 25"
       }
      ]
     },
     {
      "title": "Solve for x",
      "lines": [
       {
        "tex": "4x + 3mx &= 25 + 18m"
       },
       {
        "tex": "x(3m + 4) &= 25 + 18m"
       },
       {
        "tex": "x &= \\frac{25 + 18m}{3m + 4}"
       }
      ]
     },
     {
      "title": "Substitute x back into y = m(x − 6)",
      "lines": [
       {
        "tex": "y &= m\\left(\\frac{25 + 18m}{3m + 4} - 6\\right)"
