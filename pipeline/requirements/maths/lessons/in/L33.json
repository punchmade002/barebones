       {
        "tex": "&= m \\times \\frac{25 + 18m - 6(3m + 4)}{3m + 4}"
       },
       {
        "tex": "&= m \\times \\frac{25 + 18m - 18m - 24}{3m + 4}"
       },
       {
        "tex": "&= \\frac{m}{3m + 4}"
       }
      ]
     }
    ],
    "final": "P\\left(\\frac{25 + 18m}{3m + 4},\\ \\frac{m}{3m + 4}\\right)"
   },
