   {
    "part": "maths-pp-2019-higher-p2-q4#(b)",
    "level": "higher",
    "year": 2019,
    "marks": 15,
    "steps": [
     {
      "title": "Find the diagonal of one face",
      "lines": [
       {
        "text": "Let the side of the cube be $x$. A face is a square, so use Pythagoras."
       },
       {
        "tex": "d^2 &= x^2 + x^2"
       },
       {
        "tex": "d &= \\sqrt{2}\\,x"
       }
      ]
     },
     {
      "title": "Find the diagonal of the cube",
      "lines": [
       {
        "text": "The cube's diagonal is the hypotenuse of a right-angled triangle with sides $x$ and the face diagonal $\\sqrt{2}x$."
       },
       {
        "tex": "D^2 &= x^2 + (\\sqrt{2}\\,x)^2"
       },
       {
        "tex": "&= 3x^2"
       },
       {
        "tex": "D &= \\sqrt{3}\\,x"
       }
      ]
     },
     {
      "title": "Set up the triangle at the centre",
      "lines": [
       {
        "text": "The diagonals cross at the centre, and each is halved there. Two half-diagonals, each $\\frac{\\sqrt{3}x}{2}$, and one cube edge $x$ form a triangle with angle $A$ opposite the edge."
       },
       {
        "text": "Cosine rule: $a^2 = b^2 + c^2 - 2bc\\cos A$ with $a = x$ and $b = c = \\frac{\\sqrt{3}x}{2}$."
       }
      ]
     },
     {
      "title": "Substitute into the cosine rule",
      "lines": [
       {
        "tex": "x^2 &= \\left(\\frac{\\sqrt{3}x}{2}\\right)^2 + \\left(\\frac{\\sqrt{3}x}{2}\\right)^2 - 2\\left(\\frac{\\sqrt{3}x}{2}\\right)\\left(\\frac{\\sqrt{3}x}{2}\\right)\\cos A"
       },
       {
        "tex": "x^2 &= \\frac{3x^2}{4} + \\frac{3x^2}{4} - \\frac{3x^2}{2}\\cos A"
       },
       {
        "tex": "x^2 &= \\frac{3x^2}{2} - \\frac{3x^2}{2}\\cos A"
       }
      ]
     },
     {
      "title": "Solve for cos A",
      "lines": [
       {
        "tex": "\\frac{3x^2}{2}\\cos A &= \\frac{3x^2}{2} - x^2"
       },
       {
        "tex": "\\frac{3x^2}{2}\\cos A &= \\frac{x^2}{2}"
       },
       {
        "tex": "\\cos A &= \\frac{1}{3}"
       }
      ]
     }
    ],
    "final": "\\cos A = \\frac{1}{3}"
   }
  ]
