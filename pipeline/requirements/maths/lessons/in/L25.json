    "steps": [
     {
      "title": "Show $|OB| = 3\\sqrt{2}$ m",
      "lines": [
       {
        "text": "The diagonals of a square are equal, bisect each other and meet at $90^\\circ$, so $|OA| = |OB|$ and $\\angle AOB = 90^\\circ$."
       },
       {
        "text": "In the right-angled triangle $AOB$ the hypotenuse is $|AB| = 6$."
       },
       {
        "tex": "|OB|^2 + |OB|^2 &= 6^2"
       },
       {
        "tex": "2|OB|^2 &= 36"
       },
       {
        "tex": "|OB|^2 &= 18"
       },
       {
        "tex": "|OB| &= \\sqrt{18}"
       },
       {
        "tex": "&= \\sqrt{9 \\times 2}"
       },
       {
        "tex": "&= 3\\sqrt{2} \\text{ m}"
       }
      ]
     },
     {
      "title": "Find $|OP|$ using triangle $POB$",
      "lines": [
       {
        "text": "$P$ is directly above $O$, so $\\angle POB = 90^\\circ$. The hypotenuse is $|PB| = 11$."
       },
       {
        "tex": "|OB|^2 + |OP|^2 &= |PB|^2"
       },
       {
        "tex": "\\left(3\\sqrt{2}\\right)^2 + |OP|^2 &= 11^2"
       },
       {
        "tex": "18 + |OP|^2 &= 121"
       },
       {
        "tex": "|OP|^2 &= 103"
       },
       {
        "tex": "|OP| &= \\sqrt{103} \\text{ m}"
       }
      ]
     }
    ],
    "final": "|OB| = 3\\sqrt{2} \\text{ m},\\quad |OP| = \\sqrt{103} \\text{ m}"
   },
