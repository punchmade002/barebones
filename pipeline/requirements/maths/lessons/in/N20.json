    "question": "Simplify $\\frac{1}{2}a - \\frac{3}{4}b + \\frac{3}{2}a + \\frac{1}{4}b$.",
    "marks": 5,
    "steps": [
     {
      "title": "Group the $a$ terms and the $b$ terms",
      "lines": [
       {
        "tex": "\\frac{1}{2}a - \\frac{3}{4}b + \\frac{3}{2}a + \\frac{1}{4}b &= \\left(\\frac{1}{2}a + \\frac{3}{2}a\\right) + \\left(-\\frac{3}{4}b + \\frac{1}{4}b\\right)"
       }
      ]
     },
     {
      "title": "Combine each group",
      "lines": [
       {
        "tex": "&= 2a - \\frac{2}{4}b"
       },
