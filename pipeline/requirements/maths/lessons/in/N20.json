    "question": "Simplify $5x + 3y - 2x + 7y - y$.",
    "marks": 5,
    "steps": [
     {
      "title": "Group the like terms",
      "lines": [
       {
        "tex": "5x + 3y - 2x + 7y - y &= (5x - 2x) + (3y + 7y - y)"
       }
      ]
     },
     {
      "title": "Combine each group",
      "lines": [
       {
        "tex": "&= 3x + 9y"
       }
      ]
     }
