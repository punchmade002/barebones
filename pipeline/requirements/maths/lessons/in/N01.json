        "tex": "&= \\sqrt{4}"
       },
       {
        "tex": "&= 2"
       }
      ]
     },
     {
      "title": "Find the argument",
      "lines": [
       {
        "text": "The real part is negative and the imaginary part is positive, so $z$ is in the second quadrant."
       },
       {
        "tex": "\\tan\\alpha &= \\frac{\\sqrt{3}}{1} = \\sqrt{3}"
       },
       {
        "tex": "\\alpha &= \\frac{\\pi}{3}"
       },
       {
        "tex": "\\theta &= \\pi - \\frac{\\pi}{3} = \\frac{2\\pi}{3}"
       }
      ]
     },
     {
      "title": "Write in polar form",
      "lines": [
       {
        "tex": "z &= 2\\left(\\cos\\frac{2\\pi}{3} + i\\sin\\frac{2\\pi}{3}\\right)"
       }
      ]
     }
    ],
    "final": "z = 2\\left(\\cos\\frac{2\\pi}{3} + i\\sin\\frac{2\\pi}{3}\\right)"
   },
   {
