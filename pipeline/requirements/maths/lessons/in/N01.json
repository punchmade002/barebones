    "level": "higher",
    "year": null,
    "question": "Write $w = -\\sqrt{3} - i$ in the form $r(\\cos\\theta + i\\sin\\theta)$, where $0 \\le \\theta < 2\\pi$.",
    "marks": 5,
    "steps": [
