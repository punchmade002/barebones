    "question": "$f(x) = 2x^3 - 9x^2 + 12x + 1$.\nFind the value of $x$ for which $f''(x) = 0$.",
    "marks": 5,
    "steps": [
     {
      "title": "Find $f'(x)$",
      "lines": [
       {
        "tex": "f'(x) &= 6x^2 - 18x + 12"
       }
      ]
     },
     {
      "title": "Find $f''(x)$",
      "lines": [
       {
        "tex": "f''(x) &= 12x - 18"
       }
      ]
     },
     {
      "title": "Set $f''(x) = 0$ and solve",
