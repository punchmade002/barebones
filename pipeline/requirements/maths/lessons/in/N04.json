   {
    "part": "maths-pp-2023-higher-p1-q4#(c)(i), (ii), (iii)",
    "level": "higher",
    "year": 2023,
    "marks": 10,
    "steps": [
     {
      "title": "(i) Find iu",
      "lines": [
       {
        "tex": "iu &= i(a + bi)"
       },
       {
        "tex": "&= ai + bi^2"
       },
       {
        "text": "Use $i^2 = -1$."
       },
       {
        "tex": "&= -b + ai"
       }
      ]
     },
     {
      "title": "(i) Find the conjugate of iu",
      "lines": [
       {
        "text": "The conjugate changes the sign of the imaginary part."
       },
       {
        "tex": "\\overline{iu} &= -b - ai"
       }
      ]
     },
     {
      "title": "(ii) Plot iu and its conjugate",
      "lines": [
       {
        "text": "$iu = -b + ai$ is the point $(-b, a)$: left of the imaginary axis and a small height above the real axis."
       },
       {
        "text": "$\\overline{iu} = -b - ai$ is the point $(-b, -a)$, the reflection of $iu$ in the real axis."
       }
      ]
     },
     {
      "title": "(iii) Describe a transformation from u to the conjugate of iu",
      "lines": [
       {
        "text": "Multiplying by $i$ turns $u$ into $iu$: a rotation of $90^\\circ$ anticlockwise about the origin."
       },
       {
        "text": "Then reflecting $iu$ in the real axis gives $\\overline{iu}$."
       }
      ]
     }
    ],
    "final": "iu = -b + ai,\\ \\overline{iu} = -b - ai;\\ \\text{rotate } 90^\\circ \\text{ anticlockwise about the origin, then reflect in the real axis}"
   }
  ]
 },
