   {
    "part": "practice-cx-polar-multiply-1",
    "level": "higher",
    "year": null,
    "question": "$u = 12\\left(\\cos\\frac{2\\pi}{3} + i\\sin\\frac{2\\pi}{3}\\right)$ and $v = 3\\left(\\cos\\frac{\\pi}{6} + i\\sin\\frac{\\pi}{6}\\right)$.\nFind $\\dfrac{u}{v}$ in the form $a + bi$.",
    "marks": 10,
    "steps": [
     {
      "title": "Divide the moduli and subtract the angles",
      "lines": [
       {
        "text": "To divide in polar form, divide the moduli and subtract the arguments."
       },
       {
        "tex": "\\frac{u}{v} &= \\frac{12}{3}\\left(\\cos\\left(\\frac{2\\pi}{3} - \\frac{\\pi}{6}\\right) + i\\sin\\left(\\frac{2\\pi}{3} - \\frac{\\pi}{6}\\right)\\right)"
       }
      ]
     },
     {
      "title": "Simplify the angle",
      "lines": [
       {
        "tex": "\\frac{2\\pi}{3} - \\frac{\\pi}{6} &= \\frac{4\\pi}{6} - \\frac{\\pi}{6}"
       },
       {
        "tex": "&= \\frac{\\pi}{2}"
       },
       {
        "tex": "\\frac{u}{v} &= 4\\left(\\cos\\frac{\\pi}{2} + i\\sin\\frac{\\pi}{2}\\right)"
       }
      ]
     },
     {
      "title": "Evaluate",
      "lines": [
       {
        "tex": "\\frac{u}{v} &= 4(0 + i)"
       },
       {
        "tex": "&= 4i"
       }
      ]
     }
    ],
    "final": "\\dfrac{u}{v} = 4i"
   },
   {
    "part": "practice-cx-polar-multiply-2",
    "level": "higher",
    "year": null,
    "question": "$z = 4\\left(\\cos\\frac{\\pi}{3} + i\\sin\\frac{\\pi}{3}\\right)$ and $w = \\sqrt{3} + i$.\nWrite $w$ in polar form and hence find $zw$ in the form $a + bi$.",
    "marks": 10,
    "steps": [
     {
      "title": "Find the modulus of w",
      "lines": [
       {
        "tex": "|w| &= \\sqrt{(\\sqrt{3})^2 + 1^2}"
       },
       {
        "tex": "&= 2"
       }
      ]
     },
     {
      "title": "Find the argument of w",
      "lines": [
       {
        "text": "$\\tan\\theta = \\dfrac{1}{\\sqrt{3}}$ and $w$ is in the first quadrant, so $\\theta = \\dfrac{\\pi}{6}$."
       },
       {
        "tex": "w &= 2\\left(\\cos\\frac{\\pi}{6} + i\\sin\\frac{\\pi}{6}\\right)"
       }
      ]
     },
     {
      "title": "Multiply the moduli and add the angles",
      "lines": [
       {
        "tex": "zw &= 4 \\times 2\\left(\\cos\\left(\\frac{\\pi}{3} + \\frac{\\pi}{6}\\right) + i\\sin\\left(\\frac{\\pi}{3} + \\frac{\\pi}{6}\\right)\\right)"
       },
       {
        "tex": "&= 8\\left(\\cos\\frac{\\pi}{2} + i\\sin\\frac{\\pi}{2}\\right)"
       }
      ]
     },
     {
      "title": "Evaluate",
      "lines": [
       {
        "tex": "zw &= 8(0 + i)"
       },
       {
        "tex": "&= 8i"
       }
      ]
     }
    ],
    "final": "w = 2\\left(\\cos\\frac{\\pi}{6} + i\\sin\\frac{\\pi}{6}\\right),\\ zw = 8i"
   }
  ]
 },
