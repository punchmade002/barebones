    "level": "higher",
    "year": null,
    "question": "Prove by induction that $7^n - 4^n$ is divisible by 3 for all $n \\in \\mathbb{N}$.",
    "marks": 15,
    "steps": [
     {
      "title": "Check the statement is true for n = 1",
      "lines": [
       {
        "tex": "7^1 - 4^1 &= 3"
       },
       {
        "text": "3 is divisible by 3, so $P(1)$ is true."
       }
      ]
     },
     {
      "title": "Assume the statement is true for n = k",
      "lines": [
       {
        "text": "Assume $7^k - 4^k$ is divisible by 3, so $7^k - 4^k = 3M$ for some whole number $M$."
       },
       {
        "tex": "7^k - 4^k &= 3M"
       },
       {
        "tex": "7^k &= 3M + 4^k"
       }
      ]
     },
     {
      "title": "Write 7^(k+1) - 4^(k+1) using 7^k and 4^k",
      "lines": [
       {
        "tex": "7^{k+1} - 4^{k+1} &= 7(7^k) - 4(4^k)"
       }
      ]
     },
     {
      "title": "Substitute 7^k = 3M + 4^k",
      "lines": [
       {
        "tex": "7^{k+1} - 4^{k+1} &= 7(3M + 4^k) - 4(4^k)"
       },
       {
        "tex": "&= 21M + 7(4^k) - 4(4^k)"
       },
       {
        "tex": "&= 21M + 3(4^k)"
       }
      ]
     },
     {
      "title": "Factor out 3",
      "lines": [
       {
        "tex": "7^{k+1} - 4^{k+1} &= 3(7M + 4^k)"
       },
       {
        "text": "$7M + 4^k$ is a whole number, so $7^{k+1} - 4^{k+1}$ is divisible by 3."
       }
      ]
     },
     {
      "title": "State the conclusion",
      "lines": [
       {
        "text": "$P(1)$ is true, and if $P(k)$ is true then $P(k+1)$ is true. By induction, $7^n - 4^n$ is divisible by 3 for all $n \\in \\mathbb{N}$."
       }
      ]
     }
    ],
    "final": "7^n - 4^n \\text{ is divisible by } 3 \\text{ for all } n \\in \\mathbb{N}"
   }
  ]
 }
