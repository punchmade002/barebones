 {
  "skill": {
   "id": "induction-divisibility",
   "title": "Prove a divisibility result by induction",
   "level": "HL",
   "input": "statement \"d divides f(n)\"",
   "output": "proof"
  },
  "candidates": [
   {
    "part": "maths-pp-2021-higher-p1-q4#(a)",
    "level": "higher",
    "year": 2021,
    "marks": 15,
    "steps": [
     {
      "title": "Step P(1): test the first case",
      "lines": [
       {
        "text": "Let $P(n)$ be the statement \"$2^{3n-1}+3$ is divisible by 7\"."
       },
       {
        "tex": "2^{3(1)-1} + 3 &= 2^2 + 3"
       },
       {
        "tex": "&= 4 + 3"
       },
       {
        "tex": "&= 7"
       },
       {
        "text": "$7$ is divisible by 7, so $P(1)$ is true."
       }
      ]
     },
     {
      "title": "Step P(k): assume it is true for n = k",
      "lines": [
       {
        "text": "Assume $2^{3k-1}+3$ is divisible by 7, so it equals $7M$ for some integer $M$."
       },
       {
        "tex": "2^{3k-1} + 3 &= 7M"
       },
       {
        "tex": "2^{3k-1} &= 7M - 3"
       }
      ]
     },
     {
      "title": "Step P(k+1): write the next case using 2^(3k-1)",
      "lines": [
       {
        "text": "Replace $n$ with $k+1$: $3(k+1)-1 = 3k+2$."
       },
       {
        "tex": "&2^{3k+2} + 3"
       },
       {
        "tex": "&= 2^3 \\left(2^{3k-1}\\right) + 3"
       },
       {
        "text": "Using $2^{3k-1} = 7M-3$ from the assumption:"
       },
       {
        "tex": "&= 8(7M - 3) + 3"
       },
       {
        "tex": "&= 56M - 24 + 3"
       },
       {
        "tex": "&= 56M - 21"
       },
       {
        "tex": "&= 7(8M - 3)"
       },
       {
        "text": "This is a multiple of 7, so $P(k+1)$ is true."
       }
      ]
     },
     {
      "title": "Conclude",
      "lines": [
       {
        "text": "$P(1)$ is true, and if $P(k)$ is true then $P(k+1)$ is true. Therefore $2^{3n-1}+3$ is divisible by 7 for all $n \\in \\mathbb{N}$."
       }
      ]
     }
    ],
    "final": "2^{3n-1}+3 \\text{ is divisible by 7 for all } n \\in \\mathbb{N}"
   },
   {
    "part": "maths-pp-2016-higher-p1-q4#(a)",
    "level": "higher",
    "year": 2016,
    "marks": 15,
    "steps": [
     {
      "title": "Check the statement is true for n = 1",
      "lines": [
       {
        "tex": "8^1 - 1 &= 8 - 1"
       },
       {
        "tex": "&= 7"
       },
       {
        "text": "7 is divisible by 7, so the statement $P_1$ is true."
       }
      ]
     },
     {
      "title": "Assume the statement is true for n = k",
      "lines": [
       {
        "text": "Assume $8^k - 1$ is divisible by 7, so $8^k - 1 = 7M$ for some whole number $M$."
       },
       {
        "tex": "8^k - 1 &= 7M"
       },
       {
        "tex": "8^k &= 7M + 1"
       }
      ]
     },
     {
      "title": "Write 8^(k+1) - 1 using 8^k",
      "lines": [
       {
        "tex": "8^{k+1} - 1 &= 8(8^k) - 1"
       }
      ]
     },
     {
      "title": "Substitute 8^k = 7M + 1",
      "lines": [
       {
        "tex": "8^{k+1} - 1 &= 8(7M + 1) - 1"
       },
       {
        "tex": "&= 56M + 8 - 1"
       },
       {
        "tex": "&= 56M + 7"
       }
      ]
     },
     {
      "title": "Factor out 7",
      "lines": [
       {
        "tex": "8^{k+1} - 1 &= 7(8M + 1)"
       },
       {
        "text": "$8M + 1$ is a whole number, so $8^{k+1} - 1$ is divisible by 7."
       }
      ]
     },
     {
      "title": "State the conclusion",
      "lines": [
       {
        "text": "$P_1$ is true, and if $P_k$ is true then $P_{k+1}$ is true. By induction, $8^n - 1$ is divisible by 7 for all $n \\in \\mathbb{N}$."
       }
      ]
     }
    ],
    "final": "8^n - 1 \\text{ is divisible by } 7 \\text{ for all } n \\in \\mathbb{N}"
   },
