    "steps": [
     {
      "title": "Write $A-B$ as a sum",
      "lines": [
       {
        "tex": "\\tan(A-B) &= \\tan\\bigl(A + (-B)\\bigr)"
       }
      ]
     },
     {
      "title": "Apply the formula for $\\tan(A+B)$",
      "lines": [
       {
        "text": "Use $\\tan(A+B) = \\dfrac{\\tan A + \\tan B}{1 - \\tan A \\tan B}$ with $B$ replaced by $-B$."
       },
       {
        "tex": "&= \\frac{\\tan A + \\tan(-B)}{1 - \\tan A\\,\\tan(-B)}"
       }
      ]
     },
     {
      "title": "Use $\\tan(-B) = -\\tan B$",
      "lines": [
       {
        "tex": "&= \\frac{\\tan A - \\tan B}{1 - \\tan A\\,(-\\tan B)}"
       },
       {
        "tex": "&= \\frac{\\tan A - \\tan B}{1 + \\tan A\\,\\tan B}"
       }
      ]
     }
    ],
    "final": "\\tan(A-B) = \\dfrac{\\tan A - \\tan B}{1 + \\tan A \\tan B}"
   },
