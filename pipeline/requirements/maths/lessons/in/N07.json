        "tex": "v &= x - 2, \\quad v' = 1"
       }
      ]
     },
     {
      "title": "Substitute into the quotient rule",
      "lines": [
       {
        "tex": "f'(x) &= \\frac{(x-2)(2x) - x^2(1)}{(x-2)^2}"
       }
