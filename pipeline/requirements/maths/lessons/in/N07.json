        "tex": "&= \\frac{x(x-4)}{(x-2)^2}"
       }
      ]
     },
     {
      "title": "Set $f'(x) = 0$",
      "lines": [
       {
        "tex": "x(x-4) &= 0"
       },
       {
        "tex": "x &= 0 \\text{ or } x = 4"
       }
      ]
