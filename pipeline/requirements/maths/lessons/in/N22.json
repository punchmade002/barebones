     },
     {
      "title": "Collect like terms",
      "lines": [
       {
        "tex": "&= x^4 + x^3 - x^2 + 11x - 12"
       }
      ]
     }
    ],
    "final": "x^4 + x^3 - x^2 + 11x - 12"
   },
   {
