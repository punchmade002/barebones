       }
      ]
     },
     {
      "title": "Multiply the result by the third bracket",
      "lines": [
       {
        "tex": "(x-2)(x+2)(x^2+4) &= (x^2-4)(x^2+4)"
       },
       {
        "tex": "&= x^4 + 4x^2 - 4x^2 - 16"
       },
       {
        "tex": "&= x^4 - 16"
       }
      ]
     }
    ],
    "final": "x^4 - 16"
