    "level": "higher",
    "year": null,
    "question": "Multiply out $(x^2 + 2x - 3)(x^2 - x + 4)$ and write your answer in descending powers of $x$.",
    "marks": 5,
    "steps": [
     {
      "title": "Multiply each term of the first bracket by the second",
      "lines": [
       {
        "tex": "(x^2+2x-3)(x^2-x+4) &= x^2(x^2-x+4) + 2x(x^2-x+4) - 3(x^2-x+4)"
