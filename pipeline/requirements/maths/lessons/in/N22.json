    "steps": [
     {
      "title": "Expand (1 + √5)³",
      "lines": [
       {
        "tex": "(1+\\sqrt5)^3 &= 1 + 3\\sqrt5 + 3(\\sqrt5)^2 + (\\sqrt5)^3"
       },
       {
        "tex": "&= 1 + 3\\sqrt5 + 15 + 5\\sqrt5"
       },
       {
        "tex": "&= 16 + 8\\sqrt5"
       }
      ]
     },
     {
      "title": "Expand (1 − √5)³",
      "lines": [
       {
        "tex": "(1-\\sqrt5)^3 &= 1 - 3\\sqrt5 + 3(\\sqrt5)^2 - (\\sqrt5)^3"
       },
       {
        "tex": "&= 1 - 3\\sqrt5 + 15 - 5\\sqrt5"
       },
       {
        "tex": "&= 16 - 8\\sqrt5"
       }
      ]
     },
     {
      "title": "Subtract to get the numerator",
      "lines": [
       {
        "tex": "(1+\\sqrt5)^3 - (1-\\sqrt5)^3 &= (16 + 8\\sqrt5) - (16 - 8\\sqrt5)"
       },
       {
        "tex": "&= 16\\sqrt5"
       }
      ]
     },
     {
      "title": "Substitute n = 3 and simplify",
      "lines": [
