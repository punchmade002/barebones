   {
    "part": "practice-alg-surd-expressions-1",
    "level": "higher",
    "year": null,
    "question": "Simplify $\\frac{1}{\\sqrt{a}-\\sqrt{b}} - \\frac{1}{\\sqrt{a}+\\sqrt{b}}$, where $a > b > 0$.\nGive your answer as a single fraction with no surds in the denominator.",
    "marks": 5,
    "steps": [
     {
      "title": "Write over a common denominator",
      "lines": [
       {
        "tex": "\\frac{1}{\\sqrt{a}-\\sqrt{b}} - \\frac{1}{\\sqrt{a}+\\sqrt{b}} &= \\frac{(\\sqrt{a}+\\sqrt{b}) - (\\sqrt{a}-\\sqrt{b})}{(\\sqrt{a}-\\sqrt{b})(\\sqrt{a}+\\sqrt{b})}"
       }
      ]
     },
     {
      "title": "Simplify the numerator",
      "lines": [
       {
        "tex": "(\\sqrt{a}+\\sqrt{b}) - (\\sqrt{a}-\\sqrt{b}) &= \\sqrt{a}+\\sqrt{b}-\\sqrt{a}+\\sqrt{b}"
       },
       {
        "tex": "&= 2\\sqrt{b}"
       }
      ]
     },
     {
      "title": "Simplify the denominator (difference of two squares)",
      "lines": [
       {
        "tex": "(\\sqrt{a}-\\sqrt{b})(\\sqrt{a}+\\sqrt{b}) &= (\\sqrt{a})^2 - (\\sqrt{b})^2"
       },
       {
        "tex": "&= a - b"
       }
      ]
     },
     {
      "title": "Put the numerator over the denominator",
      "lines": [
       {
        "tex": "\\frac{1}{\\sqrt{a}-\\sqrt{b}} - \\frac{1}{\\sqrt{a}+\\sqrt{b}} &= \\frac{2\\sqrt{b}}{a-b}"
       }
      ]
     }
    ],
    "final": "\\frac{2\\sqrt{b}}{a-b}"
   },
