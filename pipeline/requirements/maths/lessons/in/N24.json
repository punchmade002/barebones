 {
  "skill": {
   "id": "seq-verify-formula",
   "title": "Verify and justify a formula from a number pattern",
   "level": "HL",
   "input": "pattern + proposed formula",
   "output": "checked/justified formula"
  },
  "candidates": [
   {
    "part": "maths-pp-2020-higher-p1-q7#(b)(i)",
    "level": "higher",
    "year": 2020,
    "marks": 5,
    "steps": [
     {
      "title": "Substitute the formula for T_n",
      "lines": [
       {
        "tex": "T_{n+1} &= \\frac{n(n+1)}{2} + (n+1)"
       }
      ]
     },
     {
      "title": "Write over a common denominator of 2",
      "lines": [
       {
        "tex": "&= \\frac{n(n+1)}{2} + \\frac{2(n+1)}{2}"
       },
       {
        "tex": "&= \\frac{n(n+1) + 2(n+1)}{2}"
       }
      ]
     },
     {
      "title": "Factor out (n + 1)",
      "lines": [
       {
        "tex": "&= \\frac{(n+1)(n+2)}{2}"
       }
      ]
     }
    ],
    "final": "\\frac{(n+1)(n+2)}{2}"
   },
   {
    "part": "maths-pp-2020-higher-p1-q7#(b)(ii)",
    "level": "higher",
    "year": 2020,
    "marks": 5,
    "steps": [
     {
      "title": "Write the sum of the two consecutive terms",
      "lines": [
       {
        "tex": "T_{n+1} + T_n &= \\frac{(n+1)(n+2)}{2} + \\frac{n(n+1)}{2}"
       }
      ]
     },
     {
      "title": "Combine and factor out (n + 1)",
      "lines": [
       {
        "tex": "&= \\frac{(n+1)\\big[(n+2) + n\\big]}{2}"
       },
       {
        "tex": "&= \\frac{(n+1)(2n+2)}{2}"
       },
       {
        "tex": "&= \\frac{2(n+1)(n+1)}{2}"
       }
      ]
     },
     {
      "title": "Cancel the 2",
      "lines": [
       {
        "tex": "&= (n+1)^2"
       },
       {
        "text": "$n+1 \\in \\mathbb{N}$, so the sum is a square $k^2$ with $k = n+1$."
       }
      ]
     }
    ],
    "final": "T_{n+1} + T_n = (n+1)^2"
   },
   {
    "part": "practice-seq-verify-formula-1",
    "level": "higher",
    "year": null,
    "question": "Prove by induction that $1 + 4 + 7 + \\dots + (3n - 2) = \\frac{n(3n-1)}{2}$ for all $n \\in \\mathbb{N}$.",
    "marks": 10,
    "steps": [
     {
      "title": "Test the formula for $n = 1$",
      "lines": [
       {
        "tex": "\\text{LHS} &= 1"
       },
       {
        "tex": "\\text{RHS} &= \\frac{1(3-1)}{2} = 1"
       },
       {
        "text": "LHS = RHS, so the formula is true for $n = 1$."
       }
      ]
     },
     {
      "title": "Assume it is true for $n = k$",
      "lines": [
       {
        "text": "Assume $1 + 4 + \\dots + (3k-2) = \\frac{k(3k-1)}{2}$."
       }
      ]
     },
     {
      "title": "Add the next term for $n = k + 1$",
      "lines": [
       {
        "tex": "S_{k+1} &= \\frac{k(3k-1)}{2} + \\big(3(k+1) - 2\\big)"
       },
       {
        "tex": "&= \\frac{k(3k-1) + 2(3k+1)}{2}"
       },
       {
        "tex": "&= \\frac{3k^2 + 5k + 2}{2}"
       },
       {
        "tex": "&= \\frac{(k+1)(3k+2)}{2}"
       }
      ]
     },
     {
      "title": "Compare with the formula at $n = k + 1$",
      "lines": [
       {
        "tex": "\\frac{(k+1)\\big(3(k+1)-1\\big)}{2} &= \\frac{(k+1)(3k+2)}{2}"
       },
       {
        "text": "This matches, so true for $n=k$ implies true for $n=k+1$. By induction the formula holds for all $n \\in \\mathbb{N}$."
       }
      ]
     }
    ],
    "final": "1 + 4 + \\dots + (3n-2) = \\frac{n(3n-1)}{2}"
   }
  ]
 },
