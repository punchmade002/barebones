 {
  "skill": {
   "id": "seq-recurring-decimal",
   "title": "Write a recurring decimal as a fraction",
   "level": "HL",
   "input": "recurring decimal",
   "output": "fraction via S∞"
  },
  "candidates": [
   {
    "part": "practice-seq-recurring-decimal-1",
    "level": "higher",
    "year": null,
    "question": "Write $0.727272\\dots$ as a fraction in its simplest form, using the sum to infinity of a geometric series.",
    "marks": 5,
    "steps": [
     {
      "title": "Write the decimal as a geometric series",
      "lines": [
       {
        "tex": "0.727272\\dots &= 0.72 + 0.0072 + 0.000072 + \\dots"
       }
      ]
     },
     {
      "title": "Find $a$ and $r$",
      "lines": [
       {
        "tex": "a &= \\frac{72}{100}"
       },
       {
        "tex": "r &= \\frac{1}{100}"
       }
      ]
     },
     {
      "title": "Use $S_\\infty = \\frac{a}{1-r}$",
      "lines": [
       {
        "tex": "S_\\infty &= \\frac{72/100}{1 - 1/100}"
       },
       {
        "tex": "&= \\frac{72/100}{99/100}"
       },
       {
        "tex": "&= \\frac{72}{99} = \\frac{8}{11}"
       }
      ]
     }
    ],
    "final": "\\frac{8}{11}"
   },
   {
    "part": "practice-seq-recurring-decimal-2",
    "level": "higher",
    "year": null,
    "question": "Express $0.2333\\dots$ as a fraction in its simplest form.\nHint: write it as $0.2$ plus a geometric series.",
    "marks": 10,
    "steps": [
     {
      "title": "Split off the non-recurring part",
      "lines": [
       {
        "tex": "0.2333\\dots &= 0.2 + (0.03 + 0.003 + 0.0003 + \\dots)"
       }
      ]
     },
     {
      "title": "Find $a$ and $r$ for the series",
      "lines": [
       {
        "tex": "a &= \\frac{3}{100}"
       },
       {
        "tex": "r &= \\frac{1}{10}"
       }
      ]
     },
     {
      "title": "Sum the series",
      "lines": [
       {
        "tex": "S_\\infty &= \\frac{3/100}{1 - 1/10}"
       },
       {
        "tex": "&= \\frac{3/100}{9/10}"
       },
       {
        "tex": "&= \\frac{1}{30}"
       }
      ]
     },
     {
      "title": "Add the $0.2$ back on",
      "lines": [
       {
        "tex": "0.2 + \\frac{1}{30} &= \\frac{1}{5} + \\frac{1}{30}"
       },
       {
        "tex": "&= \\frac{6}{30} + \\frac{1}{30}"
       },
       {
        "tex": "&= \\frac{7}{30}"
       }
      ]
     }
    ],
    "final": "\\frac{7}{30}"
   },
   {
    "part": "practice-seq-recurring-decimal-3",
    "level": "higher",
    "year": null,
    "question": "Express $2.136136136\\dots$ in the form $\\frac{a}{b}$, where $a, b \\in \\mathbb{N}$.",
    "marks": 10,
    "steps": [
     {
      "title": "Split into the whole part and a recurring part",
      "lines": [
       {
        "tex": "2.136136\\dots &= 2 + (0.136 + 0.000136 + 0.000000136 + \\dots)"
       }
      ]
     },
     {
      "title": "Find $a$ and $r$ for the series",
      "lines": [
       {
        "tex": "a &= \\frac{136}{1000}"
       },
       {
        "tex": "r &= \\frac{1}{1000}"
       }
      ]
     },
     {
      "title": "Sum the series",
      "lines": [
       {
        "tex": "S_\\infty &= \\frac{136/1000}{1 - 1/1000}"
       },
       {
        "tex": "&= \\frac{136/1000}{999/1000}"
       },
       {
        "tex": "&= \\frac{136}{999}"
       }
      ]
     },
     {
      "title": "Add the whole part",
      "lines": [
       {
        "tex": "2 + \\frac{136}{999} &= \\frac{1998}{999} + \\frac{136}{999}"
       },
       {
        "tex": "&= \\frac{2134}{999}"
       }
      ]
     }
    ],
    "final": "\\frac{2134}{999}"
   }
  ]
 },
 {
  "skill": {
   "id": "seq-sigma",
   "title": "Evaluate a series in Σ notation",
   "level": "HL",
   "input": "Σ expression",
   "output": "value"
  },
  "candidates": [
   {
    "part": "practice-seq-sigma-1",
    "level": "higher",
    "year": null,
    "question": "Evaluate $\\displaystyle\\sum_{r=1}^{12}(3r - 2)$.",
    "marks": 5,
    "steps": [
     {
      "title": "Find the first and last terms",
      "lines": [
       {
        "text": "The terms form an arithmetic series, so find the first term $a$ and last term $l$."
       },
       {
        "tex": "a &= 3(1) - 2 = 1"
       },
       {
        "tex": "l &= 3(12) - 2 = 34"
       }
      ]
     },
     {
      "title": "Count the terms",
      "lines": [
       {
        "tex": "n &= 12 - 1 + 1"
       },
       {
        "tex": "&= 12"
       }
      ]
     },
     {
      "title": "Use the sum formula",
      "lines": [
       {
        "tex": "S_{12} &= \\frac{12}{2}(a + l)"
       },
       {
        "tex": "&= \\frac{12}{2}(35)"
       },
       {
        "tex": "&= 210"
       }
      ]
     }
    ],
    "final": "210"
   },
