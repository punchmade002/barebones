      "lines": [
       {
        "text": "Each face area is the product of two of the dimensions."
       },
       {
        "tex": "xz &= 2\\sqrt{2}"
       },
       {
        "tex": "yz &= 8\\sqrt{6}"
       },
       {
        "tex": "xy &= 4\\sqrt{3}"
       }
      ]
     },
     {
      "title": "Multiply the three equations",
      "lines": [
       {
        "text": "The volume is $xyz$, and the product of the three areas is $(xyz)^2$."
       },
       {
        "tex": "(xz)(yz)(xy) &= (2\\sqrt{2})(8\\sqrt{6})(4\\sqrt{3})"
       },
       {
        "tex": "x^2y^2z^2 &= 2 \\times 8 \\times 4 \\times \\sqrt{2 \\times 6 \\times 3}"
       },
       {
        "tex": "&= 64\\sqrt{36}"
       },
       {
        "tex": "&= 64 \\times 6"
       },
       {
        "tex": "&= 384"
       }
      ]
     },
     {
      "title": "Take the square root to get the volume",
      "lines": [
       {
        "tex": "xyz &= \\sqrt{384}"
       },
       {
        "tex": "&= \\sqrt{64 \\times 6}"
       },
       {
        "tex": "&= 8\\sqrt{6}"
       }
      ]
     }
    ],
    "final": "V = 8\\sqrt{6}\\ \\text{cm}^3"
