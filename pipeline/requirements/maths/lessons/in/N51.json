   {
    "part": "practice-trig-unit-circle-2",
    "level": "ordinary",
    "year": null,
    "question": "$P$ is a point on the unit circle with centre $O$. The line $OP$ makes an angle of $300^\\circ$ with the positive $x$-axis, measured anticlockwise.\nFind the co-ordinates of $P$.",
    "marks": 5,
    "steps": [
     {
      "title": "Place P on the unit circle using the angle",
      "lines": [
       {
        "text": "On the unit circle, a point at angle $\\theta$ is $(\\cos\\theta, \\sin\\theta)$."
       },
       {
        "tex": "P &= (\\cos 300^\\circ, \\sin 300^\\circ)"
       }
      ]
     },
     {
      "title": "Find the x co-ordinate",
      "lines": [
       {
        "text": "$300^\\circ$ is in the fourth quadrant, where cos is positive. The related angle is $60^\\circ$."
       },
       {
        "tex": "\\cos 300^\\circ"
       },
       {
        "tex": "&= \\cos 60^\\circ"
       },
       {
        "tex": "&= \\frac{1}{2}"
       }
      ]
     },
     {
      "title": "Find the y co-ordinate",
      "lines": [
       {
        "text": "In the fourth quadrant sin is negative."
       },
       {
        "tex": "\\sin 300^\\circ"
       },
       {
        "tex": "&= -\\sin 60^\\circ"
       },
       {
        "tex": "&= -\\frac{\\sqrt{3}}{2}"
       }
      ]
     }
    ],
    "final": "P = \\left(\\frac{1}{2}, -\\frac{\\sqrt{3}}{2}\\right)"
   },
