     },
     {
      "title": "Add 1.5 to find the smallest value of I(t)",
      "lines": [
       {
        "tex": "0.5 &\\le 1.5 + \\sin\\frac{\\pi t}{5} \\le 2.5"
       },
       {
        "tex": "I(t) &\\ge 0.5 > 0"
       }
      ]
     },
     {
      "title": "Relate this to the radius",
      "lines": [
       {
        "text": "$r(t+1) = r(t) + I(t+1)$ and $I(t+1) > 0$, so $r(t+1) > r(t)$: the radius increases every year."
       }
      ]
     }
    ],
    "final": "r(t+1) > r(t)"
   },
