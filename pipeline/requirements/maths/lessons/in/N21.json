      "lines": [
       {
        "tex": "Q(n) &= \\frac{(n+1)^2}{(2n+1)^2}"
       },
       {
        "tex": "&= \\frac{\\left(\\frac{t-1}{2}+1\\right)^2}{\\left(2\\cdot\\frac{t-1}{2}+1\\right)^2}"
       }
      ]
     },
     {
      "title": "Simplify the numerator bracket",
      "lines": [
       {
        "text": "Write $1$ as $\\frac{2}{2}$ and add."
       },
       {
        "tex": "&= \\frac{\\left(\\frac{t-1+2}{2}\\right)^2}{\\left(2\\cdot\\frac{t-1}{2}+1\\right)^2}"
       },
       {
        "tex": "&= \\frac{\\left(\\frac{t+1}{2}\\right)^2}{\\left(2\\cdot\\frac{t-1}{2}+1\\right)^2}"
       }
      ]
     },
     {
      "title": "Simplify the denominator bracket",
      "lines": [
       {
        "text": "The 2 cancels with the denominator 2."
       },
       {
        "tex": "&= \\frac{\\left(\\frac{t+1}{2}\\right)^2}{(t-1+1)^2}"
       },
       {
        "tex": "&= \\frac{\\left(\\frac{t+1}{2}\\right)^2}{t^2}"
       }
      ]
     },
     {
      "title": "Square the fraction in the numerator",
      "lines": [
       {
        "tex": "&= \\frac{\\frac{(t+1)^2}{2^2}}{t^2}"
       },
       {
        "tex": "&= \\frac{\\frac{(t+1)^2}{4}}{t^2}"
       },
       {
        "tex": "&= \\frac{(t+1)^2}{4t^2}"
       }
      ]
     },
     {
      "title": "Expand the numerator",
      "lines": [
       {
        "tex": "&= \\frac{t^2 + 2t + 1}{4t^2}"
       }
      ]
     }
    ],
    "final": "Q(n) = \\frac{t^2 + 2t + 1}{4t^2}"
   }
  ]
 }
