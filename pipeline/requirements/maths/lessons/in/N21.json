 {
  "skill": {
   "id": "alg-fractions-simplify",
   "title": "Multiply, divide and simplify rational expressions",
   "level": "HL",
   "input": "rational algebraic expressions",
   "output": "simplified fraction"
  },
  "candidates": [
   {
    "part": "practice-alg-fractions-simplify-1",
    "level": "higher",
    "year": null,
    "question": "Write $\\frac{x}{x^2-4} - \\frac{1}{x+2}$ as a single fraction in its simplest form.",
    "marks": 10,
    "steps": [
     {
      "title": "Factorise the first denominator",
      "lines": [
       {
        "tex": "x^2 - 4 &= (x-2)(x+2)"
       },
       {
        "text": "This is the common denominator, since $x+2$ is already a factor."
       }
      ]
     },
     {
      "title": "Write both fractions over the common denominator",
      "lines": [
       {
        "tex": "\\frac{x}{x^2-4} - \\frac{1}{x+2} &= \\frac{x}{(x-2)(x+2)} - \\frac{1\\cdot(x-2)}{(x+2)(x-2)}"
       }
      ]
     },
     {
      "title": "Combine and simplify the numerator",
      "lines": [
       {
        "tex": "&= \\frac{x - (x-2)}{(x-2)(x+2)}"
       },
       {
        "tex": "&= \\frac{x - x + 2}{(x-2)(x+2)}"
       },
       {
        "tex": "&= \\frac{2}{(x-2)(x+2)}"
       }
      ]
     }
    ],
    "final": "\\frac{2}{(x-2)(x+2)}"
   },
   {
    "part": "practice-alg-fractions-simplify-2",
    "level": "higher",
    "year": null,
    "question": "Simplify $\\frac{x^2-x-6}{x^2-1} \\div \\frac{x^2-2x-3}{x^2+3x+2}$.",
    "marks": 10,
    "steps": [
     {
      "title": "Turn the division into a multiplication",
      "lines": [
       {
        "text": "Invert the second fraction."
       },
       {
        "tex": "\\frac{x^2-x-6}{x^2-1} \\div \\frac{x^2-2x-3}{x^2+3x+2} &= \\frac{x^2-x-6}{x^2-1} \\times \\frac{x^2+3x+2}{x^2-2x-3}"
       }
      ]
     },
     {
      "title": "Factorise every quadratic",
      "lines": [
       {
        "tex": "x^2 - x - 6 &= (x-3)(x+2)"
       },
       {
        "tex": "x^2 - 1 &= (x-1)(x+1)"
       },
       {
        "tex": "x^2 + 3x + 2 &= (x+1)(x+2)"
       },
       {
        "tex": "x^2 - 2x - 3 &= (x-3)(x+1)"
       }
      ]
     },
     {
      "title": "Substitute the factors",
      "lines": [
       {
        "tex": "&= \\frac{(x-3)(x+2)}{(x-1)(x+1)} \\times \\frac{(x+1)(x+2)}{(x-3)(x+1)}"
       }
      ]
     },
     {
      "title": "Cancel common factors",
      "lines": [
       {
        "text": "Cancel $(x-3)$ and one $(x+1)$ from top and bottom."
       },
       {
        "tex": "&= \\frac{(x+2)(x+2)}{(x-1)(x+1)}"
       },
       {
        "tex": "&= \\frac{(x+2)^2}{(x-1)(x+1)}"
       }
      ]
     }
    ],
    "final": "\\frac{(x+2)^2}{(x-1)(x+1)}"
   },
   {
