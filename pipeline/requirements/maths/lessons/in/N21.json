    "level": "ordinary",
    "year": null,
    "question": "Factorise $8a^3 - 12a^2 + 4a$.",
    "marks": 5,
    "steps": [
     {
      "title": "Find the highest common factor",
      "lines": [
       {
        "text": "The HCF of 8, 12 and 4 is $4$, and every term contains $a$, so the HCF is $4a$."
       }
      ]
     },
     {
      "title": "Write each term as the HCF times something",
      "lines": [
       {
        "tex": "8a^3 - 12a^2 + 4a &= 4a\\cdot 2a^2 - 4a\\cdot 3a + 4a\\cdot 1"
       }
      ]
     },
     {
      "title": "Take the HCF outside a bracket",
      "lines": [
       {
        "tex": "&= 4a(2a^2 - 3a + 1)"
       }
      ]
     }
    ],
    "final": "4a(2a^2 - 3a + 1)"
   },
   {
