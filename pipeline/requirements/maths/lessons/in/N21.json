    "year": null,
    "question": "Factorise $12x^2y - 18xy^2$.",
    "marks": 5,
    "steps": [
     {
      "title": "Find the highest common factor",
      "lines": [
       {
        "text": "The HCF of 12 and 18 is $6$. Both terms contain $x$ and $y$ at least once, so the HCF is $6xy$."
       }
      ]
     },
     {
      "title": "Write each term as the HCF times something",
      "lines": [
       {
        "tex": "12x^2y - 18xy^2 &= 6xy\\cdot 2x - 6xy\\cdot 3y"
       }
      ]
     },
     {
      "title": "Take the HCF outside a bracket",
      "lines": [
       {
        "tex": "&= 6xy(2x - 3y)"
       }
      ]
     }
    ],
    "final": "6xy(2x - 3y)"
   },
   {
