     },
     {
      "title": "Write down the profit",
      "lines": [
       {
        "tex": "\\text{Profit} &= 112.50 - 90"
       },
       {
        "tex": "&= \\text{€}22.50"
       }
      ]
     },
     {
      "title": "Find the margin as a percentage of the selling price",
      "lines": [
       {
        "text": "Margin is the profit divided by the selling price, times 100."
       },
       {
        "tex": "\\text{Margin} &= \\frac{22.50}{112.50} \\times 100"
       },
       {
        "tex": "&= 20\\%"
       }
      ]
     }
