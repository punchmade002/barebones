  "skill": {
   "id": "cx-quadratic",
   "title": "Solve a quadratic with complex roots",
   "level": "HL",
   "input": "quadratic with b² − 4ac < 0",
   "output": "conjugate pair of roots"
  },
  "candidates": [
   {
    "part": "maths-pp-2016-higher-p1-q1#(c)",
    "level": "higher",
    "year": 2016,
    "marks": 10,
    "steps": [
     {
      "title": "Use the sum of the roots",
      "lines": [
       {
        "text": "For $z^2 + bz + c = 0$ the roots add up to $-b$. Here $b = -2 + i$."
       },
       {
        "tex": "(1+i) + z_1 &= -(-2 + i)"
       },
       {
        "tex": "&= 2 - i"
       }
      ]
     },
     {
      "title": "Solve for the other root",
      "lines": [
       {
        "tex": "z_1 &= 2 - i - (1 + i)"
       },
       {
        "tex": "&= 2 - i - 1 - i"
       },
       {
        "tex": "&= 1 - 2i"
       }
      ]
     }
    ],
    "final": "1 - 2i"
   },
   {
    "part": "maths-pp-2024-higher-p1-q2#(a)",
    "level": "higher",
    "year": 2024,
    "marks": 5,
    "steps": [
     {
      "title": "Identify a, b and c",
      "lines": [
       {
        "tex": "z^2 + 12z + 261 &= 0"
       },
       {
        "text": "Here $a = 1$, $b = 12$, $c = 261$."
       }
      ]
     },
     {
      "title": "Substitute into the quadratic formula",
      "lines": [
       {
        "tex": "z &= \\frac{-12 \\pm \\sqrt{12^2 - 4(1)(261)}}{2(1)}"
       }
      ]
     },
     {
      "title": "Simplify under the square root",
      "lines": [
       {
        "tex": "z &= \\frac{-12 \\pm \\sqrt{144 - 1044}}{2}"
       },
       {
        "tex": "z &= \\frac{-12 \\pm \\sqrt{-900}}{2}"
       }
      ]
     },
     {
      "title": "Write the root using i",
      "lines": [
       {
        "text": "$\\sqrt{-900} = \\sqrt{900} \\times \\sqrt{-1} = 30i$."
       },
       {
        "tex": "z &= \\frac{-12 \\pm 30i}{2}"
       }
      ]
     },
     {
      "title": "Divide each term by 2",
      "lines": [
       {
        "tex": "z &= -6 \\pm 15i"
       },
       {
        "tex": "z &= -6 + 15i \\text{ or } z = -6 - 15i"
       }
      ]
     }
    ],
    "final": "-6 + 15i \\text{ and } -6 - 15i"
   },
   {
    "part": "practice-cx-quadratic-1",
    "level": "higher",
    "year": null,
    "question": "Solve $4z^2 - 8z + 13 = 0$, where $z \\in \\mathbb{C}$.\nGive your answers in the form $a + bi$.",
    "marks": 10,
    "steps": [
     {
      "title": "Identify a, b and c",
      "lines": [
       {
        "tex": "4z^2 - 8z + 13 &= 0"
       },
       {
        "text": "Here $a = 4$, $b = -8$, $c = 13$."
       }
      ]
     },
     {
      "title": "Substitute into the formula",
      "lines": [
       {
        "tex": "z &= \\frac{8 \\pm \\sqrt{(-8)^2 - 4(4)(13)}}{2(4)}"
       }
      ]
     },
     {
      "title": "Simplify under the square root",
      "lines": [
       {
        "tex": "z &= \\frac{8 \\pm \\sqrt{64 - 208}}{8}"
       },
       {
        "tex": "&= \\frac{8 \\pm \\sqrt{-144}}{8}"
       }
      ]
     },
     {
      "title": "Write the root using i",
      "lines": [
       {
        "text": "$\\sqrt{-144} = 12i$."
       },
       {
        "tex": "z &= \\frac{8 \\pm 12i}{8}"
       }
      ]
     },
     {
      "title": "Divide each term by 8",
      "lines": [
       {
        "tex": "z &= 1 \\pm \\frac{3}{2}i"
       },
       {
        "text": "The roots are a conjugate pair."
       }
      ]
     }
    ],
    "final": "z = 1 + \\tfrac{3}{2}i \\text{ and } z = 1 - \\tfrac{3}{2}i"
   },
   {
    "part": "practice-cx-quadratic-2",
    "level": "higher",
    "year": null,
    "question": "Solve the equation $z(z + 6) = -34$, where $z \\in \\mathbb{C}$.\nGive your answers in the form $a + bi$.",
    "marks": 5,
    "steps": [
     {
      "title": "Write in the form $az^2 + bz + c = 0$",
      "lines": [
       {
        "tex": "z(z+6) &= -34"
