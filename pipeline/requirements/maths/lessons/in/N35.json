       {
        "text": "Here $a = 1$, $b = 6$, $c = 34$."
       }
      ]
     },
     {
      "title": "Substitute into the quadratic formula",
      "lines": [
       {
        "tex": "z &= \\frac{-6 \\pm \\sqrt{6^2 - 4(1)(34)}}{2(1)}"
       }
      ]
     },
     {
      "title": "Simplify under the square root",
      "lines": [
       {
        "tex": "z &= \\frac{-6 \\pm \\sqrt{36 - 136}}{2}"
       },
       {
        "tex": "&= \\frac{-6 \\pm \\sqrt{-100}}{2}"
       }
      ]
     },
     {
      "title": "Write the root using i",
      "lines": [
       {
        "text": "$\\sqrt{-100} = \\sqrt{100} \\times \\sqrt{-1} = 10i$."
       },
       {
        "tex": "z &= \\frac{-6 \\pm 10i}{2}"
       }
      ]
     },
     {
      "title": "Divide each term by 2",
      "lines": [
       {
        "tex": "z &= -3 \\pm 5i"
       },
       {
        "text": "The roots are a conjugate pair."
       }
      ]
     }
    ],
    "final": "z = -3 + 5i \\text{ and } z = -3 - 5i"
   }
  ]
 },
