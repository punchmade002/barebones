   {
    "part": "practice-ind-negative-fractional-3",
    "level": "ordinary",
    "year": null,
    "question": "Evaluate $4^{-\\frac{3}{2}} \\times 27^{\\frac{2}{3}}$.",
    "marks": 5,
    "steps": [
     {
      "title": "Evaluate $4^{-\frac{3}{2}}$",
      "lines": [
       {
        "text": "Remove the negative index, then take the square root and cube."
       },
       {
        "tex": "4^{-\\frac{3}{2}} &= \\frac{1}{4^{\\frac{3}{2}}}"
       },
       {
        "tex": "4^{\\frac{3}{2}} &= \\left(\\sqrt{4}\\right)^3"
       },
       {
        "tex": "&= 2^3 = 8"
       },
       {
        "tex": "4^{-\\frac{3}{2}} &= \\frac{1}{8}"
       }
      ]
     },
     {
      "title": "Evaluate $27^{\frac{2}{3}}$",
      "lines": [
       {
        "text": "The denominator is the root and the numerator is the power."
       },
       {
        "tex": "27^{\\frac{2}{3}} &= \\left(\\sqrt[3]{27}\\right)^2"
       },
       {
        "tex": "&= 3^2"
       },
       {
        "tex": "&= 9"
       }
      ]
     },
     {
      "title": "Multiply the two values",
      "lines": [
       {
        "tex": "4^{-\\frac{3}{2}} \\times 27^{\\frac{2}{3}} &= \\frac{1}{8} \\times 9"
       },
       {
        "tex": "&= \\frac{9}{8}"
       }
      ]
     }
    ],
    "final": "\\frac{9}{8}"
   },
   {
    "part": "practice-ind-negative-fractional-1",
    "level": "ordinary",
    "year": null,
    "question": "Evaluate $16^{-\\frac{3}{4}}$.",
    "marks": 5,
    "steps": [
     {
      "title": "Remove the negative index",
      "lines": [
       {
        "text": "Use $a^{-n} = \\dfrac{1}{a^n}$."
       },
       {
        "tex": "16^{-\\frac{3}{4}} &= \\frac{1}{16^{\\frac{3}{4}}}"
       }
      ]
     },
     {
      "title": "Take the fourth root of 16",
      "lines": [
       {
        "text": "The denominator of the index is the root: $a^{\\frac{1}{4}} = \\sqrt[4]{a}$."
       },
       {
        "tex": "16^{\\frac{1}{4}} &= 2"
       }
      ]
     },
     {
      "title": "Cube the result",
      "lines": [
       {
        "text": "The numerator of the index is the power."
       },
       {
        "tex": "16^{\\frac{3}{4}} &= \\left(16^{\\frac{1}{4}}\\right)^3"
       },
       {
        "tex": "&= 2^3"
       },
       {
        "tex": "&= 8"
       }
      ]
     },
     {
      "title": "Write the answer",
      "lines": [
       {
        "tex": "16^{-\\frac{3}{4}} &= \\frac{1}{8}"
       }
      ]
     }
    ],
    "final": "\\frac{1}{8}"
   },
