       {
        "tex": "\\tan\\theta &= \\pm\\frac{-\\frac{1}{3} - \\frac{2}{5}}{1 + \\left(-\\frac{1}{3}\\right)\\left(\\frac{2}{5}\\right)}"
       }
      ]
     },
     {
      "title": "Simplify the fraction",
      "lines": [
       {
        "tex": "\\tan\\theta &= \\pm\\frac{-\\frac{11}{15}}{\\frac{13}{15}}"
       },
       {
        "tex": "\\tan\\theta &= \\pm\\frac{-11}{13}"
       }
      ]
     },
     {
      "title": "Find the acute angle",
      "lines": [
       {
        "text": "Take the positive value, since we want the acute angle."
       },
       {
        "tex": "\\theta &= \\tan^{-1}\\left(\\frac{11}{13}\\right)"
       },
       {
        "tex": "\\theta &= 40.2\\ldots^\\circ"
       },
       {
        "tex": "\\theta &\\approx 40^\\circ"
       }
      ]
     }
    ],
    "final": "40^\\circ"
   }
  ]
