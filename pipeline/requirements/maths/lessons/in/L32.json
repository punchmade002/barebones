 {
  "skill": {
   "id": "line-angle-between",
   "title": "Find the angle between two lines",
   "level": "HL",
   "input": "two slopes",
   "output": "tan θ = ±(m₁ − m₂)/(1 + m₁m₂)"
  },
  "candidates": [
   {
    "part": "maths-pp-2020-higher-p2-q1#(b)",
    "level": "higher",
    "year": 2020,
    "marks": 10,
    "steps": [
     {
      "title": "Find the slopes of a and b",
      "lines": [
       {
        "text": "Rearrange $x - 2y + 1 = 0$ into $y = mx + c$."
       },
       {
        "tex": "2y &= x + 1"
       },
       {
        "tex": "y &= \\frac{1}{2}x + \\frac{1}{2}"
       },
       {
        "text": "So the slope of $a$ is $\\frac{1}{2}$. Line $b$ makes $60^\\circ$ with the positive $x$-axis."
       },
       {
        "tex": "m_b &= \\tan 60^\\circ"
       },
       {
        "tex": "&= \\sqrt{3}"
       }
      ]
     },
     {
      "title": "Substitute into the angle formula",
      "lines": [
       {
        "text": "Use $\\tan\\theta = \\left|\\frac{m_1 - m_2}{1 + m_1 m_2}\\right|$ with $m_1 = \\sqrt{3}$ and $m_2 = \\frac{1}{2}$."
       },
       {
        "tex": "\\tan\\theta &= \\left|\\frac{\\sqrt{3} - \\frac{1}{2}}{1 + \\sqrt{3}\\cdot\\frac{1}{2}}\\right|"
       },
       {
        "tex": "&= \\frac{2\\sqrt{3} - 1}{2 + \\sqrt{3}}"
       }
      ]
     },
     {
      "title": "Rationalise the denominator",
      "lines": [
       {
        "text": "Multiply top and bottom by $2 - \\sqrt{3}$."
       },
       {
        "tex": "\\tan\\theta &= \\frac{(2\\sqrt{3} - 1)(2 - \\sqrt{3})}{(2+\\sqrt{3})(2-\\sqrt{3})}"
       },
       {
        "tex": "&= \\frac{4\\sqrt{3} - 6 - 2 + \\sqrt{3}}{4 - 3}"
       },
       {
        "tex": "&= 5\\sqrt{3} - 8"
       }
      ]
     },
     {
      "title": "Find the angle",
      "lines": [
       {
        "tex": "\\theta &= \\tan^{-1}\\left(5\\sqrt{3} - 8\\right)"
       },
       {
        "tex": "&= 33.435^\\circ"
       }
      ]
     }
    ],
    "final": "\\theta = 33.435^\\circ"
   },
   {
    "part": "maths-pp-2022-higher-p2-q2#(c)",
    "level": "higher",
    "year": 2022,
    "marks": 15,
    "steps": [
     {
      "title": "Write the angle formula",
      "lines": [
       {
        "text": "The angle $\\theta$ between lines with slopes $m_1$ and $m_2$ satisfies $\\tan\\theta = \\frac{m_1 - m_2}{1 + m_1 m_2}$."
       },
       {
        "text": "Let $m_1 = -2$, $m_2 = m$ (the slope of $j$) and $\\theta = 30^\\circ$."
       }
      ]
     },
     {
      "title": "Substitute the values",
      "lines": [
       {
        "tex": "\\tan 30^\\circ &= \\frac{-2 - m}{1 + (-2)m}"
       },
       {
        "tex": "\\frac{1}{\\sqrt{3}} &= \\frac{-2 - m}{1 - 2m}"
       }
      ]
     },
     {
      "title": "Clear the fraction",
      "lines": [
       {
        "text": "Multiply both sides by $\\sqrt{3}(1-2m)$."
       },
       {
        "tex": "1 - 2m &= \\sqrt{3}(-2 - m)"
       },
       {
        "tex": "1 - 2m &= -2\\sqrt{3} - \\sqrt{3}m"
       }
      ]
     },
     {
      "title": "Collect the m terms",
      "lines": [
       {
        "text": "Add $2\\sqrt{3}$ and $2m$ to both sides."
       },
       {
        "tex": "1 + 2\\sqrt{3} &= 2m - \\sqrt{3}m"
       },
       {
        "tex": "1 + 2\\sqrt{3} &= m(2 - \\sqrt{3})"
       },
       {
        "tex": "m &= \\frac{1 + 2\\sqrt{3}}{2 - \\sqrt{3}}"
       }
      ]
     },
     {
      "title": "Rationalise the denominator",
      "lines": [
       {
        "text": "Multiply top and bottom by $2 + \\sqrt{3}$."
       },
       {
        "tex": "m &= \\frac{(1 + 2\\sqrt{3})(2 + \\sqrt{3})}{(2 - \\sqrt{3})(2 + \\sqrt{3})}"
       },
       {
        "tex": "&= \\frac{2 + \\sqrt{3} + 4\\sqrt{3} + 6}{4 - 3}"
       },
       {
        "tex": "&= \\frac{8 + 5\\sqrt{3}}{1}"
       },
       {
        "tex": "&= 8 + 5\\sqrt{3}"
       }
      ]
     }
    ],
    "final": "8 + 5\\sqrt{3}"
   },
   {
