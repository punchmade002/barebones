 {
  "skill": {
   "id": "diff-slope-tangent",
   "title": "Find the slope and equation of a tangent",
   "level": "OL",
   "input": "f(x) and a point",
   "output": "slope f′(a); tangent line"
  },
  "candidates": [
   {
    "part": "maths-pp-2020-ordinary-p1-q6#(a)(ii)",
    "level": "ordinary",
    "year": 2020,
    "marks": 5,
    "steps": [
     {
      "title": "Substitute x = 1 into f'(x)",
      "lines": [
       {
        "text": "The slope of the tangent at $x = 1$ is $f'(1)$."
       },
       {
        "tex": "f'(1) &= 12(1)^2 - 6(1) + 1"
       },
       {
        "tex": "&= 12 - 6 + 1"
       },
       {
        "tex": "&= 7"
       }
      ]
     }
    ],
    "final": "7"
   },
   {
    "part": "maths-pp-2020-ordinary-p1-q6#(a)(iii)",
    "level": "ordinary",
    "year": 2020,
    "marks": 5,
    "steps": [
     {
      "title": "Write the line through (1, -5) with slope 7",
      "lines": [
       {
        "text": "Use $y - y_1 = m(x - x_1)$ with $m = 7$ and $(x_1, y_1) = (1, -5)$."
       },
       {
        "tex": "y - (-5) &= 7(x - 1)"
       },
       {
        "tex": "y + 5 &= 7(x - 1)"
       }
      ]
     },
     {
      "title": "Rearrange into the form ax + by + c = 0",
      "lines": [
       {
        "tex": "y + 5 &= 7x - 7"
       },
       {
        "tex": "0 &= 7x - 7 - y - 5"
       },
       {
        "tex": "7x - y - 12 &= 0"
       }
      ]
     }
    ],
    "final": "7x - y - 12 = 0"
   },
   {
    "part": "maths-pp-2023-ordinary-p1-q4#(b)(ii)",
    "level": "ordinary",
    "year": 2023,
    "marks": 5,
    "steps": [
     {
      "title": "Find the slope at x = 2",
      "lines": [
       {
        "text": "The slope of the tangent is $h'(2)$."
       },
       {
        "tex": "h'(2) &= 3(2)^2 + 4(2) - 1"
       },
       {
        "tex": "&= 12 + 8 - 1"
       },
       {
        "tex": "&= 19"
       }
      ]
     },
     {
      "title": "Use the point-slope formula",
      "lines": [
       {
        "text": "With $m = 19$ and point $(2, 6)$: $y - y_1 = m(x - x_1)$."
       },
       {
        "tex": "y - 6 &= 19(x - 2)"
       }
      ]
     },
     {
      "title": "Rearrange (optional)",
      "lines": [
       {
        "tex": "y - 6 &= 19x - 38"
       },
       {
        "tex": "0 &= 19x - y - 32"
       }
      ]
     }
    ],
    "final": "19x - y - 32 = 0"
   },
   {
    "part": "maths-pp-2025-ordinary-p1-q4#(b)",
    "level": "ordinary",
    "year": 2025,
    "marks": 10,
    "steps": [
     {
      "title": "Differentiate each term",
      "lines": [
       {
        "text": "Use $\\frac{d}{dx}(x^n) = nx^{n-1}$. The constant $-8$ differentiates to 0."
       },
       {
        "tex": "f'(x) &= 3x^2 - 6x + 4"
       }
      ]
     },
     {
      "title": "Substitute x = 2 into f′(x)",
      "lines": [
       {
        "tex": "f'(2) &= 3(2)^2 - 6(2) + 4"
       },
       {
        "tex": "&= 12 - 12 + 4"
       },
       {
        "tex": "&= 4"
       }
      ]
     },
     {
      "title": "State the slope",
      "lines": [
       {
        "text": "The slope of the tangent at $(2, -4)$ is the value of $f'(2)$."
       }
      ]
     }
    ],
    "final": "f'(x) = 3x^2 - 6x + 4, \\quad \\text{slope} = 4"
   },
   {
    "part": "practice-diff-slope-tangent-1",
    "level": "ordinary",
    "year": null,
    "question": "Find the equation of the tangent to the curve $y = x^3 - 4x$ at the point where $x = -1$.",
    "marks": 5,
    "steps": [
     {
      "title": "Find the slope at x = -1",
      "lines": [
       {
        "text": "Differentiate, then substitute $x = -1$."
       },
       {
        "tex": "\\frac{dy}{dx} &= 3x^2 - 4"
       },
       {
        "tex": "m &= 3(-1)^2 - 4 = -1"
       }
      ]
     },
     {
      "title": "Find the point on the curve",
      "lines": [
       {
        "tex": "y &= (-1)^3 - 4(-1) = 3"
       },
       {
        "text": "The point is $(-1, 3)$."
       }
      ]
     },
     {
      "title": "Use the point-slope formula",
      "lines": [
       {
        "text": "With $m = -1$ and point $(-1, 3)$: $y - y_1 = m(x - x_1)$."
       },
       {
        "tex": "y - 3 &= -1(x + 1)"
       },
       {
        "tex": "y &= -x + 2"
       }
      ]
     }
    ],
    "final": "y = -x + 2"
   },
   {
    "part": "practice-diff-slope-tangent-2",
    "level": "ordinary",
    "year": null,
    "question": "The curve $y = 2x^2 - 3x + 5$ passes through the point $(2, 7)$.\nFind the equation of the tangent to the curve at $(2, 7)$, in the form $ax + by + c = 0$.",
    "marks": 10,
    "steps": [
     {
      "title": "Differentiate to find the slope",
      "lines": [
       {
        "tex": "\\frac{dy}{dx} &= 4x - 3"
       }
      ]
     },
     {
      "title": "Find the slope at x = 2",
      "lines": [
       {
        "tex": "m &= 4(2) - 3 = 5"
       }
      ]
     },
     {
      "title": "Use the point-slope formula",
      "lines": [
       {
        "text": "With $m = 5$ and point $(2, 7)$: $y - y_1 = m(x - x_1)$."
       },
       {
        "tex": "y - 7 &= 5(x - 2)"
       }
      ]
     },
     {
      "title": "Rearrange",
      "lines": [
       {
        "tex": "y - 7 &= 5x - 10"
       },
       {
        "tex": "0 &= 5x - y - 3"
       }
      ]
     }
    ],
    "final": "5x - y - 3 = 0"
   }
  ]
 },
