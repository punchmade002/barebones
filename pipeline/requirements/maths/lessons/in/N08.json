    "year": null,
    "question": "Maria saves $\\text{€}500$ at the start of each year for 4 years. The account pays $2\\%$ interest per year.\nFind the total value of her savings at the end of the 4 years, correct to the nearest cent.",
    "marks": 10,
    "steps": [
     {
      "title": "Each deposit grows by 1.02 per year",
      "lines": [
       {
        "text": "$2\\% = 0.02$, so the yearly factor is $1.02$."
       },
       {
        "text": "The first deposit earns interest for 4 years, the last for 1 year."
       }
      ]
     },
     {
      "title": "Write the total as a series",
      "lines": [
       {
        "tex": "\\text{Total} &= 500(1.02)^4 + 500(1.02)^3 + 500(1.02)^2 + 500(1.02)"
       }
      ]
     },
     {
      "title": "Reverse the order and take out 500",
      "lines": [
       {
        "tex": "\\text{Total} &= 500\\left[1.02 + 1.02^2 + 1.02^3 + 1.02^4\\right]"
       }
      ]
     },
     {
      "title": "Identify the geometric series",
      "lines": [
       {
        "text": "The bracket is geometric with $a = 1.02$, $r = 1.02$ and $n = 4$."
       }
      ]
     },
     {
      "title": "Use the sum formula",
      "lines": [
       {
        "tex": "S_4 &= \\frac{a(r^n - 1)}{r - 1}"
       },
       {
        "tex": "&= \\frac{1.02\\left(1.02^4 - 1\\right)}{0.02}"
       },
       {
        "tex": "&\\approx 4.20404"
       },
       {
        "tex": "\\text{Total} &= 500 \\times 4.20404"
       },
       {
        "tex": "&\\approx 2102.02"
       }
      ]
     }
    ],
    "final": "\\text{€}2102.02"
   },
