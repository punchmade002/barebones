    "part": "maths-pp-2023-higher-p1-q8#(d)(i), (ii)",
    "level": "higher",
    "year": 2023,
    "marks": 15,
    "steps": [
     {
      "title": "(i) Each month's deposit grows by 1.0011 per month",
      "lines": [
       {
        "text": "$0.11\\% = 0.0011$, so the monthly factor is $1.0011$."
       },
       {
        "text": "The first deposit earns interest for 36 months, the second for 35 months, and so on. The last deposit earns interest for 1 month."
       }
      ]
     },
     {
      "title": "(i) Write the total as a series",
      "lines": [
       {
        "tex": "\\text{Total} &= A(1.0011)^{36} + A(1.0011)^{35} + \\cdots + A(1.0011)^2 + A(1.0011)"
       }
      ]
     },
     {
      "title": "(ii) Reverse the order and take out A",
      "lines": [
       {
        "tex": "\\text{Total} &= A(1.0011) + A(1.0011)^2 + \\cdots + A(1.0011)^{35} + A(1.0011)^{36}"
       },
       {
        "tex": "&= A\\left[1.0011 + (1.0011)^2 + \\cdots + (1.0011)^{35} + (1.0011)^{36}\\right]"
       }
      ]
     },
     {
      "title": "(ii) Identify the geometric series",
      "lines": [
       {
        "text": "The bracket is geometric with first term $a = 1.0011$, common ratio $r = 1.0011$ and $n = 36$ terms."
       }
      ]
     },
     {
      "title": "(ii) Use the sum formula and set the total to 12 000",
      "lines": [
       {
        "tex": "S_{36} &= \\frac{a(1 - r^n)}{1 - r}"
       },
       {
        "tex": "&= \\frac{1.0011\\left(1 - 1.0011^{36}\\right)}{1 - 1.0011}"
       },
       {
        "tex": "&= 36.742"
       },
       {
        "tex": "A(36.742) &= 12000"
       }
      ]
     },
     {
      "title": "(ii) Solve for A",
      "lines": [
       {
        "tex": "A &= \\frac{12000}{36.742}"
       },
       {
        "tex": "&= 326.60"
       }
      ]
     }
    ],
    "final": "A = \\text{€}326.60"
   }
  ]
