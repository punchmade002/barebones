    "part": "maths-pp-2023-higher-p1-q2#(b)",
    "level": "higher",
    "year": 2023,
    "marks": 5,
    "steps": [
     {
      "title": "Take the limit of each term separately",
      "lines": [
       {
        "tex": "\\lim_{n\\to\\infty}\\left[\\frac{n}{n+1} + \\frac{n+1000}{n} + \\left(\\frac{1}{3}\\right)^n\\right] &= \\lim_{n\\to\\infty}\\frac{n}{n+1} + \\lim_{n\\to\\infty}\\frac{n+1000}{n} + \\lim_{n\\to\\infty}\\left(\\frac{1}{3}\\right)^n"
       }
      ]
     },
     {
      "title": "Divide top and bottom of the first two fractions by n",
      "lines": [
       {
        "tex": "\\lim_{n\\to\\infty}\\frac{n}{n+1} &= \\lim_{n\\to\\infty}\\frac{1}{1 + \\frac{1}{n}}"
       },
       {
        "tex": "\\lim_{n\\to\\infty}\\frac{n+1000}{n} &= \\lim_{n\\to\\infty}\\left(1 + \\frac{1000}{n}\\right)"
       }
      ]
     },
     {
      "title": "Let n tend to infinity",
      "lines": [
       {
        "text": "As $n \\to \\infty$: $\\frac{1}{n} \\to 0$, $\\frac{1000}{n} \\to 0$ and $\\left(\\frac{1}{3}\\right)^n \\to 0$."
       },
       {
        "tex": "&= \\frac{1}{1+0} + (1 + 0) + 0"
       },
       {
        "tex": "&= 1 + 1 + 0"
       },
       {
        "tex": "&= 2"
       }
      ]
     }
    ],
    "final": "2"
   },
   {
    "part": "maths-pp-2025-higher-p1-q10#(d)(iii)",
