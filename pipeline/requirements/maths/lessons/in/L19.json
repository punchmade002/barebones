       {
        "text": "Divide each term of the numerator by $4t^2$."
       },
       {
        "tex": "Q_\\infty &= \\lim_{t\\to\\infty}\\frac{t^2 + 2t + 1}{4t^2}"
       },
       {
        "tex": "&= \\lim_{t\\to\\infty}\\left(\\frac{t^2}{4t^2} + \\frac{2t}{4t^2} + \\frac{1}{4t^2}\\right)"
       }
      ]
     },
     {
      "title": "Simplify each fraction",
      "lines": [
       {
        "tex": "Q_\\infty &= \\lim_{t\\to\\infty}\\left(\\frac{1}{4} + \\frac{1}{2t} + \\frac{1}{4t^2}\\right)"
       }
      ]
     },
     {
      "title": "Take the limit",
      "lines": [
       {
        "text": "As $t\\to\\infty$, $\\frac{1}{2t}\\to 0$ and $\\frac{1}{4t^2}\\to 0$."
       },
       {
        "tex": "Q_\\infty &= \\frac{1}{4} + 0 + 0"
       },
       {
        "tex": "&= \\frac{1}{4}"
       }
      ]
     }
    ],
    "final": "Q_\\infty = \\frac{1}{4}"
   }
  ]
