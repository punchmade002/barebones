      "title": "Substitute the limits and set equal to 9",
      "lines": [
       {
        "tex": "\\frac{1}{5}e^{5k} - \\frac{1}{5}e^{5(0)} &= 9"
       },
       {
        "text": "$e^0 = 1$."
       },
       {
        "tex": "\\frac{1}{5}e^{5k} - \\frac{1}{5} &= 9"
       }
      ]
     },
