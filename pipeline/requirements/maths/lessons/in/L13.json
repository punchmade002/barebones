    "steps": [
     {
      "title": "Find the height of the shaded strip",
      "lines": [
       {
        "text": "Between $x = -1$ and $x = 2$ the line $f$ is above the curve $g$ (the graphs only cross at $x = -2$ and $x = 3$). Area = integral of top minus bottom."
       },
       {
        "tex": "f(x) - g(x) &= x + 4 - (x^2 - 2)"
       },
       {
        "tex": "&= x + 4 - x^2 + 2"
       },
       {
        "tex": "&= -x^2 + x + 6"
       }
      ]
     },
     {
      "title": "Write the area as an integral",
      "lines": [
       {
        "tex": "\\text{Area} &= \\int_{-1}^{2} (-x^2 + x + 6)\\,dx"
       }
      ]
     },
     {
      "title": "Integrate each term",
      "lines": [
       {
        "tex": "&= \\left[-\\frac{x^3}{3} + \\frac{x^2}{2} + 6x\\right]_{-1}^{2}"
       }
      ]
     },
     {
      "title": "Substitute the limits (upper minus lower)",
      "lines": [
       {
        "tex": "&= \\left(-\\frac{2^3}{3} + \\frac{2^2}{2} + 6(2)\\right) - \\left(-\\frac{(-1)^3}{3} + \\frac{(-1)^2}{2} + 6(-1)\\right)"
       },
       {
        "tex": "&= \\left(-\\frac{8}{3} + 2 + 12\\right) - \\left(\\frac13 + \\frac12 - 6\\right)"
       },
       {
        "tex": "&= \\frac{34}{3} - \\left(-\\frac{31}{6}\\right)"
       },
       {
        "tex": "&= \\frac{68}{6} + \\frac{31}{6}"
       },
       {
        "tex": "&= \\frac{99}{6}"
       },
       {
        "tex": "&= \\frac{33}{2}"
       }
      ]
     }
    ],
    "final": "\\frac{33}{2} \\text{ units}^2"
   },
