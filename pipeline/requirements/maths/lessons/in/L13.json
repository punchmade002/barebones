      "title": "Isolate $e^{5k}$",
      "lines": [
       {
        "text": "Multiply both sides by 5."
       },
       {
        "tex": "e^{5k} - 1 &= 45"
       },
       {
        "text": "Add 1 to both sides."
       },
       {
        "tex": "e^{5k} &= 46"
       }
      ]
     },
     {
      "title": "Take natural logs and solve for $k$",
      "lines": [
       {
        "tex": "5k &= \\ln 46"
       },
       {
        "tex": "k &= \\frac{\\ln 46}{5}"
       },
       {
        "text": "This is in the form $\\frac{\\ln a}{b}$ with $a = 46$, $b = 5$."
       }
      ]
     }
