    "steps": [
     {
      "title": "Write the cubic as the quadratic times a linear factor",
      "lines": [
       {
        "text": "A quadratic factor of a cubic leaves a linear factor $(x + k)$."
       },
       {
        "tex": "(x^2 - px + 1)(x + k) &= x^3 - 2x - 3r"
       }
      ]
     },
     {
      "title": "Expand the left-hand side",
      "lines": [
       {
        "tex": "x^3 + kx^2 - px^2 - pkx + x + k &= x^3 - 2x - 3r"
       },
       {
        "tex": "x^3 + (k - p)x^2 + (1 - pk)x + k &= x^3 - 2x - 3r"
       }
      ]
     },
     {
      "title": "Compare the coefficients of x²",
      "lines": [
       {
        "text": "The right-hand side has no $x^2$ term, so its coefficient is $0$."
       },
       {
        "tex": "k - p &= 0"
       },
       {
        "tex": "k &= p"
       }
      ]
     },
     {
      "title": "Compare the coefficients of x to find p",
      "lines": [
       {
        "tex": "1 - pk &= -2"
       },
       {
        "tex": "1 - p^2 &= -2"
       },
       {
        "tex": "p^2 &= 3"
       },
       {
        "text": "Since $p < 0$, we take the negative root."
       },
       {
        "tex": "p &= -\\sqrt{3}"
       }
      ]
     },
     {
      "title": "Compare the constant terms to find r",
      "lines": [
       {
        "tex": "k &= -3r"
       },
       {
        "tex": "r &= -\\frac{k}{3}"
       },
       {
        "tex": "r &= -\\frac{-\\sqrt{3}}{3}"
       },
       {
        "tex": "r &= \\frac{\\sqrt{3}}{3}"
       }
      ]
     }
    ],
    "final": "p = -\\sqrt{3}, \\quad r = \\frac{\\sqrt{3}}{3}"
   }
  ]
