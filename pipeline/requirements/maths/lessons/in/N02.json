        "tex": "&= x^2 - 2x + 1 - 2"
       },
       {
        "tex": "&= x^2 - 2x - 1"
       }
      ]
     },
     {
      "title": "Multiply by the factor for the root 3",
      "lines": [
       {
        "tex": "(x - 3)(x^2 - 2x - 1) &= x^3 - 2x^2 - x - 3x^2 + 6x + 3"
       },
       {
        "tex": "&= x^3 - 5x^2 + 5x + 3"
       }
      ]
     }
    ],
    "final": "x^3 - 5x^2 + 5x + 3 = 0"
   },
