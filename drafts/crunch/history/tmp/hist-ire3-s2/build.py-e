out={"hist-ire3-s2."+k:{"cost":c,"needs":l} for k,(c,l) in D.items()}
txt=open(P+'packs/hist-ire3-s2.t1g1.txt').read()
ids=set(re.findall(r'^\[([^\]]+)\]',txt,re.M))
tg=re.findall(r'^\[(hist-ire3-s2\.[^\]]+)\]',txt,re.M)
miss=set(tg)^set(out)
assert not miss and len(tg)==len(set(tg)),miss
bad=[(k,x["id"]) for k,v in out.items() for x in v["needs"] if x["id"] not in ids or x["id"]==k]; assert not bad,bad
json.dump(out,open(P+'point-links/hist-ire3-s2.t1g1.json','w'),indent=1)
print(len(out),sum(len(v['needs']) for v in out.values()),sum(v['cost']==2 for v in out.values()),sum(x['confidence']=='low' for v in out.values() for x in v['needs']))
