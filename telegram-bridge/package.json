{
  "name": "barebones-telegram-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A free Telegram relay for the Barebones agent group chat.",
  "scripts": {
    "check": "node --check src/config.mjs && node --check src/relay.mjs",
    "start": "node src/relay.mjs listen",
    "relay": "node src/relay.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
