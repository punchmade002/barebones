# Keep the real values in telegram-bridge.env (at the repository root) or in
# this folder's .env. Both locations are ignored by Git.
TELEGRAM_BOT_TOKEN=

# Obtain this safely: start the bridge once, then send /id in the target group.
# Group IDs normally look like -1001234567890.
TELEGRAM_ALLOWED_CHAT_ID=

# This bridge reads OPENAI_API_KEY from the root openaiapi.env.txt too.
OPENAI_MODEL=gpt-5-mini
BOT_LABEL=Barebones Codex

# The bot responds only to /codex, /ask, or a direct @mention in groups.
TELEGRAM_REQUIRE_TRIGGER=true
